    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "typescript": "^6.0.3"
  }
}
