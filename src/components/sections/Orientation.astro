---
import ChoisirTache from '@/components/editorial/ChoisirTache.astro';
import Picto from '@/components/Picto.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['orientation']; cac?:boolean; }
const { contenu = contenuDe('ec').orientation, cac=false } = Astro.props;

/** Recette A du 15/10/2026 : contenu et ancres conservés, cadres commerciaux retirés. */
const { destinations, services } = contenu;
---

<div class="orientation"><span id="orientation-titre"></span><ChoisirTache titre={contenu.titre} cac={cac}/><nav class="section conteneur orientation-renvois" aria-label="Comprendre le service et voir des tâches"><ul class="liens">{destinations.map(d=><li><a class="lien-rangee" href={d.href}><span class="lien-libelle">{d.libelle}<span class="lien-detail">{d.texte}</span></span><Picto nom="fleche" taille={14}/></a></li>)}</ul><div class="liens-bloc"><p class="liens-titre">{contenu.invitation}</p><ul class="liens">{services.map(service=><li><a class="lien-rangee" href={service.href}><span class="lien-libelle">{service.libelle}</span><Picto nom="fleche" taille={14}/></a></li>)}</ul></div></nav></div>
<style>.orientation-renvois{display:grid;gap:40px;padding-top:40px}@media(min-width:64rem){.orientation-renvois{grid-template-columns:1fr 1fr;gap:64px}}</style>
