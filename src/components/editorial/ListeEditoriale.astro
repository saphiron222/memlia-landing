---
/** Même surface verte que la signature du hub robots, sans cellules blanches héritées. */
---
<div class="editorial-points memlia-surface-verte" data-editorial-points><ul class="editorial-points-liste rv-groupe"><slot/></ul></div>
<style>
.editorial-points{min-width:0}
.editorial-points-liste{list-style:none;margin:0;padding:0}
.editorial-points :global(.editorial-point){display:grid;gap:16px;padding:28px 0;border-top:1px solid var(--ligne-douce);background:transparent;min-width:0}
.editorial-points :global(.editorial-point:first-child){border-top:0;padding-top:0}
.editorial-points :global(.editorial-point:last-child){padding-bottom:0}
.editorial-points :global(.editorial-point-titre){font-size:var(--titre-bloc);line-height:1.25;color:var(--texte-fort);max-width:26ch}
.editorial-points :global(.editorial-point-texte){color:var(--texte-2);max-width:68ch;margin:0}
@media(min-width:64rem){.editorial-points :global(.editorial-point){grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr);gap:48px;padding:32px 0}}
</style>
