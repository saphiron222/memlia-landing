---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import IntegrationReplay from '@/components/sections/IntegrationReplay.astro';
import SourceEvidence from '@/components/sections/SourceEvidence.astro';
import Renvois from '@/components/Renvois.astro';
import { auteurPar, identiteAuteur } from '@/data/auteurs';
import { INTEGRATIONS_INDEXABLES, integrationPath, type IntegrationDefinition } from '@/data/integrations';
import { SITE } from '@/data/site.mjs';
import { PROOFS, type ProofId } from '@/data/proofs';

export function getStaticPaths() {
  return INTEGRATIONS_INDEXABLES.map((integration) => ({ params: { slug: integration.slug }, props: { integration } }));
}
interface Props { integration: IntegrationDefinition; }
const { integration } = Astro.props;
const chemin = integrationPath(integration);
const hero = `integrations/${integration.slug}` as ProofId;
if (!(hero in PROOFS)) throw new Error(`Preuve absente pour ${integration.slug}`);
const url = `${SITE.url}${chemin}`;
const auteur = auteurPar(integration.auteur);
const authorUrl = `${SITE.url}${identiteAuteur(auteur)}`;
const page = {
  chemin,
  titre: integration.tabTitle,
  description: integration.description,
  h1: integration.h1,
  chapeau: integration.intro,
  ariane: `${integration.vendor} · ${integration.task}`,
  secondaire: { libelle: 'Voir les neuf guides', href: '/integrations' },
};
const noeuds = [
  {
    '@type': 'TechArticle', '@id': `${url}#article`, url, headline: integration.h1, name: integration.h1,
    description: integration.description, datePublished: integration.datePublication, dateModified: integration.dateMiseAJour,
    inLanguage: SITE.langue, author: { '@id': authorUrl }, publisher: { '@id': `${SITE.url}/#organization` },
    citation: integration.source.url, mainEntityOfPage: { '@id': `${url}#webpage` },
  },
  {
    '@type': 'WebPage', '@id': `${url}#webpage`, url, name: integration.h1, headline: integration.h1,
    description: integration.description, datePublished: integration.datePublication, dateModified: integration.dateMiseAJour,
    author: { '@id': authorUrl }, inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` },
  },
  { '@type': 'Person', '@id': authorUrl, name: auteur.nom, url: authorUrl, jobTitle: auteur.role, worksFor: { '@id': `${SITE.url}/#organization` } },
];
const source = {
  editeur: integration.vendor,
  titre: integration.source.title,
  url: integration.source.url,
  preuve: integration.source.fact,
  consulteLe: integration.dateMiseAJour,
  limite: 'Les menus et champs peuvent varier selon l’édition, la version et les droits du cabinet. La source ne prouve ni partenariat, ni accès, ni compatibilité déjà acquise.',
};
---

<PageCommerciale
  page={page}
  noeuds={noeuds}
  eyebrow={`${integration.product} · guide documenté`}
  hero={hero}
  appel={{
    titre: 'Décrivez le geste dans votre environnement.',
    texte: 'Une description suffit pour le premier échange. Aucun fichier réel ne vous est demandé à ce stade.',
    points: [
      `Le geste : ${integration.task}, avec les mots de votre équipe.`,
      `L’environnement : ${integration.product}, son édition et les droits disponibles.`,
      'La limite : le cas qui doit arrêter la préparation.',
    ],
  }}
>
  <section class="pv" aria-labelledby="repere-editeur">
    <div class="pv-tete rv">
      <h2 id="repere-editeur">Le chemin et les champs que la règle doit connaître</h2>
      <p class="texte-2 lecture">{integration.officialPath}</p>
      <p class="texte-2 lecture">Par <a rel="author" href={identiteAuteur(auteur)}>{auteur.nom}</a>, mis à jour le <time datetime={integration.dateMiseAJour}>20 septembre 2026</time>. {integration.independence}</p>
    </div>
    <ul class="pv-cartes rv-groupe">
      {integration.fields.map((field) => (
        <li class="pv-carte rv"><div class="pv-carte-corps"><h3>{field}</h3><p>Champ observé dans le jeu fictif et relu avant toute proposition.</p></div></li>
      ))}
    </ul>
    <div class="pv-tete rv">
      <p class="texte-2 lecture"><strong>Le piège connu.</strong> {integration.knownTrap}</p>
    </div>
  </section>

  <section class="pv" aria-labelledby="regle-ecrite">
    <div class="pv-tete rv">
      <h2 id="regle-ecrite">La règle écrite</h2>
      <p class="texte-2 lecture">{integration.writtenRule}</p>
    </div>
    <div class="pv-bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ol class="pv-bande-liste rv-groupe" data-colonnes="3">
        <li class="pv-cellule rv"><h3>Préparé</h3><p>{integration.boundary.prepared}</p></li>
        <li class="pv-cellule rv"><h3>À valider</h3><p>{integration.boundary.validation}</p></li>
        <li class="pv-cellule rv"><h3>Reste humain</h3><p>{integration.boundary.human}</p></li>
      </ol>
    </div>
  </section>

  <section class="pv" aria-labelledby="jeu-fictif">
    <div class="pv-tete rv">
      <h2 id="jeu-fictif">Rejoué sur le jeu fictif</h2>
      <p class="texte-2 lecture">Preuve de conception, non recettée dans l’outil éditeur. Trois cas montrent le comportement attendu du gabarit. Ils ne prouvent pas une compatibilité avec votre édition : cette recette ne peut avoir lieu qu’après vérification de l’environnement du cabinet.</p>
    </div>
    <IntegrationReplay integration={integration} />
  </section>

  <section class="pv" aria-labelledby="source">
    <div class="pv-tete rv">
      <h2 id="source">Ce qui est documenté, et rien de plus</h2>
      <p class="texte-2 lecture">La source borne le repère utilisé par ce guide. Elle ne remplace ni l’observation du cabinet, ni la recette sur son environnement.</p>
    </div>
    <SourceEvidence source={source} />
  </section>

  <section class="pv" aria-labelledby="maillage">
    <div class="pv-tete rv">
      <h2 id="maillage">La tâche avant le nom du logiciel</h2>
      <p class="texte-2 lecture">Ce guide répond à une requête d’environnement. Le périmètre vendu reste une tâche prise en charge, avec sa frontière, ses cas d’arrêt et sa recette.</p>
    </div>
    <Renvois items={[
      { texte: 'Le service correspondant décrit la tâche sans la réduire à un éditeur.', libelle: integration.service.label, href: integration.service.href },
      ...(integration.tool ? [{ texte: 'Un outil local permet de rejouer une partie de la règle sur des données fictives.', libelle: integration.tool.label, href: integration.tool.href }] : []),
      { texte: 'Le hub explique pourquoi seuls neuf guides sont publiés.', libelle: 'Voir le cadre de publication des guides', href: '/integrations' },
    ]} colonnes={2} />
  </section>
</PageCommerciale>
