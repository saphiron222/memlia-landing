---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---

<Base titre="Page introuvable — Memlia" titreSocial="Cette page est introuvable." description="Cette page est introuvable. Revenez à l’accueil Memlia ou consultez nos articles sur les tâches répétitives des cabinets." chemin="/404" noindex base="/">
  <section class="conteneur erreur">
    <span class="eyebrow">Erreur 404</span>
    <h1>Cette page est introuvable.</h1>
    <p class="texte-2">Vous pouvez revenir à l’accueil ou consulter nos articles sur les tâches répétitives des cabinets.</p>
    <Button href="/" variante="principal">Retour à l’accueil</Button>
    <Button href="/blog" variante="contour">Consulter nos articles</Button>
    <Button href="/contact" variante="contour">Confier une première tâche</Button>
  </section>
</Base>

<style>
  .erreur { padding-block: 96px; min-height: 60vh; }
  h1 { font-size: var(--t-4xl); margin-block: 20px; }
  p { margin-bottom: 32px; max-width: 48ch; }
</style>
