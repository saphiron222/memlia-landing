---
import ProofRow from '@/components/ProofRow.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['promesse']; }
const { contenu = contenuDe('ec').promesse } = Astro.props;
/**
 * Promesse (copy validée, section 2) — oppose Memlia aux migrations et aux plateformes
 * génériques. Système de page : rangée (en-tête, maquette), puis trois engagements dans la bande
 * du site (`.bande`, global.css), bord à bord de la feuille.
 */
const { points } = contenu;
---

<section id="promesse" class="section pile promesse" aria-labelledby="promesse-titre">
  <div class="conteneur">
    <ProofRow id={contenu.image}>
      <div class="tete rv">
        <h2 id="promesse-titre">{contenu.titre}</h2>
        <p>{contenu.texte}</p>
      </div>
    </ProofRow>
  </div>
  <div class="bande coins">
    <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
    <ul class="cartes rv-groupe">
      {points.map((p) => (
        <li class="cellule promesse-point rv">
          <h3 class="carte-titre">{p.titre}</h3>
          <p class="carte-texte">{p.texte}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
