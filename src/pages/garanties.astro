---
import GrilleEditoriale from '@/components/editorial/GrilleEditoriale.astro';
import ListeEditoriale from '@/components/editorial/ListeEditoriale.astro';
import PageEditoriale from '@/layouts/PageEditoriale.astro';
import BlocEditorial from '@/components/editorial/BlocEditorial.astro';
import Picto, { type NomPicto } from '@/components/Picto.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { SERVICE_ID } from '@/data/schema.mjs';

/*
 * Corps de la page. Chaque section porte son engagement en tête (trois paragraphes au plus), puis
 * ses applications en lignes : la tâche ou l'outil, la phrase qui la borne (Kevin, 13/10/2026 : plus
 * de murs de dix paragraphes). Une phrase qui renvoie à la précédente (« ainsi », « Cette frontière ») reste collée
 * à son antécédent. Les liens de service gardent les ancres que leur recette exige depuis cette page.
 */
const page = PAGES_V2.garanties;
const url = `${SITE.url}${page.chemin}`;
const noeuds = [{
  '@type': 'WebPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
  inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': SERVICE_ID },
}];
/**
 * Les six garanties de l'accueil, chacune menant ici à la section qui la tient. Système de page :
 * des destinations nommées par leur libellé, donc une liste de liens (pictogramme, libellé, flèche).
 */
const grille: { picto: NomPicto; libelle: string; href: string }[] = [
  { picto: 'main', libelle: 'L’IA prépare, l’humain décide', href: '#arret' },
  { picto: 'fictif', libelle: 'Aucune donnée client dans les essais', href: '#donnees' },
  { picto: 'agregat', libelle: 'Agrégats, jamais nominatif', href: '#personnes' },
  { picto: 'recette', libelle: 'Recette sur les cas qui doivent échouer', href: '#recette' },
  { picto: 'regle', libelle: 'Périmètre écrit avant la mise en service', href: '#ecrit' },
  { picto: 'bouclier', libelle: 'Ce que nous ne promettons pas', href: '#refus' },
];
const appel = {
  titre: 'Déployez votre première prise en charge avec un cadre clair.',
  texte: 'Choisissez le robot ou l’agent qui répond à votre besoin. Nous définissons son adaptation, ses accès et ses validations avant la mise en service. Les mêmes engagements s’appliquent à une construction sur mesure.',
  points: ['Un résultat à vérifier avant le déploiement.', 'Des exceptions et des arrêts expliqués.', 'Une maintenance précisée au devis.'],
};
---

<PageEditoriale page={page} noeuds={noeuds} eyebrow="Nos engagements" scene="garanties" appel={appel}>
  <section class="pv" aria-label="Les six garanties">
    <div class="liens-bloc">
      <ul class="liens rv" data-garanties>
        {grille.map((g) => (
          <li>
            <a class="lien-rangee" href={g.href}>
              <Picto nom={g.picto} taille={20} />
              <span class="lien-libelle">{g.libelle}</span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pv" id="arret" aria-labelledby="arret-titre">
    <BlocEditorial scene="garanties">
      <div class="pv-copy rv">
        <h2 id="arret-titre">Vous retrouvez le résultat et ce qui demande une reprise.</h2>
        <p>Un avis absent, une session expirée ou une pièce illisible reste visible dans le compte rendu. Le robot ou l’agent arrête le traitement concerné et en explique la raison.</p>
        <p class="texte-2">Votre équipe peut corriger l’entrée, rétablir l’accès ou décider de la suite. Une donnée ambiguë n’est pas complétée au jugé. Vos saisies restent distinctes des propositions préparées.</p>
        <p class="texte-2">La règle écrite précise les lectures et classements automatiques, les validations attendues et les décisions humaines. Aucun envoi externe sans validation humaine : courriel, déclaration ou facture.</p>
      </div>
    </BlocEditorial>
    <dl class="lignes rv">
      <div class="ligne">
        <dt class="ligne-libelle">Saisie comptable</dt>
        <dd class="ligne-texte">Cette règle borne la décision de <a href="/automatisation/saisie-comptable">confier la préparation de la saisie comptable</a> : une pièce incertaine ne devient jamais une écriture certaine.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Dossier d’évaluation d’entreprise</dt>
        <dd class="ligne-texte">Vous pouvez <a href="/automatisation/evaluation-transmission">garder la décision sur la valeur de l’entreprise</a> tout en confiant la préparation des pièces et tableaux. Un ajustement en attente reste hors du total ; un conflit de versions réclame votre arbitrage.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Registres et obligations</dt>
        <dd class="ligne-texte">Pour <a href="/automatisation/registres-obligations">confier la préparation des mises à jour et rappels</a>, la fiche proposée conserve les annotations du cabinet. Une identité incertaine ou des sources contradictoires arrêtent la proposition ; l’alerte reste à valider.</dd>
      </div>
    </dl>
  </section>

  <section class="pv" aria-labelledby="regle-commune"><div class="editorial-regle"><h2 id="regle-commune">La règle de votre déploiement.</h2><p>Le catalogue donne le point de départ. La règle écrite définit le fonctionnement dans votre cabinet.</p><div class="editorial-frontiere"><div><h3>Préparer</h3><p>Lire les sources autorisées, rassembler les pièces et préparer les propositions selon le périmètre convenu.</p></div><div><h3>Faire valider</h3><p>Présenter les exceptions et attendre les validations prévues avant un envoi, un dépôt ou une signature.</p></div><div><h3>Garder le jugement</h3><p>Votre équipe apprécie le dossier, corrige et engage le cabinet. Le CAC conserve ses conclusions et son opinion.</p></div></div><div class="editorial-arret"><h3>Un arrêt expliqué fait partie du résultat.</h3><p>Accès expiré, pièce absente, contradiction ou cas hors règle : le traitement concerné s’arrête et présente son motif.</p></div><a href="/methode">Comment nous écrivons et éprouvons cette règle →</a></div></section>

  <section class="pv" id="donnees" aria-labelledby="donnees-titre"><div class="tete"><h2 id="donnees-titre">Des essais fictifs, des flux cadrés par mission</h2></div><GrilleEditoriale><article><h3>Des cas entièrement fictifs</h3><p>Les jeux d’essai que nous construisons sont <strong>entièrement fictifs</strong>. Ils reproduisent la forme de vos fichiers, jamais leur contenu. Nous pouvons ainsi <a href="/automatisation/notes-de-frais">éprouver le traitement des notes de frais</a> avec un justificatif fictif, un doublon et un refus attendu.</p></article><article><h3>Un cadrage sans copie</h3><p class="texte-2">Les fichiers réels autorisés pour le cadrage sont lus en place. Nous ne les copions pas dans nos dépôts et nous développons sur des jeux fictifs. Pour le premier échange, la description du geste suffit.</p></article><article><h3>Des accès et des flux écrits</h3><p class="texte-2">Avant la mise en service, nous documentons les données lues, les droits d’accès, les destinataires et les flux du traitement. Les hébergements éventuels, les durées de conservation et les responsabilités sont précisés pour la mission. Un traitement local se vérifie sur ses appels réseau et sa télémétrie ; le lieu du fichier ne suffit pas.</p></article></GrilleEditoriale>
    <dl class="lignes rv">
      <div class="ligne">
        <dt class="ligne-libelle">Données confiées à une IA</dt>
        <dd class="ligne-texte">Le cadrage commence par <a href="/blog/ia-comptabilite-confidentialite-donnees">préparer les données avant de les confier à une IA</a> : déterminer les entrées utiles et les usages autorisés avant tout partage.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Copie de travail</dt>
        <dd class="ligne-texte">Pour une copie de travail, vous pouvez <a href="/outils-comptables-gratuits/preparer-pseudonymiser-fichier-csv-fec">supprimer des colonnes et pseudonymiser un CSV local</a>, puis examiner les risques restants. Des alias ne garantissent pas l’anonymat.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Circularisation</dt>
        <dd class="ligne-texte"><a href="/automatisation/circularisation-cac">Automatiser la circularisation</a> prépare une proposition de tiers et les pièces postérieures choisies par le CAC. Ses saisies restent séparées des résultats générés ; les conclusions lui appartiennent.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Suivi de circularisation</dt>
        <dd class="ligne-texte">Le <a href="/outils-comptables-gratuits/suivi-circularisation">suivi local de circularisation</a> conserve lettres et notes uniquement dans l’onglet. Exportez le JSON pour reprendre votre campagne ; aucun envoi de courrier ni stockage automatique n’est effectué.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Seuils d’audit</dt>
        <dd class="ligne-texte">Vous pouvez <a href="/outils-comptables-gratuits/seuil-signification-audit">reprendre localement vos scénarios de seuils d’audit</a> : le JSON conserve paramètres et commentaires, sans stockage automatique. Le CAC choisit et justifie les seuils ; nous calculons leur effet.</dd>
      </div>
    </dl>
    <p class="mention">La <a href="/politique-de-confidentialite">politique de confidentialité</a> décrit les données du site. Les flux du service sont documentés par mission avant la mise en service.</p>
  </section>

  <section class="pv" id="personnes" aria-labelledby="personnes-titre"><div class="tete"><h2 id="personnes-titre">Nous ne mesurons pas les personnes</h2></div><GrilleEditoriale><article><h3>Suivre les dossiers</h3><p>Un outil de pilotage compte des dossiers, des étapes et des délais. Il ne classe pas les collaborateurs. Les vues que nous livrons présentent des agrégats : combien de dossiers à telle étape, combien d’exceptions en attente, quelles échéances approchent.</p></article><article><h3>Protéger les personnes</h3><p class="texte-2">L’affectation sert à distribuer le travail ; elle ne justifie pas <a href="https://www.cnil.fr/fr/controle-de-lactivite-des-personnes-employees" rel="noopener noreferrer">une mesure individuelle continue</a>, et nous ne construisons pas de vue qui la rendrait possible par défaut.</p></article><article><h3>Piloter avec des agrégats</h3><p class="texte-2">C’est notre choix de conception pour les vues de pilotage. Le glossaire définit l’<a href="/glossaire#agregat-non-nominatif">agrégat non nominatif</a> : un total utile pour suivre le travail, sans classement individuel.</p></article></GrilleEditoriale>
  </section>

  <section class="pv" id="recette" aria-labelledby="recette-titre"><div class="tete"><h2 id="recette-titre">Votre équipe vérifie avant la mise en service.</h2></div><GrilleEditoriale><article><h3>Les résultats attendus</h3><p>Un robot du catalogue passe lui aussi par des essais pour le périmètre déployé. Les cas fictifs montrent les résultats attendus et les arrêts utiles. Un arrêt manquant est corrigé avant la recette.</p></article><article><h3>Les cas qui doivent s’arrêter</h3><p class="texte-2">Un paiement groupé ambigu sert alors à <a href="/automatisation/rapprochement-bancaire">recetter le rapprochement bancaire</a> autant qu’un appariement exact.</p></article><article><h3>Votre acceptation du résultat</h3><p class="texte-2">La recette est la vérification du résultat par vos référents dans l’environnement autorisé du cabinet. Elle porte sur les cas fictifs convenus et les critères écrits. Vos référents acceptent ou refusent le résultat ; leur accord vaut pour les versions, les accès et les cas éprouvés.</p></article></GrilleEditoriale>
  </section>

  <section class="pv" id="ecrit" aria-labelledby="ecrit-titre"><div class="tete"><h2 id="ecrit-titre">Le déploiement et sa maintenance sont écrits au devis.</h2></div><GrilleEditoriale><article><h3>Le périmètre à déployer</h3><p>Le devis nomme le robot ou l’agent retenu, les adaptations et les éventuelles constructions sur mesure. Il précise les entrées, le résultat attendu, les accès et les limites. Les personnes qui valident et les critères de recette sont définis avant la mise en service.</p></article><article><h3>La maintenance convenue</h3><p class="texte-2">Le devis précise la maintenance, le support et les évolutions couverts. Si vos outils ou votre règle changent, nous analysons leur effet sur le résultat et rejouons la recette si nécessaire. Une extension du périmètre se convient avec vous.</p></article><article><h3>La responsabilité du cabinet</h3><p class="texte-2">En expertise comptable, votre équipe garde ses contrôles et ses décisions. Pour une tâche de commissariat aux comptes, elle garde aussi le choix des travaux et ses conclusions ; la signature reste au CAC. Chaque mission a son périmètre et ses accès. Le <a href="https://doc.cncc.fr/docs/codedeontologiemars2026/attachments/brochure-code-de-deontologie-mars-2026">code de déontologie, article 10</a>, rappelle que le CAC conserve la responsabilité de sa mission lorsqu’il se fait assister.</p></article></GrilleEditoriale>
    <dl class="lignes rv">
      <div class="ligne">
        <dt class="ligne-libelle">Factures fournisseurs</dt>
        <dd class="ligne-texte">Ce périmètre est la condition pour <a href="/automatisation/factures-fournisseurs">cadrer le flux des factures fournisseurs</a> sans confondre préparation, litige et décision de paiement.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Relances de facture électronique</dt>
        <dd class="ligne-texte">Pour <a href="/automatisation/facture-electronique">valider les relances hors de la plateforme du cabinet</a>, l’équipe confirme le dossier, le destinataire et le texte ; les notes saisies restent intactes et aucun message ne part seul.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Charte IA du cabinet</dt>
        <dd class="ligne-texte">Pour organiser les usages et les rôles avant de choisir une automatisation, vous pouvez <a href="/outils-comptables-gratuits/generateur-charte-ia-cabinet">préparer une trame de charte IA du cabinet</a> : chaque arbitrage non décidé reste à compléter.</dd>
      </div>
    </dl>
  </section>

  <section class="pv" id="refus" aria-labelledby="refus-titre">
    <div class="tete rv">
      <h2 id="refus-titre">Des engagements avec un périmètre précis.</h2>
      <p>Le catalogue décrit une prise en charge ; le devis précise son application chez vous. Vous gardez les contrôles métier, comme <a href="/blog/automatiser-la-saisie-comptable-ce-qui-reste-a-verifier">les six contrôles qui restent après une saisie automatisée</a>. Cette frontière vaut aussi pour le <a href="/outils-comptables-gratuits/verificateur-fec-local">contrôle local de structure d’un FEC</a> : les anomalies sont expliquées et les contrôles non évalués restent visibles ; le rapport ne certifie pas le fichier.</p>
    </div>
    <ListeEditoriale>
        <li class="editorial-point rv"><h3 class="editorial-point-titre">Un traitement documenté</h3><p class="editorial-point-texte">Nous décrivons le fonctionnement et les limites du robot ou de l’agent. La recette accepte le périmètre convenu. Elle ne constitue pas une attestation de conformité en paie, en droit social ou en protection des données, et ne certifie ni les comptes ni le dossier d’audit.</p></li>
        <li class="editorial-point rv"><h3 class="editorial-point-titre">Une compatibilité définie</h3><p class="editorial-point-texte">Nous vérifions les formats, les accès et les versions de vos outils avant de nous engager. Si la connexion demandée bloque, nous vous expliquons le point à résoudre avant de déployer.</p></li>
        <li class="editorial-point rv"><h3 class="editorial-point-titre">Des résultats vérifiables</h3><p class="editorial-point-texte">Le résultat attendu et les critères d’acceptation sont écrits avec vous. Nous vérifions les documents, les données et les exceptions remis. Les gains éventuels se mesurent sur votre tâche.</p></li>
        <li class="editorial-point rv"><h3 class="editorial-point-titre">Des démonstrations fictives identifiées</h3><p class="editorial-point-texte">Chaque démonstration publiée utilise des dossiers inventés et le précise. Elle montre le fonctionnement proposé ; elle ne représente pas un résultat obtenu chez un client.</p></li>
      </ListeEditoriale>
    <dl class="lignes rv">
      <div class="ligne">
        <dt class="ligne-libelle">Checklist des pièces</dt>
        <dd class="ligne-texte">Vous pouvez <a href="/outils-comptables-gratuits/checklist-pieces-comptables">préparer la checklist des pièces manquantes</a> sans interpréter une pièce inconnue comme absente : les éléments à clarifier restent séparés. La liste est choisie par le cabinet, pas déduite d’obligations fiscales ; le message n’est jamais envoyé par l’outil.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Barème d’heures CAC</dt>
        <dd class="ligne-texte">Le <a href="/outils-comptables-gratuits/bareme-heures-cac">barème d’heures du commissaire aux comptes</a> n’est pas un tarif universel. Une exclusion ou un champ inconnu suspend la fourchette ; le budget et la suffisance des diligences restent à justifier par le CAC.</dd>
      </div>
    </dl>
  </section>
</PageEditoriale>
