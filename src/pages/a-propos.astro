---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import Renvois from '@/components/Renvois.astro';
import ProofRow from '@/components/ProofRow.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { auteurPar, identiteAuteur } from '@/data/auteurs';

const page = PAGES_V2.apropos;
const url = `${SITE.url}${page.chemin}`;
/** Identité canonique du site : ce nœud est celui que citent le blog et chaque article. */
const auteur = auteurPar('kevin');
const identite = `${SITE.url}${identiteAuteur(auteur)}`;
const noeuds = [
  {
    '@type': 'AboutPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
    inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': identite },
  },
];
const renvois = [
  { texte: 'Comment se déroule une mission, étape par étape, avec ce que chacune produit.', libelle: 'Comprendre la méthode', href: '/methode' },
  { texte: 'Des méthodes pour écrire et vérifier une tâche avant de l’automatiser, signées et sourcées.', libelle: 'Lire les articles', href: '/blog' },
  { texte: 'Le vocabulaire du cabinet, terme par terme, sourcé et daté, avec la frontière d’automatisation de chacun.', libelle: 'Consulter le glossaire', href: '/glossaire' },
];
const appel = {
  titre: 'Parlons de la tâche, pas d’un logiciel.',
  texte: 'Décrivez le geste qui revient dans votre cabinet. Nous vous disons s’il se cadre, ce qu’il faudrait pour le prendre en charge, et à quel prix. Rien à envoyer.',
  points: ['La même personne écoute, écrit et code la règle.', 'Le devis dépend de la complexité, jamais du nombre de postes.', 'La décision reste à vos équipes.'],
};
---

<PageCommerciale page={page} noeuds={noeuds} eyebrow="Qui nous sommes" hero="v2/17-hero-apropos" appel={appel}>
  <section class="pv" aria-labelledby="pourquoi">
    <ProofRow id="v2/11-regle-mots">
      <div class="pv-copy rv">
        <h2 id="pourquoi">Pourquoi Memlia existe</h2>
        <p>Un cabinet tourne sur des règles que personne n’a écrites. Quelle pièce réclamer, quel écart vérifier avant le bulletin, quel retour DSN mérite un appel : ce savoir vit dans la tête de collaborateurs qui en ont déjà trop, difficiles à recruter, plus difficiles encore à garder.</p>
        <p class="texte-2">Écrire cette frontière permet ensuite de <a href="/automatisation/saisie-comptable">prendre en charge la préparation des écritures</a> tout en laissant leur validation au cabinet.</p>
        <p class="texte-2">Quand l’un d’eux part, la règle part avec lui. Memlia existe pour que ce savoir-faire appartienne au cabinet : écrit, testé, et automatisé partout où il se répète.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv pv-inverse" aria-labelledby="faisons">
    <ProofRow id="v2/10-une-personne">
      <div class="pv-copy rv">
        <h2 id="faisons">Ce que nous faisons</h2>
        <p>Nous prenons une tâche répétitive de votre cabinet et nous la menons de bout en bout : observer le geste, écrire la règle dans vos mots, construire l’automatisation dans vos outils, la faire recetter par vos équipes, la maintenir. Vous n’achetez ni licence ni sièges : vous confiez une tâche, et elle est prise en charge.</p>
        <p class="texte-2">La règle donne la même limite quand vous choisissez de <a href="/automatisation/rapprochement-bancaire">confier le rapprochement bancaire</a> : la mécanique prépare, le cabinet tranche l’écart.</p>
        <p class="texte-2">La même personne écoute la règle et la code. Une règle de cabinet se perd entre celui qui l’entend et celui qui l’implémente ; nous avons supprimé ce relais.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="expert">
    <div class="pv-tete rv">
      <h2 id="expert">Vous restez l’expert. Nous écrivons, et nous faisons tourner.</h2>
      <p class="texte-2 lecture">Deux choses que nous disons avant toute mission, parce qu’elles délimitent exactement ce que vous nous confiez.</p>
    </div>
    <div class="pv-bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ul class="pv-bande-liste rv-groupe" data-colonnes="2">
        <li class="pv-cellule rv"><h3>Votre règle, pas la nôtre.</h3><p>En paie, en social, en fiscal, la règle est la vôtre. Vous pouvez <a href="/automatisation/paie">confier la mécanique répétitive de la paie</a> ; nous l’écrivons telle que vous la donnez et nous la testons. Nous ne la validons pas à votre place : le jugement professionnel reste au cabinet.</p></li>
        <li class="pv-cellule rv"><h3>Un service, pas un logiciel.</h3><p>Vous ne paramétrez rien et vous ne payez pas de sièges. Vous confiez une tâche ; elle revient écrite, automatisée, recettée et maintenue, avec des critères de recette que vos équipes ont lus.</p></li>
      </ul>
    </div>
  </section>

  <section class="pv" id="kevin-kitanga" aria-labelledby="fondateur">
    <div class="pv-tete rv">
      <h2 id="fondateur">Qui est derrière Memlia</h2>
      <p class="lecture"><strong>Kevin Kitanga, fondateur.</strong> Il livre lui-même chaque automatisation : il observe le geste avec vos équipes, écrit la règle, la code et la fait recetter. Il signe les méthodes publiées sur ce site, sourcées et datées.</p>
      <p class="texte-2 lecture">Memlia est une société établie à Paris, immatriculée au RCS de Paris. Les informations légales figurent dans les <a href="/mentions-legales">mentions légales</a>.</p>
    </div>
  </section>

  <section class="pv" aria-labelledby="ecrivons">
    <div class="pv-tete rv">
      <h2 id="ecrivons">Ce que nous publions</h2>
      <p class="texte-2 lecture">Nous écrivons sur ce qui se vérifie, ce qui s’automatise et ce qui reste une décision humaine. Chaque article est signé et sourcé.</p>
    </div>
    <Renvois items={renvois} />
  </section>
</PageCommerciale>
