---
import type { PageEeat } from '@/data/page-eeat';
import SourceEvidence from '@/components/sections/SourceEvidence.astro';

interface Props { eeat: PageEeat }
const { eeat } = Astro.props;
---

{(eeat.sources.length > 0 || eeat.experience) && (
  <section class="page-evidence" aria-labelledby={eeat.sources.length > 0 ? 'page-evidence-title' : undefined} aria-label={eeat.sources.length > 0 ? undefined : 'Expérience de première main'} data-source-section>
    <div class="page-evidence-inner">
      {eeat.sources.length > 0 && (
      <div class="page-evidence-head">
        <p class="page-evidence-kicker">Références publiques</p>
        <h2 id="page-evidence-title">Sources</h2>
        <p>Les liens ci-dessous portent les repères publics cités dans la page. Leur portée est résumée au même endroit.</p>
      </div>
      )}

      {eeat.sources.length > 0 && (
        <ul class="page-evidence-list" aria-label="Sources primaires">
          {eeat.sources.map((source) => <li><SourceEvidence source={source} /></li>)}
        </ul>
      )}

      {eeat.experience && (
        <aside class="page-experience" data-first-hand-experience>
          <p class="page-evidence-kicker">Expérience de première main</p>
          <h3><a href={eeat.experience.href}>{eeat.experience.titre}</a></h3>
          <p>{eeat.experience.lien}</p>
        </aside>
      )}
    </div>
  </section>
)}

<style>
  .page-evidence { padding: 96px var(--marge-page); border-top: 1px solid var(--ligne-douce); border-bottom: 1px solid var(--ligne); background: var(--surface-page); }
  .page-evidence-inner { display: grid; gap: 28px; max-width: 880px; margin: 0 auto; }
  .page-evidence-head { display: grid; gap: 8px; }
  .page-evidence-kicker { margin: 0; color: var(--accent-texte); font-size: var(--t-sm); font-weight: 600; letter-spacing: .02em; }
  .page-evidence h2 { max-width: 22ch; font-size: var(--t-3xl); }
  .page-evidence-head > p:last-child { max-width: 62ch; margin: 0; color: var(--texte-2); }
  .page-evidence-list { display: grid; margin: 0; padding: 0; border-top: 1px solid var(--ligne); list-style: none; }
  .page-evidence-list li { min-width: 0; border-bottom: 1px solid var(--ligne-douce); }
  .page-experience { display: grid; gap: 10px; padding: 24px; background: var(--surface-feuille); }
  .page-experience p { margin: 0; color: var(--texte-2); }
  .page-experience a { color: var(--accent-texte); text-decoration: underline; text-underline-offset: 3px; }
  .page-experience { border-left: 3px solid var(--accent-appui); background: var(--accent-voile); }
  .page-experience h3 { font-size: var(--t-2xl); }
  @media (min-width: 64rem) { .page-evidence { padding: 112px var(--marge-page-lg); } }
</style>
