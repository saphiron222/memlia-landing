<div class="budget-tool" data-budget-tool>
  <form method="dialog" class="budget-entrees" data-budget-form novalidate>
    <label for="budget-heures">Temps économisé par mois (h)<input id="budget-heures" name="heures" type="number" min="0" max="100000" step="0.1" value="10" required /><small>Après les contrôles que vous conservez.</small></label>
    <label for="budget-cout">Coût d’une heure de travail (€)<input id="budget-cout" name="coutHoraire" type="number" min="0" max="10000" step="0.01" value="40" required /></label>
    <label for="budget-mensuel">Votre budget d’automatisation (€ HT/mois)<input id="budget-mensuel" name="budgetMensuel" type="number" min="0" max="1000000" step="0.01" placeholder="Montant de votre choix" required /></label>
    <details data-outil-options><summary>Ajouter un coût de mise en service</summary><label for="budget-setup">Mise en service (€ HT, facultatif)<input id="budget-setup" name="miseEnService" type="number" min="0" max="1000000" step="0.01" /></label></details>
    <button class="btn btn-principal" type="submit" data-budget-calculate>Calculer mon estimation</button>
    <p class="budget-error" data-budget-error role="alert" hidden></p>
    <p class="budget-status" role="status" data-budget-status></p>
  </form>
  <section class="budget-result" data-budget-result hidden aria-labelledby="budget-result-title">
    <h2 id="budget-result-title" tabindex="-1">Votre estimation sur un an</h2>
    <dl><div><dt>Temps dégagé</dt><dd data-result-hours></dd></div><div><dt>Valeur du temps</dt><dd data-result-value></dd></div><div><dt>Solde après votre budget</dt><dd data-result-net></dd></div></dl>
    <p data-result-roi></p><p data-first-year hidden></p>
    <p class="budget-limite">Estimation de capacité disponible, pas une économie de trésorerie garantie.</p>
    <button class="btn btn-contour" type="button" data-budget-copy data-outil-action="copie">Copier mon estimation</button>
    <p role="status" data-copy-status></p>
  </section>
 <details id="roi-formules" data-tool-help><summary>Formule de calcul</summary><p>Valeur annuelle = heures économisées par mois × coût horaire × 12. Solde = valeur annuelle − budget mensuel × 12. ROI = solde ÷ budget annuel × 100.</p><p>La mise en service facultative est déduite du solde de première année.</p></details>
</div>
<script>
 import {calculerRoiSimple} from '@/lib/roi-simple.mjs';
 const root=document.querySelector<HTMLElement>('[data-budget-tool]');
 if(root){
  const get=<T extends HTMLElement>(s:string)=>root.querySelector<T>(s)!;
  const form=get<HTMLFormElement>('[data-budget-form]'),result=get<HTMLElement>('[data-budget-result]'),error=get<HTMLElement>('[data-budget-error]');
  const field=(name:string)=>form.elements.namedItem(name) as HTMLInputElement;
  const eur=(c:number)=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',minimumFractionDigits:0,maximumFractionDigits:2}).format(c/100);
  const number=(n:number)=>new Intl.NumberFormat('fr-FR',{maximumFractionDigits:1}).format(n);
  let copy='';
  form.addEventListener('input',()=>{result.hidden=true;copy='';error.hidden=true;get<HTMLElement>('[data-budget-status]').textContent='';get<HTMLElement>('[data-copy-status]').textContent='';});
  form.addEventListener('submit',event=>{
   event.preventDefault();error.hidden=true;
   for(const name of ['heures','coutHoraire','budgetMensuel','miseEnService']){
    const input=field(name);
    if(!input.validity.valid){input.closest('details')?.setAttribute('open','');input.focus();error.textContent='Vérifiez le montant ou le temps saisi.';error.hidden=false;return;}
   }
   try{
    const r=calculerRoiSimple({heures:Number(field('heures').value),coutHoraire:Number(field('coutHoraire').value),budgetMensuel:Number(field('budgetMensuel').value),miseEnService:field('miseEnService').value.trim()?Number(field('miseEnService').value):null});
    get<HTMLElement>('[data-result-hours]').textContent=`${number(r.heuresAnnuelles)} h`;
    get<HTMLElement>('[data-result-value]').textContent=eur(r.valeurAnnuelle);
    get<HTMLElement>('[data-result-net]').textContent=eur(r.soldeAnnuel);
    get<HTMLElement>('[data-result-roi]').textContent=r.roi===null?'ROI non calculable avec un budget nul.':`ROI estimé : ${number(r.roi)} %`;
    const first=get<HTMLElement>('[data-first-year]');first.hidden=r.premiereAnnee===null;first.textContent=r.premiereAnnee===null?'':`Première année, mise en service déduite : ${eur(r.premiereAnnee)}.`;
    copy=[`Estimation annuelle — hypothèses du cabinet : ${field('heures').value} h économisées/mois, ${field('coutHoraire').value} €/h, budget ${field('budgetMensuel').value} € HT/mois.`,field('miseEnService').value?`Mise en service : ${field('miseEnService').value} € HT.`:'Mise en service non renseignée.',`Temps : ${number(r.heuresAnnuelles)} h/an ; valeur : ${eur(r.valeurAnnuelle)} ; budget : ${eur(r.budgetAnnuel)}/an ; solde : ${eur(r.soldeAnnuel)}.`,get<HTMLElement>('[data-result-roi]').textContent,first.hidden?'':first.textContent,'Estimation de capacité disponible, pas une économie de trésorerie garantie.'].filter(Boolean).join('\n');
    result.hidden=false;get<HTMLElement>('#budget-result-title').focus();
   }catch(e){error.textContent=e instanceof Error?e.message:'Vérifiez vos hypothèses.';error.hidden=false;}
  });
  get<HTMLButtonElement>('[data-budget-copy]').addEventListener('click',async()=>{if(!copy)return;try{await navigator.clipboard.writeText(copy);get<HTMLElement>('[data-copy-status]').textContent='Estimation copiée.';}catch{get<HTMLElement>('[data-copy-status]').textContent='Copie bloquée : sélectionnez le résultat.';}});
 }
</script>
<style>
.budget-tool,.budget-entrees{display:grid;gap:24px;min-width:0}.budget-entrees{max-width:640px;width:100%;margin:auto}.budget-tool label{display:grid;gap:8px;font-weight:600}.budget-tool input{width:100%;padding:12px;border:1px solid var(--ligne-forte);border-radius:var(--r-bouton);font:inherit;background:var(--surface-feuille);color:var(--texte-fort);min-height:48px}.budget-tool small,.budget-status,.budget-limite{font-size:var(--t-sm);font-weight:400;color:var(--texte-2)}.budget-entrees>.btn,.budget-result>.btn{justify-self:start}.budget-result{display:grid;gap:20px;background:var(--accent-voile);border:1px solid var(--ligne);border-radius:var(--r-carte);padding:32px}.budget-result h2{font-size:var(--titre-bloc)}.budget-result dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.budget-result dd{margin:4px 0 0;font-size:var(--t-2xl);font-weight:600;font-variant-numeric:tabular-nums}.budget-result dt{font-size:var(--t-sm);color:var(--texte-2)}.budget-tool summary{cursor:pointer;font-weight:600;min-height:44px}.budget-error{padding:12px;border-left:3px solid var(--rouge);color:var(--rouge)}.budget-tool [hidden],.budget-tool p:empty{display:none!important}@media(max-width:40rem){.budget-result{padding:20px}.budget-result dl{grid-template-columns:1fr}}
</style>
