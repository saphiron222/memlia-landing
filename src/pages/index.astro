---
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import Hero from '@/components/sections/Hero.astro';
import Garanties from '@/components/sections/Garanties.astro';
import Promesse from '@/components/sections/Promesse.astro';
import Modules from '@/components/sections/Modules.astro';
import Preuves from '@/components/sections/Preuves.astro';
import Methode from '@/components/sections/Methode.astro';
import Faq from '@/components/sections/Faq.astro';
import AppelFinal from '@/components/sections/AppelFinal.astro';

/**
 * Accueil — ordre des sections fixé par la spec (S2 → S8) : hero, grille de garanties,
 * promesse, bandes de modules, proposition vs saisie, méthode, questions, appel final.
 * Le title et la description sont les seuls textes SEO hors copy validée.
 */
const titre = "Memlia — L'IA du conseil pour les experts-comptables";
const description =
  'Memlia code vos règles de paie, de supervision et de contrôle dans les classeurs Excel que vos équipes utilisent déjà. L’IA prépare, le cabinet décide. Devis à la complexité.';
---

<Base titre={titre} description={description} chemin="/">
  <JsonLd slot="head" description={description} />

  <div class="feuille">
    <Hero />
    <Garanties />
    <Promesse />
    <Modules />
    <Preuves />
    <Methode />
    <Faq />
    <AppelFinal />
  </div>
</Base>
