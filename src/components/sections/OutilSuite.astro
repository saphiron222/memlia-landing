---
import Picto from '@/components/Picto.astro';
import { OUTILS_HUB_PATH, type OutilDefinition, type OutilServicePage } from '@/data/outils';

interface Props {
  outil: OutilDefinition;
}

const { outil } = Astro.props;
const destinations: Record<OutilServicePage, string> = {
  '/automatisation-cabinet-comptable': 'Comprendre notre méthode d’automatisation',
  '/automatisation/factures-fournisseurs': 'Voir le cadrage des factures fournisseurs',
  '/automatisation/rapprochement-bancaire': 'Voir le cadrage du rapprochement bancaire',
  '/methode': 'Comprendre la méthode',
};
/*
 * Les liens du contrat (OUTILS-CONTRAT-DE-LIENS.md), sur une ligne, dans l'ordre : le hub, la
 * ressource exacte quand elle existe, la page service. L'appel vers /contact suit, seul, dans
 * l'appel final (épure du 14/10/2026 : plus de cartes ni de second appel).
 */
---

<div class="outil-suite" data-tool-section="suite">
  <div class="conteneur">
    <nav data-tool-links aria-label="Pour continuer">
      <ul class="outil-suite-liens">
        <li><a class="lien-action" href={OUTILS_HUB_PATH}>Tous les outils comptables gratuits<Picto nom="fleche" taille={14} /></a></li>
        {outil.articleExact && (
          <li><a class="lien-action" href={outil.articleExact}>Consulter la ressource associée<Picto nom="fleche" taille={14} /></a></li>
        )}
        <li><a class="lien-action" href={outil.pageService}>{destinations[outil.pageService]}<Picto nom="fleche" taille={14} /></a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  .outil-suite {
    padding-top: var(--section-espace);
  }
  .outil-suite-liens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2) var(--espace-8);
    margin: 0;
    padding: var(--espace-4) 0 0;
    border-top: 1px solid var(--ligne);
    list-style: none;
  }
</style>
