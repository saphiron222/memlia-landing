---
import ProofMedia from '@/components/ProofMedia.astro';
import type { OutilDefinition } from '@/data/outils';
import type { ProofId } from '@/data/proofs';

interface Props {
  titre: string;
  source: OutilDefinition['source'];
  proof?: ProofId;
}

const { titre, source, proof } = Astro.props;
/*
 * « Comment c'est calculé », sous l'outil (épure du 14/10/2026, OUTILS-EPURE-PLAN.md) : la source
 * se cite par un lien sur son nom, avec son extrait, une seule fois sur la page, sans date de
 * consultation (charte §7 bis). L'image figée de l'outil, retirée du héros, se lit ici, chargée
 * à la demande ; elle reste l'image de partage.
 */
---

<section class="section outil-source" data-tool-section="source" aria-labelledby="outil-source-titre">
  <div class="conteneur outil-source-inner">
    <div class="outil-source-texte rv">
      <h2 id="outil-source-titre">{titre}</h2>
      <div class="outil-source-citation" data-official-source>
        {source.titre && <h3>{source.titre}</h3>}
        <p><a href={source.url} rel={source.url.startsWith('http') ? 'noopener' : undefined}>{source.nom}</a> : {source.extrait}</p>
        {source.complement && (
          <p class="outil-source-complement">
            {source.complement.extrait}{' '}
            <a href={source.complement.url} rel="noopener">{source.complement.nom}</a>.
          </p>
        )}
      </div>
    </div>
    {proof && (
      <div class="outil-source-visuel rv" data-tool-media>
        <ProofMedia id={proof} cadre />
      </div>
    )}
  </div>
</section>

<style>
  .outil-source-inner {
    display: grid;
    gap: var(--bloc-ecart);
    align-items: start;
  }
  .outil-source-texte {
    display: grid;
    gap: var(--tete-ecart);
    max-width: 62ch;
  }
  .outil-source-texte h2 {
    font-size: var(--titre-section);
  }
  .outil-source-citation {
    display: grid;
    gap: var(--espace-3);
  }
  .outil-source-citation h3 {
    font-size: var(--titre-bloc);
    line-height: 1.2;
  }
  .outil-source-citation p {
    margin: 0;
    color: var(--texte-2);
    text-wrap: pretty;
  }
  .outil-source-citation a {
    color: var(--accent-texte);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .outil-source-complement {
    padding-top: var(--espace-3);
    border-top: 1px solid var(--ligne-douce);
    font-size: var(--t-sm);
  }
  .outil-source-visuel {
    min-width: 0;
  }
  @media (min-width: 64rem) {
    .outil-source-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--espace-16);
    }
  }
</style>
