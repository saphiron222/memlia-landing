---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import Renvois from '@/components/Renvois.astro';
import ProofRow from '@/components/ProofRow.astro';
import Picto, { type NomPicto } from '@/components/Picto.astro';
import RelatedIntegrations from '@/components/RelatedIntegrations.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { serviceNode, SERVICE_ID } from '@/data/schema.mjs';

const page = PAGES_V2.service;
const url = `${SITE.url}${page.chemin}`;
const noeuds = [
  {
    '@type': 'WebPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
    inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': SERVICE_ID },
  },
  serviceNode(),
];
const requis: { picto: NomPicto; titre: string; texte: string }[] = [
  { picto: 'feuilles', titre: 'Les formats réels', texte: 'Pas le format théorique de votre logiciel, celui de vos fichiers.' },
  { picto: 'bouclier', titre: 'Les accès', texte: 'Ce que l’automatisation doit lire, ce qu’elle peut écrire, et où s’arrête son périmètre.' },
  { picto: 'limites', titre: 'Les cas limites', texte: 'Le dossier atypique, le mois particulier, la reprise d’un exercice. Ce sont eux qui font échouer une automatisation naïve.' },
  { picto: 'grille', titre: 'L’environnement', texte: 'La version de vos outils, les postes concernés, qui utilisera quoi.' },
];
const renvois = [
  { texte: 'Choisir une prochaine action à partir des pratiques déclarées, sans classement des équipes.', libelle: 'Situer les pratiques IA du cabinet', href: '/outils-comptables-gratuits/diagnostic-maturite-ia-cabinet' },
  { texte: 'La carte des tâches automatisables d’un cabinet : douze pôles, soixante familles, une frontière par tâche.', libelle: 'Lire la carte', href: '/blog/automatiser-un-cabinet-comptable-la-carte-des-taches' },
  { texte: 'Contrôler les bulletins de paie avant la DSN : une liste de contrôles à rejouer chaque mois.', libelle: 'Lire les contrôles avant la DSN', href: '/blog/controler-les-bulletins-de-paie-avant-la-dsn' },
  { texte: 'Suivre la production sociale dans Excel sans surveiller les personnes.', libelle: 'Lire le suivi de production sociale', href: '/blog/suivre-la-production-sociale-dans-excel' },
  { texte: 'Après une saisie automatisée, six contrôles restent à faire : lesquels, et pourquoi.', libelle: 'Lire les contrôles après la saisie', href: '/blog/automatiser-la-saisie-comptable-ce-qui-reste-a-verifier' },
  { texte: 'Lire un compte rendu métier DSN et ses anomalies, retour par retour.', libelle: 'Lire la méthode des retours DSN', href: '/blog/comprendre-les-comptes-rendus-metier-dsn' },
  { texte: 'Nos engagements, écrits avant de commencer.', libelle: 'Nos garanties', href: '/garanties' },
];
const appel = {
  titre: 'Décrivez le geste qui revient.',
  texte: 'Nous regardons ensemble s’il se cadre, ce qu’il faudrait pour le prendre en charge, et à quel prix. Rien à envoyer, aucun engagement.',
  points: ['Le geste : ce que quelqu’un refait chaque mois.', 'Les outils : d’où viennent les fichiers, où va le résultat.', 'Le résultat attendu : ce qui devrait exister à la fin.'],
};
---

<PageCommerciale page={page} noeuds={noeuds} eyebrow="Le service" hero="v2/14-hero-service" appel={appel}>
  <section class="pv" aria-labelledby="situation">
    <ProofRow id="01-flux">
      <div class="pv-copy rv">
        <h2 id="situation">Le geste que quelqu’un refait chaque mois</h2>
        <p>Recopier des montants d’un export vers un classeur. Réclamer les mêmes pièces aux mêmes clients. Comparer deux états qui devraient concorder. Le geste est maîtrisé, il revient chaque mois, et il prend le temps de la personne la plus qualifiée pour autre chose.</p>
        <p class="texte-2">Ce n’est ni un problème de compétence ni un outil qui manque. C’est un savoir-faire qui vit dans la tête d’un collaborateur et dans les habitudes du cabinet, que personne n’a écrit, et qui part le jour où il part.</p>
        <p class="texte-2">Pour une première règle concrète, vous pouvez <a href="/automatisation/saisie-comptable">confier la préparation de la saisie comptable</a> sans céder la validation des écritures.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="prepare">
    <div class="pv-tete rv">
      <h2 id="prepare">La règle écrite, de la frontière au jeu d’essai</h2>
      <p class="texte-2 lecture">Nous transformons le savoir-faire du cabinet en une règle relisible, puis en automatisation dans vos outils. Quatre parties ne changent jamais.</p>
    </div>
    <div class="pv-bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ul class="pv-bande-liste rv-groupe">
        <li class="pv-cellule rv"><h3>La frontière</h3><p>Trois colonnes fixent ce qui se prépare seul, ce qui attend une validation et ce qui reste humain.</p></li>
        <li class="pv-cellule rv"><h3>La proposition</h3><p>L’automatisation prépare le résultat et le présente. Ce que le cabinet saisit ne se touche jamais.</p></li>
        <li class="pv-cellule rv"><h3>L’arrêt</h3><p>Une donnée manque, le cas sort de la règle ou deux lectures restent possibles : le traitement s’arrête et nomme le doute.</p></li>
        <li class="pv-cellule rv"><h3>Le jeu d’essai</h3><p>Les cas qui doivent aboutir et ceux qui doivent échouer sont rejoués sur des données fictives avant la recette.</p></li>
      </ul>
    </div>
  </section>

  <section class="pv pv-inverse" aria-labelledby="cabinet">
    <ProofRow id="v2/02-proposition">
      <div class="pv-copy rv">
        <h2 id="cabinet">Que garde le cabinet quand une tâche est automatisée ?</h2>
        <p><strong>La décision. Toujours.</strong></p>
        <p>Une proposition qui vous semble juste se valide. Une proposition qui vous surprend s’examine. Et lorsque la règle ne tranche pas — une donnée manque, une exception n’était pas prévue, deux lectures sont possibles — l’automatisation s’arrête et vous le dit, plutôt que d’écrire quelque chose de faux.</p>
        <p>Cette frontière reste visible lorsque vous choisissez de <a href="/automatisation/rapprochement-bancaire">confier la préparation du rapprochement bancaire</a> : les appariements se proposent, les écarts restent à décider.</p>
        <p class="texte-2">C’est le point sur lequel nous ne transigeons pas. Une automatisation qui décide seule dans le doute est plus coûteuse que le geste manuel qu’elle remplace.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="requis">
    <ProofRow id="v2/01-qualification">
      <div class="pv-copy rv">
        <h2 id="requis">Comment savoir si une tâche est prête à être automatisée ?</h2>
        <p>Quatre points, sur vos fichiers réels, pas sur la théorie du logiciel.</p>
        <p class="texte-2">Cette qualification est un travail, pas une formalité. Elle décide si la tâche est automatisable, et à quel coût.</p>
      </div>
    </ProofRow>
    <ul class="pv-cartes rv-groupe" data-vedette>
      {requis.map((r) => (
        <li class="pv-carte rv">
          <div class="pv-carte-marque" aria-hidden="true"><Picto nom={r.picto} taille={24} /></div>
          <div class="pv-carte-corps"><h3>{r.titre}</h3><p>{r.texte}</p></div>
        </li>
      ))}
    </ul>
    <p class="texte-2 lecture">Un justificatif manquant montre immédiatement pourquoi ce cadrage compte lorsque vous choisissez de <a href="/automatisation/notes-de-frais">confier le traitement répétitif des notes de frais</a>.</p>
  </section>

  <section class="pv pv-inverse" aria-labelledby="livre">
    <ProofRow id="07-livrer">
      <div class="pv-copy rv">
        <h2 id="livre">Que livre Memlia pour une tâche automatisée ?</h2>
        <p>Un périmètre écrit, des critères de recette, et une automatisation qui les satisfait sur vos fichiers.</p>
        <p>Après les essais fictifs, la recette se joue dans l’environnement autorisé du cabinet, sur les cas et fichiers convenus : ceux qui doivent aboutir, et ceux qui doivent échouer. Un refus attendu qui ne se produit pas est un défaut au même titre qu’un résultat faux.</p>
        <p class="texte-2">La maintenance se traite au contrat, pas en supplément implicite : vos règles évoluent, vos formats aussi.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="perimetre">
    <div class="pv-tete rv">
      <h2 id="perimetre">Ce que nous savons écrire</h2>
      <p class="texte-2 lecture">Production comptable, paie et social, portefeuille et échéances, facturation et recouvrement, juridique et fiscal, administratif, ressources humaines, données et outils : soixante familles de tâches, douze pôles, une frontière par tâche. L’audit légal est listé dans la carte, mais n’est pas ouvert à la prise en charge. Une règle écrite se construit en automatisation après vérification des accès, des formats et des cas couverts. <a href="/blog/automatiser-un-cabinet-comptable-la-carte-des-taches">Lire la carte des tâches</a>.</p>
      <p class="texte-2 lecture">Dans le pôle social, vous pouvez <a href="/automatisation/paie">confier un geste répétitif autour de la paie</a> tout en laissant chaque correction et chaque décision aux gestionnaires.</p>
      <p class="texte-2 lecture">Avant de cadrer une tâche, comparez vos volumes, le contrôle restant et les dépenses réellement évitables avec le <a href="/outils-comptables-gratuits/calculateur-roi-automatisation">calculateur de ROI d’automatisation comptable</a>. La capacité libérée reste distincte des économies de trésorerie.</p>
      <p class="texte-2 lecture">Pour vérifier une formule précise avant de la transposer à une règle de cabinet, le <a href="/outils-comptables-gratuits/calculateur-marge-commerciale">calculateur de marge commerciale</a> rejoue sur deux montants HT fictifs la marge, le taux de marge et le taux de marque, sans produire de conseil de prix.</p>
      <p class="texte-2 lecture">Pour rendre un plan annuel contrôlable avant toute reprise dans un dossier, le <a href="/outils-comptables-gratuits/calculateur-amortissement-comptable">calculateur d’amortissement comptable</a> affiche la base, le prorata, la dotation et la valeur nette de chaque exercice.</p>
      <p class="texte-2 lecture">Pour localiser un problème de structure avant de retourner au logiciel, le <a href="/outils-comptables-gratuits/verificateur-fec-local">vérificateur FEC local</a> prépare un rapport par ligne, colonne et règle, sans corriger ni certifier le fichier.</p>
      <p class="texte-2 lecture">Pour commencer à écrire une consigne de préparation, le <a href="/outils-comptables-gratuits/generateur-prompt-expert-comptable">générateur de prompt pour expert-comptable</a> distingue les entrées autorisées, le format, la validation et l’arrêt. Il aide à décrire le geste ; il ne réalise pas la tâche à la place du cabinet.</p>
    </div>
  </section>

  <section class="pv" aria-labelledby="prix">
    <ProofRow id="v2/03-devis">
      <div class="pv-copy rv">
        <h2 id="prix">Vous payez une tâche prise en charge, pas des sièges.</h2>
        <p>Le devis dépend de la complexité de la tâche : règles à appliquer, formats à traiter, exceptions et contraintes de votre environnement. Il précise le périmètre, les critères de recette et les conditions de maintenance. <strong>Il n’est jamais multiplié par le nombre de postes.</strong></p>
      </div>
    </ProofRow>
  </section>

  <section class="pv pv-inverse" aria-labelledby="outils">
    <ProofRow id="08-integration">
      <div class="pv-copy rv">
        <h2 id="outils">Faut-il changer d’outil pour automatiser une tâche ?</h2>
        <p>Un classeur, un export ou un logiciel métier peut être le point de départ. Nous vérifions les formats et les accès avant de nous engager, et nous vous disons ce qui se branche. <strong>Nous ne promettons rien que nous n’ayons vérifié.</strong></p>
        <p class="texte-2">La même vérification précède le choix de <a href="/automatisation/factures-fournisseurs">confier le flux des factures fournisseurs</a> : réception, proposition et exceptions doivent rester lisibles dans le circuit existant.</p>
      </div>
    </ProofRow>
  </section>

  <RelatedIntegrations servicePath="/automatisation-cabinet-comptable" />

  <section class="pv" aria-labelledby="avant">
    <div class="pv-tete rv">
      <h2 id="avant">Pour aller plus loin</h2>
      <p class="texte-2">La carte des tâches, deux méthodes publiées, et nos engagements.</p>
    </div>
    <Renvois items={renvois} colonnes={2} />
  </section>
</PageCommerciale>
