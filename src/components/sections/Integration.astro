---
import ProofRow from '@/components/ProofRow.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['integration']; }
const { contenu = contenuDe('ec').integration } = Astro.props;
---
<section id="integration" class="integration" aria-labelledby="integration-title">
  <ProofRow id={contenu.image} enlarge>
  <div class="integration-copy rv">
    <h2 id="integration-title">{contenu.titre}</h2>
    <p class="texte-2">{contenu.texte}</p>
    <p class="texte-2">{contenu.limites}</p>
  </div>
  </ProofRow>
    <ul class="integration-rules">
      {contenu.regles.map((r, i) => <Fragment>{i > 0 && ' '}<li><strong>{r.titre}</strong> {r.texte}</li></Fragment>)}
    </ul>

</section>
<style>
  .integration { padding: 0 var(--marge-page) 64px; display: grid; grid-template-columns: 1fr; gap: 40px; }
  .integration-copy { display: grid; gap: 24px; }
  .integration-rules { display: grid; gap: 20px; color: var(--texte-2); }
  strong { font-weight: 600; color: var(--texte-fort); }
  .integration-image { align-self: center; }
  .integration-image :global(img) { border-radius: var(--r-carte); }
  @media (min-width: 64rem) {
    .integration { padding: 0 var(--marge-page-lg) 96px; gap: 32px; }
    .integration-copy { max-width: 75ch; }
  }
</style>
