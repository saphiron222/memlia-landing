---
interface Props {
  mentionLocale: string;
  limites: readonly string[];
  suspension?: { motif: string; date: string };
}

const { mentionLocale, limites, suspension } = Astro.props;
---

<section class="outil-zone-section" data-tool-section="calcul" aria-labelledby="outil-zone-titre">
  <div class="conteneur outil-zone-inner">
    <h2 id="outil-zone-titre" class="sr-only">Utiliser l’outil</h2>
    <div class="outil-zone">
      <div class="outil-calcul coins">
        <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
        {suspension ? (
          <div class="outil-suspension" role="status" aria-labelledby="outil-suspension-titre">
            <p class="outil-suspension-label">Règle à revérifier</p>
            <h2 id="outil-suspension-titre">Calcul suspendu</h2>
            <p>Nous avons arrêté ce calcul plutôt que de répondre avec une règle que sa source officielle ne confirme plus.</p>
            <dl>
              <div><dt>Motif</dt><dd>{suspension.motif}</dd></div>
              <div><dt>Depuis le</dt><dd>{suspension.date}</dd></div>
            </dl>
          </div>
        ) : <slot />}
      </div>
      <aside class="outil-local rv" data-local-notice aria-labelledby="local-titre">
        <h2 id="local-titre">Ce qui reste dans votre navigateur</h2>
        <p>{mentionLocale}</p>
        <p>Seul un clic volontaire vers « Confier une première tâche » change de page. Le chemin de cette page n’est conservé que si vous envoyez ensuite le formulaire avec votre consentement.</p>
      </aside>
    </div>

    <div class="outil-limites rv" aria-labelledby="limites-titre">
      <h2 id="limites-titre">Ce que cette page ne fait pas</h2>
      <ul>
        {limites.map((limite) => <li>{limite}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .outil-zone-section {
    border-bottom: 1px solid var(--ligne-douce);
    background: var(--surface-feuille);
  }
  .outil-zone-inner {
    display: grid;
    gap: 64px;
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .outil-zone {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  .outil-calcul {
    min-width: 0;
    padding: clamp(20px, 4vw, 40px);
    border: 1px solid var(--ligne);
    border-radius: var(--r-cadre);
    background: var(--surface-feuille);
    box-shadow: var(--ombre-xs);
  }
  .outil-suspension {
    display: grid;
    gap: 16px;
    max-width: 62ch;
  }
  .outil-suspension-label {
    color: var(--accent-texte);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .outil-suspension h2 {
    font-size: var(--t-4xl);
  }
  .outil-suspension > p:not(.outil-suspension-label),
  .outil-suspension dd {
    color: var(--texte-2);
  }
  .outil-suspension dl {
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }
  .outil-suspension dl div {
    display: grid;
    gap: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--ligne-douce);
  }
  .outil-suspension dt {
    font-weight: 700;
  }
  .outil-local {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 24px;
    border-left: 3px solid var(--accent-appui);
    background: var(--accent-voile);
  }
  .outil-local h2 {
    font-size: var(--t-2xl);
  }
  .outil-local p {
    max-width: 58ch;
    color: var(--texte);
  }
  .outil-limites {
    display: grid;
    gap: 20px;
    max-width: 880px;
  }
  .outil-limites h2 {
    font-size: var(--t-4xl);
  }
  .outil-limites ul {
    display: grid;
    gap: 12px;
  }
  .outil-limites li {
    position: relative;
    padding-left: 22px;
    color: var(--texte-2);
    text-wrap: pretty;
  }
  .outil-limites li::before {
    content: '';
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-appui);
  }
  @media (min-width: 64rem) {
    .outil-zone-inner {
      gap: 80px;
      padding-top: 112px;
      padding-bottom: 112px;
    }
    .outil-zone {
      grid-template-columns: minmax(0, 7fr) minmax(280px, 5fr);
      gap: 48px;
    }
    .outil-local {
      position: sticky;
      top: calc(var(--nav-h) + 32px);
    }
  }
</style>
