---
import Carte from '@/components/catalogue/Carte.astro';
interface Props {cac?:boolean;titre?:string;}
const {cac=false,titre="Un robot, un agent IA ou une construction sur mesure."}=Astro.props;
const cartes=[
 {nom:'Un robot pour une routine',fonction:'Une collecte, un suivi, un résultat.',resume:cac?'Réunir des informations légales, collecter des attestations ou préparer des documents : choisissez une routine utile à votre cabinet.':'Collecter les avis fiscaux, suivre les messageries ou classer les attestations. Nous adaptons le robot à vos dossiers et à votre rythme.',categorie:'Choisir une routine',href:'/automatisation-cabinet-comptable',action:'Explorer les robots',nature:'Robots Memlia',image:{src:'/robots/cfe',alt:'',couleur:'#e4a277'}},
 {nom:'Un agent IA pour votre métier',fonction:cac?'Préparer le travail du mandat.':'Organiser la préparation des dossiers.',resume:cac?'Pièces, sélections et rapprochements préparés selon vos paramètres. Votre équipe garde le choix des travaux et ses conclusions.':'Comptabilité, social, juridique ou gestion du cabinet : nous déployons l’agent avec vos sources, vos règles et vos validations.',categorie:'Accompagner un métier',href:'/agents-ia',action:'Explorer les agents IA',nature:'Agents IA Memlia',image:{src:`/illustrations/figurines/${cac?'aude':'balthazar'}`,alt:'',couleur:cac?'#c9b38f':'#a6ad8e'}},
 {nom:'Votre tâche sur mesure',fonction:'Construire ce qui vous manque.',resume:'Votre besoin dépasse le catalogue ? Nous concevons une nouvelle prise en charge ou prolongeons un robot ou un agent avec les fonctions nécessaires.',categorie:'Répondre à un besoin propre',href:'/contact',action:'Décrire votre besoin',nature:'Construit sur votre cabinet',image:{src:'/robots/habilitations-fiscales',alt:'',couleur:'#a8bdcf'}},
];
---
<section class="catalogue-section editorial-choix" aria-labelledby="choix-tache-titre"><div class="tete"><h2 id="choix-tache-titre">{titre}</h2><p>Nous partons du catalogue, adaptons la prise en charge à votre cabinet et assurons le déploiement et la maintenance. Le sur mesure complète l’offre quand votre besoin l’exige.</p></div><ul class="catalogue-grille">{cartes.map(c=><li><Carte {...c}/></li>)}</ul></section>
