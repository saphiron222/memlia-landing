---
import { integrationPath, type IntegrationDefinition } from '@/data/integrations';

/** Guides par environnement : chaque guide est une carte du site (global.css), lien en entier. */
interface Props {
  integrations: readonly IntegrationDefinition[];
  compact?: boolean;
}
const { integrations, compact = false } = Astro.props;
---

<ul class="cartes" data-integration-cards>
  {integrations.map((integration) => (
    <li>
      <a class="carte" href={integrationPath(integration)}>
        <div class="carte-corps">
          <span class="carte-meta">{integration.vendor} · {integration.product}</span>
          <h3 class="carte-titre">{integration.primaryQuery.charAt(0).toUpperCase() + integration.primaryQuery.slice(1)}</h3>
          {!compact && <p class="carte-texte">{integration.description}</p>}
          <span class="carte-action">Lire le guide<span aria-hidden="true"> →</span></span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  /* La carte remplit sa cellule de grille : les actions s'alignent d'une carte à l'autre. */
  li { display: flex; }
  li > .carte { flex: 1 1 auto; }
</style>
