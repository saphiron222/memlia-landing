---
import Lockup from './Lockup.astro';
import Button from './Button.astro';
import { CTA } from '@/data/site.mjs';
import { NAV_V2 } from '@/data/pages-v2.mjs';

/**
 * Navigation du site v2 : six entrées hors logo — les cinq pages, plus l'appel à l'action.
 *
 * Aucune entrée primaire n'est cachée derrière un menu. Sur mobile elles descendent dans
 * le flux, en deux colonnes puis une seule quand le texte ne tient plus, et l'appel à
 * l'action prend toute la largeur. Il n'y a donc ni panneau à ouvrir, ni verrou de
 * défilement, ni dépendance au JavaScript : la navigation est du HTML servi.
 *
 * La barre n'est collante qu'en grand écran ; en mobile sa hauteur masquerait le contenu.
 */
interface Props {
  blogActif: boolean;
  /** Chemin canonique de la page courante (fourni par Base, indépendant de la forme d'URL du build). */
  chemin: string;
  /** Prefixe des ancres : vide sur l'accueil, « / » depuis une autre page. */
  base?: string;
}
const { blogActif, chemin } = Astro.props;

/** Le Hub reste la section courante depuis les contenus qu'il réunit. */
const surRessources: 'page' | 'true' | undefined = chemin === '/ressources'
  ? 'page'
  : ['/glossaire', '/guides', '/modeles'].some((route) => chemin === route || chemin.startsWith(`${route}/`))
    ? 'true'
    : undefined;

/**
 * Deux marquages distincts : « page » quand on est exactement sur l'entrée, « true »
 * quand on est dans sa section. Sans le second, un article de blog ne marquait plus
 * aucune entrée et le lecteur perdait sa position dans la navigation.
 */
const entrees = NAV_V2
  .filter((entree) => blogActif || entree.href !== '/blog')
  .map((entree) => ({
    ...entree,
    courant: entree.href === '/ressources'
      ? surRessources
      : chemin === entree.href
        ? ('page' as const)
        : chemin.startsWith(`${entree.href}/`)
          ? ('true' as const)
          : undefined,
  }));
const actionCourante = chemin === CTA.nav.href ? 'page' : undefined;
---

<header class="nav-barre">
  <div class="conteneur nav">
    <div class="nav-marque">
      <Lockup href="/" />
    </div>

    <nav class="nav-centre" aria-label="Navigation principale">
      <ul class="nav-liste">
        {entrees.map((e) => (
          <li class="nav-item">
            <a class="nav-entree" href={e.href} aria-current={e.courant}>{e.libelle}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-droite">
      <Button href={CTA.nav.href} variante="principal" picto="fleche" class="nav-principal" aria-current={actionCourante}>
        {CTA.nav.libelle}
      </Button>
    </div>
  </div>
</header>

<style>
  .nav-barre {
    z-index: 50;
    background: rgba(255, 254, 251, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--ligne-douce);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .nav {
    display: grid;
    /* Cinq cibles de 48 px occupent déjà la hauteur : le rythme vertical du bandeau
       reste serré pour ne pas repousser la première vue utile sous la ligne de flottaison. */
    gap: 4px;
    padding-block: 6px;
  }
  .nav-marque {
    display: flex;
    align-items: center;
    min-height: 48px;
  }
  .nav-liste {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 8px;
  }
  .nav-item {
    display: flex;
  }
  .nav-entree {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 48px;
    padding: 6px 8px;
    border-radius: var(--r-bouton);
    /* 1rem en mobile : une entrée primaire ne rétrécit pas parce qu'elle descend
       dans le flux. Le pas typographique du bandeau ne revient qu'en grand écran. */
    font-size: 1rem;
    font-weight: 500;
    color: var(--texte);
    transition: color var(--duree-1) ease-out, background-color var(--duree-1) ease-out;
  }
  .nav-entree[aria-current] {
    color: var(--texte-fort);
    background: var(--surface-hover);
  }
  .nav-entree:focus-visible {
    color: var(--texte-fort);
    background: var(--surface-hover);
  }
  .nav-droite {
    display: flex;
  }
  .nav-principal {
    width: 100%;
    min-height: 48px;
    justify-content: center;
    white-space: normal;
    font-size: 1rem;
  }
  /*
   * Le libellé le plus large, « Automatisation », demande 125 px avec sa gouttière,
   * mesuré dans Hanken Grotesk à 16 px : deux colonnes tiennent dès 320 px. En dessous
   * elles couperaient le texte, donc une seule — jamais une cible plus petite.
   */
  @media (max-width: 19rem) {
    .nav-liste {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (hover: hover) {
    .nav-entree:hover {
      color: var(--texte-fort);
      background: var(--surface-hover);
    }
  }
  @media (min-width: 64rem) {
    .nav-barre {
      position: sticky;
      top: 0;
    }
    .nav {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 16px;
      height: var(--nav-h);
      padding-block: 0;
    }
    .nav-centre {
      justify-self: center;
    }
    .nav-liste {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .nav-entree {
      width: auto;
      min-height: 0;
      padding: 6px 8px;
      font-size: var(--t-sm);
    }
    .nav-principal {
      width: auto;
      min-height: 0;
      white-space: nowrap;
      font-size: var(--t-sm);
    }
  }
</style>
