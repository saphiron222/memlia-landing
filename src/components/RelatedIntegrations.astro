---
import { integrationPath, integrationsForService } from '@/data/integrations';

interface Props {
  servicePath: string;
}

const { servicePath } = Astro.props;
const integrations = integrationsForService(servicePath);
---

{integrations.length > 0 && (
  <aside class="rayons" aria-labelledby={`rayons-${servicePath.replaceAll('/', '-')}`}>
    <div class="rayons-tete">
      <p class="surtitre">Guides par environnement</p>
      <h2 id={`rayons-${servicePath.replaceAll('/', '-')}`}>La même frontière, dans l’outil du cabinet</h2>
      <p>Ces pages documentent des repères propres à chaque environnement. Elles ne constituent ni un catalogue de compatibilités, ni une promesse sans recette.</p>
    </div>
    <ul class="rayons-liste">
      {integrations.map((integration) => (
        <li>
          <a href={integrationPath(integration)}>
            <span>{integration.vendor} · {integration.product}</span>
            <strong>{integration.primaryQuery}</strong>
            <small>{integration.suggestions} suggestions mesurées · vague 1</small>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .rayons {
    display: grid;
    gap: 28px;
    margin-top: 48px;
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--ligne-douce);
    background: var(--surface-feuille);
  }
  .rayons-tete {
    display: grid;
    gap: 10px;
    max-width: 70ch;
  }
  .rayons-tete h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }
  .rayons-tete p:last-child {
    color: var(--texte-2);
  }
  .surtitre {
    color: var(--accent-texte);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .rayons-liste {
    display: grid;
    gap: 12px;
  }
  .rayons-liste a {
    display: grid;
    gap: 5px;
    min-height: 48px;
    padding: 18px;
    border: 1px solid var(--ligne-douce);
    color: var(--texte-fort);
    background: var(--surface-page);
  }
  .rayons-liste span,
  .rayons-liste small {
    color: var(--texte-2);
  }
  .rayons-liste strong {
    font-size: 1.05rem;
  }
  @media (min-width: 48rem) {
    .rayons-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (hover: hover) {
    .rayons-liste a:hover {
      border-color: var(--accent-appui);
      background: var(--accent-voile);
    }
  }
</style>
