---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import IntegrationCards from '@/components/sections/IntegrationCards.astro';
import { auteurPar, identiteAuteur } from '@/data/auteurs';
import { INTEGRATIONS_INDEXABLES, integrationPath } from '@/data/integrations';
import { SITE } from '@/data/site.mjs';

const chemin = '/integrations';
const url = `${SITE.url}${chemin}`;
const auteur = auteurPar('kevin');
const products = [...new Set(INTEGRATIONS_INDEXABLES.map((integration) => integration.product))];
const page = {
  chemin,
  titre: 'Guides par environnement comptable | Memlia',
  description: 'Trouvez les repères de contrôle dans Sage 100 Comptabilité, Sage 100 Paie & RH, Cegid Loop ou mySilae : champs à lire, préparation et décisions du cabinet.',
  h1: 'Guides par environnement comptable',
  chapeau: `Choisissez le logiciel de votre équipe, puis la tâche qui vous occupe. Les ${INTEGRATIONS_INDEXABLES.length} guides indiquent les champs à lire, les contrôles à préparer et les décisions qui restent au cabinet.`,
  ariane: 'Guides par environnement',
  secondaire: { libelle: 'Comprendre le service Memlia', href: '/automatisation-cabinet-comptable' },
};
const noeuds = [
  {
    '@type': 'CollectionPage', '@id': `${url}#webpage`, url, name: page.h1, headline: page.h1,
    description: page.description, datePublished: '2026-09-20', dateModified: '2026-10-08', inLanguage: SITE.langue,
    author: { '@id': `${SITE.url}${identiteAuteur(auteur)}` }, isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': `${url}#items` },
  },
  {
    '@type': 'ItemList', '@id': `${url}#items`, numberOfItems: INTEGRATIONS_INDEXABLES.length,
    itemListElement: INTEGRATIONS_INDEXABLES.map((integration, index) => ({
      '@type': 'ListItem', position: index + 1, name: integration.h1, url: `${SITE.url}${integrationPath(integration)}`,
    })),
  },
];
---

<PageCommerciale
  page={page}
  noeuds={noeuds}
  eyebrow="Guides documentés"
  hero="integrations/hub"
  appel={{
    titre: 'Confiez la tâche qui revient dans votre équipe.',
    texte: 'Nous écrivons sa règle dans vos mots, puis nous automatisons sa part répétitive dans vos outils. Nous prenons en charge la construction, les essais avec votre équipe et la maintenance. Vous gardez la décision.',
    points: ['Une règle qui appartient au cabinet.', 'Une proposition avant validation.', 'Un arrêt quand le cas sort de la règle.'],
    action: { libelle: 'Confier une première tâche', href: '/contact' },
  }}
>
  <section class="pv" aria-labelledby="publication">
    <div class="tete rv">
      <h2 id="publication">Trouvez les repères utiles à votre tâche</h2>
      <p class="texte-2 lecture">Quand la tâche traverse plusieurs supports, il faut <a href="/blog/automatiser-avec-ia-sans-changer-logiciel">écrire le passage entre les outils</a> : ce qui entre, ce qui sort et le cas qui arrête la préparation.</p>
      <p>Chaque guide part de la documentation de l’éditeur et montre une règle de préparation sur un jeu d’essai fictif. Le chemin disponible, les champs à vérifier et les limites du repère sont précisés dans le guide.</p>
    </div>
    <ol class="lignes rv">
      <li class="ligne"><h3 class="ligne-libelle">Le logiciel de votre équipe</h3><p class="ligne-texte">Choisissez le produit exact : Sage 100 Comptabilité et Sage 100 Paie &amp; RH ont des parcours distincts.</p></li>
      <li class="ligne"><h3 class="ligne-libelle">Les champs à vérifier</h3><p class="ligne-texte">Ouvrez le guide de votre tâche pour retrouver les données nécessaires au contrôle et leur rôle dans la préparation.</p></li>
      <li class="ligne"><h3 class="ligne-libelle">La décision à garder</h3><p class="ligne-texte">La règle écrite distingue ce qui se prépare, ce qui attend votre validation et le cas qui arrête la préparation.</p></li>
      <li class="ligne"><h3 class="ligne-libelle">Les limites du repère</h3><p class="ligne-texte">Lisez le périmètre de la documentation citée. Avant de construire une automatisation, nous vérifions votre version, vos formats et vos accès.</p></li>
    </ol>
  </section>

  {products.map((product, index) => {
    const integrations = INTEGRATIONS_INDEXABLES.filter((integration) => integration.product === product);
    return (
      <section class="pv" aria-labelledby={`product-${index}`}>
        <div class="tete rv">
          <p class="surtitre">{integrations[0].vendor}</p>
          <h2 id={`product-${index}`}>{product}</h2>
          <p>{integrations.length} {integrations.length > 1 ? 'guides pour préparer vos contrôles' : 'guide pour préparer vos contrôles'} dans {product}. Choisissez votre tâche ci-dessous.</p>
        </div>
        <IntegrationCards integrations={integrations} titresParTache />
      </section>
    );
  })}

  <section class="pv" aria-labelledby="passage-tache">
    <div class="tete rv">
      <h2 id="passage-tache">Du guide à la tâche confiée</h2>
      <p>Le guide vous aide à choisir ce que vous voulez confier. Nous partons ensuite de votre manière de travailler, de ce que votre logiciel fait déjà et des exceptions que votre équipe rencontre. La règle est éprouvée sur un dossier fictif, puis votre équipe teste et accepte le résultat avant la mise en service.</p>
    </div>
  </section>
</PageCommerciale>
