---
import Base from '@/layouts/Base.astro';
import OutilHero from '@/components/sections/OutilHero.astro';
import AppelFinal from '@/components/sections/AppelFinal.astro';
import Picto from '@/components/Picto.astro';
import { SITE } from '@/data/site.mjs';
import { OUTIL_CATEGORIES, OUTILS_DISPONIBLES, OUTILS_HUB_PATH, outilPath } from '@/data/outils';

const h1 = 'Outils comptables gratuits : calculer, vérifier et préparer';
const title = `${h1} | Memlia`;
const description = 'Des outils gratuits pour calculer, contrôler ou préparer une tâche comptable. Choisissez selon les entrées, le résultat et les limites, sans inscription.';
const url = `${SITE.url}${OUTILS_HUB_PATH}`;
const titreHub = (outil: (typeof OUTILS_DISPONIBLES)[number]) => outil.slug === 'suivi-circularisation'
  ? 'Suivi de circularisation : préparer les lettres et les retours'
  : outil.h1;
const actions: Record<string, string> = {
  'checklist-pieces-comptables': 'Préparer la demande des pièces manquantes',
  'bareme-heures-cac': 'Calculer la référence d’heures',
  'seuil-signification-audit': 'Comparer vos scénarios de seuils',
  'suivi-circularisation': 'Préparer les lettres et le suivi',
  'generateur-prompt-ia-gratuit': 'Préparer une consigne texte',
  'bibliotheque-prompts-comptables': 'Choisir un modèle de prompt',
  'verificateur-prompt-ia': 'Examiner votre prompt',
  'preparer-pseudonymiser-fichier-csv-fec': 'Préparer une copie pseudonymisée',
  'diagnostic-maturite-ia-cabinet': 'Situer les pratiques du cabinet',
  'generateur-prompt-expert-comptable': 'Écrire un prompt pour votre tâche',
  'calculateur-roi-automatisation': 'Comparer vos hypothèses de ROI',
  'generateur-charte-ia-cabinet': 'Préparer une trame de charte',
  'verificateur-fec-local': 'Contrôler la structure du FEC',
  'calculateur-marge-commerciale': 'Calculer la marge et les taux',
  'calculateur-date-echeance-facture': 'Calculer la date d’échéance',
  'calculateur-amortissement-comptable': 'Calculer le plan annuel',
  'modele-rapprochement-bancaire-excel-gratuit': 'Accéder au classeur à télécharger',
};
const categoriesPubliees = OUTIL_CATEGORIES.map((category) => ({
  ...category,
  tools: OUTILS_DISPONIBLES.filter((outil) => outil.categorie === category.id),
})).filter((category) => category.tools.length > 0);
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage', '@id': `${url}#page`, url, name: h1, headline: h1, description,
      inLanguage: SITE.langue, mainEntity: { '@id': `${url}#list` },
    },
    {
      '@type': 'ItemList', '@id': `${url}#list`, name: 'Outils comptables gratuits',
      numberOfItems: OUTILS_DISPONIBLES.length,
      itemListElement: OUTILS_DISPONIBLES.map((outil, index) => ({
        '@type': 'ListItem', position: index + 1, name: titreHub(outil), url: `${SITE.url}${outilPath(outil)}`,
      })),
    },
    {
      '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Outils comptables gratuits', item: url },
      ],
    },
  ],
};
---

<Base titre={title} titreSocial={h1} description={description} chemin={OUTILS_HUB_PATH} base="/" socialImage={{ url: `${SITE.url}/proofs/v2/og/24-outils-hub.webp`, width: 1200, height: 630, alt: 'Quatre outils comptables gratuits : marge, échéance, amortissement et rapprochement bancaire.' }} schema={graph}>

  <div class="feuille outils-feuille">
    <OutilHero
      title={h1}
      description="Choisissez la tâche que vous voulez préparer, puis ouvrez l’outil sans inscription. Chaque carte indique les données nécessaires, le résultat disponible et sa limite. Vous gardez la validation et la décision pour votre dossier."
      proof="v2/24-outils-hub"
      titleId="outils-titre"
      eyebrow="Un besoin, un résultat, une limite"
      breadcrumbs={[{ label: 'Accueil', href: '/' }, { label: 'Outils comptables gratuits' }]}
    />

    {categoriesPubliees.map((category) => (
      <section class="section outils-categorie" aria-labelledby={`categorie-${category.id}`}>
        <div class="conteneur pile">
          <div class="tete rv">
            <h2 id={`categorie-${category.id}`}>{category.label}</h2>
          </div>
          <ul class="cartes rv-groupe">
            {category.tools.map((outil) => (
              <li class="carte rv" data-outil-card>
                <div class="carte-corps">
                  <h3 class="carte-titre">{titreHub(outil)}</h3>
                  <p class="carte-texte">{outil.description}</p>
                  <dl>
                    <div><dt>Entrée</dt><dd>{outil.promesse.entree}</dd></div>
                    <div><dt>Résultat</dt><dd>{outil.promesse.resultat}</dd></div>
                    <div><dt>Limite</dt><dd>{outil.limites[outil.slug === 'modele-rapprochement-bancaire-excel-gratuit' ? 1 : 0]}</dd></div>
                  </dl>
                  <a class="carte-action carte-lien outil-carte-action" href={outilPath(outil)}>{actions[outil.slug] ?? 'Ouvrir l’outil'}<Picto nom="fleche" taille={14} /></a>
                  <p>Gratuit, sans inscription.</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>
  <AppelFinal
    id="hub-confier"
    titre="La même tâche revient dans vos dossiers ?"
    texte="Nous écrivons sa règle dans vos mots, puis nous prenons en charge la tâche entière dans vos outils existants. Vos collaborateurs gardent les validations et le jugement."
    points={['Règle et limites écrites avec votre cabinet', 'Essais sur des données fictives, puis validation par votre équipe', 'Livraison et maintenance dans le périmètre convenu']}
  />
</Base>

<style>
  /*
   * Système de page : une catégorie est une section (titre, puis ses cartes) au pas des sections,
   * sans filet entre elles. Chaque outil est une carte du site (global.css) : la grille suit le
   * nombre d'outils de la catégorie ; l'outil seul de sa catégorie garde la largeur d'une colonne.
   */
  .outils-feuille { min-height: 70vh; padding-bottom: var(--section-espace); }
  .outils-categorie dl { display: grid; gap: 10px; margin: 4px 0 0; padding-top: 16px; border-top: 1px solid var(--ligne); }
  .outils-categorie dl div { display: grid; gap: 2px; }
  .outils-categorie dt { color: var(--texte-2); font-size: var(--t-sm); font-weight: 600; }
  .outils-categorie dd { margin: 0; color: var(--texte-fort); }
</style>
