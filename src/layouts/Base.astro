---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { SITE, OG_IMAGE } from '@/data/site.mjs';
import { withBreadcrumb } from '@/data/schema.mjs';
import { socialImageUrl } from '@/data/social-image.mjs';
import { BLOG } from '@/data/blog.mjs';
import { construireRubriques } from '@/data/blog-rubriques.mjs';
import { isBlogEntryVisible } from '@/data/blog-visibility.mjs';
import { AUTEURS, identiteAuteur } from '@/data/auteurs';

/**
 * Gabarit commun : head SEO complet (title, description, canonical, robots, OG, Twitter),
 * polices préchargées (Fraunces 600, Hanken 400, Hanken 500), navigation, pied, script
 * d'apparition au défilement. Le JSON-LD est passé par le slot `head`.
 */
interface Props {
  titre: string;
  /** Titre des cartes de partage (og:title, twitter:title) ; par défaut le titre de l'onglet. */
  titreSocial?: string;
  description: string;
  /** Chemin canonique sans slash final (« / » pour l'accueil). */
  chemin: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Image sociale spécifique à la page ; l’OG globale reste le repli des pages sans visuel dédié. */
  socialImage?: { url: string; width: number; height: number; alt: string };
  /** Ancres de la nav depuis une autre page que l'accueil. */
  base?: string;
  /** Politique locale d'une page autonome ; dupliquée en en-tête Cloudflare sur la route. */
  csp?: string;
  /** Graphe JSON-LD de la page. Base y fusionne l'attribution pour conserver un bloc unique. */
  schema?: Record<string, any>;
  /** Le slot head fournit déjà son bloc JSON-LD (accueil et articles). */
  schemaExterne?: boolean;
}
const {
  titre,
  titreSocial = titre,
  description,
  chemin,
  noindex = false,
  ogType = 'website',
  socialImage = { url: OG_IMAGE.url, width: OG_IMAGE.largeur, height: OG_IMAGE.hauteur, alt: OG_IMAGE.alt },
  base = '',
  csp,
  schema,
  schemaExterne = false,
} = Astro.props;
const canonical = chemin === '/' ? `${SITE.url}/` : `${SITE.url}${chemin}`;
const sharingImageUrl = socialImageUrl(socialImage.url);
const articles = await getCollection('blog', isBlogEntryVisible);
const blogActif = articles.length > 0;
const rubriques = construireRubriques(articles);
const auteur = AUTEURS.kevin;
const auteurId = `${SITE.url}${identiteAuteur(auteur)}`;
// Les dates restent celles des sources éditoriales explicites : aucune date de repli
// ni lastmod technique du sitemap ne doit devenir une date de publication.
const attribution = {
  '@context': 'https://schema.org',
  '@id': `${canonical}#page`,
  author: { '@id': auteurId },
};
const schemaAvecAttribution = schema?.['@graph']
  ? {
      ...schema,
      '@graph': schema['@graph'].map((node: Record<string, any>) => {
        const types = Array.isArray(node?.['@type']) ? node['@type'] : [node?.['@type']];
        const estPage = types.some((type: unknown) => typeof type === 'string' && type.endsWith('Page'));
        return estPage
          ? {
              ...node,
              author: node.author ?? attribution.author,
            }
          : node;
      }),
    }
  : schema
    ? { ...attribution, ...schema }
    : { ...attribution, '@type': 'WebPage', url: canonical, name: titreSocial, inLanguage: SITE.langue };
const schemaComplet = withBreadcrumb(schemaAvecAttribution, { chemin, name: titreSocial, noindex });
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="author" content={auteur.nom} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content={SITE.couleurTheme} />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {blogActif && <link rel="alternate" type="application/rss+xml" title={BLOG.titre} href={BLOG.fluxRss} />}

    <link rel="preload" href="/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-500.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={titreSocial} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={sharingImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreSocial} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={sharingImageUrl} />
    {ogType !== 'article' && !schemaExterne && <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaComplet).replace(/</g, '\\u003c')} />}

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip">Aller au contenu</a>
    <Nav blogActif={blogActif} chemin={chemin} base={base} />
    <main id="main">
      <slot />
    </main>
    <Footer blogActif={blogActif} rubriques={rubriques} base={base} />

    <script>
      // Apparitions au défilement (spec §5.2) : la classe `js` active les états initiaux ;
      // sans JS, tout est visible. Sous prefers-reduced-motion, tout est révélé d'emblée.
      document.documentElement.classList.add('js');
      const cibles = document.querySelectorAll<HTMLElement>('.rv');
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduit || !('IntersectionObserver' in window)) {
        cibles.forEach((el) => el.classList.add('in'));
      } else {
        const obs = new IntersectionObserver(
          (entrees) => {
            for (const e of entrees) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in');
              obs.unobserve(e.target);
            }
          },
          // Le bloc se révèle avant d'entrer à l'écran (30 % de hauteur d'avance) : au défilement, il est
          // déjà lisible quand il arrive, au lieu d'apparaître une demi-seconde après (Kevin, 07/10/2026).
          { threshold: 0, rootMargin: '0px 0px 30% 0px' }
        );
        cibles.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>
