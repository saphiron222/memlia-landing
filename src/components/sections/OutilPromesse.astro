---
interface Props {
  entree: string;
  resultat: string;
}

const { entree, resultat } = Astro.props;
// Système de page : ce que l'on saisit et ce que l'on obtient sont deux définitions, donc des
// lignes (le terme, puis son explication), sous le héros, au pas des sections.
---

<section class="section outil-promesse-section" data-tool-section="promesse" aria-labelledby="outil-promesse-titre">
  <div class="conteneur">
    <h2 id="outil-promesse-titre" class="sr-only">Entrée et résultat attendus</h2>
    <dl class="lignes outil-promesse rv">
      <div class="ligne">
        <dt class="ligne-libelle">Vous saisissez</dt>
        <dd class="ligne-texte">{entree}</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Vous obtenez</dt>
        <dd class="ligne-texte">{resultat}</dd>
      </div>
    </dl>
  </div>
</section>
