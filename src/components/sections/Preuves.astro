---
import Picto from '@/components/Picto.astro';
import ProofMedia from '@/components/ProofMedia.astro';
const proofs = [
  { title: 'Preuve de méthode', text: 'Règle écrite, cas limites, refus attendus et recette avant livraison.', href: '#methode' },
  { title: 'Preuve de contrôle', text: 'Proposition visible, validation humaine et refus des sorties sensibles non prévues au contrat.', href: '#faq-ia-decide' },
  { title: 'Preuve de confidentialité', text: 'Jeux fictifs pour construire, démontrer et tester.', href: '#faq-donnees-reelles' },
];

/**
 * S6 — « Proposition vs saisie » + repères vérifiables (spec §4.10 / S6 b), à la place
 * des témoignages : aucune preuve sociale sans autorisation distincte. Le motif directeur
 * du produit est dit tel quel ; chaque repère renvoie à la preuve correspondante sur la page.
 */
---

<section id="preuves" class="preuves" aria-labelledby="preuves-titre">
  <div class="preuves-tete rv">

    <span class="eyebrow">proposition vs saisie</span>
    <h2 id="preuves-titre">Automatiser la mécanique. Pas le jugement.</h2>
    <p class="texte-2 lecture preuves-intro">
      Nous distinguons ce qui peut être exécuté, ce qui doit être proposé et ce qui doit être refusé.
      Une information ambiguë bloque l’écriture concernée et appelle une revue humaine.
    </p>
    <p class="texte-2 lecture">Memlia propose. Le cabinet saisit ou valide. Ce que Memlia génère se régénère ;
      ce que le cabinet saisit ne se touche jamais. Aucun envoi externe sans validation humaine.</p>
  </div>

  <div class="coins">
    <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
  <ul class="reperes rv-groupe" aria-label="Preuves de méthode">
    {proofs.map((r) => (
      <li class="repere rv">
        <h3 class="proof-title">{r.title}</h3>
        <p class="repere-libelle">{r.text}</p>
        <a class="btn btn-lien repere-lien" href={r.href}>
          Lire le détail
          <Picto nom="fleche" taille={14} />
        </a>
      </li>
    ))}
  </ul>
  </div>
  <div class="preuves-media"><ProofMedia id="03-controle" /></div>
</section>

<style>
  .preuves-media { padding: 0 var(--marge-page); }
  @media (min-width: 64rem) { .preuves-media { padding: 0 var(--marge-page-lg); } }
  .proof-title { font-size: var(--t-2xl); }
  .preuves {
    padding-top: 96px;
  }
  .preuves-tete {
    display: grid;
    gap: 12px;
    max-width: 720px;
    padding: 0 var(--marge-page) 40px;
  }
  .preuves-embleme {
    width: 72px;
    height: 72px;
    border-radius: var(--r-carte);
    overflow: hidden;
    border: 1px solid var(--ligne-douce);
    margin-bottom: 8px;
  }
  .preuves-intro {
    max-width: 62ch;
  }
  .reperes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--ligne-douce);
    border-top: 1px solid var(--ligne);
    border-bottom: 1px solid var(--ligne);
  }
  .repere {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 40px 24px 44px;
    background: var(--surface-feuille);
  }
  .repere-chiffre {
    font-family: var(--police-chiffres), 'Fraunces Fallback';
    font-variant-numeric: tabular-nums;
    font-size: var(--t-chiffre);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--texte-fort);
  }
  .repere-libelle {
    color: var(--texte);
    max-width: 34ch;
  }
  .repere-lien {
    justify-self: start;
    margin-top: 6px;
  }
  @media (min-width: 40rem) {
    .reperes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .repere:last-child { grid-column: 1 / -1; }
  }
  @media (min-width: 64rem) {
    .preuves {
      padding-top: 128px;
    }
    .preuves-tete {
      padding-left: var(--marge-page-lg);
      padding-right: var(--marge-page-lg);
    }
    .reperes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .repere:last-child { grid-column: auto; }
    .repere {
      padding: 48px 32px 56px;
    }
  }
</style>
