---

import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['preuves']; }
const { contenu = contenuDe('ec').preuves } = Astro.props;
const proofs = contenu.reperes;

/** Recette A du 15/10/2026 : contenu et ancres conservés, cadres commerciaux retirés. */
---

<section id="preuves" class="section preuves" aria-labelledby="preuves-titre"><div class="conteneur"><div class="editorial-regle"><div class="tete"><p class="surtitre">La règle écrite · {contenu.etiquette}</p><h2 id="preuves-titre">{contenu.titre}</h2><p>{contenu.texte}</p><p>{contenu.propriete}</p></div><div class="editorial-frontiere">{proofs.map(r=><div><h3>{r.title}</h3><p>{r.text}</p></div>)}</div><div class="editorial-arret"><h3>Dans le doute, le traitement concerné s’arrête.</h3><p>Une pièce manquante ou un cas hors règle reste visible, avec sa raison. Votre équipe décide de la suite.</p></div><a class="catalogue-action" href="/garanties">Examiner nos garanties →</a></div></div></section>
