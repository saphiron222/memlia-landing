---
import { getCollection } from 'astro:content';
import Courriel from '@/components/Courriel.astro';
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import Picto from '@/components/Picto.astro';
import Button from '@/components/Button.astro';
import { SITE, CTA } from '@/data/site.mjs';
import { organizationNode } from '@/data/schema.mjs';
import { BLOG, compterMots } from '@/data/blog.mjs';
import { IMAGES } from '@/data/images.mjs';
import { AUTEURS, identiteAuteur } from '@/data/auteurs';
import { isBlogEntryDiscoverable } from '@/data/blog-visibility.mjs';

/**
 * Route /blog : le pilier en point de départ, puis la liste des autres articles du plus récent au plus ancien, ligne
 * éditoriale, fiche auteur ancrée (#auteur-kevin, cible du `rel=author` des articles).
 * Fichier `blog.astro` (pas `blog/index.astro`) : avec `build.format: 'file'`, l'URL
 * canonique sans slash est servie sans redirection.
 */
// Le pilier (format pillar-page) SORT de la liste : il ouvre la page comme point de départ, et la
// liste qui suit se lit alors strictement du plus récent au plus ancien. Épinglé dans la liste, il
// donnait à lire un ordre faux dès qu'un satellite portait une date postérieure.
const parDate = (await getCollection('blog', isBlogEntryDiscoverable)).sort(
  (a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime()
);
const pilier = parDate.find((a) => a.data.format === 'pillar-page');
const suite = parDate.filter((a) => a !== pilier);
// L'ordre du DOM, et donc celui du graphe : le pilier d'abord, puis la liste chronologique.
const articles = pilier ? [pilier, ...suite] : suite;
const formatDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const minutes = (corps: string | undefined) => Math.max(1, Math.ceil(compterMots(corps ?? '') / BLOG.motsParMinute));
const u = `${SITE.url}/`;
const url = `${SITE.url}${BLOG.chemin}`;
const auteurs = Object.values(AUTEURS);
const headline = 'Ce qui se vérifie, ce qui s’automatise, ce qui se décide.';

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // Le contrat de schéma attend une CollectionPage : c'est aussi le seul nœud de page
      // de cette route, que « Blog » seul ne fournissait pas.
      '@type': ['CollectionPage', 'Blog'],
      '@id': `${url}#page`,
      url,
      name: BLOG.titre,
      headline,
      description: BLOG.description,
      inLanguage: SITE.langue,
      isPartOf: { '@id': `${u}#website` },
      mainEntityOfPage: { '@id': `${url}#page` },
      publisher: { '@id': `${u}#organization` },
      blogPost: articles.map((a) => ({ '@id': `${SITE.url}${BLOG.chemin}/${a.id}#article` })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: u },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: url },
      ],
    },
    ...auteurs.map((a) => ({
      '@type': 'Person',
      '@id': `${u}${identiteAuteur(a).slice(1)}`,
      name: a.nom,
      jobTitle: a.role,
      description: a.bio,
      url: `${SITE.url}${a.pageIdentite}`,
      worksFor: { '@id': `${u}#organization` },
    })),
    organizationNode(),
    { '@type': 'WebSite', '@id': `${u}#website`, url: u, name: SITE.nom, inLanguage: SITE.langue, publisher: { '@id': `${u}#organization` } },
  ],
};
---

<Base titre={BLOG.titre} titreSocial={headline} description={BLOG.description} chemin={BLOG.chemin} base="/" schema={graph}>

  <div class="feuille blog-feuille">
    <section class="conteneur blog-tete" aria-labelledby="blog-titre">
      <nav class="ariane" aria-label="Fil d’Ariane">
        <ol>
          <li><a href="/">Accueil</a></li>
          <li aria-current="page">Blog</li>
        </ol>
      </nav>
      <span class="eyebrow">Blog</span>
      <h1 id="blog-titre">{headline}</h1>
      <p class="texte-2 lecture blog-intro">
        Le savoir-faire d’un cabinet tient dans des règles que personne n’a écrites. Ces méthodes les écrivent,
        une tâche à la fois : contrôler les bulletins avant la DSN, relancer les pièces, suivre la production
        sociale, vérifier une saisie automatique. Chacune dit ce qui se prépare seul, ce qui attend une
        validation, et ce qui reste à vos équipes.
      </p>
      <p class="texte-2 lecture blog-transition">Commencez par la tâche qui vous occupe.</p>
      <a class="btn btn-lien blog-rss" href={BLOG.fluxRss} type="application/rss+xml">Flux RSS <Picto nom="fleche" taille={14} /></a>
    </section>

    {pilier && (
      <section class="conteneur blog-depart" aria-labelledby="depart-titre">
        <span class="pastille"><span class="point"></span>À lire en premier</span>
        <h2 id="depart-titre" class="sr-only">Article de référence</h2>
        <article class="blog-carte blog-pilier rv" data-article={pilier.id}>
          <a href={`${BLOG.chemin}/${pilier.id}`} class="carte-image" aria-hidden="true" tabindex="-1">
            <Picture id={pilier.data.image as keyof typeof IMAGES} sizes="(min-width: 64rem) 560px, (min-width: 48rem) 50vw, 100vw" />
          </a>
          <div class="carte-texte">
            <p class="carte-meta texte-2">
              <time datetime={iso(pilier.data.datePublication)}>{formatDate(pilier.data.datePublication)}</time>
              <span aria-hidden="true">·</span>
              <span>{minutes(pilier.body)} min de lecture</span>
            </p>
            <h3 class="carte-titre"><a href={`${BLOG.chemin}/${pilier.id}`}>{pilier.data.titre}</a></h3>
            <p class="texte-2 carte-resume">{pilier.data.resume}</p>
            <span class="btn btn-lien carte-lire" aria-hidden="true">Lire l’article <Picto nom="fleche" taille={14} /></span>
          </div>
        </article>
      </section>
    )}

    <section class="conteneur blog-section-liste" aria-labelledby="articles-titre">
      <h2 id="articles-titre" class="blog-liste-titre">Les articles</h2>
      <ul class="blog-liste rv-groupe" data-articles={suite.length}>
        {suite.map((a) => (
          <li class="blog-carte rv" data-article={a.id}>
            <a href={`${BLOG.chemin}/${a.id}`} class="carte-image" aria-hidden="true" tabindex="-1">
              <Picture id={a.data.image as keyof typeof IMAGES} sizes="(min-width: 64rem) 560px, (min-width: 48rem) 50vw, 100vw" />
            </a>
            <div class="carte-texte">
              <p class="carte-meta texte-2">
                <time datetime={iso(a.data.datePublication)}>{formatDate(a.data.datePublication)}</time>
                <span aria-hidden="true">·</span>
                <span>{minutes(a.body)} min de lecture</span>
              </p>
              <h3 class="carte-titre"><a href={`${BLOG.chemin}/${a.id}`}>{a.data.titre}</a></h3>
              <p class="texte-2 carte-resume">{a.data.resume}</p>
              <span class="btn btn-lien carte-lire" aria-hidden="true">Lire l’article <Picto nom="fleche" taille={14} /></span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="conteneur blog-auteurs" aria-labelledby="auteurs-titre">
      <h2 id="auteurs-titre">Qui écrit ici</h2>
      {auteurs.map((a) => (
        <article class="auteur-fiche" id={a.ancre.slice(1)}>
          <span class="auteur-initiale" aria-hidden="true">{a.nom.charAt(0)}</span>
          <div>
            <h3 class="auteur-nom"><a href={identiteAuteur(a)}>{a.nom}</a> <span class="texte-2 auteur-role">· {a.role}</span></h3>
            <p class="texte-2">{a.bio}</p>
            <p class="auteur-contact"><Courriel /></p>
          </div>
        </article>
      ))}
    </section>

    <!-- Sortie de page : même forme que celle du glossaire (titre en question, une phrase, l'action), en dernier. -->
    <section class="conteneur blog-sortie" aria-labelledby="sortie-titre">
      <h2 id="sortie-titre">Une tâche revient chaque semaine dans votre cabinet ?</h2>
      <p class="texte-2">Décrivez-la : nous vous disons si elle se cadre et ce qu’il faudrait pour la prendre en charge, sans rien nous envoyer. Pour le vocabulaire, le <a href="/glossaire">glossaire</a> fixe chaque terme et sa frontière d’automatisation.</p>
      <p class="blog-actions">
        <Button href={CTA.principal.href} variante="principal" picto="fleche">{CTA.principal.libelle}</Button>
        <Button href="/methode" variante="lien">Comprendre notre méthode</Button>
      </p>
    </section>
  </div>
</Base>

<style>
  .blog-feuille { background: var(--surface-feuille); padding-bottom: clamp(48px, 8vw, 96px); }
  .blog-tete { display: grid; gap: 16px; padding-top: clamp(28px, 5vw, 56px); padding-bottom: 40px; max-width: 880px; margin-inline: 0; }
  .ariane ol { display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--t-sm); color: var(--texte-2); margin-bottom: 12px; }
  .ariane li + li::before { content: '›'; margin-right: 6px; color: var(--picto-repos); }
  .ariane a { color: var(--texte-2); text-decoration: underline; text-underline-offset: 2px; }
  .ariane [aria-current] { color: var(--texte); }
  .blog-tete h1 { font-size: var(--t-5xl); max-width: 20ch; }
  .blog-intro { max-width: 62ch; }
  .blog-rss { justify-self: start; }
  /* Le pilier a son propre bloc au-dessus de la liste : la liste redevient strictement
     chronologique, et le moyeu du cluster reste la première chose vue. */
  .blog-depart { display: grid; justify-items: start; gap: 20px; border-top: 1px solid var(--ligne); padding-top: 32px; }
  .blog-pilier { width: 100%; }
  .blog-pilier .carte-titre { font-size: var(--t-3xl); }
  .blog-section-liste { margin-top: 56px; border-top: 1px solid var(--ligne); padding-top: 32px; }
  .blog-liste-titre { font-size: var(--t-xl); margin-bottom: 24px; }
  .blog-liste { display: grid; gap: 32px; }
  .blog-carte { display: grid; gap: 16px; }
  .carte-image { display: block; border-radius: var(--r-carte); overflow: hidden; border: 1px solid var(--ligne-douce); }
  .carte-texte { display: grid; gap: 8px; align-content: start; }
  .carte-meta { display: flex; flex-wrap: wrap; gap: 8px; font-size: var(--t-sm); }
  .carte-titre { font-size: var(--t-2xl); line-height: 1.15; }
  .carte-titre a { transition: color var(--duree-1); }
  .carte-resume { max-width: 58ch; }
  .carte-lire { justify-self: start; margin-top: 4px; }
  .blog-auteurs { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--ligne-douce); display: grid; gap: 16px; }
  .blog-sortie { display: grid; justify-items: start; gap: 12px; max-width: 720px; margin-top: 72px; padding-top: 40px; border-top: 1px solid var(--ligne-forte); }
  .blog-sortie h2 { font-size: var(--t-3xl); max-width: 24ch; }
  .blog-sortie p { max-width: 60ch; }
  .blog-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 8px; }
  .blog-auteurs h2 { font-size: var(--t-2xl); }
  .auteur-fiche { display: flex; gap: 16px; align-items: flex-start; max-width: 720px; scroll-margin-top: calc(var(--nav-h) + 24px); }
  .auteur-initiale {
    display: grid; place-items: center; flex: 0 0 auto; width: 48px; height: 48px; border-radius: 12px;
    background: var(--accent); color: var(--creme); font-family: var(--police-display), 'Fraunces Fallback'; font-weight: 600; font-size: 1.4rem;
  }
  .auteur-nom { font-size: var(--t-lg); font-family: var(--police-corps), 'Hanken Fallback'; font-weight: 600; margin-bottom: 4px; }
  .auteur-role { font-weight: 400; }
  .auteur-contact { margin-top: 8px; font-size: var(--t-sm); }
  .auteur-contact a { color: var(--accent-texte); text-decoration: underline; text-underline-offset: 2px; }
  @media (hover: hover) {
    .carte-titre a:hover { color: var(--accent-texte); }
  }
  @media (min-width: 48rem) {
    .blog-carte { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  }
</style>
