---
import Button from '@/components/Button.astro';
import { OUTILS_HUB_PATH, type OutilDefinition } from '@/data/outils';

interface Props {
  outil: OutilDefinition;
}

const { outil } = Astro.props;
---

<section class="outil-suite" data-tool-section="suite" aria-labelledby="outil-suite-titre">
  <div class="conteneur outil-suite-inner">
    <h2 id="outil-suite-titre">Pour continuer</h2>
    <nav class="outil-liens" data-tool-links aria-label="Pour continuer">
      <a href={OUTILS_HUB_PATH}>Tous les outils comptables gratuits</a>
      {outil.articleExact && <a href={outil.articleExact}>Consulter la ressource associée</a>}
      <a href={outil.pageService}>Comprendre la méthode</a>
      <Button href={outil.cta} variante="principal" picto="fleche">Confier une première tâche</Button>
    </nav>
  </div>
</section>

<style>
  .outil-suite {
    border-bottom: 1px solid var(--ligne-douce);
    background: var(--surface-page);
  }
  .outil-suite-inner {
    display: grid;
    gap: 24px;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .outil-suite h2 {
    font-size: var(--t-3xl);
  }
  .outil-liens {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding-top: 24px;
    border-top: 1px solid var(--ligne-forte);
  }
  .outil-liens > a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-texte);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 64rem) {
    .outil-suite-inner {
      padding-top: 80px;
      padding-bottom: 80px;
    }
  }
</style>
