---
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['methode']; }
const { contenu = contenuDe('ec').methode } = Astro.props;

// Les étapes restent du texte natif ; la scène propre à l’accueil vit dans Quotidien.
---

<section id="methode" class="section parcours" aria-labelledby="methode-titre">
  <div class="conteneur pile">
    <div class="tete">
      <h2 id="methode-titre" class="parcours-h2">{contenu.titre}</h2>
    </div>
    <ol class="editorial-etapes editorial-etapes-court">
      {contenu.etapes.map((e, i) => (
        <li class="etape" data-etape={i}>
          <div class="etape-copie step-copy" >
            <p class="surtitre step-number">{contenu.libelleEtape} {e.numero}</p>
            <h3 class="etape-h3">{e.titre}</h3>
            <p class="texte-2">{e.texte}</p>
          </div>

        </li>
      ))}
    </ol>
    <a class="catalogue-action" href="/methode">De l’observation à la maintenance →</a>
    <slot name="frontiere" />
    <slot />
  </div>
</section>
