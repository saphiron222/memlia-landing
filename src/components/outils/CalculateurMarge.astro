<section aria-label="Formules de marge">
  <p>Marge = vente HT − achat HT.</p>
  <p>Taux de marge = marge ÷ achat HT × 100.</p>
  <p>Taux de marque = marge ÷ vente HT × 100.</p>
  <p>Les deux montants HT doivent être strictement positifs. Une marge négative reste calculable. Les taux affichés sont arrondis à deux décimales.</p>
</section>
<form class="outil-form" data-margin-form novalidate>
  <div class="fields two">
    <label>Prix d’achat HT <input name="purchase" inputmode="decimal" autocomplete="off" placeholder="Ex. 80,00" required /></label>
    <label>Prix de vente HT <input name="sale" inputmode="decimal" autocomplete="off" placeholder="Ex. 100,00" required /></label>
  </div>
  <p class="hint">Montants positifs, deux décimales au maximum, bornés à 999 999 999,99 €.</p>
  <div class="actions">
    <button class="btn btn-contour" type="button" data-example data-outil-action="exemple">Charger un exemple fictif</button>
    <button class="btn btn-contour" type="reset" data-outil-action="effacer">Effacer</button>
    <button class="btn btn-principal" type="submit">Calculer la marge</button>
  </div>
  <p class="error" id="marge-erreur" data-error role="alert" aria-live="assertive" hidden></p>
  <section class="result" data-output aria-live="polite" aria-atomic="true" hidden>
    <h2 tabindex="-1">Résultat et trace</h2>
    <dl>
      <div><dt>Marge commerciale</dt><dd data-margin></dd></div>
      <div><dt>Taux de marge</dt><dd data-rate-margin></dd></div>
      <div><dt>Taux de marque</dt><dd data-rate-mark></dd></div>
    </dl>
    <ol data-trace></ol>
    <div class="result-actions">
      <button class="btn btn-contour" type="button" data-copy data-outil-action="copie">Copier le résultat et la trace</button>
      <button class="btn btn-contour" type="button" data-download data-outil-action="export">Télécharger le CSV</button>
    </div>
    <p class="status" data-status aria-live="polite"></p>
    <p class="proof"><strong>Preuve de refus :</strong> un montant vide, négatif, nul, ambigu ou au-delà de la borne ne produit aucun taux.</p>
  </section>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-margin-form]');
  const parseCents = (raw: string) => {
    const value = raw.trim().replace(/\u00a0|\u202f| /g, '');
    if (!/^\d{1,9}(?:[,.]\d{1,2})?$/.test(value)) return null;
    const [whole, decimals = ''] = value.replace(',', '.').split('.');
    const cents = Number(whole) * 100 + Number(decimals.padEnd(2, '0'));
    return Number.isSafeInteger(cents) && cents <= 99999999999 ? cents : null;
  };
  const money = (cents: number) => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(cents / 100);
  const percent = (value: number) => new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value) + ' %';
  if (form) {
    const purchaseInput = form.elements.namedItem('purchase') as HTMLInputElement;
    const saleInput = form.elements.namedItem('sale') as HTMLInputElement;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const output = form.querySelector<HTMLElement>('[data-output]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const copy = form.querySelector<HTMLButtonElement>('[data-copy]')!;
    const download = form.querySelector<HTMLButtonElement>('[data-download]')!;
    let trace: string[] = [];
    let csv = '';

    const clearState = () => {
      output.hidden = true;
      error.hidden = true;
      status.textContent = '';
      trace = [];
      csv = '';
      for (const input of [purchaseInput, saleInput]) {
        input.removeAttribute('aria-invalid');
        input.removeAttribute('aria-describedby');
      }
    };
    const refuse = (message: string, inputs: HTMLInputElement[]) => {
      error.textContent = message;
      error.hidden = false;
      inputs.forEach((input) => {
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', 'marge-erreur');
      });
      inputs[0]?.focus();
    };
    purchaseInput.addEventListener('input', clearState);
    saleInput.addEventListener('input', clearState);
    form.addEventListener('reset', () => queueMicrotask(clearState));
    form.querySelector<HTMLButtonElement>('[data-example]')!.addEventListener('click', () => {
      purchaseInput.value = '80,00';
      saleInput.value = '100,00';
      clearState();
      purchaseInput.focus();
    });

    form.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const purchase = parseCents(String(data.get('purchase') ?? ''));
    const sale = parseCents(String(data.get('sale') ?? ''));
    output.hidden = true;
    status.textContent = '';
    if (purchase === null || sale === null) {
      const invalid = [purchase === null ? purchaseInput : null, sale === null ? saleInput : null].filter((input): input is HTMLInputElement => Boolean(input));
      refuse('Refus : saisissez deux montants positifs, sans séparateur de milliers, avec deux décimales au maximum.', invalid);
      return;
    }
    if (purchase === 0 || sale === 0) {
      const invalid = [purchase === 0 ? purchaseInput : null, sale === 0 ? saleInput : null].filter((input): input is HTMLInputElement => Boolean(input));
      refuse('Refus : le prix d’achat et le prix de vente doivent être supérieurs à zéro pour calculer les taux.', invalid);
      return;
    }
    error.hidden = true;
    purchaseInput.removeAttribute('aria-invalid');
    saleInput.removeAttribute('aria-invalid');
    const margin = sale - purchase;
    const rateMargin = margin / purchase * 100;
    const rateMark = margin / sale * 100;
    form.querySelector<HTMLElement>('[data-margin]')!.textContent = money(margin);
    form.querySelector<HTMLElement>('[data-rate-margin]')!.textContent = percent(rateMargin);
    form.querySelector<HTMLElement>('[data-rate-mark]')!.textContent = percent(rateMark);
    trace = [
      `Marge = ${money(sale)} − ${money(purchase)} = ${money(margin)}.`,
      `Taux de marge = ${money(margin)} ÷ ${money(purchase)} × 100 = ${percent(rateMargin)}.`,
      `Taux de marque = ${money(margin)} ÷ ${money(sale)} × 100 = ${percent(rateMark)}.`,
      'Les montants sont calculés au centime ; les taux sont arrondis à deux décimales pour l’affichage.',
    ];
    form.querySelector<HTMLOListElement>('[data-trace]')!.replaceChildren(...trace.map((line) => {
      const item = document.createElement('li'); item.textContent = line; return item;
    }));
    const csvValue = (value: string) => `"${value.replace(/"/g, '""')}"`;
    csv = '\uFEFF' + [
      ['Calcul de marge commerciale', 'Valeur'],
      ['Prix d’achat HT', money(purchase)],
      ['Prix de vente HT', money(sale)],
      ['Marge commerciale', money(margin)],
      ['Taux de marge', percent(rateMargin)],
      ['Taux de marque', percent(rateMark)],
    ].map((row) => row.map(csvValue).join(';')).join('\r\n');
    output.hidden = false;
    output.querySelector('h2')?.focus?.();
    });

    copy.addEventListener('click', async () => {
      if (!trace.length) return;
      try {
        await navigator.clipboard.writeText(trace.join('\n'));
        status.textContent = 'Résultat et trace copiés.';
      } catch {
        status.textContent = 'La copie est bloquée par le navigateur. Le résultat reste sélectionnable.';
      }
    });
    download.addEventListener('click', () => {
      if (!csv) return;
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'calcul-marge-commerciale.csv';
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 0);
    });
  }
</script>
<style>
  .outil-form,.fields,label,.result,.result dl,.result dl div { display:grid; gap:12px; }
  .fields.two { grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  label { color:var(--texte-fort); font-weight:600; }
  input { width:100%; min-height:48px; padding:10px 12px; border:1px solid var(--ligne-forte); border-radius:var(--r-bouton); background:var(--surface-feuille); color:var(--texte-fort); font:inherit; }
  .hint { margin:0; color:var(--texte-2); font-size:var(--t-sm); }
  .actions,.result-actions { display:flex; flex-wrap:wrap; gap:12px; align-items:center; }
  .btn { justify-self:start; }
  .error { margin:0; padding:12px 14px; border-left:3px solid var(--rouge); background:var(--rouge-voile); color:var(--rouge); }
  .result { margin-top:8px; padding:20px; border:1px solid var(--ligne); border-radius:var(--r-boite); background:var(--surface-page); }
  .result h2 { font-size:var(--t-2xl); }
  .result dl { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .result dl div { padding:12px; border-left:3px solid var(--accent-appui); }
  dt { color:var(--texte-2); font-size:var(--t-sm); } dd { margin:0; font-weight:700; font-size:var(--t-xl); }
  .result ol { display:grid; gap:8px; padding-left:20px; }
  .proof,.status { margin:0; color:var(--texte-2); }
  .outil-form [hidden] { display:none !important; }
  .result { box-sizing:border-box; width:100%; min-width:0; }
  @media(max-width:40rem){.fields.two,.result dl{grid-template-columns:1fr;}}
</style>
