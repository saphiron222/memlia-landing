---
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import Hero from '@/components/sections/Hero.astro';
import Garanties from '@/components/sections/Garanties.astro';
import Promesse from '@/components/sections/Promesse.astro';
import Usages from '@/components/sections/Usages.astro';
import Integration from '@/components/sections/Integration.astro';
import Quotidien from '@/components/sections/Quotidien.astro';
import Preuves from '@/components/sections/Preuves.astro';
import Methode from '@/components/sections/Methode.astro';
import Faq from '@/components/sections/Faq.astro';
import AppelFinal from '@/components/sections/AppelFinal.astro';

/**
 * M3-S : processus chronophage, résultat, usages illustratifs, méthode, intégration,
 * contrôle humain et garanties. Aucun catalogue public.
 */
const titre = 'Automatisation IA pour cabinets comptables | Memlia';
const description =
  'Memlia transforme les tâches répétitives des cabinets comptables en automatisations adaptées à leurs outils, avec règles cadrées et validation humaine.';
---

<Base titre={titre} description={description} chemin="/">
  <JsonLd slot="head" description={description} />

  <div class="feuille">
    <Hero />
    <Quotidien />
    <Promesse />
    <Usages />
    <Methode />
    <Integration />
    <Preuves />
    <Garanties />
    <Faq />
    <AppelFinal />
  </div>
</Base>
