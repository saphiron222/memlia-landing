---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import ProofRow from '@/components/ProofRow.astro';
import Button from '@/components/Button.astro';
import Picto, { type NomPicto } from '@/components/Picto.astro';
import Courriel from '@/components/Courriel.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { CTA, SITE } from '@/data/site.mjs';

const page = PAGES_V2.contact;
const url = `${SITE.url}${page.chemin}`;
const noeuds = [{
  '@type': 'ContactPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
  inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` },
}];
const preparer: { picto: NomPicto; titre: string; texte: string }[] = [
  { picto: 'flux', titre: 'Le geste', texte: 'Ce que quelqu’un refait chaque semaine ou chaque mois, décrit en une phrase.' },
  { picto: 'excel', titre: 'Les outils', texte: 'D’où viennent les fichiers, où va le résultat.' },
  { picto: 'coche', titre: 'Le résultat attendu', texte: 'Ce qui devrait exister à la fin, et qui le vérifie aujourd’hui.' },
];
const appel = {
  titre: 'Vous préférez en parler de vive voix ?',
  texte: 'Réservez un créneau pour parcourir la tâche ensemble. Vous pouvez aussi nous écrire par courriel.',
  points: ['Une tâche récurrente pour commencer.', 'Un échange sans engagement sur un développement.', 'Un devis établi selon la complexité de la tâche.'],
  action: CTA.rendezVous,
  secondaire: { libelle: 'Écrire à Memlia', href: `mailto:${SITE.email}` },
};
---

<PageCommerciale page={page} noeuds={noeuds} eyebrow="Premier échange" hero="v2/18-hero-contact" appel={appel}>
  <section class="pv" aria-labelledby="formulaire-titre">
    <div class="tete rv">
      <h2 id="formulaire-titre">Décrivez la tâche</h2>
      <p>Trois phrases suffisent. Nous répondons par courriel, sans envoi automatique.</p>
    </div>
    <div class="contact-grille">
      <form id="formulaire" class="contact-form rv" method="post" action="/api/contact" aria-labelledby="formulaire-titre" data-contact>
        <div class="champ">
          <label for="nom">Votre nom</label>
          <input id="nom" name="nom" type="text" required minlength="2" maxlength="120" autocomplete="name" />
        </div>
        <div class="champ">
          <label for="cabinet">Cabinet <span class="texte-2">(facultatif)</span></label>
          <input id="cabinet" name="cabinet" type="text" maxlength="160" autocomplete="organization" />
        </div>
        <div class="champ">
          <label for="courriel">Votre adresse de courriel</label>
          <input id="courriel" name="courriel" type="email" required maxlength="254" autocomplete="email" inputmode="email" />
        </div>
        <div class="champ">
          <label for="message">Le geste qui revient, vos outils, le résultat attendu</label>
          <textarea id="message" name="message" required minlength="20" maxlength="4000" rows="7" aria-describedby="message-aide"></textarea>
          <p id="message-aide" class="champ-aide texte-2">Rien à envoyer : la description suffit. Décrivez le geste sans donnée client ; ce formulaire ne reçoit pas de fichier.</p>
        </div>
        <div class="champ-piege" aria-hidden="true">
          <label for="site_web">Site web</label>
          <input id="site_web" name="site_web" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input id="origine" name="origine" type="hidden" value="" />
        <div class="champ champ-consentement">
          <input id="consentement" name="consentement" type="checkbox" required />
          <label for="consentement">J’ai pris connaissance de la <a href="/politique-de-confidentialite">politique de confidentialité</a>. Memlia utilise ces informations pour me répondre sur la base de son intérêt légitime.</label>
        </div>
        <div class="champ champ-consentement">
          <input id="consentement_origine" name="consentement_origine" type="checkbox" />
          <label for="consentement_origine">J’accepte que Memlia associe à mon message le chemin interne disponible pour comprendre la page du site à l’origine de ma demande (facultatif). Je peux envoyer mon message sans cet accord et le retirer en écrivant à Memlia.</label>
        </div>
        <div data-turnstile></div>
        <p class="mention">Cette vérification anti-abus peut nécessiter JavaScript. Si elle ne s’affiche pas, <a href={`mailto:${SITE.email}`}>écrivez-nous par courriel</a> ; vos champs restent ici.</p>
        <p class="contact-etat" data-etat role="status" aria-live="polite" hidden></p>
        <div class="contact-envoi">
          <Button type="submit" variante="principal" picto="fleche" disabled>Envoyer le message</Button>
        </div>
      </form>

      <aside class="contact-aside rv" aria-labelledby="preparer-titre">
        <h3 id="preparer-titre">Ce qu’il est utile de préparer</h3>
        <p class="texte-2">Ces trois repères nous aident à comprendre le travail de votre équipe.</p>
        <ul class="lignes contact-lignes">
          {preparer.map((p) => (
            <li class="ligne">
              <div class="ligne-tete">
                <span class="ligne-picto" aria-hidden="true"><Picto nom={p.picto} taille={20} /></span>
                <h4 class="ligne-libelle">{p.titre}</h4>
              </div>
              <p class="ligne-texte">{p.texte}</p>
            </li>
          ))}
        </ul>
        <p class="mention">Pour commencer, décrivez une tâche récurrente, un cas courant et une exception. Nous regardons ensemble ce qui se prépare et ce que votre équipe garde à décider.</p>
      </aside>
    </div>
  </section>

  <section class="pv" aria-labelledby="pasdemande">
    <div class="tete rv">
      <h2 id="pasdemande">Nous partons du travail de votre équipe</h2>
    </div>
    <div class="bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ul class="cartes rv-groupe">
        <li class="cellule rv"><h3 class="carte-titre">Le geste qui se répète</h3><p class="carte-texte">Racontez un cas courant et une exception. Nous repérons les étapes répétitives et celles qui demandent le jugement de votre équipe.</p></li>
        <li class="cellule rv"><h3 class="carte-titre">Le savoir-faire à écrire</h3><p class="carte-texte">Nous faisons préciser la règle que vos collaborateurs appliquent aujourd’hui. Elle sert à définir la tâche à prendre en charge et les validations à conserver.</p></li>
      </ul>
    </div>
  </section>

  <section class="pv" aria-labelledby="ensuite">
    <ProofRow id="v2/13-deux-issues">
      <div class="pv-copy rv">
        <h2 id="ensuite">Ce qui se passe ensuite</h2>
        <p>L’échange dure une trentaine de minutes. Nous parcourons la tâche, ses outils et ses exceptions pour voir si sa règle peut s’écrire.</p>
        <p class="texte-2">Si la tâche peut être prise en charge, nous vous proposons un cadrage : le résultat à livrer et ce que votre équipe garde à valider. Si elle n’est pas automatisable en l’état, nous vous expliquons ce qui bloque.</p>
        <p class="texte-2">Le devis vient après ce cadrage. Il dépend des sources, des règles, des exceptions et des validations, jamais du nombre de personnes dans votre cabinet. La maintenance, le support et les évolutions y sont écrits.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="canaux">
    <ProofRow id="v2/12-avant-echange">
      <div class="pv-copy rv">
        <h2 id="canaux">Les canaux</h2>
        <p>Le formulaire ci-dessus, un créneau réservé, ou un courriel : <a href={CTA.rendezVous.href} rel="noopener">{CTA.rendezVous.libelle}</a>, ou <Courriel libelle="écrire à Memlia" /> à <Courriel />.</p>
        <p class="texte-2">Le traitement de vos données de contact est décrit dans la <a href="/politique-de-confidentialite">politique de confidentialité</a>. Avant de nous parler, vous pouvez lire <a href="/automatisation-cabinet-comptable">ce que le service livre</a>, <a href="/methode">comment se déroule une mission</a> ou <a href="/garanties">ce que nous refusons de faire</a>.</p>
      </div>
    </ProofRow>
  </section>
</PageCommerciale>

<script>
  import { MESSAGES_CONTACT, MESSAGE_CONTACT_DEFAUT } from '@/data/contact-messages.mjs';
  /**
   * Avec JavaScript, le formulaire s'envoie sans quitter la page et dit ce qui s'est passé.
   * Sans JavaScript, il fonctionne tel quel : la fonction redirige vers une page de réponse.
   */
  const formulaire = document.querySelector<HTMLFormElement>('[data-contact]');
  const etat = document.querySelector<HTMLElement>('[data-etat]');
  const afficherEtat = (texte: string, ok: boolean) => {
    if (!etat) return;
    etat.textContent = texte; etat.hidden = false; etat.dataset.ok = ok ? 'oui' : 'non';
  };
  const renouvelerVerification = () => (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
  document.addEventListener('contact:verifie', () => afficherEtat('Vérification terminée. Vous pouvez envoyer votre message.', true));
  document.addEventListener('contact:expire', () => {
    afficherEtat('La vérification a expiré. Recommencez-la avant l’envoi ; vos champs sont conservés.', false);
    renouvelerVerification();
  });
  document.addEventListener('contact:erreur', () => afficherEtat('La vérification n’a pas pu charger. Réessayez, ou écrivez-nous par courriel.', false));

  // La clé publique est lue au runtime : le rendu statique reste identique entre environnements.
  const boutonEnvoi = formulaire?.querySelector<HTMLButtonElement>('button[type="submit"]');
  fetch('/api/contact', { cache: 'no-store' })
    .then((reponse) => { if (!reponse.ok) throw new Error('config'); return reponse.json(); })
    .then(({ sitekey }) => {
      if (!sitekey) throw new Error('config');
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.onload = () => {
        const widget = document.querySelector<HTMLElement>('[data-turnstile]');
        const turnstile = (window as Window & { turnstile?: { render: (element: HTMLElement, options: object) => void } }).turnstile;
        if (!widget || !turnstile) return;
        turnstile.render(widget, {
          sitekey, action: 'contact', language: 'fr',
          size: widget.getBoundingClientRect().width < 300 ? 'compact' : 'normal',
          callback: () => document.dispatchEvent(new Event('contact:verifie')),
          'expired-callback': () => document.dispatchEvent(new Event('contact:expire')),
          'error-callback': () => document.dispatchEvent(new Event('contact:erreur')),
        });
        if (boutonEnvoi) boutonEnvoi.disabled = false;
      };
      script.onerror = () => afficherEtat('La vérification ne se charge pas. Écrivez-nous par courriel.', false);
      document.head.appendChild(script);
    })
    .catch(() => afficherEtat('Le formulaire est indisponible. Écrivez-nous par courriel.', false));

  /**
   * D4 — la page d'origine : d'où vient la personne qui écrit, pour savoir quel article amène
   * une demande, uniquement après un accord distinct. On ne retient que le CHEMIN d'une page du site : un référent externe, absent
   * ou illisible laisse le champ vide, et la fonction écarte de toute façon ce qui n'est pas une
   * route interne. Sans JavaScript, le champ reste vide : c'est une commodité de mesure, pas une
   * condition d'envoi.
   */
  const origine = document.querySelector<HTMLInputElement>('#origine');
  const accordOrigine = document.querySelector<HTMLInputElement>('#consentement_origine');
  const actualiserOrigine = () => {
    if (!origine) return;
    origine.value = '';
    if (!accordOrigine?.checked) return;
    try {
      const venant = new URL(document.referrer, window.location.href);
      if (document.referrer && venant.origin === window.location.origin && venant.pathname !== window.location.pathname) {
        origine.value = venant.pathname;
      }
    } catch {
      /* Un référent illisible ne vaut pas une erreur pour le visiteur. */
    }
  };
  accordOrigine?.addEventListener('change', actualiserOrigine);
  // Le formulaire est utilisable avant le téléchargement du script : relire le choix déjà saisi.
  actualiserOrigine();
  if (formulaire && etat) {
    formulaire.addEventListener('submit', async (evenement) => {
      if (!formulaire.checkValidity()) return; // Le navigateur signale lui-même le champ manquant.
      evenement.preventDefault();
      actualiserOrigine();
      const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]');
      const afficher = afficherEtat;
      if (!new FormData(formulaire).get('cf-turnstile-response')) {
        afficher('Terminez la vérification anti-abus avant l’envoi, ou écrivez-nous par courriel.', false);
        return;
      }
      if (bouton) bouton.disabled = true;
      try {
        const reponse = await fetch(formulaire.action, {
          method: 'POST', headers: { accept: 'application/json' }, body: new FormData(formulaire),
        });
        const corps = await reponse.json().catch(() => ({ ok: false, code: 'illisible' }));
        if (corps.ok) {
          formulaire.reset();
          actualiserOrigine();
          afficher('Message envoyé. Nous vous répondons par courriel, sans envoi automatique.', true);
        } else {
          afficher((MESSAGES_CONTACT as Record<string, string>)[corps.code] ?? MESSAGE_CONTACT_DEFAUT, false);
          renouvelerVerification();
          if (bouton) bouton.disabled = false;
        }
      } catch {
        afficher('Le réseau n’a pas répondu. Réessayez, ou écrivez-nous par courriel.', false);
        renouvelerVerification();
        if (bouton) bouton.disabled = false;
      }
    });
  }
</script>

<style>
  /*
   * Système de page : l'en-tête de la section porte le titre ; dessous, le formulaire sur son
   * plateau et, à côté dès 64 rem, ce qu'il est utile de préparer (un titre de bloc, des lignes à
   * pictogramme, une mention). Dans cette colonne, dès 64 rem, les lignes s'empilent : elle est
   * trop étroite pour le tiers et les deux tiers.
   */
  .contact-grille { display: grid; gap: var(--bloc-ecart); }
  .contact-form { display: grid; gap: 20px; padding: var(--carte-marge); border: 1px solid var(--ligne); border-radius: var(--r-carte); background: var(--surface-feuille); box-shadow: var(--ombre-xs); }
  .champ { display: grid; gap: 8px; }
  .champ label { font-weight: 500; color: var(--texte-fort); }
  .champ input[type='text'], .champ input[type='email'], .champ textarea {
    width: 100%; min-height: 48px; padding: 12px 14px; font: inherit; color: var(--texte-fort);
    border: 1px solid var(--ligne-forte); border-radius: var(--r-bouton); background: var(--blanc);
  }
  .champ textarea { resize: vertical; line-height: 1.5; }
  .champ input:focus-visible, .champ textarea:focus-visible { outline: 2.5px solid var(--focus); outline-offset: 2px; }
  .champ-aide { margin: 0; font-size: var(--t-sm); }
  .champ-consentement { grid-template-columns: 24px minmax(0, 1fr); align-items: start; gap: 12px; }
  .champ-consentement input { width: 20px; height: 20px; margin-top: 3px; accent-color: var(--vert-appui); }
  .champ-consentement label { font-weight: 400; color: var(--texte); font-size: var(--t-sm); line-height: 1.5; }
  /* Le champ piège n'existe pas pour une personne : hors écran, hors lecteur d'écran, hors tabulation. */
  .champ-piege { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .contact-etat { margin: 0; padding: 12px 14px; border-radius: var(--r-bouton); font-size: var(--t-sm); }
  .contact-etat[data-ok='oui'] { color: var(--vert-texte); background: var(--vert-voile); }
  .contact-etat[data-ok='non'] { color: var(--rouge); background: var(--rouge-voile); }
  .contact-envoi { display: flex; }
  .contact-aside { display: grid; gap: var(--tete-ecart); align-content: start; }
  .contact-aside h3 { font-size: var(--titre-bloc); line-height: 1.2; }
  .contact-aside > p { margin: 0; }
  .contact-lignes { margin-top: var(--espace-2); }
  @media (min-width: 48rem) { .contact-form { padding: var(--carte-marge-lg); } }
  @media (min-width: 64rem) {
    .contact-grille { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--espace-16); align-items: start; }
    .contact-aside { position: sticky; top: calc(var(--nav-h) + 32px); }
    .contact-lignes .ligne { grid-template-columns: minmax(0, 1fr); }
    .contact-lignes .ligne > :first-child { padding-right: 0; }
  }
</style>
