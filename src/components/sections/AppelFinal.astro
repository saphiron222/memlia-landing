---
import Button from '@/components/Button.astro';
import Picto from '@/components/Picto.astro';

import { CTA } from '@/data/site.mjs';

/**
 * S8 — Appel final (spec §4.13 ; copy validée section 7). Un seul bouton principal,
 * le CTA humain en secondaire. Fond IMG-02 décoratif, texte au-dessus d'un voile crème
 * pour tenir le contraste quel que soit le visuel livré.
 */
/**
 * Le même bloc sert les pages commerciales, avec leur propre titre et leurs points :
 * un seul composant pour que l'appel final ait partout la même forme.
 */
interface Props {
  id?: string;
  titre?: string;
  texte?: string;
  points?: string[];
  action?: { libelle: string; href: string };
  secondaire?: { libelle: string; href: string };
}
const {
  id = 'evaluer',
  titre = 'Quelle tâche vos collaborateurs refont-ils encore à la main ?',
  texte = 'Décrivez-la en trois phrases. Nous vous disons si elle se cadre, ce qu’il faudrait pour la prendre en charge, et à quel prix. Vous n’avez rien à nous envoyer : la description suffit.',
  points = [
    'La tâche : ce que quelqu’un refait chaque mois, et avec quels outils.',
    'Le périmètre : sources, exceptions, cas de refus.',
    'Le devis : à la complexité, jamais au nombre de postes.',
  ],
  action = CTA.principal,
  secondaire,
} = Astro.props;
---

<section
  id={id}
  class="appel"
  data-service-section={id === 'confier' ? 'appel' : undefined}
  data-tool-section={id === 'outil-confier' ? 'appel' : undefined}
  aria-labelledby={`${id}-titre`}
>
  {id === 'evaluer' && <span id="demo" aria-hidden="true"></span>}

  <div class="appel-int coins rv">
    <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
    <h2 id={`${id}-titre`} class="appel-h2">{titre}</h2>
    <p class="texte-2 appel-texte">{texte}</p>
    <ul class="appel-cadrage">
      {points.map((c) => (
        <li><Picto nom="coche" taille={14} /><span>{c}</span></li>
      ))}
    </ul>
    <div class="appel-boutons">
      <Button href={action.href} variante="principal" picto="fleche">{action.libelle}</Button>
      {secondaire && (
        <Fragment>
          {secondaire.href.startsWith('mailto:') && <Fragment set:html={`<!--email_off-->`} />}
          <Button href={secondaire.href} variante="contour">{secondaire.libelle}</Button>
          {secondaire.href.startsWith('mailto:') && <Fragment set:html={`<!--/email_off-->`} />}
        </Fragment>
      )}
    </div>
  </div>
</section>

<style>
  .appel {
    position: relative;
    padding: 128px var(--marge-page) 96px;
    overflow: hidden;
    isolation: isolate;
  }
  .appel-fond {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
    mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent);
  }
  .appel-fond :global(picture),
  .appel-fond :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .appel-int {
    display: grid;
    gap: 16px;
    justify-items: center;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px;
    border: 1px solid var(--ligne);
    border-radius: var(--r-carte);
    background: rgba(255, 254, 251, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--ombre-xs);
  }
  .appel-h2 {
    font-size: var(--t-4xl);
    max-width: 22ch;
  }
  .appel-texte {
    max-width: 52ch;
  }
  .appel-cadrage {
    display: grid;
    gap: 8px;
    margin-top: 4px;
    font-size: var(--t-sm);
    color: var(--texte-2);
    text-align: left;
  }
  .appel-cadrage li {
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
  }
  .appel-cadrage svg {
    flex: 0 0 auto;
    margin-top: 0.3em;
    color: var(--accent-appui);
  }
  .appel-boutons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 12px;
  }
  @media (max-width: 24.99rem) {
    .appel-boutons {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
  @media (min-width: 64rem) {
    .appel {
      padding: 176px var(--marge-page-lg) 144px;
    }
    .appel-int {
      padding: 64px 72px;
    }
  }
</style>
