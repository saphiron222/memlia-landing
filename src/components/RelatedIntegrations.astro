---
import IntegrationCards from '@/components/sections/IntegrationCards.astro';
import { integrationsForService } from '@/data/integrations';

interface Props { servicePath: string; }
const { servicePath } = Astro.props;
const integrations = integrationsForService(servicePath);
const titleId = `rayons-${servicePath.replaceAll('/', '-')}`;
---

{integrations.length > 0 && (
  <aside class="rayons" aria-labelledby={titleId}>
    <div class="rayons-tete">
      <p class="surtitre">Guides par environnement</p>
      <h2 id={titleId}>La même frontière, dans l’outil du cabinet</h2>
      <p>Chaque guide situe la tâche dans un environnement précis : le repère utile, la limite de la documentation et le point où le cabinet doit décider.</p>
    </div>
    <IntegrationCards integrations={integrations} compact />
    <a class="rayons-hub" href="/integrations">Voir les neuf guides par environnement<span aria-hidden="true"> →</span></a>
  </aside>
)}

<style>
  .rayons { padding: 96px var(--marge-page) 0; }
  .rayons-tete { display: grid; gap: 12px; max-width: 760px; }
  .rayons-tete h2 { font-size: var(--t-4xl); text-wrap: balance; }
  .rayons-tete p:last-child { max-width: 64ch; color: var(--texte-2); text-wrap: pretty; }
  .surtitre { color: var(--accent-texte); font-size: var(--t-sm); font-weight: 600; }
  .rayons :global(.cartes) { margin-top: 28px; }
  .rayons-hub { display: inline-flex; align-items: center; min-height: 44px; margin-top: 24px; color: var(--accent-texte); font-weight: 600; }
  @media (min-width: 64rem) { .rayons { padding: 128px var(--marge-page-lg) 0; } }
</style>
