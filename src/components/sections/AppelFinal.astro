---
import Button from '@/components/Button.astro';
import Insecable from '@/components/Insecable.astro';
import Picto from '@/components/Picto.astro';

import { CTA } from '@/data/site.mjs';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';

/**
 * S8 — Appel final (spec §4.13 ; copy validée section 7). Un seul bouton principal,
 * le CTA humain en secondaire. Un encadré crème sur la feuille, sans image de fond.
 */
/**
 * Le même bloc sert les pages commerciales, avec leur propre titre et leurs points :
 * un seul composant pour que l'appel final ait partout la même forme.
 */
interface Props {
  contenu?: ContenuAccueil['appelFinal'];
  id?: string;
  titre?: string;
  texte?: string;
  points?: string[];
  action?: { libelle: string; href: string };
  secondaire?: { libelle: string; href: string };
}
const {
  contenu = contenuDe('ec').appelFinal,
  id = 'evaluer',
  titre = contenu.titre,
  texte = contenu.texte,
  points = contenu.points,
  action = CTA.principal,
  secondaire,
} = Astro.props;
---

<section
  id={id}
  class="appel"
  data-service-section={id === 'confier' ? 'appel' : undefined}
  data-tool-section={id === 'outil-confier' ? 'appel' : undefined}
  aria-labelledby={`${id}-titre`}
>
  {id === 'evaluer' && <span id="demo" aria-hidden="true"></span>}

  <div class="appel-int coins rv">
    <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
    <h2 id={`${id}-titre`} class="appel-h2"><Insecable texte={titre} /></h2>
    <p class="texte-2 appel-texte">{texte}</p>
    {points.length > 0 && (
      <ul class="appel-cadrage">
        {points.map((c) => (
          <li><Picto nom="coche" taille={14} /><span>{c}</span></li>
        ))}
      </ul>
    )}
    <div class="appel-boutons">
      <Button href={action.href} variante="principal" picto="fleche">{action.libelle}</Button>
      {secondaire && (
        <Fragment>
          {secondaire.href.startsWith('mailto:') && <Fragment set:html={`<!--email_off-->`} />}
          <Button href={secondaire.href} variante="contour">{secondaire.libelle}</Button>
          {secondaire.href.startsWith('mailto:') && <Fragment set:html={`<!--/email_off-->`} />}
        </Fragment>
      )}
    </div>
  </div>
</section>

<style>
  /* Système de page : l'appel final prend le pas des sections au-dessus et au-dessous (aucun vide
     propre), et le titre de section. C'est, avec le héros de l'accueil, le seul bloc centré. */
  .appel {
    position: relative;
    padding: var(--section-espace) var(--marge-page);
    overflow: hidden;
    isolation: isolate;
  }
  .appel-int {
    display: grid;
    gap: var(--tete-ecart);
    justify-items: center;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px;
    border: 1px solid var(--ligne);
    border-radius: var(--r-carte);
    background: var(--surface-feuille);
    box-shadow: var(--ombre-xs);
  }
  .appel-h2 {
    font-size: var(--titre-section);
    max-width: 24ch;
  }
  .appel-texte {
    max-width: 52ch;
  }
  .appel-cadrage {
    display: grid;
    gap: 8px;
    margin-top: 4px;
    font-size: var(--t-sm);
    color: var(--texte-2);
    text-align: left;
  }
  .appel-cadrage li {
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
  }
  .appel-cadrage svg {
    flex: 0 0 auto;
    margin-top: 0.3em;
    color: var(--accent-appui);
  }
  .appel-boutons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 12px;
  }
  @media (max-width: 24.99rem) {
    .appel-boutons {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
  @media (min-width: 64rem) {
    .appel {
      padding-inline: var(--marge-page-lg);
    }
    .appel-int {
      padding: 64px 72px;
    }
  }
</style>
