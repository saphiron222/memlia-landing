---
import Picto from '@/components/Picto.astro';
import { integrationPath, integrationsForService } from '@/data/integrations';

/**
 * Guides par environnement d'une page (hub, service). Système de page : des destinations nommées
 * par leur titre, donc une liste de liens, titrée par son libellé (titre, éditeur et produit
 * dessous, « Lire le guide » et la flèche au bout), jamais une carte seule ; puis le lien d'action
 * vers les neuf guides. Le libellé titre la liste plutôt qu'un surtitre : au plus un surtitre pour
 * trois sections.
 */
interface Props { servicePath: string; }
const { servicePath } = Astro.props;
const integrations = integrationsForService(servicePath);
const titleId = `rayons-${servicePath.replaceAll('/', '-')}`;
const titre = (requete: string) => requete.charAt(0).toUpperCase() + requete.slice(1);
---

{integrations.length > 0 && (
  <aside class="rayons pile" aria-labelledby={titleId}>
    <div class="tete rv">
      <h2 id={titleId}>La même frontière, dans l’outil du cabinet</h2>
      <p>Chaque guide situe la tâche dans un environnement précis : le repère utile, la limite de la documentation et le point où le cabinet doit décider.</p>
    </div>
    <div class="liens-bloc">
      <p class="liens-titre">Guides par environnement</p>
      <ul class="liens" data-integration-links>
        {integrations.map((integration) => (
          <li>
            <a class="lien-rangee" href={integrationPath(integration)}>
              <span class="lien-libelle">{titre(integration.primaryQuery)}<span class="lien-detail">{integration.vendor} · {integration.product}</span></span>
              <span class="lien-suite">Lire le guide</span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a class="lien-action" href="/integrations">Voir les neuf guides par environnement<Picto nom="fleche" taille={14} /></a>
  </aside>
)}

<style>
  /* Au pas des sections du système de page ; les formes viennent de global.css. */
  .rayons { padding: var(--section-espace) var(--marge-page) 0; }
  @media (min-width: 64rem) { .rayons { padding-inline: var(--marge-page-lg); } }
</style>
