---
import Picto from '@/components/Picto.astro';

const garanties = [
  {
    picto: 'main' as const,
    titre: 'Sans compte ni adresse e-mail',
    texte: 'L’outil est accessible gratuitement. Aucun mur d’inscription ne précède le résultat.',
    href: '#outil-faq-gratuit',
  },
  {
    picto: 'bouclier' as const,
    titre: 'Aucune connexion sortante',
    texte: 'La politique de sécurité publique de la page bloque les connexions réseau pendant le calcul.',
    href: '#outil-faq-local',
  },
  {
    picto: 'limites' as const,
    titre: 'Les limites avant le résultat',
    texte: 'La règle couverte, la source datée et les cas refusés restent lisibles sur la page.',
    href: '#limites-titre',
  },
];
---

<section class="outil-garanties" data-tool-section="garanties" aria-labelledby="outil-garanties-titre">
  <div class="conteneur outil-garanties-inner">
    <div class="outil-garanties-heading rv">
      <h2 id="outil-garanties-titre">Trois garanties vérifiables avant de saisir une valeur.</h2>
    </div>
    <ul class="outil-garanties-grid rv-groupe">
      {garanties.map((garantie) => (
        <li class="outil-garantie rv">
          <a href={garantie.href}>
            <span class="outil-garantie-icon" aria-hidden="true"><Picto nom={garantie.picto} taille={24} /></span>
            <h3>{garantie.titre}</h3>
            <p>{garantie.texte}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .outil-garanties {
    border-bottom: 1px solid var(--ligne-douce);
    background: var(--surface-feuille);
  }
  .outil-garanties-inner {
    display: grid;
    gap: 40px;
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .outil-garanties-heading {
    max-width: 720px;
  }
  .outil-garanties-grid {
    display: grid;
    gap: 1px;
    border-block: 1px solid var(--ligne);
    background: var(--ligne);
  }
  .outil-garantie {
    background: var(--surface-feuille);
  }
  .outil-garantie a {
    display: grid;
    align-content: start;
    gap: 12px;
    height: 100%;
    min-height: 100%;
    padding: 32px 24px 40px;
    transition: background-color var(--duree-1) var(--courbe-standard);
  }
  .outil-garantie-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 8px;
    border: 1px solid var(--ligne-douce);
    border-radius: var(--r-boite);
    color: var(--accent-texte);
    background: var(--surface-page);
    transition: border-color var(--duree-1) var(--courbe-standard), color var(--duree-1) var(--courbe-standard);
  }
  .outil-garantie h3 {
    font-size: var(--t-2xl);
  }
  .outil-garantie p {
    max-width: 38ch;
    color: var(--texte-2);
  }
  @media (hover: hover) {
    .outil-garantie a:hover {
      background: var(--surface-hover);
    }
    .outil-garantie a:hover .outil-garantie-icon {
      border-color: var(--accent-appui);
      color: var(--texte-fort);
    }
  }
  @media (min-width: 48rem) {
    .outil-garanties-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .outil-garantie a {
      padding: 40px 32px 48px;
    }
  }
  @media (min-width: 64rem) {
    .outil-garanties-inner {
      gap: 56px;
      padding-top: 112px;
      padding-bottom: 112px;
    }
  }
</style>
