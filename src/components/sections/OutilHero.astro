---
import ProofMedia from '@/components/ProofMedia.astro';
import Button from '@/components/Button.astro';
import Insecable from '@/components/Insecable.astro';
import type { ProofId } from '@/data/proofs';

interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  proof?: ProofId;
  breadcrumbs: readonly Crumb[];
  eyebrow?: string;
  titleId: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { title, description, proof, breadcrumbs, eyebrow, titleId, ctaHref, ctaLabel } = Astro.props;
/*
 * Héros partagé du système de page (docs/design/2026-10-07-systeme-de-page.md, § 1), comme les
 * services : surtitre, titre, chapeau et un bouton principal à gauche ; la preuve dans le cadre
 * unique à droite dès 1 024 px, dessous avant. Sans preuve, la pile de texte reste seule.
 */
---

<section class="outil-hero" data-tool-section="hero" aria-labelledby={titleId}>
  <div class="conteneur outil-hero-inner">
    <nav class="ariane" aria-label="Fil d’Ariane">
      <ol>
        {breadcrumbs.map((crumb, index) => (
          <li aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>
            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : crumb.label}
          </li>
        ))}
      </ol>
    </nav>
    <div class:list={["outil-hero-grid", { "sans-visuel": !proof }]}>
      <header class="outil-hero-copy">
        {eyebrow && <span class="surtitre">{eyebrow}</span>}
        <h1 id={titleId}><Insecable texte={title} /></h1>
        <p>{description}</p>
        {ctaHref && ctaLabel && <Button href={ctaHref} variante="principal" picto="fleche">{ctaLabel}</Button>}
      </header>
      {proof && (
        <div class="outil-hero-visual" data-tool-media>
          <ProofMedia id={proof} priority cadre />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .outil-hero-inner { padding-top: 28px; }
  .ariane ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; font-size: var(--t-sm); color: var(--texte-2); }
  .ariane li + li::before { content: '›'; margin-right: 6px; color: var(--picto-repos); }
  .ariane a { color: var(--texte-2); text-decoration: underline; text-underline-offset: 2px; }
  .ariane [aria-current] { min-width: 0; color: var(--texte); overflow-wrap: anywhere; }
  .outil-hero-grid { display: grid; gap: var(--bloc-ecart); align-items: center; padding-top: var(--bloc-ecart); }
  .outil-hero-copy { display: grid; justify-items: start; gap: 20px; min-width: 0; }
  .outil-hero-copy h1 { max-width: 21ch; font-size: var(--titre-page-partage); line-height: 1.08; animation: outil-copy-entry var(--duree-entree) var(--courbe-sortie) both; }
  .outil-hero-copy p { max-width: 62ch; margin: 0; color: var(--texte-2); font-size: var(--t-lg); line-height: 1.55; animation: outil-copy-entry var(--duree-entree) var(--courbe-sortie) 100ms both; }
  .outil-hero-copy :global(.btn) { animation: outil-copy-entry var(--duree-entree) var(--courbe-sortie) 180ms both; }
  .outil-hero-visual { min-width: 0; animation: outil-proof-reveal var(--duree-revelation) var(--courbe-douce) both; }
  @keyframes outil-copy-entry { from { opacity: 0; transform: translateY(15px) scale(0.98); filter: blur(7px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes outil-proof-reveal { from { opacity: 0; transform: scale(0.98); filter: blur(6px) grayscale(1); } to { opacity: 1; transform: none; filter: none; } }
  @media (prefers-reduced-motion: reduce) {
    .outil-hero-copy h1,
    .outil-hero-copy p,
    .outil-hero-copy :global(.btn),
    .outil-hero-visual {
      animation: none;
    }
  }
  @media (min-width: 64rem) {
    .outil-hero-inner { padding-top: 32px; }
    .outil-hero-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--rangee-gouttiere); padding-top: 64px; }
    .outil-hero-grid.sans-visuel { grid-template-columns: minmax(0, 720px); }
  }
</style>
