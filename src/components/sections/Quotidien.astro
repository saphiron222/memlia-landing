---
import Insecable from '@/components/Insecable.astro';
import BlocEditorial from '@/components/editorial/BlocEditorial.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
import type {SceneId} from '@/data/scenes-figurines';
interface Props { contenu?: ContenuAccueil['quotidien']; scene?:SceneId; }
const { contenu = contenuDe('ec').quotidien, scene='accueil' } = Astro.props;
/** Recette A du 15/10/2026 : contenu et ancres conservés, cadres commerciaux retirés. */
---
<section class="section daily" aria-labelledby="daily-title">
  <div class="conteneur pile">
    <BlocEditorial scene={scene}>
      <div class="tete rv">
        <h2 id="daily-title"><Insecable texte={contenu.titre} /></h2>
        <p>{contenu.texte}</p>
      </div>
    </BlocEditorial>
    <dl class="lignes rv">
      {contenu.points.map((p, i) => <Fragment>{i > 0 && ' '}<div class="ligne"><dt class="ligne-libelle">{p.titre}</dt><dd class="ligne-texte">{p.texte}</dd></div></Fragment>)}
    </dl>
    <p class="daily-note mention">{contenu.note}</p>
  </div>
</section>
