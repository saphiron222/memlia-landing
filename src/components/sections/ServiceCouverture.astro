---
import Picto from '@/components/Picto.astro';
import { couvertureDe } from '@/data/couverture-logiciels.mjs';

/*
 * Sous le héros d'une page service : ce que le logiciel du cabinet fait déjà, puis ce qui reste à
 * la main. Le nom de l'éditeur porte le lien vers sa page : une source se cite dans le texte, jamais
 * dans une section « Sources » (Kevin, 06/10/2026). La date de lecture reste un contrôle interne.
 * Une tâche que l'outil du cabinet couvre ne se présente jamais comme un gain (règle du 06/10/2026).
 */

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const couverture = couvertureDe(slug);
---

{couverture && (
  <section class="service-couverture" data-service-section="couverture" aria-labelledby="service-couverture-title">
    <div class="conteneur service-couverture-inner">
      <div class="service-couverture-heading rv">
        <span class="eyebrow">Avant de nous confier cette tâche</span>
        <h2 id="service-couverture-title">Ce que votre logiciel fait déjà</h2>
        <p>Si votre outil fait déjà ce geste, nous ne le refaisons pas. Nous partons de ce qu’il laisse.</p>
      </div>
      <div class="service-couverture-grid">
        <ul class="cartes service-couverture-outils rv-groupe">
          {couverture.dejaFait.map((geste) => (
            <li class="carte rv">
              <p class="carte-texte"><a href={geste.source.url} rel="noopener noreferrer" title={geste.source.libelle}>{geste.outil}</a> {geste.geste}.</p>
            </li>
          ))}
        </ul>
        <div class="carte service-couverture-reste rv">
          <span class="carte-icone" aria-hidden="true"><Picto nom="main" taille={24} /></span>
          <div class="carte-corps">
            <h3 class="carte-titre">Ce qui reste à la main, et que nous prenons</h3>
            <ul class="carte-texte">
              {couverture.reste.map((ligne) => <li>{ligne}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .service-couverture {
    padding: 72px 0;
    border-bottom: 1px solid var(--ligne);
    background: var(--surface-page);
  }
  .service-couverture-inner {
    display: grid;
    gap: 40px;
  }
  .service-couverture-heading {
    display: grid;
    gap: 12px;
    max-width: 62ch;
  }
  .service-couverture-heading h2 {
    font-size: var(--t-4xl);
  }
  .service-couverture-grid {
    display: grid;
    gap: 32px;
  }
  /* Ce que fait déjà chaque logiciel : une carte du site par éditeur (global.css). */
  .service-couverture-outils a {
    color: var(--accent-texte);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* Ce qui reste à la main : une carte du site elle aussi, à côté de celles des logiciels. */
  .service-couverture-reste ul {
    display: grid;
    gap: 8px;
    padding-left: 20px;
    list-style: disc;
  }
  @media (min-width: 900px) {
    .service-couverture-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
