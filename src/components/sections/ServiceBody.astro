---
import ProofMedia from '@/components/ProofMedia.astro';
import { PROOFS, type ProofId } from '@/data/proofs';

interface Props {
  proof: ProofId;
}

const { proof } = Astro.props;
const media = PROOFS[proof];
---

<section class="service-body" data-service-section="body" data-service-sections aria-label="Périmètre de la mission">
  <div class="service-body-grid conteneur">
    <aside class="service-body-proof rv" data-service-media aria-labelledby="service-proof-title">
      <div class="service-body-frame coins">
        <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
        <ProofMedia id={proof} />
      </div>
      <div class="service-body-proof-copy">
        <span class="eyebrow">preuve fonctionnelle fictive</span>
        <h2 id="service-proof-title">{media.title}</h2>
        <p>{media.detail}</p>
      </div>
    </aside>

    <div class="service-body-copy lecture rv">
      <slot />
    </div>
  </div>
</section>

<style>
  .service-body {
    padding: 96px 0;
    border-bottom: 1px solid var(--ligne-douce);
    background: var(--surface-feuille);
  }
  .service-body-grid {
    display: grid;
    gap: 56px;
  }
  .service-body-proof {
    display: grid;
    align-content: start;
    gap: 24px;
    min-width: 0;
  }
  .service-body-frame {
    padding: 12px;
    border: 1px solid var(--ligne);
    border-radius: var(--r-cadre);
    background: var(--surface-page);
    box-shadow: var(--ombre-xs);
  }
  .service-body-frame :global(figure) {
    overflow: hidden;
    border: 1px solid var(--ligne-douce);
    border-radius: var(--r-ecran);
  }
  .service-body-proof-copy {
    display: grid;
    gap: 12px;
  }
  .service-body-proof-copy h2 {
    max-width: 22ch;
    font-size: var(--t-3xl);
  }
  .service-body-proof-copy p {
    max-width: 58ch;
    color: var(--texte-2);
  }
  .service-body-copy {
    min-width: 0;
    max-width: none;
  }
  .service-body-copy :global(h2) {
    margin: 0;
    padding-top: 56px;
    border-top: 1px solid var(--ligne-douce);
    font-size: var(--t-4xl);
    line-height: 1.12;
  }
  .service-body-copy :global(h2:first-child) {
    padding-top: 0;
    border-top: 0;
  }
  .service-body-copy :global(h2:not(:first-child)) {
    margin-top: 64px;
  }
  .service-body-copy :global(h3) {
    margin: 40px 0 12px;
    font-size: var(--t-2xl);
  }
  .service-body-copy :global(p) {
    margin: 18px 0 0;
    color: var(--texte);
  }
  .service-body-copy :global(ul),
  .service-body-copy :global(ol) {
    margin: 20px 0 0;
    padding-left: 1.3em;
  }
  .service-body-copy :global(ul) { list-style: disc; }
  .service-body-copy :global(ol) { list-style: decimal; }
  .service-body-copy :global(li) { margin: 0.5em 0; }
  .service-body-copy :global(a) {
    color: var(--accent-texte);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .service-body-copy :global(strong) {
    color: var(--texte-fort);
    font-weight: 600;
  }
  .service-body-copy :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 28px 0 0;
    overflow-x: auto;
    border-top: 1px solid var(--ligne);
    border-bottom: 1px solid var(--ligne);
    border-collapse: collapse;
    font-size: var(--t-sm);
  }
  .service-body-copy :global(thead),
  .service-body-copy :global(tbody) {
    display: table;
    min-width: 560px;
    width: 100%;
    table-layout: fixed;
  }
  .service-body-copy :global(th),
  .service-body-copy :global(td) {
    width: 33.333%;
    padding: 14px 12px;
    border-bottom: 1px solid var(--ligne-douce);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .service-body-copy :global(th) {
    color: var(--texte-fort);
    font-weight: 600;
    background: var(--surface-page);
  }
  @media (min-width: 64rem) {
    .service-body {
      padding: 128px 0;
    }
    .service-body-grid {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: 80px;
      align-items: start;
    }
    .service-body-proof {
      position: sticky;
      top: calc(var(--nav-h) + 32px);
    }
  }
</style>
