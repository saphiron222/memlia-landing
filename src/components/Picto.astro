---
/**
 * Pictogrammes maison — tracés au trait 1,5 sur une grille 24 px, monochromes,
 * hérités de `currentColor`. Aucun asset tiers.
 */
export type NomPicto =
  | 'fleche'
  | 'chevron'
  | 'coche'
  | 'main'
  | 'fictif'
  | 'bouclier'
  | 'excel'
  | 'stop'
  | 'agregat'
  | 'panneau'
  | 'regle'
  | 'limites'
  | 'code'
  | 'recette'
  | 'menu'
  | 'fermer'
  | 'gauche'
  | 'droite'
  | 'feuilles'
  | 'grille'
  | 'flux'
  | 'salaires'
  | 'complexite';

interface Props {
  nom: NomPicto;
  taille?: number;
  class?: string;
}
const { nom, taille = 24, class: className, ...rest } = Astro.props;

const TRACES: Record<NomPicto, string> = {
  fleche: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  coche: '<path d="m5 12 4 4 10-10"/>',
  main: '<path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12"/><path d="M11 11.5V4.5a1.5 1.5 0 0 1 3 0V12"/><path d="M14 11.5V6.5a1.5 1.5 0 0 1 3 0V13"/><path d="M17 12.5v-1a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-2a6 6 0 0 1-5-2.7L4.3 14a1.6 1.6 0 0 1 2.6-1.8L8 13.5"/>',
  fictif: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6M9 16h6"/><path d="M4 20 20 4" stroke-dasharray="2 2"/>',
  bouclier: '<path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6z"/><path d="m9 12 2 2 4-4"/>',
  excel: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M3 15h18M9 4v16M15 4v16"/>',
  stop: '<path d="M8 3h8l5 5v8l-5 5H8l-5-5V8z"/><path d="M12 8v5"/><path d="M12 16.5h.01"/>',
  agregat: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  panneau: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/><path d="M17 9h2M17 12h2"/>',
  regle: '<path d="M3 17 17 3l4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/>',
  limites: '<path d="M4 4v16M20 4v16"/><path d="M8 12h8"/><path d="m14 9 3 3-3 3M10 9l-3 3 3 3"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  recette: '<path d="M9 3h6l1 3H8z"/><rect x="5" y="6" width="14" height="15" rx="2"/><path d="m9 14 2 2 4-4"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  fermer: '<path d="M6 6l12 12M18 6 6 18"/>',
  gauche: '<path d="m15 6-6 6 6 6"/>',
  droite: '<path d="m9 6 6 6-6 6"/>',
  feuilles: '<rect x="7" y="3" width="13" height="15" rx="1.5"/><path d="M4 8v11.5A1.5 1.5 0 0 0 5.5 21H16"/>',
  grille: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  flux: '<path d="M4 7h10a4 4 0 0 1 0 8H8a4 4 0 0 0 0 8h12"/><path d="m17 4 3 3-3 3"/>',
  salaires: '<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9h.01M18 15h.01"/>',
  complexite: '<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7.5 7.5 11 16M16.5 7.5 13 16M8 6h8"/>',
};
---

<svg
  {...rest}
  class={className}
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={TRACES[nom]}
/>
