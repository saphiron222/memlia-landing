---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import OutilHero from '@/components/sections/OutilHero.astro';
import { SITE } from '@/data/site.mjs';
import { OUTILS_HUB_PATH, outilPath, type OutilDefinition } from '@/data/outils';

interface Props { outil: OutilDefinition }
const { outil } = Astro.props;
const path = outilPath(outil);
const url = `${SITE.url}${path}`;
const socialImage = outil.proof ? {
  url: `/proofs/v2/og/${outil.proof.slice(3)}.webp`, width: 1200, height: 630,
  alt: `Aperçu fictif — ${outil.h1}`,
} : undefined;
const csp = "default-src 'self'; base-uri 'self'; connect-src 'none'; font-src 'self'; form-action 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'";
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage', '@id': `${url}#page`, url, name: outil.h1, headline: outil.h1, description: outil.description,
      inLanguage: SITE.langue, mainEntity: { '@id': `${url}#application` },
    },
    {
      '@type': 'WebApplication', '@id': `${url}#application`, url, name: outil.h1,
      description: outil.description, applicationCategory: 'BusinessApplication', operatingSystem: 'Any',
      browserRequirements: 'JavaScript activé dans un navigateur récent', isAccessibleForFree: true,
    },
    {
      '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Outils comptables gratuits', item: `${SITE.url}${OUTILS_HUB_PATH}` },
        { '@type': 'ListItem', position: 3, name: outil.h1, item: url },
      ],
    },
  ],
};
---

<Base titre={outil.title} titreSocial={outil.h1} description={outil.description} chemin={path} noindex={outil.statut === 'temoin'} base="/" csp={csp} socialImage={socialImage}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />

  <div class="feuille outil-feuille">
    {outil.proof ? (
      <OutilHero
        title={outil.h1}
        description={outil.description}
        proof={outil.proof}
        titleId="outil-titre"
        breadcrumbs={[
          { label: 'Accueil', href: '/' },
          { label: 'Outils comptables gratuits', href: OUTILS_HUB_PATH },
          { label: outil.h1 },
        ]}
      />
    ) : (
      <section class="conteneur outil-tete" aria-labelledby="outil-titre">
        <nav class="ariane" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li><a href={OUTILS_HUB_PATH}>Outils comptables gratuits</a></li><li aria-current="page">{outil.h1}</li></ol></nav>
        <span class="pastille">Démonstration technique</span>
        <h1 id="outil-titre">{outil.h1}</h1>
        <p class="texte-2 lecture">{outil.description}</p>
      </section>
    )}
    <section class="conteneur outil-promesse-wrap" aria-label="Entrée et résultat attendus">
      <dl class="outil-promesse">
        <div><dt>Vous saisissez</dt><dd>{outil.promesse.entree}</dd></div>
        <div><dt>Vous obtenez</dt><dd>{outil.promesse.resultat}</dd></div>
      </dl>
    </section>

    <section class="conteneur outil-zone" aria-label="Zone de calcul">
      <div class="outil-calcul"><slot /></div>
      <aside class="outil-local" data-local-notice aria-labelledby="local-titre">
        <h2 id="local-titre">Ce qui reste dans votre navigateur</h2>
        <p>{outil.mentionLocale}</p>
        <p>Seul un clic volontaire vers « Confier une première tâche » change de page. Le chemin de cette page n’est conservé que si vous envoyez ensuite le formulaire avec votre consentement.</p>
      </aside>
    </section>

    <section class="conteneur outil-limites" aria-labelledby="limites-titre">
      <h2 id="limites-titre">Ce que cette page ne fait pas</h2>
      <ul>{outil.limites.map((limite) => <li>{limite}</li>)}</ul>
    </section>

    <section class="conteneur outil-source" aria-labelledby="source-titre" data-official-source>
      <h2 id="source-titre">Règle et source officielle</h2>
      <p>{outil.source.extrait}</p>
      <p class="texte-2"><a href={outil.source.url} rel={outil.source.url.startsWith('http') ? 'noopener' : undefined}>{outil.source.nom}</a> · vérifiée le {outil.source.verifieeLe}.</p>
      {outil.source.complement && (
        <p class="source-complement">
          {outil.source.complement.extrait}{' '}
          <a href={outil.source.complement.url} rel="noopener">{outil.source.complement.nom}</a>.
        </p>
      )}
    </section>

    <nav class="conteneur outil-liens" data-tool-links aria-label="Pour continuer">
      <a href={OUTILS_HUB_PATH}>Tous les outils comptables gratuits</a>
      {outil.articleExact && <a href={outil.articleExact}>Consulter la ressource associée</a>}
      <a href={outil.pageService}>Comprendre la méthode</a>
      <Button href={outil.cta} variante="principal" picto="fleche">Confier une première tâche</Button>
    </nav>
  </div>
</Base>

<style>
  .outil-feuille { padding-bottom: clamp(56px, 8vw, 104px); background: var(--surface-feuille); }
  .outil-tete { display: grid; justify-items: start; gap: 16px; max-width: 900px; padding-top: clamp(28px, 5vw, 64px); }
  .ariane ol { display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--t-sm); color: var(--texte-2); margin-bottom: 12px; }
  .ariane li + li::before { content: '›'; margin-right: 6px; color: var(--picto-repos); }
  .ariane a { color: var(--texte-2); text-decoration: underline; text-underline-offset: 2px; }
  .ariane [aria-current] { color: var(--texte); }
  .outil-tete h1 { max-width: 21ch; font-size: var(--t-5xl); }
  .outil-promesse-wrap { padding-top: 32px; }
  .outil-promesse { display: grid; width: 100%; border-block: 1px solid var(--ligne); }
  .outil-promesse div { display: grid; gap: 4px; padding: 20px 0; }
  .outil-promesse div + div { border-top: 1px solid var(--ligne); }
  .outil-promesse dt { color: var(--texte-2); font-size: var(--t-sm); font-weight: 600; }
  .outil-promesse dd { margin: 0; color: var(--texte-fort); }
  .outil-zone { display: grid; gap: 32px; align-items: start; margin-top: 48px; }
  .outil-calcul { min-width: 0; padding: clamp(20px, 4vw, 40px); border: 1px solid var(--ligne); border-radius: var(--r-carte); background: var(--surface-feuille); box-shadow: var(--ombre-xs); }
  .outil-local { display: grid; gap: 12px; align-content: start; padding: 24px; border-left: 3px solid var(--accent-appui); background: var(--accent-voile); }
  .outil-local h2 { font-size: var(--t-2xl); }
  .outil-local p { margin: 0; max-width: 58ch; color: var(--texte); }
  .outil-limites { display: grid; gap: 16px; max-width: 820px; margin-top: 64px; }
  .outil-limites h2 { font-size: var(--t-3xl); }
  .outil-limites ul { display: grid; gap: 10px; }
  .outil-limites li { position: relative; padding-left: 20px; color: var(--texte-2); }
  .outil-limites li::before { content: ''; position: absolute; top: 0.65em; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--accent-appui); }
  .outil-source { display: grid; gap: 12px; max-width: 820px; margin-top: 48px; padding: 24px; border: 1px solid var(--ligne); border-radius: var(--r-boite); background: var(--surface-page); }
  .outil-source h2 { font-size: var(--t-2xl); }
  .outil-source p { margin: 0; }
  .outil-source a { color: var(--accent-texte); text-decoration: underline; text-underline-offset: 3px; }
  .outil-liens { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--ligne-forte); }
  .outil-liens > a:not(.btn) { min-height: 44px; display: inline-flex; align-items: center; color: var(--accent-texte); text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 48rem) {
    .outil-promesse { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .outil-promesse div { padding: 20px 24px 20px 0; }
    .outil-promesse div + div { border-top: 0; border-left: 1px solid var(--ligne); padding-left: 24px; }
  }
  @media (min-width: 64rem) {
    .outil-zone { grid-template-columns: minmax(0, 7fr) minmax(280px, 5fr); gap: 48px; }
  }
</style>
