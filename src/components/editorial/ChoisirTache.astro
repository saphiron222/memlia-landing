---
import Carte from '@/components/catalogue/Carte.astro';
interface Props {cac?:boolean;titre?:string;}
const {cac=false,titre="Une première tâche, plusieurs façons de la confier."}=Astro.props;
const cartes=[
 {nom:'Un robot pour une routine',fonction:'Un déclencheur. Un résultat précis.',resume:'Collecter des avis, suivre une messagerie, classer des attestations : choisissez la tâche qui revient dans votre cabinet.',categorie:'La routine à confier',href:'/automatisation-cabinet-comptable',action:'Explorer les robots',nature:'Robots Memlia',image:{src:'/robots/cfe',alt:'',couleur:'#e4a277'}},
 {nom:'Un agent IA pour votre métier',fonction:cac?'Préparer le travail du mandat.':'Réunir les tâches d’un même métier.',resume:cac?'Préparer les pièces et les rapprochements, présenter les écarts. Vous choisissez les travaux et conservez vos conclusions.':'Organiser la préparation d’un dossier, rapprocher les informations et présenter les points qui demandent votre appréciation.',categorie:'Le métier à accompagner',href:'/methode#cadrer',action:'Construire votre agent IA',nature:'Agents IA Memlia',image:{src:`/illustrations/figurines/${cac?'aude':'balthazar'}`,alt:'',couleur:cac?'#c9b38f':'#a6ad8e'}},
 {nom:'Votre tâche sur mesure',fonction:'Partir du geste de votre équipe.',resume:'Votre besoin n’a pas encore sa fiche ? Nous observons le travail, écrivons sa règle et construisons le robot ou l’agent adapté.',categorie:'Le besoin à construire',href:'/contact',action:'Décrire votre tâche',nature:'Construit sur votre cabinet',image:{src:'/robots/habilitations-fiscales',alt:'',couleur:'#a8bdcf'}},
];
---
<section class="catalogue-section editorial-choix" aria-labelledby="choix-tache-titre"><div class="tete"><h2 id="choix-tache-titre">{titre}</h2><p>Nous prenons le travail en charge jusqu’à sa maintenance. La règle, les accès et les validations se définissent avec votre cabinet.</p></div><ul class="catalogue-grille">{cartes.map(c=><li><Carte {...c}/></li>)}</ul></section>
