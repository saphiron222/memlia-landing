---
import Base from '@/layouts/Base.astro';
import Picto from '@/components/Picto.astro';
import Figurine from '@/components/catalogue/Figurine.astro';
import Button from '@/components/Button.astro';
import { GROUPES_OUTILS, OUTILS_VITRINE } from '@/data/outils-vitrine';
import '@/styles/catalogue/commun.css';
import '@/styles/catalogue/hub.css';
import { SITE } from '@/data/site.mjs';
import { OUTILS_DISPONIBLES, OUTILS_HUB_PATH, outilPath } from '@/data/outils';

const h1 = 'Outils comptables gratuits : calculer, vérifier et préparer';
const title = `${h1} | Memlia`;
const description = 'Des outils gratuits pour calculer, contrôler ou préparer une tâche comptable. Chaque outil montre sa règle, sa source et ses limites, sans inscription.';
const url = `${SITE.url}${OUTILS_HUB_PATH}`;
const titreHub = (outil: (typeof OUTILS_DISPONIBLES)[number]) => outil.slug === 'suivi-circularisation'
  ? 'Suivi de circularisation : préparer les lettres et les retours'
  : outil.h1;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage', '@id': `${url}#page`, url, name: h1, headline: h1, description,
      inLanguage: SITE.langue, mainEntity: { '@id': `${url}#list` },
    },
    {
      '@type': 'ItemList', '@id': `${url}#list`, name: 'Outils comptables gratuits',
      numberOfItems: OUTILS_DISPONIBLES.length,
      itemListElement: OUTILS_VITRINE.map((outil, index) => ({
        '@type': 'ListItem', position: index + 1, name: titreHub(outil), url: `${SITE.url}${outilPath(outil)}`,
      })),
    },
    {
      '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Outils comptables gratuits', item: url },
      ],
    },
  ],
};
---

<Base titre={title} titreSocial={h1} description={description} chemin={OUTILS_HUB_PATH} socialImage={{url:`${SITE.url}/outils/social/hub.webp`,width:1200,height:630,alt:'Les outils gratuits Memlia pour préparer une consigne, un calcul ou un dossier.'}} schema={graph}>
<div class="feuille catalogue-page catalogue-hub outils-feuille">
<section class="hub-hero" data-tool-section="hero" aria-labelledby="outils-titre">
  <p class="surtitre">Les outils gratuits Memlia</p>
  <h1 id="outils-titre">Outils comptables gratuits : calculer, vérifier et préparer</h1>
  <p class="hub-intro">Un prompt à préparer, un calcul à faire, un fichier à vérifier. Choisissez votre outil et obtenez un résultat à relire.</p>
  <p class="outil-gratuit" data-gratuit>Gratuit, sans inscription.</p>
  <Button href="#catalogue-outils" variante="lien" picto="chevron">Choisir un outil</Button>
  <ul class="hub-trio" aria-hidden="true">{['comptabilite','informatique-outils','finance'].map(slug=><li><div class="hub-medaillon"><Figurine src={`/agents/${slug}`} taille={116} prioritaire/></div></li>)}</ul>
</section>
<section class="catalogue-section" id="catalogue-outils" aria-labelledby="catalogue-titre">
  <div class="tete hub-annuaire-tete"><h2 id="catalogue-titre">De quoi avez-vous besoin ?</h2><p class="hub-total">{OUTILS_VITRINE.length} outils gratuits</p></div>
  <fieldset class="hub-filtres"><legend class="sr-only">Filtrer les outils par besoin</legend>
    <label><input type="radio" name="besoin-outil" value="essentiels" checked/><span>Les essentiels <span>({OUTILS_VITRINE.filter(o=>o.essentiel).length})</span></span></label>
    <label><input type="radio" name="besoin-outil" value="tous"/><span>Tous <span>({OUTILS_VITRINE.length})</span></span></label>
    {GROUPES_OUTILS.map(g=><label><input type="radio" name="besoin-outil" value={g.id}/><span>{g.nom} <span>({OUTILS_VITRINE.filter(o=>o.groupe===g.id).length})</span></span></label>)}
  </fieldset>
  <ul class="catalogue-grille outils-grille">{OUTILS_VITRINE.map(o=><li data-outil-card data-besoin={o.groupe} data-essentiel={o.essentiel?"oui":"non"}>
    <a class="outil-carte" href={outilPath(o)}><span class="outil-icone"><Picto nom={o.picto} taille={24}/></span><span class="outil-groupe">{GROUPES_OUTILS.find(g=>g.id===o.groupe)!.nom}</span><h3>{o.nom}</h3><p class="carte-texte">{o.texte}</p><span class="catalogue-action">Utiliser l’outil<Picto nom="fleche" taille={14}/></span></a>
  </li>)}</ul>
</section>
<section class="catalogue-fin" id="hub-confier" aria-labelledby="confier-titre"><h2 id="confier-titre">Cette tâche revient chaque semaine ?</h2><p>Nos outils gratuits vous aident sur un besoin ponctuel. Pour une tâche récurrente, nous déployons et adaptons un robot ou un agent IA dans vos logiciels. Nous construisons aussi sur mesure.</p><div class="outils-catalogues"><a class="catalogue-action" href="/automatisation-cabinet-comptable">Explorer les robots<Picto nom="fleche" taille={14}/></a><a class="catalogue-action" href="/agents-ia">Rencontrer les agents IA<Picto nom="fleche" taille={14}/></a></div><Button href="/contact" variante="principal" picto="fleche">Confier une première tâche</Button></section>
</div></Base>
<style>
.outils-feuille .hub-hero{padding-top:40px;gap:16px}.outils-feuille .hub-trio{margin-top:8px;padding-bottom:0;gap:20px}.outils-feuille .hub-trio li,.outils-feuille .hub-medaillon{width:88px}.outils-feuille .hub-medaillon{height:88px}.outils-feuille .hub-trio li:nth-child(2){padding-top:12px}.outils-feuille #catalogue-outils{padding-top:48px}.outils-feuille .hub-hero h1{max-width:24ch}.outil-gratuit{color:var(--accent-texte);font-size:var(--t-sm);font-weight:600}.outil-carte{height:100%;display:flex;flex-direction:column;align-items:start;gap:16px;padding:28px;border:1px solid var(--ligne);border-radius:var(--r-carte);background:var(--surface-feuille);text-decoration:none;color:var(--texte);transition:border-color var(--duree-1),box-shadow var(--duree-1)}.outil-carte h3{font-size:var(--titre-bloc);line-height:1.2}.outil-carte p{color:var(--texte-2)}.outil-carte .catalogue-action{margin-top:auto}.outil-icone{color:var(--accent-texte);display:grid;place-items:center;width:48px;height:48px;background:var(--accent-voile);border-radius:14px}.outil-groupe{font-size:var(--t-xs);color:var(--texte-2)}.outils-catalogues{display:flex;flex-wrap:wrap;justify-content:center;gap:24px}.outil-carte:hover{border-color:var(--accent-appui);box-shadow:var(--ombre-xs)}
#catalogue-outils:has(input[value="essentiels"]:checked) [data-essentiel="non"],#catalogue-outils:has(input[value="ia"]:checked) [data-besoin]:not([data-besoin="ia"]),#catalogue-outils:has(input[value="calculs"]:checked) [data-besoin]:not([data-besoin="calculs"]),#catalogue-outils:has(input[value="dossiers"]:checked) [data-besoin]:not([data-besoin="dossiers"]){display:none}
</style>
