---
import ProofMedia from '@/components/ProofMedia.astro';
import type { ProofId } from '@/data/proofs';

interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  proof: ProofId;
  breadcrumbs: readonly Crumb[];
  eyebrow?: string;
  titleId: string;
}

const { title, description, proof, breadcrumbs, eyebrow, titleId } = Astro.props;
---

<section class="outil-hero" data-tool-section="hero" aria-labelledby={titleId}>
  <div class="conteneur outil-hero-inner">
    <nav class="ariane" aria-label="Fil d’Ariane">
      <ol>
        {breadcrumbs.map((crumb, index) => (
          <li aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>
            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : crumb.label}
          </li>
        ))}
      </ol>
    </nav>
    <div class="outil-hero-grid">
      <header class="outil-hero-copy">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 id={titleId}>{title}</h1>
        <p>{description}</p>
      </header>
      <div class="outil-hero-visual coins" data-tool-media>
        <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
        <div class="outil-hero-frame"><ProofMedia id={proof} /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .outil-hero { border-bottom: 1px solid var(--ligne-douce); background: var(--surface-feuille); }
  .outil-hero-inner { padding-top: 28px; padding-bottom: 64px; }
  .ariane ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; font-size: var(--t-sm); color: var(--texte-2); }
  .ariane li + li::before { content: '›'; margin-right: 6px; color: var(--picto-repos); }
  .ariane a { color: var(--texte-2); text-decoration: underline; text-underline-offset: 2px; }
  .ariane [aria-current] { min-width: 0; color: var(--texte); overflow-wrap: anywhere; }
  .outil-hero-grid { display: grid; gap: 40px; align-items: center; padding-top: 40px; }
  .outil-hero-copy { display: grid; justify-items: start; gap: 18px; min-width: 0; }
  .outil-hero-copy h1 { max-width: 21ch; font-size: var(--t-5xl); line-height: 1.08; animation: outil-copy-entry var(--duree-entree) var(--courbe-sortie) both; }
  .outil-hero-copy p { max-width: 62ch; margin: 0; color: var(--texte-2); font-size: var(--t-lg); line-height: 1.55; animation: outil-copy-entry var(--duree-entree) var(--courbe-sortie) 100ms both; }
  .outil-hero-visual { min-width: 0; padding: 16px; border: 1px solid var(--ligne); border-radius: var(--r-cadre); background: var(--surface-page); box-shadow: var(--ombre-xs); animation: outil-proof-reveal var(--duree-revelation) var(--courbe-douce) both; }
  .outil-hero-frame { overflow: hidden; border: 1px solid var(--ligne); border-radius: var(--r-ecran); background: var(--surface-feuille); }
  .outil-hero-frame :global(figure), .outil-hero-frame :global(img) { width: 100%; }
  @keyframes outil-copy-entry { from { opacity: 0; transform: translateY(15px) scale(0.98); filter: blur(7px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes outil-proof-reveal { from { opacity: 0; transform: scale(0.98); filter: blur(6px) grayscale(1); } to { opacity: 1; transform: none; filter: none; } }
  @media (min-width: 64rem) {
    .outil-hero-inner { padding-top: 32px; padding-bottom: 88px; }
    .outil-hero-grid { grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr); gap: 64px; padding-top: 56px; }
  }
</style>
