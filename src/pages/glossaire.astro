---
import Base from '@/layouts/Base.astro';
import AppelFinal from '@/components/sections/AppelFinal.astro';
import { CTA, SITE } from '@/data/site.mjs';
import { organizationNode } from '@/data/schema.mjs';
import { GLOSSARY_BY_ID, GLOSSARY_ENTRIES, GLOSSARY_SOURCES } from '@/data/glossary';

const title = 'Glossaire des tâches et contrôles du cabinet | Memlia';
const description = 'Glossaire comptable : des définitions directes, leur contexte d’usage et la limite entre préparation automatisable et décision professionnelle.';
const path = '/glossaire';
const headline = 'Glossaire des tâches et contrôles du cabinet.';
const url = `${SITE.url}${path}`;
const byLetter = new Map<string, typeof GLOSSARY_ENTRIES>();
for (const entry of GLOSSARY_ENTRIES) {
  const letter = entry.term.normalize('NFD').replace(/\p{Diacritic}/gu, '').charAt(0).toUpperCase();
  byLetter.set(letter, [...(byLetter.get(letter) ?? []), entry]);
}
const letters = [...byLetter.keys()];
// Décision de Kevin du 06/10/2026 : pas de bloc « Sources ». L'organisme externe qui établit la définition est cité
// entre parenthèses à sa fin, son nom portant le lien ; les renvois internes restent dans « Pour aller plus loin ».
// Chaque source externe garde son lien : un second document du même éditeur se nomme par son libellé court.
const citations = (sourceIds: string[]) => {
  const editeurs = new Set<string>();
  const urls = new Set<string>();
  return sourceIds.flatMap((sourceId) => {
    const source = GLOSSARY_SOURCES[sourceId];
    if (!source) throw new Error(`Source inconnue : ${sourceId}`);
    if (source.publisher === 'Memlia' || urls.has(source.url)) return [];
    urls.add(source.url);
    const editeur = source.publisher.split(' — ')[0];
    if (!editeurs.has(editeur)) {
      editeurs.add(editeur);
      return [{ sourceId, nom: editeur, url: source.url, titre: source.title }];
    }
    if (!source.libelleCourt) throw new Error(`Second document ${editeur} sans libellé court : ${sourceId}`);
    return [{ sourceId, nom: source.libelleCourt, url: source.url, titre: source.title }];
  });
};
type Citation = ReturnType<typeof citations>[number];
type LienSurMot = { mot: string; cite: Citation };
/** Le texte découpé autour du premier `mot` de chaque lien encore à poser ; `poses` retient ceux déjà posés. */
const segmenter = (texte: string, liens: LienSurMot[], poses: Set<string>): (string | LienSurMot)[] =>
  liens.reduce<(string | LienSurMot)[]>((morceaux, lien) => {
    if (poses.has(lien.mot)) return morceaux;
    const rang = morceaux.findIndex((morceau) => typeof morceau === 'string' && morceau.includes(lien.mot));
    if (rang === -1) return morceaux;
    const morceau = morceaux[rang] as string;
    const debut = morceau.indexOf(lien.mot);
    poses.add(lien.mot);
    return [...morceaux.slice(0, rang), morceau.slice(0, debut), lien, morceau.slice(debut + lien.mot.length), ...morceaux.slice(rang + 1)];
  }, [texte]);
// Les sources Memlia (méthode, articles) sont des renvois internes : elles rejoignent « Pour aller plus loin », sans
// doublon avec les renvois déjà écrits (revue de #166, 07/10/2026).
const liensInternes = (entry: (typeof GLOSSARY_ENTRIES)[number]) => {
  const memlia = entry.sourceIds
    .map((sourceId) => GLOSSARY_SOURCES[sourceId])
    .filter((source) => source?.publisher === 'Memlia')
    .map((source) => ({ label: source.title, href: source.url }));
  return [...entry.internalLinks, ...memlia.filter((lien) => !entry.internalLinks.some((existant) => existant.href === lien.href))];
};
// Une définition écrite par Memlia (« Dans ce glossaire, Memlia appelle… ») n'est pas celle de l'organisme cité :
// chaque source externe se pose sur le mot qu'elle établit (motsSources), jamais en parenthèse après une phrase maison.
type Entree = (typeof GLOSSARY_ENTRIES)[number];
const definitionMaison = (entry: Entree) => entry.nature === 'Éditoriale Memlia';
// Calculé ici et non dans le gabarit : `astro check` ne lit pas les annotations de type d'une expression du gabarit.
const corpsEntree = (entry: Entree) => {
  const cites = citations(entry.sourceIds);
  const maison = definitionMaison(entry);
  const mots: Partial<Record<string, string>> = ('motsSources' in entry && entry.motsSources) || {};
  const liens: LienSurMot[] = maison
    ? cites.flatMap((cite) => (mots[cite.sourceId] ? [{ mot: mots[cite.sourceId] as string, cite }] : []))
    : [];
  const enParentheses = cites.filter((cite) => !liens.some((lien) => lien.cite === cite));
  const poses = new Set<string>();
  const definition = segmenter(entry.definition, liens, poses);
  const contexte = segmenter(entry.context, liens, poses);
  const absent = liens.find((lien) => !poses.has(lien.mot));
  if (absent) throw new Error(`Glossaire ${entry.id} : « ${absent.mot} » introuvable dans la définition ou le contexte.`);
  if (maison && enParentheses.length > 0) throw new Error(`Glossaire ${entry.id} : source externe sans mot (motsSources) sur une définition maison.`);
  return { definition, contexte, parentheses: maison ? [] : enParentheses };
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage', '@id': `${url}#page`, url, name: title.replace(' | Memlia', ''), headline, description,
      inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': `${url}#term-set` },
    },
    {
      '@type': 'DefinedTermSet', '@id': `${url}#term-set`, url, name: 'Glossaire Memlia', description,
      hasDefinedTerm: GLOSSARY_ENTRIES.map((entry) => ({
        '@type': 'DefinedTerm', '@id': `${url}#${entry.anchor}`, name: entry.term,
        description: entry.definition, url: `${url}#${entry.anchor}`,
        inDefinedTermSet: { '@id': `${url}#term-set` },
      })),
    },
    {
      '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Glossaire', item: url },
      ],
    },
    organizationNode(),
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.nom, inLanguage: SITE.langue, publisher: { '@id': `${SITE.url}/#organization` } },
  ],
};
---

<Base titre={title} titreSocial={headline} description={description} chemin={path} base="/" schema={graph}>

  <div class="feuille glossaire-feuille">
    <section class="conteneur glossaire-tete" aria-labelledby="glossaire-titre">
      <nav class="ariane" aria-label="Fil d’Ariane">
        <ol>
          <li><a href="/">Accueil</a></li>
          <li aria-current="page">Glossaire</li>
        </ol>
      </nav>
      <h1 id="glossaire-titre">{headline}</h1>
      <p class="texte-2 lecture glossaire-intro">Retrouvez le sens d’un terme, un exemple fictif et la frontière entre ce qui se prépare et ce qui reste à décider au cabinet.</p>
    </section>

    <section class="conteneur glossaire-outils" aria-label="Accès aux termes">
      <div class="recherche" data-search hidden>
        <label for="recherche-terme">Rechercher un terme</label>
        <div class="recherche-ligne">
          <input id="recherche-terme" type="search" placeholder="Ex. DSN, contrôle, échéance" autocomplete="off" data-search-input />
          <button type="button" class="recherche-effacer" data-search-reset disabled>Effacer la recherche</button>
        </div>
        <p class="texte-2 recherche-resultat" data-result-count>{GLOSSARY_ENTRIES.length} termes</p>
        <p class="recherche-vide" data-empty hidden>Aucun terme ne correspond à cette recherche.</p>
      </div>

      <nav class="alphabet" aria-label="Index alphabétique">
        <ol>
          {letters.map((letter) => <li><a href={`#lettre-${letter.toLowerCase()}`}>{letter}</a></li>)}
        </ol>
      </nav>
    </section>

    <div class="conteneur glossaire-corps" data-glossary-list>
      {letters.map((letter) => (
        <section class="lettre" id={`lettre-${letter.toLowerCase()}`} data-lettre={letter} aria-labelledby={`titre-lettre-${letter.toLowerCase()}`}>
          <h2 id={`titre-lettre-${letter.toLowerCase()}`}>{letter}</h2>
          <dl>
            {byLetter.get(letter)?.map((entry) => (
              <div
                class="glossaire-entree"
                id={entry.anchor}
                data-definition={entry.definition}
                data-example-fictitious={entry.exampleFictitious}
                data-common-confusion={entry.commonConfusion}
                data-automation-boundary={entry.automationBoundary}
                data-searchable={`${entry.term} ${entry.definition} ${entry.context}`}
              >
                <dt><a href={`#${entry.anchor}`}>{entry.term}</a></dt>
                <dd>
                  {[corpsEntree(entry)].map((corps) => (
                    <>
                      <p class="definition">{corps.definition.map((morceau) => (typeof morceau === 'string' ? morceau : <a href={morceau.cite.url} rel="noopener noreferrer" title={morceau.cite.titre}>{morceau.mot}</a>))}{corps.parentheses.length > 0 && <> ({corps.parentheses.map((cite, index) => <>{index > 0 && ', '}<a href={cite.url} rel={cite.url.startsWith('http') ? 'noopener noreferrer' : undefined} title={cite.titre}>{cite.nom}</a></>)})</>}</p>
                      <p class="contexte">{corps.contexte.map((morceau) => (typeof morceau === 'string' ? morceau : <a href={morceau.cite.url} rel="noopener noreferrer" title={morceau.cite.titre}>{morceau.mot}</a>))}</p>
                    </>
                  ))}
                  <div class="entree-details">
                    <p><strong>Confusion fréquente</strong>{entry.commonConfusion}</p>
                    <p><strong>Exemple avec données fictives</strong>{entry.exampleFictitious}</p>
                    <p><strong>Ce qui reste à décider</strong>{entry.automationBoundary}</p>
                  </div>
                  <div class="entree-liens">
                    <div>
                      <strong>Termes voisins</strong>
                      <ul class="liens-liste">
                        {entry.relatedTerms.map((relatedId) => {
                          const related = GLOSSARY_BY_ID.get(relatedId);
                          if (!related) throw new Error(`Terme voisin inconnu : ${relatedId}`);
                          return <li><a href={`/glossaire#${related.anchor}`}>{related.term}</a></li>;
                        })}
                      </ul>
                    </div>
                    <div>
                      <strong>Pour aller plus loin</strong>
                      <ul class="liens-liste">
                        {liensInternes(entry).map((link) => <li><a href={link.href}>{link.label}</a></li>)}
                      </ul>
                    </div>
                  </div>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    {/* Système de page : appel final commun, textes du glossaire relus sur main. */}
    <AppelFinal
      id="sortie"
      titre="Une tâche répétitive à nous confier ?"
      texte="Nous écrivons la règle avec votre équipe, puis prenons la tâche entière en charge dans vos outils existants : construction, essais, recette et maintenance. La recette est la vérification du résultat par votre équipe. Vous gardez la décision."
      points={[]}
      action={CTA.principal}
    />
  </div>
</Base>

<style>
  /* Système de page : l'en-tête du héros partagé, sans maquette (40 puis 64 px au-dessus). */
  .glossaire-tete { display: grid; gap: 16px; padding-top: 40px; max-width: 880px; margin-inline: 0; }
  .ariane ol { display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--t-sm); color: var(--texte-2); margin-bottom: 12px; }
  .ariane li + li::before { content: '›'; margin-right: 6px; color: var(--picto-repos); }
  .ariane a { color: var(--texte-2); text-decoration: underline; text-underline-offset: 2px; }
  .ariane [aria-current] { color: var(--texte); }
  .glossaire-tete h1 { font-size: var(--titre-page-partage); max-width: 22ch; }
  .glossaire-intro { max-width: 62ch; }
  .glossaire-statut { max-width: 65ch; padding: 12px 16px; border-left: 3px solid var(--ocre); background: var(--ocre-voile); color: var(--texte); font-size: var(--t-sm); }
  .glossaire-outils { display: grid; gap: 24px; margin-top: var(--bloc-ecart); padding-block: 24px; border-block: 1px solid var(--ligne); }
  .recherche { display: grid; gap: 8px; max-width: 640px; }
  /* Réserver la recherche avant l'activation JS : l'index ne descend pas au chargement. */
  .recherche[hidden] { display: grid; visibility: hidden; }
  .recherche label { font-weight: 600; color: var(--texte-fort); }
  .recherche-ligne { display: grid; gap: 8px; }
  .recherche input { width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid var(--ligne-forte); border-radius: var(--r-bouton); background: var(--surface-feuille); color: var(--texte-fort); font: inherit; }
  .recherche-effacer { min-height: 48px; padding: 8px 12px; border: 1px solid var(--ligne-forte); border-radius: var(--r-bouton); background: var(--surface-page); color: var(--texte-fort); font: inherit; font-weight: 500; cursor: pointer; }
  .recherche-effacer:disabled { opacity: 0.5; cursor: default; }
  .recherche-resultat { font-size: var(--t-sm); }
  .recherche-vide { padding: 16px; border: 1px solid var(--ligne); background: var(--surface-page); }
  .alphabet ol { display: flex; flex-wrap: wrap; gap: 8px; }
  .alphabet a { display: grid; place-items: center; min-width: 48px; min-height: 48px; border: 1px solid var(--ligne); border-radius: var(--r-bouton); color: var(--texte-fort); font-weight: 600; }
  .glossaire-corps { margin-top: var(--bloc-ecart); }
  .lettre { scroll-margin-top: calc(var(--nav-h) + 20px); }
  /* Les lettres sont les intertitres d'un document : 32 px, espacées de 64 px, sans filet. */
  .lettre + .lettre { margin-top: var(--espace-16); }
  .lettre > h2 { font-size: var(--titre-intertitre); }
  .lettre dl { display: grid; }
  .glossaire-entree { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; padding-block: 28px; border-bottom: 1px solid var(--ligne); scroll-margin-top: calc(var(--nav-h) + 20px); }
  .glossaire-entree[hidden], .lettre[hidden] { display: none; }
  .glossaire-entree dt { min-width: 0; }
  .glossaire-entree dt a { font-family: var(--police-display), 'Fraunces Fallback'; font-size: var(--t-2xl); font-weight: 600; color: var(--texte-fort); text-decoration: underline; text-decoration-color: var(--ligne-forte); text-underline-offset: 5px; }
  .glossaire-entree dd { min-width: 0; margin: 0; display: grid; gap: 16px; max-width: 72ch; }
  .definition { color: var(--texte-fort); font-size: var(--t-lg); line-height: 1.5; }
  .contexte { color: var(--texte-2); }
  .entree-details { display: grid; gap: 12px; padding-left: 16px; border-left: 3px solid var(--accent-appui); }
  .entree-details p { display: grid; gap: 2px; }
  .entree-details strong, .entree-liens strong { font-size: var(--t-sm); color: var(--texte-fort); }
  .entree-liens { display: grid; gap: 8px; font-size: var(--t-sm); }
  .entree-liens > div { display: grid; gap: 2px; }
  .liens-liste { display: flex; flex-wrap: wrap; gap: 2px 16px; }
  .liens-liste li { display: flex; align-items: center; min-height: 44px; }
  .entree-liens a, .definition a, .contexte a { color: var(--accent-texte); text-decoration: underline; text-underline-offset: 2px; overflow-wrap: anywhere; }
  @media (hover: hover) {
    .alphabet a:hover, .recherche-effacer:hover { background: var(--surface-hover); }
  }
  @media (min-width: 36rem) {
    .recherche-ligne { grid-template-columns: minmax(0, 1fr) auto; }
  }
  @media (min-width: 64rem) {
    .glossaire-tete { padding-top: 64px; }
    /* Le terme sur un tiers, sa définition sur deux tiers, comme les lignes du système. */
    .glossaire-entree { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--rangee-gouttiere); padding-block: 36px; }
  }
  @media (forced-colors: active) {
    .glossaire-statut, .entree-details { border-left-color: CanvasText; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-glossary-list]');
  const search = document.querySelector<HTMLElement>('[data-search]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const reset = document.querySelector<HTMLButtonElement>('[data-search-reset]');
  const count = document.querySelector<HTMLElement>('[data-result-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const normalize = (value: string) => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLocaleLowerCase('fr');
  if (root && search && input && reset && count && empty) {
    search.hidden = false;
    count.setAttribute('aria-live', 'polite');
    const entries = [...root.querySelectorAll<HTMLElement>('.glossaire-entree')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-lettre]')];
    const update = () => {
      const query = normalize(input.value.trim());
      let visible = 0;
      for (const entry of entries) {
        const matches = !query || normalize(entry.dataset.searchable ?? '').includes(query);
        entry.hidden = !matches;
        if (matches) visible += 1;
      }
      for (const section of sections) section.hidden = !section.querySelector('.glossaire-entree:not([hidden])');
      count.textContent = `${visible} ${visible === 1 ? 'terme' : 'termes'}`;
      empty.hidden = visible !== 0;
      reset.disabled = query.length === 0;
    };
    input.addEventListener('input', update);
    reset.addEventListener('click', () => { input.value = ''; update(); input.focus(); });
    const revealAnchor = () => {
      let id: string;
      try { id = decodeURIComponent(window.location.hash.slice(1)); }
      catch { return; }
      const target = document.getElementById(id);
      if (!target || !root.contains(target) || !target.closest('[hidden]')) return;
      // Une navigation explicite prime sur le filtre, sans laisser un compteur incohérent.
      input.value = '';
      update();
      target.scrollIntoView();
    };
    window.addEventListener('hashchange', revealAnchor);
    // Réactiver le fragment courant ne déclenche pas hashchange (clic ou Entrée).
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
      const url = new URL(link.href);
      if (url.origin === location.origin && url.pathname === location.pathname && url.search === location.search && url.hash === location.hash) revealAnchor();
    });
    revealAnchor();
  }
</script>
