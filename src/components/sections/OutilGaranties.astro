---
import Picto from '@/components/Picto.astro';

const garanties = [
  {
    picto: 'main' as const,
    titre: 'Sans compte ni adresse e-mail',
    texte: 'L’outil est accessible gratuitement. Aucun mur d’inscription ne précède le résultat.',
    href: '#outil-faq-gratuit',
  },
  {
    picto: 'bouclier' as const,
    titre: 'Aucune connexion sortante',
    texte: 'La politique de sécurité publique de la page bloque les connexions réseau pendant le calcul.',
    href: '#outil-faq-local',
  },
  {
    picto: 'limites' as const,
    titre: 'Les limites avant le résultat',
    texte: 'La règle couverte, la source datée et les cas refusés restent lisibles sur la page.',
    href: '#limites-titre',
  },
];
// Système de page : chaque garantie mène à sa preuve dans la page ; ce sont des destinations
// nommées, donc une liste de liens (pictogramme, libellé, phrase dessous, flèche), comme les
// garanties de l'accueil.
---

<section class="section outil-garanties" data-tool-section="garanties" aria-labelledby="outil-garanties-titre">
  <div class="conteneur pile">
    <div class="tete rv">
      <h2 id="outil-garanties-titre">Trois garanties vérifiables avant de saisir une valeur.</h2>
    </div>
    <div class="liens-bloc rv">
      <ul class="liens">
        {garanties.map((garantie) => (
          <li>
            <a class="lien-rangee" href={garantie.href}>
              <Picto nom={garantie.picto} taille={20} />
              <span class="lien-libelle">{garantie.titre}<span class="lien-detail">{garantie.texte}</span></span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
