{
  "name": "memlia-landing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Site memlia.fr — Astro, Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-briefs.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "test:proof": "python3 -m unittest discover -s tests/proof -v",
