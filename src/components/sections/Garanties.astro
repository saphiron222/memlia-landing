---
import Picto from '@/components/Picto.astro';
import ProofRow from '@/components/ProofRow.astro';
import { GARANTIES } from '@/data/garanties';

/**
 * S3 — Grille de garanties (spec §4.9), à la place des logos clients.
 * Chaque cellule est un lien vers la question FAQ qui la détaille.
 */
---

<section id="garanties" class="garanties" aria-labelledby="garanties-titre">
  <div class="garanties-media"><ProofRow id="09-garanties">
  <div class="garanties-tete">
    <div class="garanties-phrase">
      <h2 id="garanties-titre" class="garanties-h2">Nos engagements, écrits avant de développer.</h2>
      <a class="btn btn-lien" href="#questions">Lire les réponses <Picto nom="fleche" taille={14} /></a>
    </div>
    <span class="garanties-sep" aria-hidden="true"></span>

  </div>

  <div class="garanties-proof-list">
  <ul class="garanties-grille rv" data-garanties>
    {GARANTIES.map((g) => (
      <li class="garantie">
        <a href={g.href} class="garantie-lien">
          <span class="carte-icone garantie-picto" aria-hidden="true"><Picto nom={g.picto} taille={24} /></span>
          <span class="garantie-libelle">{g.libelle}</span>
          <Picto nom="fleche" taille={14} class="garantie-fleche" />
        </a>
      </li>
    ))}
  </ul>
  </div>
  </ProofRow></div>
</section>

<style>
  .garanties-media { padding: 0 var(--marge-page); }
  @media (min-width: 64rem) { .garanties-media { padding: 0 var(--marge-page-lg); } }
  .garanties {
    margin-top: 32px;
  }
  .garanties-tete {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 0 24px;
  }
  .garanties-phrase {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .garanties-h2 {
    font-family: var(--police-corps), 'Hanken Fallback';
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--texte);
  }
  .garanties-sep {
    display: none;
    width: 1px;
    height: 56px;
    background: var(--ligne);
  }
  /* La grille des six garanties est partagée avec /garanties : global.css. */
  @media (min-width: 48rem) {
    .garanties-tete {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 0 0 24px;
    }
    .garanties-phrase {
      flex-direction: column;
      align-items: start;
      gap: 16px;
      flex: 1;
    }
    .garanties-sep {
      display: none;
      margin: 0 24px;
    }
  }
  @media (min-width: 64rem) {
    .garanties-tete {
      padding: 0 0 24px;
    }
  }
</style>
