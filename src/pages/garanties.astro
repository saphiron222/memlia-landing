---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import ProofRow from '@/components/ProofRow.astro';
import Picto, { type NomPicto } from '@/components/Picto.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { SERVICE_ID } from '@/data/schema.mjs';

const page = PAGES_V2.garanties;
const url = `${SITE.url}${page.chemin}`;
const noeuds = [{
  '@type': 'WebPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
  inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': SERVICE_ID },
}];
/** La grille de l'accueil, dont chaque cellule mène ici à la section qui la tient. */
const grille: { picto: NomPicto; libelle: string; href: string }[] = [
  { picto: 'main', libelle: 'L’IA prépare, l’humain décide', href: '#arret' },
  { picto: 'fictif', libelle: 'Aucune donnée client dans les essais', href: '#donnees' },
  { picto: 'agregat', libelle: 'Agrégats, jamais nominatif', href: '#personnes' },
  { picto: 'recette', libelle: 'Recette sur les cas qui doivent échouer', href: '#recette' },
  { picto: 'regle', libelle: 'Périmètre écrit avant la mise en service', href: '#ecrit' },
  { picto: 'bouclier', libelle: 'Ce que nous ne promettons pas', href: '#refus' },
];
const appel = {
  titre: 'Ces engagements se lisent avant de s’engager.',
  texte: 'Confiez-nous la tâche répétitive qui charge votre équipe. Nous écrivons sa règle avec vous, puis nous la construisons et la maintenons dans vos outils. Vous gardez la décision.',
  points: ['L’exception est présentée, jamais avalée.', 'Le développement utilise des jeux fictifs.', 'Le périmètre est écrit avant la mise en service.'],
};
---

<PageCommerciale page={page} noeuds={noeuds} eyebrow="Nos engagements" hero="v2/16-hero-garanties" appel={appel}>
  <section class="pv" aria-label="Les six garanties">
    <ul class="garanties-grille rv" data-garanties>
      {grille.map((g) => (
        <li class="garantie">
          <a class="garantie-lien" href={g.href}>
            <span class="garantie-picto" aria-hidden="true"><Picto nom={g.picto} taille={24} /></span>
            <span class="garantie-libelle">{g.libelle}</span>
            <span class="garantie-fleche" aria-hidden="true"><Picto nom="chevron" taille={14} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="pv" id="arret" aria-labelledby="arret-titre">
    <ProofRow id="v2/07-exception-visible">
      <div class="pv-copy rv">
        <h2 id="arret-titre">Dans le doute, l’automatisation s’arrête</h2>
        <p>Une donnée absente, une pièce illisible ou un cas hors règle arrête la préparation et présente le motif à votre équipe.</p>
        <p class="texte-2">Une contradiction entre deux règles ou un format inattendu bloque l’écriture concernée. Le motif est visible ; votre équipe corrige l’entrée ou décide de la suite. La règle ne devine pas la donnée manquante.</p>
        <p class="texte-2">Cette règle borne la décision de <a href="/automatisation/saisie-comptable">confier la préparation de la saisie comptable</a> : une pièce incertaine ne devient jamais une écriture certaine.</p>
        <p class="texte-2">Une exception visible se présente avec son contexte et son motif. Votre équipe décide de la suite.</p>
        <p class="texte-2">La règle écrite distingue ce qui se prépare seul, ce qui attend une validation et ce qui reste humain. Les décisions sensibles vous sont proposées. Aucun envoi externe sans validation humaine : courriel, déclaration ou facture.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv pv-inverse" id="donnees" aria-labelledby="donnees-titre">
    <ProofRow id="v2/45-cadrage-donnees">
      <div class="pv-copy rv">
        <h2 id="donnees-titre">Des essais fictifs, des flux cadrés par mission</h2>
        <p class="texte-2">Vous pouvez <a href="/outils-comptables-gratuits/seuil-signification-audit">reprendre localement vos scénarios de seuils d’audit</a> : le JSON conserve paramètres et commentaires, sans stockage automatique. Le CAC choisit et justifie les seuils ; nous calculons leur effet.</p>
        <p class="texte-2">Le <a href="/outils-comptables-gratuits/suivi-circularisation">suivi local de circularisation</a> conserve lettres et notes uniquement dans l’onglet. Exportez le JSON pour reprendre votre campagne ; aucun envoi de courrier ni stockage automatique n’est effectué.</p>
        <p class="texte-2"><a href="/automatisation/circularisation-cac">Automatiser la circularisation</a> prépare une proposition de tiers et les pièces postérieures choisies par le CAC. Ses saisies restent séparées des résultats générés ; les conclusions lui appartiennent.</p>
        <p>Les jeux d’essai que nous construisons sont <strong>entièrement fictifs</strong>. Ils reproduisent la forme de vos fichiers, jamais leur contenu.</p>
        <p class="texte-2">Nous pouvons ainsi <a href="/automatisation/notes-de-frais">éprouver le traitement des notes de frais</a> avec un justificatif fictif, un doublon et un refus attendu.</p>
        <p class="texte-2">Les fichiers réels autorisés pour le cadrage sont lus en place. Nous ne les copions pas dans nos dépôts et nous développons sur des jeux fictifs. Pour le premier échange, la description du geste suffit.</p>
        <p class="texte-2">Avant la mise en service, nous documentons les données lues, les droits d’accès, les destinataires et les flux du traitement. Les hébergements éventuels, les durées de conservation et les responsabilités sont précisés pour la mission. Un traitement local se vérifie sur ses appels réseau et sa télémétrie ; le lieu du fichier ne suffit pas.</p>
        <p class="texte-2">La <a href="/politique-de-confidentialite">politique de confidentialité</a> décrit les données du site. Les flux du service sont documentés par mission avant la mise en service.</p>
        <p class="texte-2">Pour une copie de travail, vous pouvez <a href="/outils-comptables-gratuits/preparer-pseudonymiser-fichier-csv-fec">supprimer des colonnes et pseudonymiser un CSV local</a>, puis examiner les risques restants. Des alias ne garantissent pas l’anonymat.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" id="personnes" aria-labelledby="personnes-titre">
    <ProofRow id="09-garanties">
      <div class="pv-copy rv">
        <h2 id="personnes-titre">Nous ne mesurons pas les personnes</h2>
        <p>Un outil de pilotage compte des dossiers, des étapes et des délais. Il ne classe pas les collaborateurs. Les vues que nous livrons présentent des agrégats : combien de dossiers à telle étape, combien d’exceptions en attente, quelles échéances approchent.</p>
        <p class="texte-2">L’affectation sert à distribuer le travail ; elle ne justifie pas une mesure individuelle continue, et nous ne construisons pas de vue qui la rendrait possible par défaut.</p>
        <p class="texte-2">C’est notre choix de conception pour les vues de pilotage. Le glossaire définit l’<a href="/glossaire#agregat-non-nominatif">agrégat non nominatif</a> : un total utile pour suivre le travail, sans classement individuel.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv pv-inverse" id="recette" aria-labelledby="recette-titre">
    <ProofRow id="06-eprouver">
      <div class="pv-copy rv">
        <h2 id="recette-titre">La recette éprouve les refus autant que les résultats</h2>
        <p>Chaque mission passe par un jeu d’essai fictif qui contient les cas qui doivent aboutir et ceux qui doivent s’arrêter. Un arrêt attendu qui ne se produit pas est traité comme un résultat faux : corrigé avant la recette, jamais livré.</p>
        <p class="texte-2">Un paiement groupé ambigu sert alors à <a href="/automatisation/rapprochement-bancaire">recetter le rapprochement bancaire</a> autant qu’un appariement exact.</p>
        <p class="texte-2">La recette est la vérification du résultat par vos référents dans l’environnement autorisé du cabinet. Elle porte sur les cas fictifs convenus et les critères écrits. Vos référents acceptent ou refusent le résultat ; leur accord vaut pour les versions, les accès et les cas éprouvés.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" id="ecrit" aria-labelledby="ecrit-titre">
    <ProofRow id="v2/09-perimetre-ecrit">
      <div class="pv-copy rv">
        <h2 id="ecrit-titre">Ce qui est écrit avant de commencer</h2>
        <p>Avant de construire, nous écrivons avec vous la tâche entière : entrées, règle, exceptions, résultat attendu et limites. Le périmètre accepté fixe les accès, les personnes qui valident et les critères de recette avant la mise en service.</p>
        <p class="texte-2">Le devis précise la maintenance, le support et les évolutions couverts. Si vos outils ou votre règle changent, nous analysons leur effet sur le résultat et rejouons la recette si nécessaire. Une extension du périmètre se convient avec vous.</p>
        <p class="texte-2">En expertise comptable, votre équipe garde ses contrôles et ses décisions. Pour une tâche de commissariat aux comptes, elle garde aussi le choix des travaux et ses conclusions ; la signature reste au CAC. Chaque mission a son périmètre et ses accès. Le <a href="https://doc.cncc.fr/docs/codedeontologiemars2026/attachments/brochure-code-de-deontologie-mars-2026">code de déontologie, article 10</a>, rappelle que le CAC conserve la responsabilité de sa mission lorsqu’il se fait assister.</p>
        <p class="texte-2">Ce périmètre est la condition pour <a href="/automatisation/factures-fournisseurs">cadrer le flux des factures fournisseurs</a> sans confondre préparation, litige et décision de paiement.</p>
        <p class="texte-2">Pour organiser les usages et les rôles avant de choisir une automatisation, vous pouvez <a href="/outils-comptables-gratuits/generateur-charte-ia-cabinet">préparer une trame de charte IA du cabinet</a> : chaque arbitrage non décidé reste à compléter.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" id="refus" aria-labelledby="refus-titre">
    <div class="pv-tete rv">
      <h2 id="refus-titre">Ce que nous ne promettons pas</h2>
      <p class="texte-2 lecture">Nos engagements portent sur une tâche définie, sa règle écrite et sa recette. Vous gardez les contrôles métier, comme <a href="/blog/automatiser-la-saisie-comptable-ce-qui-reste-a-verifier">les six contrôles qui restent après une saisie automatisée</a>.</p>
      <p class="texte-2 lecture">Cette frontière vaut aussi pour le <a href="/outils-comptables-gratuits/verificateur-fec-local">contrôle local de structure d’un FEC</a> : les anomalies sont expliquées et les contrôles non évalués restent visibles ; le rapport ne certifie pas le fichier.</p>
      <p class="texte-2 lecture">Le <a href="/outils-comptables-gratuits/bareme-heures-cac">barème d’heures du commissaire aux comptes</a> n’est pas un tarif universel. Une exclusion ou un champ inconnu suspend la fourchette ; le budget et la suffisance des diligences restent à justifier par le CAC.</p>
    </div>
    <div class="pv-bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ul class="pv-bande-liste rv-groupe" data-colonnes="2">
        <li class="pv-cellule rv"><h3>Aucune attestation de conformité</h3><p>Nous documentons le traitement prévu et ses limites. Ce document n’est pas une attestation de conformité en paie, en droit social ou en protection des données. La recette valide le périmètre convenu ; elle ne certifie pas les comptes ni le dossier d’audit.</p></li>
        <li class="pv-cellule rv"><h3>Aucun branchement universel</h3><p>Nous vérifions les formats et les accès de vos outils avant de nous engager. Si la connexion n’est pas possible, nous le disons.</p></li>
        <li class="pv-cellule rv"><h3>Aucun pourcentage inventé</h3><p>Le résultat attendu et les critères d’acceptation sont écrits avec vous. Les gains se mesurent sur votre tâche ; nous n’annonçons pas d’heures ni de pourcentages sans mesure.</p></li>
        <li class="pv-cellule rv"><h3>Aucune illustration trompeuse</h3><p>Les exemples que nous publions sont fictifs et le disent. Aucun n’est une capture d’un dossier réel ni un résultat client.</p></li>
      </ul>
    </div>
  </section>
</PageCommerciale>

<style>
  /* La grille des six garanties, telle qu'elle existe sur l'accueil (Garanties.astro),
     dont chaque cellule mène ici à sa section plutôt qu'à la FAQ. */
  .garanties-grille { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--ligne-douce); border-top: 1px solid var(--ligne-douce); border-bottom: 1px solid var(--ligne-douce); }
  .garantie { position: relative; background: var(--surface-feuille); min-height: 96px; overflow: hidden; }
  .garantie-lien { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; height: 100%; min-height: 96px; padding: 12px 8px 16px; text-align: center; color: var(--texte-2); transition: color var(--duree-4) var(--courbe-standard); }
  .garantie-picto { color: var(--picto-repos); transition: color var(--duree-4) var(--courbe-standard); }
  .garantie-libelle { font-size: 0.8125rem; font-weight: 500; line-height: 1.3; text-wrap: balance; }
  .garantie-fleche { position: absolute; right: 10px; bottom: 8px; opacity: 0; transform: translateY(12px); color: var(--accent-texte); transition: opacity var(--duree-3) var(--courbe-standard), transform var(--duree-3) var(--courbe-standard); }
  .garantie-lien:focus-visible { outline-offset: -3px; border-radius: 0; }
  .garantie-lien:focus-visible, .garantie-lien:focus-visible .garantie-picto { color: var(--texte-fort); }
  .garantie-lien:focus-visible .garantie-fleche { opacity: 1; transform: none; }
  .garantie::after { content: ''; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.6) 50%, transparent 70%); transform: translateX(-100%); pointer-events: none; }
  :global(html.js) .garanties-grille.in .garantie::after { animation: garantie-balayage 1.5s var(--courbe-standard) both; animation-delay: calc(var(--i, 0) * 150ms); }
  .garantie:nth-child(2) { --i: 1; } .garantie:nth-child(3) { --i: 2; } .garantie:nth-child(4) { --i: 3; } .garantie:nth-child(5) { --i: 4; } .garantie:nth-child(6) { --i: 5; }
  @keyframes garantie-balayage { to { transform: translateX(100%); } }
  @media (hover: hover) {
    .garantie-lien:hover, .garantie-lien:hover .garantie-picto { color: var(--texte-fort); }
    .garantie-lien:hover .garantie-fleche { opacity: 1; transform: none; }
  }
  @media (min-width: 40rem) { .garantie, .garantie-lien { min-height: 128px; } }
  @media (prefers-reduced-motion: reduce) { .garantie::after { animation: none !important; } }
</style>
