---
import Lockup from './Lockup.astro';
import Button from './Button.astro';

import Picto from './Picto.astro';
import { CTA } from '@/data/site.mjs';


/**
 * Navigation M3-S : ancres narratives directes et panneau mobile refermable par Échap.
 */
interface Props {
  blogActif: boolean;
  /** Chemin canonique de la page courante (fourni par Base, indépendant de la forme d'URL du build). */
  chemin: string;
  /** Préfixe des ancres : vide sur l'accueil, « / » depuis une autre page. */
  base?: string;
}
const { blogActif, chemin, base = '' } = Astro.props;
/** `page` sur /blog, `true` (section) sur un article ; rien ailleurs. */
const surBlog: 'page' | 'true' | undefined = chemin === '/blog' ? 'page' : chemin.startsWith('/blog/') ? 'true' : undefined;

const entrees = [
  { libelle: 'Usages', href: `${base}#usages` },
  { libelle: 'Méthode', href: `${base}#methode` },
  { libelle: 'Intégration', href: `${base}#integration` },
  { libelle: 'Garanties', href: `${base}#garanties` },
  { libelle: 'Questions', href: `${base}#questions` },
  ...(blogActif ? [{ libelle: 'Blog', href: '/blog', courant: surBlog }] : []),
];
---

<header class="nav-barre">
  <div class="conteneur nav">
    <Lockup href="/" />

    <nav class="nav-centre" aria-label="Navigation principale">
      <ul class="nav-liste">

        {entrees.map((e) => (
          <li class="nav-item">
            <a class="nav-entree" href={e.href} aria-current={'courant' in e ? e.courant : undefined}>{e.libelle}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-droite">

      <Button href={CTA.principal.href} variante="principal" picto="fleche" class="nav-principal">
        {CTA.principal.libelle}
      </Button>

      <button
        type="button"
        class="nav-burger"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
        data-burger
      >
        <Picto nom="menu" taille={16} class="burger-ouvrir" />
        <Picto nom="fermer" taille={16} class="burger-fermer" />
      </button>
    </div>
  </div>
</header>
  <!-- Frère du header : son backdrop-filter ne doit pas contenir le fixed (WebKit). -->
  <div class="nav-mobile" id="menu-mobile" data-menu-mobile hidden>
    <nav aria-label="Navigation mobile" class="conteneur">
      <ul class="nav-mobile-liste">

        {entrees.map((e) => (
          <li><a class="nav-mobile-lien" href={e.href} aria-current={'courant' in e ? e.courant : undefined}>{e.libelle}</a></li>
        ))}
        <li class="nav-mobile-cta">

          <Button href={CTA.principal.href} variante="principal" picto="fleche">{CTA.principal.libelle}</Button>
        </li>
      </ul>
    </nav>
  </div>

<noscript>
  <nav class="conteneur nav-sans-js" aria-label="Navigation sans JavaScript">

    {entrees.map(e => <a href={e.href}>{e.libelle}</a>)}
  </nav>
</noscript>

<style>
  .nav-sans-js { display: flex; flex-wrap: wrap; gap: 16px; padding-block: 12px; }
  @media (max-width: 23rem) {
    .nav { gap: 8px; }
    .nav-droite { gap: 8px; }
    .nav-principal-mobile { font-size: 12px; padding-inline: 8px; }
  }
  .nav-barre {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 254, 251, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--ligne-douce);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--nav-h);
  }
  .nav-centre {
    display: none;
  }
  .nav-liste {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-item {
    position: relative;
  }
  .nav-entree {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 8px;
    border-radius: var(--r-bouton);
    border: 0;
    background: transparent;
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--texte);
    cursor: pointer;
    transition: color var(--duree-1) ease-out, background-color var(--duree-1) ease-out;
  }
  .nav-declencheur {
    padding-right: 10px;
  }
  .nav-chevron {
    transition: transform var(--duree-2) var(--courbe-standard);
  }
  .nav-declencheur[aria-expanded='true'] .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-entree[aria-current] {
    color: var(--texte-fort);
    background: var(--surface-hover);
  }
  .nav-declencheur[aria-expanded='true'],
  .nav-entree:focus-visible {
    color: var(--texte-fort);
    background: var(--surface-hover);
  }
  .nav-panneau {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) scale(0.9);
    opacity: 0;
    width: 560px;
    max-width: calc(100vw - 32px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    padding: 16px;
    border-radius: var(--r-boite);
    border: 1px solid var(--ligne);
    background: var(--surface-feuille);
    box-shadow: var(--ombre-panneau);
    transition: opacity var(--duree-1) var(--courbe-sortie), transform var(--duree-1) var(--courbe-sortie);
  }
  .nav-panneau[hidden] {
    display: none;
  }
  .nav-panneau.ouvert {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
  .nav-panneau-entree {
    display: grid;
    gap: 6px;
    padding: 10px 12px;
    border-radius: var(--r-bouton);
  }
  .nav-panneau-texte {
    font-size: 0.8125rem;
    color: var(--texte-2);
  }
  .nav-droite {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav-humain,
  .nav-principal {
    display: none;
  }
  .nav-burger {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 6px;
    border-radius: var(--r-bouton);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: background-color var(--duree-1), border-color var(--duree-1);
  }
  .nav-burger .burger-fermer,
  .nav-burger[aria-expanded='true'] .burger-ouvrir {
    display: none;
  }
  .nav-burger[aria-expanded='true'] .burger-fermer {
    display: block;
  }
  .nav-mobile {
    position: fixed;
    z-index: 49;
    top: calc(var(--nav-h) + env(safe-area-inset-top, 0px) + 1px);
    left: 0;
    right: 0;
    height: calc(100vh - var(--nav-h) - env(safe-area-inset-top, 0px) - 1px);
    height: calc(100dvh - var(--nav-h) - env(safe-area-inset-top, 0px) - 1px);
    overflow-y: auto;
    overscroll-behavior-y: contain;
    background: #fffefb;
    border-top: 1px solid var(--ligne);
    padding: 12px env(safe-area-inset-right, 0px) max(32px, env(safe-area-inset-bottom, 0px)) env(safe-area-inset-left, 0px);
  }
  .nav-mobile[hidden] {
    display: none;
  }
  .nav-mobile-liste {
    display: grid;
  }
  .nav-mobile-lien {
    display: block;
    min-height: 44px;
    padding: 12px 8px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--texte-fort);
    border-bottom: 1px solid var(--ligne-douce);
  }
  .nav-mobile-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 20px 8px 0;
  }
  .nav-mobile-cta :global(.btn) {
    min-height: 44px;
    font-size: 1rem;
    white-space: normal;
  }
  @media (max-width: 63.999rem) {
    .nav-barre {
      padding-top: env(safe-area-inset-top, 0px);
    }
    .nav-barre[data-mobile-open] {
      position: fixed;
      left: 0;
      right: 0;
      background: #fffefb;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  :global(body[data-mobile-menu-open]) {
    position: fixed;
    top: var(--mobile-menu-scroll-top);
    left: 0;
    right: 0;
    overflow: hidden;
  }
  @media (hover: hover) {
    .nav-entree:hover {
      color: var(--texte-fort);
      background: var(--surface-hover);
    }
    .nav-panneau-entree:hover {
      background: var(--surface-hover);
    }
    .nav-burger:hover {
      background: var(--surface-hover);
      border-color: var(--ligne);
    }
  }
  @media (min-width: 64rem) {
    .nav-centre {
      display: block;
    }
    .nav-humain,
    .nav-principal {
      display: inline-flex;
    }
    .nav-principal-mobile,
    .nav-burger,
    .nav-mobile {
      display: none;
    }
  }
</style>

<script>
  // Fond inerte et scroll conservé ; la navigation mobile reste quittable par X / Échap.
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu-mobile]');
  const header = document.querySelector<HTMLElement>('.nav-barre');
  if (burger && menu && header) {
    const desktop = window.matchMedia('(min-width: 64rem)');
    let scrollPosition = { x: 0, y: 0 };
    let previousScrollTop = '';
    let inertElements: { element: HTMLElement; inert: boolean }[] = [];
    const closeMenu = (restoreFocus = true) => {
      if (menu.hidden) return;
      menu.hidden = true;
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Ouvrir le menu');
      header.removeAttribute('data-mobile-open');
      document.body.removeAttribute('data-mobile-menu-open');
      if (previousScrollTop) document.body.style.setProperty('--mobile-menu-scroll-top', previousScrollTop);
      else document.body.style.removeProperty('--mobile-menu-scroll-top');
      inertElements.forEach(({ element, inert }) => { element.inert = inert; });
      inertElements = [];
      window.scrollTo({ left: scrollPosition.x, top: scrollPosition.y, behavior: 'instant' });
      if (restoreFocus) burger.focus({ preventScroll: true });
    };
    burger.addEventListener('click', () => {
      if (!menu.hidden) return closeMenu();
      if (desktop.matches) return;
      scrollPosition = { x: window.scrollX, y: window.scrollY };
      previousScrollTop = document.body.style.getPropertyValue('--mobile-menu-scroll-top');
      document.body.style.setProperty('--mobile-menu-scroll-top', `${-scrollPosition.y}px`);
      document.body.setAttribute('data-mobile-menu-open', '');
      header.setAttribute('data-mobile-open', '');
      const background = [...document.body.children].filter((element): element is HTMLElement =>
        element instanceof HTMLElement && element !== header && element !== menu &&
        !['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(element.tagName));
      inertElements = [...background, ...header.querySelectorAll<HTMLElement>('a')]
        .map(element => ({ element, inert: element.inert }));
      inertElements.forEach(({ element }) => { element.inert = true; });
      menu.hidden = false;
      menu.scrollTop = 0;
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Fermer le menu');
      burger.focus({ preventScroll: true });
    });
    menu.addEventListener('click', (e) => {
      // Restaurer le fond avant l'action native du lien (ancre ou changement de page).
      if ((e.target as Element).closest('a')) closeMenu();
    });
    document.addEventListener('focusin', (e) => {
      if (!menu.hidden && e.target !== burger && !menu.contains(e.target as Node)) burger.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', (e) => {
      if (menu.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeMenu();
      } else if (e.key === 'Tab') {
        // Safari peut exclure les liens du Tab natif : parcourir toute la boucle explicitement.
        const controls = [burger, ...menu.querySelectorAll<HTMLAnchorElement>('a[href]')];
        const index = controls.indexOf(document.activeElement as HTMLButtonElement | HTMLAnchorElement);
        const next = (index + (e.shiftKey ? -1 : 1) + controls.length) % controls.length;
        e.preventDefault();
        controls[next].focus();
      }
    });
    desktop.addEventListener('change', (e) => {
      if (!e.matches || menu.hidden) return;
      closeMenu(false);
      header.querySelector<HTMLAnchorElement>('.nav-centre a')?.focus({ preventScroll: true });
    });
    // Ne pas conserver le verrou si la page est restaurée depuis le bfcache.
    window.addEventListener('pagehide', () => closeMenu(false));
  }


</script>
