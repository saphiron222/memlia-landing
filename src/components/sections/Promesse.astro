---
import ListeEditoriale from '@/components/editorial/ListeEditoriale.astro';
import BlocEditorial from '@/components/editorial/BlocEditorial.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['promesse']; }
const { contenu = contenuDe('ec').promesse } = Astro.props;
/** Recette A du 15/10/2026 : contenu et ancres conservés, cadres commerciaux retirés. */
const { points } = contenu;
---

<section id="promesse" class="section pile promesse" aria-labelledby="promesse-titre">
  <div class="conteneur">
    <BlocEditorial>
      <div class="tete rv">
        <h2 id="promesse-titre">{contenu.titre}</h2>
        <p>{contenu.texte}</p>
      </div>
    </BlocEditorial>
  </div>
  <div class="conteneur"><ListeEditoriale>
      {points.map((p) => (
        <li class="editorial-point rv">
          <h3 class="editorial-point-titre">{p.titre}</h3>
          <p class="editorial-point-texte">{p.texte}</p>
        </li>
      ))}
    </ListeEditoriale></div>
</section>
