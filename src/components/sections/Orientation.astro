---
import Picto from '@/components/Picto.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['orientation']; }
const { contenu = contenuDe('ec').orientation } = Astro.props;

/**
 * Les quatre résumés d'orientation de l'accueil (copy transversale, section « Accueil —
 * les résumés qui mènent aux nouvelles pages »).
 *
 * L'accueil oriente ; il ne détaille pas. Sans ce bloc, les cinq pages du site v2
 * n'étaient atteignables que par le bandeau et le pied de page : aucun lien de corps,
 * donc aucun chemin de lecture depuis la page d'entrée.
 *
 * Système de page : quatre destinations décrites par une phrase, donc quatre cartes (2 × 2),
 * chacune finie par le lien d'action ; cinq services nommés par leur seul libellé, donc une
 * liste de liens.
 */
const { destinations, services } = contenu;
---

<section class="section orientation" aria-labelledby="orientation-titre">
  <div class="conteneur pile">
    <div class="tete">
      <h2 id="orientation-titre">{contenu.titre}</h2>
    </div>
    <ul class="cartes">
      {destinations.map((d) => (
        <li class="carte">
          <div class="carte-corps">
            <p class="carte-texte">{d.texte}</p>
            <a class="carte-action carte-lien" href={d.href}>{d.libelle}<Picto nom="fleche" taille={14} /></a>
          </div>
        </li>
      ))}
    </ul>
    <nav class="liens-bloc" aria-label="Pages de service">
      <span class="liens-titre">{contenu.invitation}</span>
      <ul class="liens">
        {services.map((service) => (
          <li>
            <a class="lien-rangee" href={service.href}>
              <span class="lien-libelle">{service.libelle}</span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>
