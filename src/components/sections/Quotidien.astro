---
import Insecable from '@/components/Insecable.astro';
import ProofRow from '@/components/ProofRow.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['quotidien']; }
const { contenu = contenuDe('ec').quotidien } = Astro.props;
/**
 * Le problème quotidien, sans métrique client ni témoignage inventé.
 * Système de page : rangée (en-tête, maquette), puis des lignes (un verbe, sa définition), puis
 * la mention qui borne la promesse.
 */
---
<section class="section daily" aria-labelledby="daily-title">
  <div class="conteneur pile">
    <ProofRow id={contenu.image}>
      <div class="tete rv">
        <h2 id="daily-title"><Insecable texte={contenu.titre} /></h2>
        <p>{contenu.texte}</p>
      </div>
    </ProofRow>
    <dl class="lignes rv">
      {contenu.points.map((p, i) => <Fragment>{i > 0 && ' '}<div class="ligne"><dt class="ligne-libelle">{p.titre}</dt><dd class="ligne-texte">{p.texte}</dd></div></Fragment>)}
    </dl>
    <p class="daily-note mention">{contenu.note}</p>
  </div>
</section>
