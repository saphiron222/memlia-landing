---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Scene from '@/components/editorial/SceneFigurines.astro';
import '@/styles/catalogue/commun.css';
const titrePage='Les figurines racontent aussi notre manière de travailler.';
const schema={'@context':'https://schema.org','@graph':[{'@type':'WebPage','@id':'https://memlia.fr/apercu/direction-figurines#page',url:'https://memlia.fr/apercu/direction-figurines',name:titrePage,headline:titrePage,inLanguage:'fr'}]};
const pages=[
 ['Accueil expertise comptable','Un savoir-faire à transmettre. Des tâches à confier.','Agents par métier, robots par routine, tâche sur mesure. Une scène de portefeuille et un parcours direct vers le bon catalogue.'],
 ['Accueil commissariat aux comptes','La mécanique préparée. Le jugement du CAC.','Figurine d’audit, dossiers de travail et exceptions. La revue, les conclusions et la signature restent au commissaire aux comptes.'],
 ['Méthode','Observer. Écrire. Éprouver. Livrer.','Une scène ample, cinq étapes lisibles, la règle sombre puis les points de départ robot, agent ou sur mesure.'],
 ['À propos','Le savoir-faire reste à votre cabinet.','Pourquoi Memlia existe, qui écrit et construit, puis comment la prise en charge est maintenue. Les figurines représentent les services.'],
 ['Garanties','Votre équipe garde les décisions.','Des engagements lisibles, les accès et validations prévus, les exceptions et les conditions d’arrêt. Une scène de reprise plutôt qu’un faux certificat.'],
 ['Contact','Quelle tâche voulez-vous nous confier ?','Le formulaire prend la première place. Une figurine accueillante l’accompagne en colonne latérale ; le choix reste facultatif et ouvert au sur mesure.'],
];
---
<Base titre="Proposition de direction visuelle Memlia — figurines" titreSocial={titrePage} schema={schema} description="Deux recettes d’images et un pilote Méthode pour prolonger le design des agents IA et des robots sur les pages Memlia." chemin="/apercu/direction-figurines" noindex socialImage={{url:'https://memlia.fr/illustrations/figurines/a-atelier-1200.webp',width:1200,height:800,alt:'Scène de travail Memlia en argile mate.'}}>
<div class="feuille catalogue-page atelier">
 <div class="atelier-note"><span>Proposition à valider · 15 octobre 2026</span><a href="/automatisation-cabinet-comptable">Voir le hub robots enrichi →</a></div>
 <section class="atelier-hero"><p class="surtitre">La famille Memlia</p><h1>{titrePage}</h1><p>La même matière, la même douceur et les mêmes repères que les agents IA et les robots. Des scènes choisies pour chaque page, avec de l’espace pour le texte et le travail du cabinet.</p><Button href="/apercu/methode-figurines" variante="principal" picto="fleche">Voir le pilote Méthode</Button></section>
 <section class="catalogue-section" aria-labelledby="recettes"><div class="tete"><h2 id="recettes">Deux recettes à comparer.</h2><p>Nous proposons les scènes de travail pour expliquer la méthode et les accueils. Les portraits métier peuvent accompagner le contact et les rappels plus courts.</p></div><div class="atelier-recettes">
  <figure><Scene recette="a-atelier" prioritaire alt="Un robot abricot et un agent sauge accompagnent un registre, des feuilles à classer et une exception séparée."/><figcaption><span class="surtitre">Piste A · Scènes de travail</span><h3>Montrer le passage d’une tâche.</h3><p>Des pièces reçues, une règle, un résultat rangé et une exception visible. Une illustration ample explique l’ensemble du travail pris en charge.</p><a class="catalogue-action" href="/apercu/methode-figurines">Comparer dans le pilote Méthode →</a></figcaption></figure>
  <figure><Scene recette="b-portrait" alt="Le robot abricot derrière un dossier ouvert, accompagné d’une feuille vierge et d’une clé."/><figcaption><span class="surtitre">Piste B · Portraits métier</span><h3>Une présence, quelques objets.</h3><p>Une figurine plus proche, un attribut concret et un fond crème respirant. Une image calme pour accueillir le lecteur ou rappeler la tâche confiée.</p><a class="catalogue-action" href="/apercu/methode-figurines">Comparer dans le pilote Méthode →</a></figcaption></figure>
 </div></section>
 <section class="catalogue-section" aria-labelledby="declinaisons"><div class="tete"><h2 id="declinaisons">Une même famille. Six pages avec leur rôle.</h2><p>Les titres, cartes, bandeaux et appels reprennent le langage des catalogues. L’image arrive à l’endroit où elle aide à comprendre, sans vignette obligatoire après chaque titre.</p></div><dl class="atelier-pages">{pages.map(([page,titre,texte])=><div><dt><span>{page}</span><h3>{titre}</h3></dt><dd>{texte}</dd></div>)}</dl></section>
 <section class="catalogue-section"><div class="atelier-attente"><h2>Les compatibilités viendront avec le chantier agents IA.</h2><p>Le hub « Guides par environnement comptable » attend la fin de la session Claude Code. Sa refonte reprendra la page de compatibilités des agents IA terminée. Les six autres pages seront déclinées après votre choix de recette d’images.</p></div></section>
 <section class="catalogue-fin"><h2>La méthode, en situation.</h2><p>Le pilote permet de comparer les deux images dans une vraie composition de page, avec les figurines, les étapes et la règle écrite.</p><Button href="/apercu/methode-figurines" variante="principal" picto="fleche">Ouvrir le pilote Méthode</Button></section>
</div>
</Base>
<style>
.atelier-note{padding:16px var(--marge-page);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;border-bottom:1px solid var(--ligne-douce);font-size:var(--t-sm);color:var(--texte-2)}.atelier-note a{color:var(--accent-texte);min-height:44px;display:inline-flex;align-items:center}.atelier-hero{padding:64px var(--marge-page) 0;display:grid;justify-items:center;text-align:center;gap:24px}.atelier-hero h1{font-size:var(--titre-page);max-width:22ch}.atelier-hero>p:not(.surtitre){max-width:62ch;color:var(--texte-2)}.atelier-recettes{display:grid;gap:48px}.atelier-recettes figure{margin:0;min-width:0}.atelier-recettes figcaption{display:grid;gap:16px;padding-top:24px}.atelier-recettes h3{font-size:var(--titre-bloc)}.atelier-recettes p{color:var(--texte-2)}.atelier-pages{margin:0;display:grid;gap:0}.atelier-pages>div{padding:32px 0;border-top:1px solid var(--ligne-douce);display:grid;gap:20px}.atelier-pages dt>span{font-size:var(--t-sm);color:var(--accent-texte)}.atelier-pages h3{font-size:var(--titre-bloc);margin-top:12px}.atelier-pages dd{margin:0;max-width:62ch;color:var(--texte-2)}.atelier-attente{background:var(--surface-page);padding:32px;border-radius:var(--r-cadre);display:grid;gap:24px}.atelier-attente h2{font-size:var(--titre-bloc)}.atelier-attente p{max-width:72ch;color:var(--texte-2)}
@media(min-width:64rem){.atelier-note{padding-inline:var(--marge-page-lg)}.atelier-recettes{grid-template-columns:repeat(2,minmax(0,1fr))}.atelier-pages>div{grid-template-columns:1fr 1fr;gap:64px}}
</style>
