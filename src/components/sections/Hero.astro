---
import Button from '@/components/Button.astro';
import Insecable from '@/components/Insecable.astro';

import { CTA } from '@/data/site.mjs';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['hero']; }
const { contenu = contenuDe('ec').hero } = Astro.props;
// Conserver les séparateurs du HTML historique, même avec des expressions Astro.
const retour = '\n';

/**
 * Hero M4-R4 : média R8 sans cartouche, conservé octet pour octet.
 */

---

<section class="hero" aria-labelledby="hero-titre">
  <div class="hero-texte">
    <span class="surtitre hero-eyebrow">{retour}{contenu.etiquette}{retour}</span>
    <h1 id="hero-titre" class="hero-h1">
      <Insecable texte={contenu.titre} />
    </h1>
    <p class="hero-sub">{retour}{contenu.texte}{retour}</p>
    <div class="hero-boutons">
      <Button href={CTA.principal.href} variante="principal" picto="fleche" class="hero-btn">
        {CTA.principal.libelle}
      </Button>

    </div>
    <slot name="audience" />
  </div>

  <div class="hero-cadre" data-cadre>
    <div class="hero-verre cadre">
      {contenu.video ? <div class="hero-ecran" data-video-player>
        <video muted loop playsinline preload="none" width="1920" height="1080"
          tabindex="0" data-video aria-label="Reprendre la vidéo" aria-describedby={contenu.descriptionVideo ? 'hero-video-description' : undefined}
          disablepictureinpicture disableRemotePlayback controlslist="nodownload nofullscreen noremoteplayback"
          poster={contenu.poster} src={contenu.video} data-video-mobile={contenu.videoMobile}>
          <track kind="subtitles" srclang="fr" label="Français" src={contenu.sousTitres} />
          <p>Votre navigateur ne peut pas lire cette vidéo. <a href={contenu.video}>Télécharger la vidéo</a>.</p>
        </video>
        {contenu.descriptionVideo && <p id="hero-video-description" class="sr-only">{contenu.descriptionVideo}</p>}
        {contenu.sousTitresOptionnels && <button class="hero-video-captions" type="button" data-video-captions aria-pressed="false" hidden>Sous-titres</button>}
        <div class="hero-video-overlay" data-video-overlay>
          <button class="hero-video-sound" type="button" data-video-sound>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
              <path d="M5 9v6h4l5 4V5L9 9H5Zm12.5-.5a5 5 0 0 1 0 7" />
            </svg>
            <span>Activer le son</span>
          </button>
        </div>
        <div class="hero-video-status" data-video-status role="status" aria-live="polite" hidden>
          <span data-video-status-message></span>
          <a href={contenu.video} data-video-download hidden>Télécharger la vidéo</a>
        </div>
        <noscript>
          <p class="hero-video-noscript">
            Votre navigateur ne peut pas lancer le lecteur interactif.
            <a href={contenu.video}>Télécharger la vidéo</a>.
            {contenu.sousTitresOptionnels && <a href={contenu.sousTitres}>Télécharger les sous-titres</a>}
          </p>
        </noscript>
      </div> : <div class="hero-ecran">
        <img src={contenu.poster} width="1600" height="900" alt="Sélection fictive des tiers : critères, graine, deux passes et validation en attente." loading="eager" fetchpriority="high" />
      </div>}
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 40px var(--marge-page) 0;
    isolation: isolate;
  }
  .hero-texte {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    margin: 0 auto;
  }
  .hero-h1 {
    max-width: 1050px;
    font-size: var(--titre-page);
  }
  .hero-sub {
    max-width: 672px;
    color: var(--texte-2);
    font-size: var(--t-base);
  }
  .hero-boutons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 12px;
  }
  /* Média du héros dans le cadre unique des maquettes (`.cadre`, global.css) : le plateau porte le
     bord et la marge, l'écran posé dedans prend le rayon concentrique. */
  .hero-cadre {
    margin-top: var(--bloc-ecart);
    max-width: min(1200px, calc(100vw - 32px));
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% + 256px);
  }
  .hero-ecran {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .hero-ecran video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    cursor: pointer;
  }
  .hero-ecran video:focus-visible {
    outline: 3px solid var(--accent-texte);
    outline-offset: -5px;
  }
  .hero-ecran img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
  }
  /* Rien ne se pose au centre de la vidéo, où passent ses titres : le bouton du son va dans le
     coin bas gauche, vide sur toutes les images de la vidéo (système de page, § 1). */
  .hero-video-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end start;
    padding: 0;
    pointer-events: none;
  }
  .hero-video-overlay[hidden],
  .hero-video-status[hidden] {
    display: none;
  }
  .hero-video-sound {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    margin: var(--espace-3);
    padding: 0 16px 0 14px;
    border: 1px solid var(--accent-appui);
    border-radius: var(--r-bouton);
    background: rgba(39, 182, 87, 0.92);
    color: var(--encre);
    font: inherit;
    font-size: var(--t-sm);
    font-weight: 600;
    cursor: pointer;
    pointer-events: auto;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: var(--ombre-plein);
  }
  .hero-video-sound:hover {
    background: var(--accent-appui);
    color: var(--blanc);
  }
  .hero-video-sound:focus-visible {
    outline: 3px solid var(--blanc);
    outline-offset: 3px;
    box-shadow: 0 0 0 5px var(--accent-texte);
  }
  .hero-video-sound svg {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero-video-captions {
    position: absolute;
    top: calc(100% + var(--espace-3));
    right: 0;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--accent-appui);
    border-radius: var(--r-bouton);
    background: var(--blanc);
    color: var(--encre);
    font: inherit;
    font-size: var(--t-sm);
    cursor: pointer;
  }
  .hero-ecran:has([data-video-captions]) {
    margin-bottom: calc(44px + var(--espace-3));
  }
  .hero-video-captions[aria-pressed="true"] {
    background: var(--accent-texte);
    color: var(--blanc);
  }
  .hero-video-captions:focus-visible {
    outline: 3px solid var(--accent-texte);
    outline-offset: 3px;
  }
  /* Le message d'état se lit en haut : il ne recouvre jamais le bouton du son qu'il désigne. */
  .hero-video-status,
  .hero-video-noscript {
    position: absolute;
    z-index: 2;
    top: 16px;
    right: 16px;
    left: 16px;
    width: fit-content;
    max-width: calc(100% - 32px);
    margin: 0 auto;
    padding: 10px 14px;
    border: 1px solid rgba(35, 31, 32, 0.14);
    border-radius: 12px;
    background: rgba(255, 254, 251, 0.96);
    color: var(--encre);
    font-size: var(--t-sm);
    text-align: center;
  }
  .hero-video-status a,
  .hero-video-noscript a {
    color: var(--accent-texte);
    font-weight: 600;
  }

  @media (max-width: 24.99rem) {
    .hero-boutons {
      flex-direction: column;
      align-items: stretch;
    }
  }
  @media (min-width: 48rem) {
    .hero-video-sound {
      margin: var(--espace-4);
    }
  }
  @media (min-width: 64rem) {
    .hero {
      padding: 64px var(--marge-page-lg) 0;
    }
    .hero-texte {
      min-height: 270px;
    }
    .hero-cadre {
      margin: var(--bloc-ecart) 0 0;
    }
  }
  @media (min-width: 80rem) {
    .hero-cadre {
      margin-left: 0;
      margin-right: 0;
    }
  }

  /* Entrées au chargement (§5.1) — hero seulement, flou autorisé ici. */
  @keyframes hero-entree {
    from {
      opacity: 0;
      transform: translateY(15px) scale(0.98);
      filter: blur(7px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-etiquette {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.8);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-bouton {
    from {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(3px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-verre {
    from {
      opacity: 0;
      transform: scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-ecran {
    from {
      opacity: 0;
      transform: scale(0.98);
      filter: blur(6px) grayscale(1);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0) grayscale(0);
    }
  }
  :global(html.js) .hero-h1 {
    animation: hero-entree var(--duree-entree) var(--courbe-sortie) both;
  }
  :global(html.js) .hero-sub {
    animation: hero-entree var(--duree-entree) var(--courbe-sortie) 100ms both;
  }
  :global(html.js) .hero-eyebrow {
    animation: hero-etiquette var(--duree-etiquette) var(--courbe-etiquette) 200ms both;
  }
  :global(html.js) .hero-boutons > :nth-child(1) {
    animation: hero-bouton var(--duree-entree) var(--courbe-sortie) 100ms both;
  }
  :global(html.js) .hero-boutons > :nth-child(2) {
    animation: hero-bouton var(--duree-entree) var(--courbe-sortie) 200ms both;
  }
  :global(html.js) .hero-verre {
    animation: hero-verre var(--duree-etiquette) var(--courbe-sortie) 200ms both;
  }
  :global(html.js) .hero-ecran {
    animation: hero-ecran var(--duree-revelation) var(--courbe-douce) 200ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero :is(.hero-h1, .hero-sub, .hero-eyebrow, .hero-boutons > *, .hero-verre, .hero-ecran) {
      animation: none;
    }
  }
</style>

<script>
  const pauseLabel = 'Mettre la vidéo en pause';
  const playLabel = 'Reprendre la vidéo';

  for (const player of document.querySelectorAll<HTMLElement>('[data-video-player]')) {
    const video = player.querySelector<HTMLVideoElement>('[data-video]');
    const overlay = player.querySelector<HTMLElement>('[data-video-overlay]');
    const soundButton = player.querySelector<HTMLButtonElement>('[data-video-sound]');
    const status = player.querySelector<HTMLElement>('[data-video-status]');
    const statusMessage = player.querySelector<HTMLElement>('[data-video-status-message]');
    const downloadLink = player.querySelector<HTMLAnchorElement>('[data-video-download]');
    if (!video || !overlay || !soundButton || !status || !statusMessage || !downloadLink) continue;

    let mediaFailed = false;
    let playbackRequested = false;
    let sourceSelected = false;

    // Choisir une seule rendition à la première lecture, jamais pendant la lecture.
    const selectSource = () => {
      if (sourceSelected) return;
      sourceSelected = true;
      if (window.matchMedia('(max-width: 767px)').matches && video.dataset.videoMobile) {
        video.src = video.dataset.videoMobile;
      }
    };

    const setStatus = (message = '', offerDownload = false) => {
      statusMessage.textContent = message;
      downloadLink.hidden = !offerDownload;
      status.hidden = message.length === 0;
    };

    const syncPlaybackLabel = () => {
      if (mediaFailed) {
        video.setAttribute('aria-label', 'Vidéo indisponible');
        return;
      }
      video.setAttribute('aria-label', video.paused ? playLabel : pauseLabel);
    };

    const startPlayback = async (autoplayAttempt = false) => {
      playbackRequested = true;
      selectSource();
      try {
        await video.play();
        setStatus();
        syncPlaybackLabel();
        return true;
      } catch {
        video.pause();
        syncPlaybackLabel();
        if (mediaFailed) return false;
        if (autoplayAttempt) {
          setStatus('La lecture automatique n’a pas démarré. Activez le son pour lancer la vidéo.');
        } else {
          setStatus('La vidéo ne peut pas démarrer. ', true);
        }
        return false;
      }
    };

    const showMediaError = () => {
      mediaFailed = true;
      video.pause();
      overlay.hidden = true;
      setStatus('La vidéo ne peut pas être lue. ', true);
      syncPlaybackLabel();
    };

    video.controls = false;
    video.removeAttribute('controls');
    video.muted = true;
    video.defaultMuted = true;
    video.loop = true;
    const captionsButton = player.querySelector<HTMLButtonElement>('[data-video-captions]');
    if (captionsButton) captionsButton.hidden = false;
    captionsButton?.addEventListener('click', () => {
      const track = video.textTracks[0];
      if (!track) return;
      const showing = track.mode !== 'showing';
      track.mode = showing ? 'showing' : 'disabled';
      captionsButton.setAttribute('aria-pressed', String(showing));
    });
    video.addEventListener('error', showMediaError);
    if (video.error) showMediaError();

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) {
      video.autoplay = false;
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
      syncPlaybackLabel();
    } else {
      // L’affiche prioritaire termine son chargement avant toute requête vidéo.
      // Sur mobile le lecteur est sous le pli : ne pas télécharger hors écran.
      const observePlayback = () => {
        const observer = new IntersectionObserver(entries => {
          if (!entries.some(entry => entry.isIntersecting)) return;
          observer.disconnect();
          if (playbackRequested) return;
          video.autoplay = true;
          video.setAttribute('autoplay', '');
          void startPlayback(true);
        }, { threshold: 0.1 });
        observer.observe(video);
      };
      if (document.readyState === 'complete') observePlayback();
      else window.addEventListener('load', observePlayback, { once: true });
    }

    soundButton.addEventListener('click', async () => {
      video.currentTime = 0;
      video.loop = false;
      video.removeAttribute('loop');
      video.muted = false;
      video.defaultMuted = false;
      if (await startPlayback()) overlay.hidden = true;
    });

    video.addEventListener('click', () => {
      if (mediaFailed) return;
      if (video.paused) void startPlayback();
      else video.pause();
    });

    video.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      video.click();
    });

    video.addEventListener('play', syncPlaybackLabel);
    video.addEventListener('pause', syncPlaybackLabel);
  }
</script>
