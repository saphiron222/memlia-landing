{
  "name": "memlia-landing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Site memlia.fr — Astro, Cloudflare Pages",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run blog:audit && npm run service:audit && npm run build:site && npm run resource:audit:qa",
    "build:site": "astro build && npm run test:blog-contract && npm run test:service-design && node scripts/strip-briefs.mjs && npm run test:blog-title-intent && npm run test:blog-proof-render && npm run test:proof && npm run test:lastmod && npm run test:images && npm run test:preview-export && npm run test:scripts",
    "preview": "astro preview",
    "preview:prepare": "node scripts/prepare-preview.mjs",
    "check": "astro check",
    "test": "playwright test",
    "test:images": "node scripts/verify-m4-images.mjs",
    "lastmod:sync": "node scripts/sync-lastmod.mjs",
    "test:lastmod": "node scripts/sync-lastmod.mjs --check",
    "test:proof-render": "node scripts/render-proof-images.mjs --check",
    "render:proofs": "node scripts/render-proof-images.mjs",
    "render:blog-proofs": "node scripts/render-blog-article-proofs.mjs",
    "test:blog-proof-render": "node scripts/render-blog-article-proofs.mjs --check",
    "test:proof": "python3 -m unittest discover -s tests/proof -v",
    "test:preview-export": "node --test tests/scripts/prepare-preview.test.mjs",
    "test:service-design": "node scripts/verify-service-design.mjs && node --test tests/scripts/service-design.test.mjs",
    "test:c3-r1": "node --test tests/scripts/c3-r1-validator.test.mjs",
    "veille:questions": "node scripts/veille/questions.mjs",
    "veille:reglementaire": "node scripts/veille/reglementaire.mjs",
    "veille:outils": "node scripts/veille-outils.mjs",
    "test:veille": "node --test tests/scripts/veille-acces.test.mjs",
    "test:scripts": "node scripts/test-scripts.mjs",
    "test:indexability": "node scripts/verify-production-indexability.mjs",
    "test:blog-pipeline": "npm run test:blog-pipeline:unit && npm run test:blog-pipeline:render",
    "test:blog-pipeline:unit": "node --test tests/scripts/blog-pipeline.test.mjs tests/scripts/blog-pipeline-hardening.test.mjs tests/scripts/blog-published-authority.test.mjs",
    "test:blog-pipeline:render": "node --test tests/scripts/blog-candidate-render.test.mjs",
    "test:blog-title-intent": "node --test tests/scripts/blog-title-intent.test.mjs",
    "test:blog-contract": "node --test tests/scripts/blog-contract.test.mjs && node scripts/verify-blog-contract.mjs",
    "test:resource-pipeline:unit": "node --test tests/scripts/resource-pipeline.test.mjs",
    "blog:audit": "node scripts/blog-pipeline.mjs audit",
    "service:audit": "node scripts/service-forge.mjs auditer",
    "service:preparer": "node scripts/service-forge.mjs preparer",
    "service:sceller": "node scripts/service-forge.mjs sceller",
    "service:publier": "node scripts/service-forge.mjs publier",
    "blog:create": "node scripts/blog-pipeline.mjs create",
    "blog:verify-source": "node scripts/blog-pipeline.mjs verify-source",
    "blog:gate": "node scripts/blog-pipeline.mjs gate",
    "blog:preview": "node scripts/blog-pipeline.mjs preview",
    "blog:review": "node scripts/blog-pipeline.mjs review",
    "blog:production-check": "node scripts/blog-pipeline.mjs production-check",
    "resource:audit": "node scripts/resource-pipeline.mjs audit",
    "resource:audit:qa": "node scripts/resource-pipeline.mjs audit --phase qa",
    "resource:audit:preview": "node scripts/resource-pipeline.mjs audit --phase preview",
    "resource:audit:approval": "node scripts/resource-pipeline.mjs audit --phase approval",
    "resource:audit:release": "node scripts/resource-pipeline.mjs audit --phase release",
    "resource:validate": "node scripts/resource-pipeline.mjs validate",
    "resource:seal-surfaces": "node scripts/seal-resource-surfaces.mjs",
    "qa:screens": "node scripts/capture.mjs",
    "placeholders": "node scripts/placeholders.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "contact:messages": "node scripts/contact-messages.mjs",
    "contact:dev": "wrangler pages dev dist --ip 127.0.0.1 --port 8789 --show-interactive-dev-session false",
    "contact:purge:deploy": "wrangler deploy -c workers/purge-contact/wrangler.toml",
    "contact:schema": "wrangler d1 execute memlia-contact --remote --file db/contact/0001-messages.sql"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "ajv": "^8.20.0",
    "astro": "^7.3.2",
    "parse5": "8.0.1",
    "sharp": "^0.35.4",
    "undici": "8.10.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "typescript": "^6.0.3"
  }
}
