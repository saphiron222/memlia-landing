---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import Renvois from '@/components/Renvois.astro';
import ProofRow from '@/components/ProofRow.astro';
import Picto, { type NomPicto } from '@/components/Picto.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { serviceNode, SERVICE_ID } from '@/data/schema.mjs';

const page = PAGES_V2.service;
const url = `${SITE.url}${page.chemin}`;
const noeuds = [
  {
    '@type': 'WebPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
    inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': SERVICE_ID },
  },
  serviceNode(),
];
const requis: { picto: NomPicto; titre: string; texte: string }[] = [
  { picto: 'feuilles', titre: 'Les formats réels', texte: 'Pas le format théorique de votre logiciel, celui de vos fichiers.' },
  { picto: 'bouclier', titre: 'Les accès', texte: 'Ce que l’automatisation doit lire, ce qu’elle peut écrire, et où s’arrête son périmètre.' },
  { picto: 'limites', titre: 'Les cas limites', texte: 'Le dossier atypique, le mois particulier, la reprise d’un exercice. Ce sont eux qui font échouer une automatisation naïve.' },
  { picto: 'grille', titre: 'L’environnement', texte: 'La version de vos outils, les postes concernés, qui utilisera quoi.' },
];
const renvois = [
  { texte: 'La carte des tâches automatisables d’un cabinet : onze pôles, soixante familles, une frontière par tâche.', libelle: 'Lire la carte', href: '/blog/automatiser-un-cabinet-comptable-la-carte-des-taches' },
  { texte: 'Contrôler les bulletins de paie avant la DSN : une liste de contrôles à rejouer chaque mois.', libelle: 'Lire la méthode', href: '/blog/controler-les-bulletins-de-paie-avant-la-dsn' },
  { texte: 'Suivre la production sociale dans Excel sans surveiller les personnes.', libelle: 'Lire la méthode', href: '/blog/suivre-la-production-sociale-dans-excel' },
  { texte: 'Nos engagements, écrits avant de commencer.', libelle: 'Nos garanties', href: '/garanties' },
];
const appel = {
  titre: 'Décrivez le geste qui revient.',
  texte: 'Nous regardons ensemble s’il se cadre, ce qu’il faudrait pour le prendre en charge, et à quel prix. Rien à envoyer, aucun engagement.',
  points: ['Le geste : ce que quelqu’un refait chaque mois.', 'Les outils : d’où viennent les fichiers, où va le résultat.', 'Le résultat attendu : ce qui devrait exister à la fin.'],
};
---

<PageCommerciale page={page} noeuds={noeuds} eyebrow="Le service" hero="v2/14-hero-service" appel={appel}>
  <section class="pv" aria-labelledby="situation">
    <ProofRow id="01-flux">
      <div class="pv-copy rv">
        <h2 id="situation">Le geste que quelqu’un refait chaque mois</h2>
        <p>Recopier des montants d’un export vers un classeur. Réclamer les mêmes pièces aux mêmes clients. Comparer deux états qui devraient concorder. Le geste est maîtrisé, il revient chaque mois, et il prend le temps de la personne la plus qualifiée pour autre chose.</p>
        <p class="texte-2">Ce n’est ni un problème de compétence ni un outil qui manque. C’est un savoir-faire qui vit dans la tête d’un collaborateur et dans les habitudes du cabinet, que personne n’a écrit, et qui part le jour où il part.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="prepare">
    <div class="pv-tete rv">
      <h2 id="prepare">Ce que nous livrons, en trois temps</h2>
      <p class="texte-2 lecture">Nous transformons cette règle en automatisation, dans vos outils, en trois temps qui ne changent jamais.</p>
    </div>
    <div class="pv-bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ul class="pv-bande-liste rv-groupe" data-colonnes="3">
        <li class="pv-cellule rv"><h3>L’entrée</h3><p>Nous partons des fichiers que vous utilisez déjà, dans le format où ils arrivent. Un classeur, un export de votre logiciel de paie, un état comptable.</p></li>
        <li class="pv-cellule rv"><h3>La règle</h3><p>Nous l’écrivons avec vous, dans vos mots. Ce qui doit se produire, ce qui constitue une exception, ce qui doit faire arrêter le traitement. Cette écriture est le cœur du travail : une règle qu’on ne sait pas énoncer ne s’automatise pas.</p></li>
        <li class="pv-cellule rv"><h3>La proposition</h3><p>L’automatisation prépare le résultat et le présente. Elle ne l’inscrit pas à votre place. Ce qu’elle génère lui appartient et se régénère ; ce que le cabinet saisit ne se touche jamais.</p></li>
      </ul>
    </div>
  </section>

  <section class="pv pv-inverse" aria-labelledby="cabinet">
    <ProofRow id="v2/02-proposition">
      <div class="pv-copy rv">
        <h2 id="cabinet">Ce qui reste au cabinet</h2>
        <p><strong>La décision. Toujours.</strong></p>
        <p>Une proposition qui vous semble juste se valide. Une proposition qui vous surprend s’examine. Et lorsque la règle ne tranche pas — une donnée manque, une exception n’était pas prévue, deux lectures sont possibles — l’automatisation s’arrête et vous le dit, plutôt que d’écrire quelque chose de faux.</p>
        <p class="texte-2">C’est le point sur lequel nous ne transigeons pas. Une automatisation qui décide seule dans le doute est plus coûteuse que le geste manuel qu’elle remplace.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="requis">
    <ProofRow id="v2/01-qualification">
      <div class="pv-copy rv">
        <h2 id="requis">Ce que nous regardons ensemble avant de nous engager</h2>
        <p>Quatre points, sur vos fichiers réels, pas sur la théorie du logiciel.</p>
        <p class="texte-2">Cette qualification est un travail, pas une formalité. Elle décide si la tâche est automatisable, et à quel coût.</p>
      </div>
    </ProofRow>
    <ul class="pv-cartes rv-groupe" data-vedette>
      {requis.map((r) => (
        <li class="pv-carte rv">
          <div class="pv-carte-marque" aria-hidden="true"><Picto nom={r.picto} taille={24} /></div>
          <div class="pv-carte-corps"><h3>{r.titre}</h3><p>{r.texte}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="pv pv-inverse" aria-labelledby="livre">
    <ProofRow id="07-livrer">
      <div class="pv-copy rv">
        <h2 id="livre">Ce qui est livré</h2>
        <p>Un périmètre écrit, des critères de recette, et une automatisation qui les satisfait sur vos fichiers.</p>
        <p>La recette se joue sur des cas construits ensemble : ceux qui doivent aboutir, et ceux qui doivent échouer. Un refus attendu qui ne se produit pas est un défaut au même titre qu’un résultat faux.</p>
        <p class="texte-2">La maintenance se traite au contrat, pas en supplément implicite : vos règles évoluent, vos formats aussi.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="perimetre">
    <div class="pv-tete rv">
      <h2 id="perimetre">Ce que nous savons écrire</h2>
      <p class="texte-2 lecture">Production comptable, paie et social, portefeuille et échéances, facturation et recouvrement, juridique et fiscal, administratif, ressources humaines, données et outils : soixante familles de tâches, onze pôles, une frontière par tâche. Si votre cabinet la refait chaque mois, elle a une règle, et une règle s’écrit. <a href="/blog/automatiser-un-cabinet-comptable-la-carte-des-taches">Lire la carte des tâches</a>.</p>
    </div>
  </section>

  <section class="pv" aria-labelledby="prix">
    <ProofRow id="v2/03-devis">
      <div class="pv-copy rv">
        <h2 id="prix">Vous payez une tâche prise en charge, pas des sièges.</h2>
        <p>Le devis dépend de la complexité de la tâche : règles à appliquer, formats à traiter, exceptions et contraintes de votre environnement. Il précise le périmètre, les critères de recette et les conditions de maintenance. <strong>Il n’est jamais multiplié par le nombre de postes.</strong></p>
      </div>
    </ProofRow>
  </section>

  <section class="pv pv-inverse" aria-labelledby="outils">
    <ProofRow id="08-integration">
      <div class="pv-copy rv">
        <h2 id="outils">Vos outils</h2>
        <p>Un classeur, un export ou un logiciel métier peut être le point de départ. Nous vérifions les formats et les accès avant de nous engager, et nous vous disons ce qui se branche. <strong>Nous ne promettons rien que nous n’ayons vérifié.</strong></p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="avant">
    <div class="pv-tete rv">
      <h2 id="avant">Pour aller plus loin</h2>
      <p class="texte-2">La carte des tâches, deux méthodes publiées, et nos engagements.</p>
    </div>
    <Renvois items={renvois} colonnes={2} />
  </section>
</PageCommerciale>
