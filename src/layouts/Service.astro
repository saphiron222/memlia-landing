---
import Base from './Base.astro';
import ServiceHero from '@/components/sections/ServiceHero.astro';
import ServiceBody from '@/components/sections/ServiceBody.astro';
import ServiceCouverture from '@/components/sections/ServiceCouverture.astro';
import ServicePrinciples from '@/components/sections/ServicePrinciples.astro';
import AppelFinal from '@/components/sections/AppelFinal.astro';
import Picto from '@/components/Picto.astro';
import RelatedIntegrations from '@/components/RelatedIntegrations.astro';
import { SITE } from '@/data/site.mjs';
import { organizationNode } from '@/data/schema.mjs';
import { serviceDesignFor } from '@/data/service-design';
import { PROOFS } from '@/data/proofs';
import { auteurPar, identiteAuteur, noeudAuteur } from '@/data/auteurs';
import { eeatService } from '@/data/page-eeat';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entree: CollectionEntry<'services'>;
}

const { entree } = Astro.props;
const { data } = entree;
const chemin = `/automatisation/${entree.id}`;
const url = `${SITE.url}${chemin}`;
const noindex = data.status !== 'publie';
const design = serviceDesignFor(entree.id);
const eeat = eeatService(entree.id);
const socialImage = entree.id === 'entrees-sorties-salaries'
  ? { url: `${SITE.url}/proofs/v2/og/44-service-entrees-sorties-salaries.webp`, width: 1200, height: 630, alt: 'Sept annonces fictives : propositions à valider, arrêts et circuit existant conservé.' }
  : entree.id === 'secretariat-juridique'
    ? { url: `${SITE.url}/proofs/v2/og/46-service-secretariat-juridique.webp`, width: 1200, height: 630, alt: 'Échéances fictives : suivi résiduel, brouillon à valider, circuit couvert exclu et date inconnue arrêtée.' }
  : entree.id === 'evaluation-transmission'
    ? { url: `${SITE.url}/proofs/v2/og/47-service-evaluation-transmission.jpg`, width: 1200, height: 630, alt: 'Trois cas fictifs de préparation : ajustement accepté, attente et conflit de versions.' }
  : entree.id === 'circularisation-cac'
    ? { url: `${SITE.url}/proofs/v2/og/${design.heroProof.replace('v2/', '')}.webp`, width: 1200, height: 630, alt: PROOFS[design.heroProof].alt }
  : undefined;
const auteur = auteurPar(eeat.auteur);
const auteurId = `${SITE.url}${identiteAuteur(auteur)}`;
const toolLink = entree.id === 'factures-fournisseurs'
  ? { href: '/outils-comptables-gratuits/calculateur-date-echeance-facture', label: 'Calculer une date d’échéance de facture' }
  : entree.id === 'rapprochement-bancaire'
    ? { href: '/outils-comptables-gratuits/modele-rapprochement-bancaire-excel-gratuit', label: 'Contrôler des soldes fictifs et exporter le CSV' }
    : null;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: data.headline,
      headline: data.headline,
      description: data.description,
      inLanguage: SITE.langue,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${url}#service` },
      breadcrumb: { '@id': `${url}#breadcrumb` },
      author: { '@id': auteurId },
      datePublished: eeat.datePublication,
      dateModified: eeat.dateModification,
    },
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: data.headline,
      serviceType: data.primaryQuery,
      description: data.description,
      url,
      areaServed: 'FR',
      provider: { '@id': `${SITE.url}/#organization` },
      audience: { '@type': 'Audience', audienceType: data.family.startsWith('cac-') ? 'Cabinets de commissariat aux comptes' : "Cabinets d'expertise comptable" },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Automatisation', item: `${SITE.url}/automatisation-cabinet-comptable` },
        { '@type': 'ListItem', position: 3, name: data.headline, item: url },
      ],
    },
    noeudAuteur(auteur, SITE.url),
    organizationNode(),
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.nom,
      inLanguage: SITE.langue,
      publisher: { '@id': `${SITE.url}/#organization` },
    },
  ],
};
---

<Base titre={data.tabTitle} titreSocial={data.ogTitle} description={data.description} chemin={chemin} noindex={noindex} base="/" schema={graph} socialImage={socialImage}>
  <meta slot="head" name="memlia-candidate" content={data.candidateFingerprint} />

  <div class="feuille">
    <article data-service={entree.id} data-service-layout="da-v1">
      <ServiceHero headline={data.headline} hero={data.hero} cta={data.cta} proof={design.heroProof} preview={noindex}>
      </ServiceHero>
      <ServiceCouverture slug={entree.id} />
      <ServiceBody proof={design.bodyProof}>
        <slot />
        {toolLink && (
          <aside class="service-outil" aria-label="Outil gratuit associé">
            <strong>{entree.id === 'rapprochement-bancaire' ? 'Contrôle de soldes fictifs, pas l’appariement des mouvements' : 'Rejouer la règle sur des données fictives'}</strong>
            <a class="lien-action" href={toolLink.href}>{toolLink.label}<Picto nom="fleche" taille={14} /></a>
          </aside>
        )}
      </ServiceBody>
      <RelatedIntegrations servicePath={chemin} />
      <ServicePrinciples />
      <AppelFinal
        id="confier"
        titre="Décrivez le geste qui revient."
        texte="Une description suffit pour le premier échange. Aucun fichier ne vous est demandé à ce stade."
        points={[
          'Le geste : ce qui revient et dans quel outil.',
          'La limite : le cas qui doit arrêter le traitement.',
          'Le résultat : ce que votre équipe doit pouvoir valider.',
        ]}
        action={{ libelle: data.cta.label, href: data.cta.destination }}
      />
    </article>
  </div>
</Base>

<style>
  /* L'outil associé : son intitulé, puis le lien d'action du système de page. */
  .service-outil { display: grid; gap: var(--espace-1); margin-top: var(--espace-10); }
  .service-outil strong { color: var(--texte-fort); font-weight: 600; }
  .service-outil .lien-action { text-decoration: none; }
</style>
