---
import Base from './Base.astro';
import Button from '@/components/Button.astro';
import Picto from '@/components/Picto.astro';
import Insecable from '@/components/Insecable.astro';
import DemoAgent from '@/components/catalogue/DemoAgent.astro';
import Figurine from '@/components/catalogue/Figurine.astro';
import Carte from '@/components/catalogue/Carte.astro';
import { AGENTS, GROUPES, HUB, cheminAgent, ficheDe, type Specialiste } from '@/data/specialistes';
import { imageAgent } from '@/data/images-agents';
import { connecteurNomme, MENTION_MARQUES, LOGOS_SUR_ENCRE } from '@/data/connecteurs';
import { TOUTES_LES_FAMILLES } from '@/data/familles';
import { ficheGraph } from '@/data/schema-agents.mjs';
import '@/styles/catalogue/commun.css';
import '@/styles/catalogue/fiche.css';
interface Props { agent:Specialiste; liens:Readonly<Record<string,{href:string}>>; regle?:{href:string;libelle:string}; }
const {agent,liens,regle}=Astro.props;
const fiche=ficheDe(agent), image=imageAgent(agent);
const voisins=fiche.voisins.map(v=>AGENTS.find(a=>a.slug===v.agent)!);
const taches=fiche.tachesDepart.map(id=>({id,nom:fiche.taches.find(t=>t.famille===id)?.geste??TOUTES_LES_FAMILLES.find(f=>f.id===id)!.libelle}));
const outils=agent.logiciels.map(nom=>connecteurNomme(nom)!);
const references=fiche.eeat.sources.map(s=>({texte:s.mot,href:s.url}));
function fragments(texte:string){const morceaux:Array<{texte:string;href?:string}>=[];let reste=texte;while(reste){const lien=references.map(l=>({...l,i:reste.indexOf(l.texte)})).filter(l=>l.i>=0).sort((a,b)=>a.i-b.i)[0];if(!lien){morceaux.push({texte:reste});break;}if(lien.i)morceaux.push({texte:reste.slice(0,lien.i)});morceaux.push({texte:lien.texte,href:lien.href});reste=reste.slice(lien.i+lien.texte.length);}return morceaux;}
const csp="default-src 'self'; base-uri 'self'; connect-src 'none'; font-src 'self'; form-action 'self'; img-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'";
---
<Base titre={fiche.titreOnglet} titreSocial={fiche.h1} description={fiche.description} chemin={cheminAgent(agent)} socialImage={{url:fiche.image.url,width:1200,height:630,alt:fiche.image.alt}} schema={ficheGraph(agent)} csp={csp}>
<div class="feuille catalogue-page routine-page agent-page" data-agent-fiche={agent.slug}>
<div class="routine-haut"><nav class="catalogue-ariane" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li><a href={HUB.chemin}>Agents IA</a></li><li aria-current="page">{agent.prenom} · {agent.libelle}</li></ol></nav></div>
<section class="routine-hero" aria-labelledby="routine-titre" data-agent-section="hero"><div class="routine-hero-texte"><div class="routine-identite"><div><Figurine {...image} taille={84} prioritaire/></div><p class="surtitre">{agent.prenom} · Agent IA {agent.libelle.toLocaleLowerCase('fr')}</p></div><h1 id="routine-titre"><Insecable texte={fiche.h1}/></h1><p>{fiche.chapeau}</p><Button href="/contact" variante="principal" picto="fleche" data-tache-agent={taches[0].id}>Confier une première tâche</Button><a class="catalogue-action" href="#livrables">Voir ce que l’agent vous remet<Picto nom="chevron" taille={14}/></a></div><DemoAgent agent={agent}/></section>
<section class="catalogue-section" id="livrables" aria-labelledby="livrables-titre" data-agent-section="livrables"><div class="tete"><h2 id="livrables-titre">Ce que {agent.prenom} vous remet.</h2><p>Des sorties à relire et à utiliser dans votre cabinet.</p></div><dl class="routine-livrables">{fiche.livrables.map(l=><div><dt>{l.titre}</dt><dd>{l.texte}</dd></div>)}</dl><p class="mention">Exemples sur dossier fictif. Nous adaptons les formats, le classement et les validations à votre cabinet.</p></section>
<section class="catalogue-section" aria-labelledby="fonctionnement-titre" data-agent-section="fonctionnement"><div class="tete"><h2 id="fonctionnement-titre">Un agent du catalogue, adapté à vos tâches.</h2></div><ol class="catalogue-etapes"><li><span class="catalogue-etape-numero">01</span><h3>Vous montrez le travail</h3><p>Nous parcourons une tâche courante et ses exceptions : documents reçus, outils ouverts, résultat attendu et décisions de votre équipe.</p></li><li><span class="catalogue-etape-numero">02</span><h3>Nous réglons l’agent</h3><p>Nous adaptons ses tâches, ses accès et ses formats à votre règle. Les essais sur dossiers fictifs vérifient les propositions et les conditions d’arrêt.</p></li><li><span class="catalogue-etape-numero">03</span><h3>Vous vérifiez, nous maintenons</h3><p>Votre équipe accepte le résultat avant sa mise en service. Nous suivons ensuite les évolutions des outils et de la règle, dans le périmètre convenu.</p></li></ol></section>
<section class="catalogue-section" aria-labelledby="taches-titre" data-agent-section="taches"><div class="tete"><h2 id="taches-titre">Les tâches prises en charge.</h2></div><div class="routine-taches-outils"><div><dl class="routine-taches">{fiche.taches.map((t,i)=><div id={`tache-${t.famille}-${i+1}`}><dt>{t.geste}</dt><dd>{t.prepare}{liens[t.famille]&&<a class="catalogue-action" href={liens[t.famille].href}>Détailler cette tâche<Picto nom="fleche" taille={14}/></a>}</dd></div>)}</dl>{fiche.aussi.length>0&&<p class="mention">Aussi dans son périmètre : {fiche.aussi.map(t=>t.texte).join(' ')}</p>}</div><aside class="routine-outils" aria-labelledby="outils-titre" data-agent-outils><h3 id="outils-titre">Dans vos outils</h3><p>Nous préparons le déploiement dans vos logiciels, avec les accès et les formats définis ensemble.</p><ul>{outils.map(o=><li><a href={`/integrations#${o.id}`}>{o.logo&&<img src={o.logo.src} width="28" height="28" alt="" loading="lazy" class:list={{'logo-sur-encre':LOGOS_SUR_ENCRE.has(o.id)}}/>}{o.nom}</a></li>)}</ul><p>Votre logiciel n’est pas listé ? Nous l’intégrons sur demande.</p><a class="catalogue-action" href="/integrations">Toutes les compatibilités<Picto nom="fleche" taille={14}/></a><p class="mention">{MENTION_MARQUES}</p></aside></div></section>
<section class="catalogue-section" aria-labelledby="comparaison-titre" data-agent-section="comparaison"><div class="tete"><h2 id="comparaison-titre">Les mêmes tâches. Une autre façon de les suivre.</h2></div><div class="routine-comparaison" data-table-scroll role="region" aria-label={`Avec et sans ${agent.prenom}`} tabindex="0"><table><thead><tr><th scope="col">Sans l’agent</th><th scope="col">Avec {agent.prenom}</th></tr></thead><tbody>{fiche.avecSans.map(l=><tr><td>{l.sans}</td><td>{l.avec}</td></tr>)}</tbody></table></div></section>
<section class="catalogue-section" id="regle" aria-labelledby="regle-titre" data-agent-section="regle"><div class="routine-regle"><h2 id="regle-titre">La règle écrite.</h2><p>{agent.demonstration.regle}</p><div class="routine-frontiere">{['Se prépare dans le périmètre configuré','Attend votre validation','Reste au cabinet'].map((titre,i)=><div><h3>{titre}</h3><ul>{fiche.frontiere.map(l=><li>{l[i]}</li>)}</ul></div>)}</div><div class="routine-arrets"><h3>Ce qui arrête la tâche</h3><ul>{fiche.arrets.map(a=><li>{a}</li>)}</ul></div><div class="routine-arrets"><h3>Ce qui ne part jamais sans vous</h3><ul>{fiche.neJamaisSansVous.map(l=><li><strong>{l.envoi} :</strong> {l.validation}</li>)}</ul></div>{regle&&<a href={regle.href}>La tâche détaillée : {regle.libelle}</a>}</div></section>
<section class="catalogue-section" aria-labelledby="voisins-titre" data-agent-section="voisins"><div class="tete"><h2 id="voisins-titre">Utiles avant ou après.</h2><p>Chaque métier garde ses tâches et sa règle. Ces agents peuvent préparer la suite.</p></div><ul class="catalogue-grille">{voisins.map(v=><li><Carte nom={v.prenom} fonction={v.libelle} resume={v.ligne} categorie={GROUPES.find(g=>g.id===v.groupe)!.libelle} href={cheminAgent(v)} image={imageAgent(v)} nature="Agent IA Memlia" action={`Découvrir ${v.prenom}`}/></li>)}</ul><a class="catalogue-action" href="/methode">Derrière ces agents, notre méthode<Picto nom="fleche" taille={14}/></a></section>
<section class="catalogue-section routine-faq" aria-labelledby="faq-titre" data-agent-section="faq" data-faq><div class="tete"><h2 id="faq-titre">Avant de confier cette tâche.</h2></div><div>{fiche.faq.questions.map((q,i)=><details id={`faq-${agent.slug}-${i+1}`}><summary>{q.question}<Picto nom="chevron" taille={16}/></summary><p class="faq-r">{fragments(q.reponse).map(f=>f.href?<a href={f.href} rel="noopener noreferrer">{f.texte}</a>:f.texte)}</p></details>)}</div></section>
<section class="catalogue-fin" id="depart" aria-labelledby="contact-titre" data-agent-section="contact" data-agent-depart><h2 id="contact-titre">Par quelle tâche commencer ?</h2><p>Vous payez une tâche prise en charge, pas des sièges. Le devis précise le déploiement, les adaptations et la maintenance selon la complexité du besoin.</p><ul class="routine-departs">{taches.map(t=><li><a href="/contact" data-tache-agent={t.id}>{t.nom}<Picto nom="fleche" taille={14}/></a></li>)}</ul><Button href="/contact" variante="principal" picto="fleche" data-tache-agent={taches[0].id}>Confier une première tâche</Button><p class="mention">Rien à envoyer : la description suffit.</p></section>
<div class="routine-retour" data-agent-section="retour"><a class="catalogue-action" href={HUB.chemin}><Picto nom="gauche" taille={14}/>Tous les agents IA</a></div>
</div>
</Base>
<script>import '@/lib/table-keyboard';
document.querySelectorAll<HTMLAnchorElement>('a[data-tache-agent]').forEach(lien=>lien.addEventListener('click',()=>{try{sessionStorage.setItem('memlia-tache',lien.dataset.tacheAgent??'');}catch{/* Le contact reste utilisable sans stockage. */}}));
const ouvrirAncre=()=>{const cible=document.getElementById(location.hash.slice(1));if(cible instanceof HTMLDetailsElement&&cible.closest('.routine-faq'))cible.open=true;};ouvrirAncre();addEventListener('hashchange',ouvrirAncre);
</script>
<style>.routine-outils .logo-sur-encre {background:var(--encre);padding:3px;border-radius:4px;}.routine-taches dd .catalogue-action {display:flex;font-size:var(--t-sm);}.routine-regle > a {color:var(--creme);}</style>
