---
import { getCollection, render } from 'astro:content';
import Article from '@/layouts/Article.astro';
import { isBlogEntryVisible } from '@/data/blog-visibility.mjs';

/**
 * Route /blog/<slug> : un fichier par article publié (brouillon: false). Les brouillons
 * ne produisent aucune page. « À lire ensuite » : les autres articles, du plus récent
 * au plus ancien, deux au plus.
 */
export async function getStaticPaths() {
  const publies = (await getCollection('blog', isBlogEntryVisible)).sort(
    (a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime()
  );
  return publies.map((entree) => ({
    params: { slug: entree.id },
    props: { entree, suivants: publies.filter((e) => e.id !== entree.id).slice(0, 2) },
  }));
}

const { entree, suivants } = Astro.props;
const { Content, headings } = await render(entree);
---

<Article entree={entree} suivants={suivants} headings={headings}>
  <Content />
</Article>
