---
import { getCollection } from 'astro:content';
import Service from '@/layouts/Service.astro';
import { eeatService, lierSources } from '@/data/page-eeat';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entree) => ({ params: { slug: entree.id }, props: { entree } }));
}

const { entree } = Astro.props;
// Le corps rendu de la fiche, chaque source posée sur un mot de son texte (décision de Kevin du 06/10/2026) :
// le fichier scellé de la fiche reste intact, seul son rendu porte les liens.
const corps = entree.rendered?.html;
if (!corps) throw new Error(`Corps rendu absent pour /automatisation/${entree.id}`);
const html = lierSources(corps, eeatService(entree.id).sources);
---

<Service entree={entree}>
  <Fragment set:html={html} />
</Service>
