---
import ProofMedia from '@/components/ProofMedia.astro';
import type { ProofId } from '@/data/proofs';
interface Props { id: ProofId; enlarge?: boolean; }
const { id, enlarge = false } = Astro.props;
---
<div class="proof-row" data-proof-row>
  <div class="proof-copy" data-proof-copy><slot /></div>
  <ProofMedia id={id} enlarge={enlarge} />
</div>
<style>
  .proof-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 32px; border-top: 1px solid var(--ligne); }
  .proof-copy { min-width: 0; }
  @media (min-width: 64rem) {
    .proof-row { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 0; min-height: 400px; padding-block: 20px; }
    .proof-copy { padding-right: 48px; }
  }
</style>
