---
import { MODELS, POLES, MODEL_FORMATS, modelPrompt, GENERATOR_PATH } from '@/lib/bibliotheque-prompts.mjs';
---
<div class="catalogue" data-library>
  <form method="dialog" class="filters" data-filters autocomplete="off" data-own-telemetry>
    <label>Rechercher un prompt<input name="query" type="search" disabled maxlength="200" placeholder="Relance, contrôle, note…" /></label>
    <details class="library-facettes" data-outil-options><summary>Affiner la recherche</summary>
      <div><label for="library-pole">Pôle</label><select id="library-pole" name="pole" disabled><option value="">Tous les pôles</option>{POLES.map(p => <option value={p.id}>{p.label}</option>)}</select></div>
      <div><label for="library-format">Format attendu</label><select id="library-format" name="format" disabled><option value="">Tous les formats</option>{MODEL_FORMATS.map(f => <option value={f.id}>{f.label}</option>)}</select></div>
      <div><label for="library-task">Tâche</label><select id="library-task" name="task" disabled><option value="">Toutes les tâches</option>{MODELS.map(m => <option value={m.id}>{m.title}</option>)}</select></div>
    </details>
    <button type="reset" hidden disabled class="btn btn-contour">Effacer les filtres</button>
  </form>
  <div class="rail-heading"><p data-count role="status">12 modèles disponibles.</p><div class="rail-actions" data-prompt-navigation hidden><button type="button" class="btn btn-contour" data-slide="prev" aria-label="Prompts précédents">←</button><button type="button" class="btn btn-contour" data-slide="next" aria-label="Prompts suivants">→</button></div></div>
  <p data-empty hidden>Aucun prompt trouvé. Essayez un autre mot.</p>
  <div class="prompt-gallery-rail" data-prompt-rail role="region" aria-label="Galerie de prompts, défilement horizontal" tabindex="0">
    {MODELS.map(m => <article class="carte model" data-model={m.id} aria-labelledby={`title-${m.id}`}>
      <p class="carte-meta meta">{POLES.find(p => p.id === m.pole)?.label}</p>
      <h3 id={`title-${m.id}`} class="carte-titre">{m.title}</h3>
      <p class="carte-texte">{m.context}</p>
      <a class="lien-action" href={`#prompt-${m.id}`} data-read={m.id}>Lire le prompt complet →</a>
    </article>)}
  </div>
  {MODELS.map(m => <section class="prompt-reader" id={`prompt-${m.id}`} data-prompt-reader={m.id} aria-labelledby={`reader-${m.id}`}>
    <h3 id={`reader-${m.id}`} tabindex="-1">{m.title}</h3>
    <label>Prompt complet<textarea readonly rows="16" spellcheck="false" data-text data-public-prompt>{modelPrompt(m)}</textarea></label>
    <button type="button" class="btn btn-principal" data-copy disabled>Copier le prompt</button>
    <details data-outil-options><summary>Personnaliser ou télécharger</summary><div class="actions" data-actions><button type="button" class="btn btn-contour" data-export disabled>Exporter en texte</button><a class="btn btn-contour" href={GENERATOR_PATH} data-adapt>Adapter dans le générateur</a></div></details>
    <p data-card-status aria-live="polite"></p><a href={GENERATOR_PATH} data-adapt-fallback hidden>Ouvrir le générateur →</a>
  </section>)}
</div>
<script>
  import { filterModels, TRANSFER_KEY, GENERATOR_PATH } from '@/lib/bibliotheque-prompts.mjs';
  const root = document.querySelector<HTMLElement>('[data-library]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-filters]')!;
    // Le gabarit réserve leur place dès le HTML ; seul leur état change au démarrage.
    root.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>('[disabled]').forEach(el => el.disabled = false);
    const rail = root.querySelector<HTMLElement>('[data-prompt-rail]')!;
    root.querySelector<HTMLElement>('[data-prompt-navigation]')!.hidden = false;
    root.querySelectorAll<HTMLButtonElement>('[data-slide]').forEach(button => button.addEventListener('click', () => rail.scrollBy({left:(button.dataset.slide==='next'?1:-1)*rail.clientWidth,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})));
    const navigation=()=>{root.querySelector<HTMLButtonElement>('[data-slide=prev]')!.disabled=rail.scrollLeft<=1;root.querySelector<HTMLButtonElement>('[data-slide=next]')!.disabled=rail.scrollLeft+rail.clientWidth>=rail.scrollWidth-1;};
    rail.addEventListener('scroll',navigation,{passive:true});new ResizeObserver(navigation).observe(rail);navigation();
    const readers = [...root.querySelectorAll<HTMLElement>('[data-prompt-reader]')];
    const activate=(reader:HTMLElement,focus=false)=>{
      readers.forEach(el=>el.hidden=el!==reader);
      if(focus)reader.querySelector<HTMLElement>('h3')!.focus();
      else requestAnimationFrame(()=>reader.scrollIntoView({block:'start',behavior:'instant'}));
    };
    const fromHash=()=>{
      const reader=readers.find(el=>`#${el.id}`===location.hash);
      if(reader)activate(reader);else if(!location.hash)readers.forEach(el=>el.hidden=true);
    };
    readers.forEach(reader=>reader.hidden=true);fromHash();
    window.addEventListener('hashchange',fromHash);window.addEventListener('popstate',fromHash);
    root.querySelectorAll<HTMLAnchorElement>('[data-read]').forEach(link=>link.addEventListener('click',event=>{
      event.preventDefault();const reader=readers.find(el=>el.dataset.promptReader===link.dataset.read)!;
      if(location.hash!==link.hash)history.pushState(null,'',link.hash);
      activate(reader,true);
    }));
    const filter = () => {
      const ids = new Set(filterModels(Object.fromEntries(new FormData(form))).map(m => m.id));
      root.querySelectorAll<HTMLElement>('[data-model]').forEach(el => el.hidden = !ids.has(el.dataset.model!));
      root.querySelector('[data-count]')!.textContent = `${ids.size} modèle${ids.size > 1 ? 's' : ''} disponible${ids.size > 1 ? 's' : ''}.`;
      root.querySelector<HTMLElement>('[data-empty]')!.hidden = ids.size !== 0;
      form.querySelector<HTMLButtonElement>('[type=reset]')!.hidden = ![...new FormData(form).values()].some(value=>String(value).trim());
      readers.filter(el => !ids.has(el.dataset.promptReader!)).forEach(el => {el.hidden=true;if(location.hash===`#${el.id}`)history.replaceState(null,'',location.pathname+location.search);});
      rail.scrollLeft = 0;requestAnimationFrame(navigation);
    };
    form.addEventListener('submit', e => e.preventDefault());
    form.addEventListener('input', filter); form.addEventListener('change', filter);
    form.addEventListener('reset', (event) => {
      event.preventDefault();
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input,select').forEach(field => field.value = '');
      filter();
    });
    root.querySelectorAll<HTMLElement>('[data-prompt-reader]').forEach(card => {
      const text = card.querySelector<HTMLTextAreaElement>('[data-text]')!;
      const status = card.querySelector<HTMLElement>('[data-card-status]')!;
      const emit = (action: string) => window.dispatchEvent(new CustomEvent('memlia:outil', { detail: { action, outil: 'bibliotheque-prompts-comptables' } }));
      card.querySelector('[data-copy]')!.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(text.value); status.textContent = 'Modèle complet copié.'; emit('copie'); }
        catch { text.focus(); text.select(); status.textContent = 'Copie indisponible. Le prompt complet est sélectionné : utilisez votre raccourci de copie ou exportez-le.'; }
      });
      card.querySelector('[data-export]')!.addEventListener('click', () => {
        const url = URL.createObjectURL(new Blob([text.value], { type: 'text/plain;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url; link.download = `prompt-${card.dataset.promptReader}.txt`;
        document.body.append(link);
        try { link.click(); status.textContent = 'Fichier texte complet préparé.'; emit('export'); }
        // Laisser le navigateur consommer le Blob avant de libérer sa référence.
        finally { setTimeout(() => { link.remove(); URL.revokeObjectURL(url); }, 1000); }
      });
      card.querySelector('[data-adapt]')!.addEventListener('click', (e) => {
        e.preventDefault();
        try { sessionStorage.setItem(TRANSFER_KEY, JSON.stringify({ version: 1, id: card.dataset.promptReader })); emit('reprise'); window.location.assign(GENERATOR_PATH); }
        catch { status.textContent = 'Stockage temporaire indisponible. Copiez le prompt avant de continuer.';card.querySelector<HTMLAnchorElement>('[data-adapt-fallback]')!.hidden=false; }
      });
    });
  }
</script>
<style>
.catalogue,.filters,.prompt-reader{display:grid;gap:20px;min-width:0}.catalogue .btn{min-height:44px}.catalogue .filters{grid-template-columns:minmax(0,1fr) auto;align-items:end}.catalogue .filters [data-outil-options]{border:0;padding:0}.library-facettes[open]{grid-column:1/-1}.catalogue label{display:grid;gap:8px;font-weight:600;min-width:0}.catalogue :is(input,select,textarea){width:100%;min-width:0;min-height:48px;padding:12px;border:1px solid var(--ligne-forte);border-radius:var(--r-bouton);background:var(--surface-feuille);color:var(--texte-fort);font:inherit}.catalogue textarea{resize:vertical;line-height:1.6;font-weight:400}.rail-heading{min-height:44px}.rail-heading,.rail-actions,.actions{display:flex;align-items:center;justify-content:space-between;gap:12px}.rail-actions .btn{min-width:44px;min-height:44px;padding:8px}.prompt-gallery-rail{display:flex;min-width:0;max-width:100%;gap:20px;overflow-x:auto;scroll-snap-type:x proximity;scroll-padding:4px;padding:8px 4px 20px;overscroll-behavior-x:contain}.model{flex:0 0 82%;display:flex;flex-direction:column;gap:12px;scroll-snap-align:start;min-width:0}.model .lien-action{margin-top:auto;padding-block:8px}.prompt-reader{scroll-margin-top:calc(var(--nav-h) + 24px);padding:24px;border:1px solid var(--ligne);border-radius:var(--r-carte);background:var(--accent-voile)}.prompt-reader h3{font-size:var(--titre-bloc)}.prompt-reader>.btn,.filters>.btn{justify-self:start}.prompt-reader p:empty{display:none}.actions{justify-content:flex-start;flex-wrap:wrap}.catalogue [hidden]{display:none!important}.catalogue summary{cursor:pointer;min-height:44px}.library-facettes[open]{display:grid;gap:16px}@media(min-width:48rem){.model{flex-basis:calc((100% - 20px)/2)}}@media(min-width:75rem){.model{flex-basis:calc((100% - 40px)/3)}}@media(max-width:40rem){.catalogue .filters{grid-template-columns:1fr}.prompt-reader{padding:16px}}
</style>
