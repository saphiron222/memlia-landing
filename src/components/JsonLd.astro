---
import { SITE, OG_IMAGE } from '@/data/site.mjs';
import { FAQ } from '@/data/faq';


/**
 * Données structurées de l'accueil — quatre nœuds conservés (Organization, WebSite,
 * Service, FAQPage). Ne décrivent que des faits : ni avis, ni note, ni chiffre
 * client (ligne rouge « aucune preuve inventée »). Le texte FAQ est celui de l'accordéon.
 */
interface Props {
  description: string;
}
const { description } = Astro.props;
const u = `${SITE.url}/`;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${u}#organization`,
      name: SITE.nom,
      url: u,
      logo: `${SITE.url}/apple-touch-icon.png`,
      email: SITE.email,
      slogan: SITE.tagline,
      description:
        "Memlia est un service d'automatisation IA pour cabinets d'expertise comptable : un processus cadré, une automatisation éprouvée sur jeux fictifs et des décisions sensibles validées par le cabinet.",
      contactPoint: {
        '@type': 'ContactPoint',
        email: SITE.email,
        contactType: 'customer support',
        areaServed: 'FR',
        availableLanguage: 'French',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${u}#website`,
      url: u,
      name: SITE.nom,
      inLanguage: SITE.langue,
      publisher: { '@id': `${u}#organization` },
    },
    {
      '@type': 'Service',
      '@id': `${u}#service`,
      name: 'Memlia : automatisation IA du cabinet',
      serviceType: "Automatisation IA pour cabinets d'expertise comptable",
      areaServed: 'FR',
      url: u,
      image: OG_IMAGE.url,
      description,
      provider: { '@id': `${u}#organization` },
      audience: { '@type': 'Audience', audienceType: "Cabinets d'expertise comptable" },
    },
    {
      '@type': 'FAQPage',
      '@id': `${u}#faq`,
      inLanguage: SITE.langue,
      isPartOf: { '@id': `${u}#website` },
      about: { '@id': `${u}#service` },
      mainEntity: FAQ.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: { '@type': 'Answer', text: q.reponse },
      })),
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
