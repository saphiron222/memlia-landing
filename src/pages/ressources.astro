---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Picto from '@/components/Picto.astro';
import { CTA, SITE } from '@/data/site.mjs';
import { isBlogEntryVisible } from '@/data/blog-visibility.mjs';
import { projectPublicResources, RESOURCE_ROLE_LABELS } from '@/data/resources';

const title = 'Ressources pour les tâches du cabinet | Memlia';
const description = 'Des ressources pour comprendre, vérifier et cadrer les tâches d’un cabinet, sans céder la décision humaine.';
const path = '/ressources';
const url = `${SITE.url}${path}`;
const articles = await getCollection('blog', isBlogEntryVisible);
const resources = projectPublicResources(articles);
const featured = resources.find((resource) => resource.id.includes('controler-les-bulletins')) ?? resources[0];
const complements = resources.filter((resource) => resource.id !== featured?.id).slice(0, 2);
const roles = [...new Set(resources.map((resource) => resource.role))];
const types = [...new Set(resources.map((resource) => resource.type))];
const pathCopy = {
  comprendre: {
    title: 'Comprendre',
    description: 'Clarifier un terme, une règle ou les limites d’une approche.',
  },
  'faire-verifier': {
    title: 'Faire et vérifier',
    description: 'Suivre une méthode, contrôler la sortie et savoir quand s’arrêter.',
  },
  cadrer: {
    title: 'Cadrer une automatisation',
    description: 'Décrire la tâche, les exceptions et la validation attendue avant de parler solution.',
  },
};
const formatDate = (date: Date | null) => date?.toLocaleDateString('fr-FR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage', '@id': `${url}#page`, url,
      name: title.replace(' | Memlia', ''), description, inLanguage: SITE.langue,
      isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': `${url}#liste` },
    },
    {
      '@type': 'ItemList', '@id': `${url}#liste`, numberOfItems: resources.length,
      itemListElement: resources.map((resource, index) => ({
        '@type': 'ListItem', position: index + 1, name: resource.title,
        url: `${SITE.url}${resource.href}`,
      })),
    },
    {
      '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Ressources', item: url },
      ],
    },
    { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.nom, url: `${SITE.url}/`, logo: `${SITE.url}/apple-touch-icon.png`, email: SITE.email },
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.nom, inLanguage: SITE.langue, publisher: { '@id': `${SITE.url}/#organization` } },
  ],
};
---

<Base titre={title} description={description} chemin={path} base="/">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />

  <div class="feuille ressources-feuille">
    <section class="conteneur ressources-tete" aria-labelledby="ressources-titre">
      <nav class="ariane" aria-label="Fil d’Ariane">
        <ol><li><a href="/">Accueil</a></li><li aria-current="page">Ressources</li></ol>
      </nav>
      <h1 id="ressources-titre">Des ressources pour faire avancer une tâche du cabinet.</h1>
      <p class="texte-2 lecture ressources-intro">{description}</p>
      <p class="texte-2 lecture ressources-intro">Comprendre une règle, préparer son exécution, vérifier les limites ou cadrer une automatisation : chaque ressource distingue ce qui peut être préparé de ce que le professionnel doit valider.</p>
    </section>

    {featured && (
      <section class="conteneur selection" aria-labelledby="selection-titre">
        <div class="selection-tete">
          <h2 id="selection-titre">À consulter en premier</h2>
          <p class="texte-2">Une ressource de fond, puis deux compléments pour passer de la question au contrôle.</p>
        </div>
        <article class="selection-principale">
          <p class="selection-tache">{featured.task}</p>
          <h3><a href={featured.href}>{featured.title}</a></h3>
          <p class="texte-2">{featured.summary}</p>
          <span class="selection-lien" aria-hidden="true">Lire l’article <Picto nom="fleche" taille={16} /></span>
          <footer><span>{featured.typeLabel}</span><span>{featured.roleLabel}</span></footer>
        </article>
        <div class="selection-complements">
          {complements.map((resource) => (
            <article>
              <p>{resource.task}</p>
              <h3><a href={resource.href}>{resource.title}</a></h3>
              <span>{resource.typeLabel}</span>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="conteneur parcours" aria-label="Choisir un parcours">
      {Object.entries(pathCopy).map(([key, copy]) => (
        <div>
          <h2>{copy.title}</h2>
          <p class="texte-2">{copy.description}</p>
          <ul>
            {resources.filter((resource) => resource.path === key).map((resource) => (
              <li><a href={resource.href}>{resource.task}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="conteneur registre" aria-labelledby="registre-titre">
      <header class="registre-tete">
        <h2 id="registre-titre">Toutes les ressources</h2>
        <p class="texte-2">Affinez par rôle ou par format. Sans filtre, la liste complète reste affichée.</p>
      </header>
      <div class="filtres" data-filters hidden>
        <div>
          <label for="resource-role">Rôle</label>
          <select id="resource-role" data-role-filter>
            <option value="">Tous les rôles</option>
            {roles.map((role) => <option value={role}>{RESOURCE_ROLE_LABELS[role]}</option>)}
          </select>
        </div>
        <div>
          <label for="resource-type">Format</label>
          <select id="resource-type" data-type-filter>
            <option value="">Tous les formats</option>
            {types.map((type) => <option value={type}>{type === 'article' ? 'Articles' : 'Glossaire'}</option>)}
          </select>
        </div>
        <button type="button" data-reset disabled>Réinitialiser les filtres</button>
      </div>
      <p class="compteur" data-count>{resources.length} ressources</p>
      <p class="etat-vide" data-empty hidden>Aucune ressource ne correspond à ces filtres.</p>
      <ol class="registre-liste" data-resource-list>
        {resources.map((resource) => (
          <li data-resource-id={resource.id} data-role={resource.role} data-type={resource.type}>
            <article class="resource-line">
              <div class="resource-meta">
                <span>{resource.typeLabel}</span><span>{resource.roleLabel}</span>
                {resource.date && <time datetime={resource.date.toISOString().slice(0, 10)}>{formatDate(resource.date)}</time>}
              </div>
              <p class="resource-task">{resource.task}</p>
              <h3><a href={resource.href}>{resource.title}</a></h3>
              <p class="texte-2 resource-summary">{resource.summary}</p>
            </article>
          </li>
        ))}
      </ol>
      <noscript><p class="texte-2 sans-js">La liste complète est affichée. Les filtres nécessitent JavaScript.</p></noscript>
    </section>

    <section class="conteneur ressources-sortie" aria-labelledby="sortie-titre">
      <h2 id="sortie-titre">Une tâche revient chaque mois ?</h2>
      <p class="texte-2">Le premier échange sert à écrire la règle, ses exceptions et la validation attendue, sans transmettre de donnée client réelle.</p>
      <Button href={CTA.principal.href} variante="principal" picto="fleche">{CTA.principal.libelle}</Button>
    </section>
  </div>
</Base>

<style>
  .ressources-feuille { background: var(--surface-feuille); padding-bottom: clamp(64px, 9vw, 120px); }
  .ressources-tete { display: grid; gap: 18px; padding-top: clamp(28px, 5vw, 64px); }
  .ariane ol { display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--t-sm); color: var(--texte-2); }
  .ariane li + li::before { content: '›'; margin-right: 6px; color: var(--picto-repos); }
  .ariane a { text-decoration: underline; text-underline-offset: 2px; }
  .ariane [aria-current] { color: var(--texte); }
  .ressources-tete h1 { max-width: 22ch; }
  .ressources-intro { max-width: 65ch; }
  .selection { display: grid; gap: 0; margin-top: clamp(48px, 7vw, 88px); }
  .selection-tete { display: grid; gap: 8px; max-width: 65ch; margin-bottom: 24px; }
  .selection-tete h2, .registre-tete h2 { font-size: var(--t-4xl); }
  .selection-principale { display: grid; align-content: start; gap: 14px; padding: clamp(24px, 4vw, 44px); border: 1px solid var(--ligne); border-left: 4px solid var(--accent-appui); background: var(--surface-page); }
  .selection-tache, .resource-task { color: var(--texte-fort); font-weight: 600; }
  .selection-principale h3 { font-size: var(--t-3xl); max-width: 25ch; }
  .selection-principale h3 a, .selection-complements h3 a, .resource-line h3 a { text-decoration: underline; text-decoration-color: var(--ligne-forte); text-underline-offset: 5px; }
  .selection-lien { display: inline-flex; align-items: center; gap: 6px; color: var(--accent-texte); font-size: var(--t-sm); font-weight: 600; }
  .selection-principale footer, .resource-meta { display: flex; flex-wrap: wrap; gap: 4px 18px; color: var(--texte-2); font-size: var(--t-sm); }
  .selection-principale footer { padding-top: 14px; border-top: 1px solid var(--ligne); }
  .selection-complements { display: grid; align-content: start; border-inline: 1px solid var(--ligne); }
  .selection-complements article { display: grid; gap: 8px; padding: 24px; border-bottom: 1px solid var(--ligne); }
  .selection-complements article > p, .selection-complements article > span { color: var(--texte-2); font-size: var(--t-sm); }
  .selection-complements h3 { font-size: var(--t-xl); }
  .parcours { display: grid; gap: 32px; margin-top: clamp(56px, 8vw, 104px); padding-block: 32px; border-block: 1px solid var(--ligne); }
  .parcours > div { display: grid; align-content: start; gap: 10px; }
  .parcours h2 { font-size: var(--t-2xl); }
  .parcours ul { display: grid; margin-top: 6px; }
  .parcours li { border-top: 1px solid var(--ligne-douce); }
  .parcours a { display: block; padding-block: 12px; color: var(--accent-texte); text-decoration: underline; text-underline-offset: 3px; }
  .registre { margin-top: clamp(64px, 9vw, 112px); }
  .registre-tete { display: grid; gap: 8px; max-width: 65ch; }
  .filtres { display: grid; gap: 12px; margin-top: 28px; padding: 20px; border: 1px solid var(--ligne); background: var(--surface-page); }
  .filtres[hidden] { display: none; }
  .filtres > div { display: grid; gap: 5px; }
  .filtres label { font-size: var(--t-sm); font-weight: 600; color: var(--texte-fort); }
  .filtres select, .filtres button { min-height: 48px; width: 100%; padding: 10px 12px; border: 1px solid var(--ligne-forte); border-radius: var(--r-bouton); background: var(--surface-feuille); color: var(--texte-fort); }
  .filtres button { font-weight: 500; cursor: pointer; }
  .filtres button:disabled { opacity: .5; cursor: default; }
  .compteur { margin-top: 20px; color: var(--texte-2); font-size: var(--t-sm); }
  .etat-vide { margin-top: 16px; padding: 18px; border-left: 3px solid var(--ocre); background: var(--ocre-voile); }
  .registre-liste { margin-top: 8px; border-top: 2px solid var(--texte-fort); }
  .registre-liste > li { border-bottom: 1px solid var(--ligne); }
  .registre-liste > li[hidden] { display: none; }
  .resource-line { display: grid; gap: 8px; padding-block: clamp(24px, 4vw, 36px); }
  .resource-line h3 { font-size: var(--t-2xl); max-width: 40ch; }
  .resource-summary { max-width: 68ch; }
  .sans-js { margin-top: 12px; font-size: var(--t-sm); }
  .ressources-sortie { display: grid; justify-items: start; gap: 12px; max-width: 720px; margin-top: clamp(64px, 9vw, 112px); padding-top: 40px; border-top: 1px solid var(--ligne-forte); }
  .ressources-sortie h2 { font-size: var(--t-3xl); max-width: 24ch; }
  .ressources-sortie p { max-width: 60ch; }
  @media (hover: hover) {
    .filtres button:not(:disabled):hover { background: var(--surface-hover); }
    .selection-principale h3 a:hover, .selection-complements h3 a:hover, .resource-line h3 a:hover { text-decoration-color: var(--accent-appui); }
  }
  @media (min-width: 48rem) {
    .selection { grid-template-columns: minmax(0, 7fr) minmax(260px, 5fr); }
    .selection-tete { grid-column: 1 / -1; }
    .selection-complements { border-left: 0; border-right: 1px solid var(--ligne); }
    .parcours { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .parcours > div:last-child { grid-column: 1 / -1; }
    .filtres { grid-template-columns: repeat(2, minmax(0, 1fr)) auto; align-items: end; }
    .filtres button { width: auto; }
    .resource-line { grid-template-columns: minmax(180px, .8fr) minmax(0, 2.2fr); column-gap: 40px; }
    .resource-meta { grid-column: 1; grid-row: 1 / span 3; align-content: start; flex-direction: column; }
    .resource-task, .resource-line h3, .resource-summary { grid-column: 2; }
  }
  @media (min-width: 64rem) {
    .parcours { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; }
    .parcours > div:last-child { grid-column: auto; }
  }
  @media (forced-colors: active) {
    .selection-principale, .etat-vide { border-left-color: CanvasText; }
  }
</style>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const role = document.querySelector<HTMLSelectElement>('[data-role-filter]');
  const type = document.querySelector<HTMLSelectElement>('[data-type-filter]');
  const reset = document.querySelector<HTMLButtonElement>('[data-reset]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const list = document.querySelector<HTMLElement>('[data-resource-list]');
  if (filters && role && type && reset && count && empty && list) {
    filters.hidden = false;
    const entries = [...list.querySelectorAll<HTMLElement>('[data-resource-id]')];
    let interacted = false;
    const update = () => {
      if (!interacted) {
        interacted = true;
        count.setAttribute('aria-live', 'polite');
      }
      let visible = 0;
      for (const entry of entries) {
        const matches = (!role.value || entry.dataset.role === role.value) && (!type.value || entry.dataset.type === type.value);
        entry.hidden = !matches;
        if (matches) visible += 1;
      }
      count.textContent = `${visible} ${visible === 1 ? 'ressource' : 'ressources'}`;
      empty.hidden = visible !== 0;
      reset.disabled = !role.value && !type.value;
    };
    role.addEventListener('change', update);
    type.addEventListener('change', update);
    reset.addEventListener('click', () => {
      role.value = '';
      type.value = '';
      update();
      role.focus();
    });
  }
</script>
