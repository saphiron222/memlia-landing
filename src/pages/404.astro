---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---

<Base titre="Page introuvable — Memlia" description="Cette page n’existe pas. Retrouvez le service d’automatisation IA et la méthode Memlia depuis l’accueil." chemin="/404" noindex base="/">
  <section class="conteneur erreur">
    <span class="eyebrow">Erreur 404</span>
    <h1>Cette page n’existe pas.</h1>
    <p class="texte-2">Le lien a peut-être changé. Retrouvez notre service d’automatisation IA et notre méthode depuis l’accueil.</p>
    <Button href="/" variante="principal">Retour à l’accueil</Button>
  </section>
</Base>

<style>
  .erreur { padding-block: 96px; min-height: 60vh; }
  h1 { font-size: var(--t-4xl); margin-block: 20px; }
  p { margin-bottom: 32px; max-width: 48ch; }
</style>
