---
/**
 * Renvois de fin de page : une phrase, un lien. Chaque renvoi est une carte du site (`.carte`,
 * global.css), cliquable en entier ; la grille `.cartes` choisit seule ses colonnes selon le
 * nombre de renvois, sans carte orpheline.
 */
interface Props {
  items: { texte: string; libelle: string; href: string }[];
}
const { items } = Astro.props;
---

<ul class="cartes rv-groupe">
  {items.map((r) => (
    <li class="carte rv">
      <div class="carte-corps">
        <p class="carte-texte">{r.texte}</p>
        <a class="carte-action carte-lien" href={r.href}>{r.libelle}</a>
      </div>
    </li>
  ))}
</ul>
