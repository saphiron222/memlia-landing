---
import Picto from '@/components/Picto.astro';

const principes = [
  {
    picto: 'regle' as const,
    titre: 'La règle est écrite',
    texte: 'Le cas courant, les exceptions et la frontière humaine sont lisibles avant le développement.',
  },
  {
    picto: 'limites' as const,
    titre: 'Le doute arrête',
    texte: 'Une donnée absente ou une règle qui ne tranche pas produit un cas à examiner, jamais une valeur probable.',
  },
  {
    picto: 'recette' as const,
    titre: 'Le cabinet valide',
    texte: 'L’automatisation prépare une proposition traçable. La correction et la décision restent au cabinet.',
  },
];
// Système de page : trois engagements, donc la bande du site, bord à bord de la feuille. La
// phrase d'appui suit le titre plutôt qu'un surtitre : au plus un surtitre pour trois sections.
---

<section class="section pile service-principles" data-service-section="principles" aria-labelledby="service-principles-title">
  <div class="conteneur">
    <div class="tete rv">
      <h2 id="service-principles-title">L’IA prépare. L’humain décide.</h2>
      <p>La même frontière, à chaque mission</p>
    </div>
  </div>
  <div class="bande coins">
    <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
    <ul class="cartes rv-groupe">
      {principes.map((principe) => (
        <li class="cellule rv">
          <span class="carte-icone" aria-hidden="true"><Picto nom={principe.picto} taille={24} /></span>
          <h3 class="carte-titre">{principe.titre}</h3>
          <p class="carte-texte">{principe.texte}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
