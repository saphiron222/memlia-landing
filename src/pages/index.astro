---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import { LIEN_CAC } from '@/data/navigation.mjs';
import { cacDisponible } from '@/data/navigation-publiee';
import JsonLd from '@/components/JsonLd.astro';
import Hero from '@/components/editorial/HeroEditorial.astro';
import {sceneSociale} from '@/data/scenes-figurines';
import '@/styles/editorial.css';
import Orientation from '@/components/sections/Orientation.astro';
import Garanties from '@/components/sections/Garanties.astro';
import Promesse from '@/components/sections/Promesse.astro';
import Usages from '@/components/sections/Usages.astro';
import Integration from '@/components/sections/Integration.astro';
import Quotidien from '@/components/sections/Quotidien.astro';
import Preuves from '@/components/sections/Preuves.astro';
import Methode from '@/components/sections/Methode.astro';
import Faq from '@/components/sections/Faq.astro';
import AppelFinal from '@/components/sections/AppelFinal.astro';
import { contenuDe } from '@/data/accueil/contenu';
const contenu = contenuDe('ec');

/**
 * Offre catalogue : robots et agents IA, adaptation et déploiement, sur mesure au besoin.
 */
const titre = 'Automatisation IA pour cabinets comptables | Memlia';
const headline = contenu.hero.titre;
const description =
  'Robots comptables et agents IA Memlia : collecte fiscale, dossiers préparés et écarts à revoir. Déploiement dans vos outils, adaptation et maintenance. Sur mesure au besoin.';
---

<Base titre={titre} titreSocial={headline} description={description} chemin="/" schemaExterne socialImage={sceneSociale('accueil')}>
  <JsonLd slot="head" description={description} headline={headline} />

  <div class="feuille editorial-page">
    <Hero contenu={contenu.hero}>
      {cacDisponible && <Button slot="audience" href={LIEN_CAC.href} variante="lien" picto="fleche" data-accueil-cac>Vous êtes commissaire aux comptes ?</Button>}
    </Hero>
    <Quotidien contenu={contenu.quotidien} scene="accueil" />
    <Orientation contenu={contenu.orientation} />

    <Promesse contenu={contenu.promesse} />
    <Usages contenu={contenu.usages} />
    <Methode contenu={contenu.methode} />
    <Integration contenu={contenu.integration} />
    <Preuves contenu={contenu.preuves} />
    <Garanties contenu={contenu.garanties} />
    <Faq contenu={contenu.faq} />
    <AppelFinal contenu={contenu.appelFinal} />
  </div>
</Base>
