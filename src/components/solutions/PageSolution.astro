---
import type { Solution } from '@/data/solutions';
import { CONNECTEURS } from '@/data/connecteurs';
import { MODELES_OUVERTS } from '@/data/modeles-ouverts';
import Picto from '@/components/Picto.astro';
import Button from '@/components/Button.astro';
import SceneOS from './SceneOS.astro';
import SceneModele from './SceneModele.astro';
import '@/styles/catalogue/commun.css';
import '@/styles/solutions/solutions.css';
interface Props { solution: Solution }
const {solution:s}=Astro.props;
const os=s.id==='os';
const outils=CONNECTEURS.filter(c=>['pennylane','microsoft-sharepoint','google-drive','microsoft-outlook','microsoft-teams','slack'].includes(c.id));
---
<div class="feuille catalogue-page solution-page" data-solution={s.id}>
  <section class="solution-hero" aria-labelledby="solution-titre">
    <nav class="catalogue-ariane" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">{s.nom}</li></ol></nav>
    <p class="surtitre">{s.surtitre}</p><h1 id="solution-titre">{s.h1}</h1><p class="solution-intro">{s.intro}</p>
    <div class="solution-actions"><Button href="/contact" data-tache-solution={os?'solution-memlia-os':'solution-modele-prive'} variante="principal" picto="fleche">Confier une première tâche</Button><Button href={os?'#explorer':'#recette'} variante="lien" picto="chevron">{os?'Explorer Memlia OS':'Voir la recette'}</Button></div>
    {os ? <SceneOS/> : <SceneModele/>}
  </section>
  <section class="catalogue-section" aria-labelledby="probleme-titre"><div class="solution-tete"><h2 id="probleme-titre">{s.probleme.titre}</h2><p>{s.probleme.texte}</p></div><div class="solution-cartes">{s.probleme.cartes.map((c,i)=><article><span class="solution-index">0{i+1}</span><h3>{c.titre}</h3><p>{c.texte}</p></article>)}</div></section>
  {os && <section class="catalogue-section" aria-labelledby="systeme-titre"><div class="solution-tete"><p class="surtitre">Memlia OS</p><h2 id="systeme-titre">Le contexte, les outils et les décisions. Reliés.</h2><p>Le système d’exploitation IA du cabinet organise le travail autour d’une mémoire commune. Chaque équipe garde ses espaces et ses responsabilités.</p></div><div class="os-principes"><article><Picto nom="feuilles" taille={28}/><h3>Une mémoire sourcée</h3><p>Les connaissances restent reliées aux documents autorisés. Vos règles et leurs versions accompagnent les réponses.</p></article><article><Picto nom="flux" taille={28}/><h3>Des agents dans vos outils</h3><p>Vos savoir-faire deviennent des consignes réutilisables. Les agents préparent les tâches dans le périmètre prévu.</p></article><article><Picto nom="recette" taille={28}/><h3>Un travail qui se reprend</h3><p>Sessions, travaux remis et exceptions conservent le contexte utile, avec les règles de conservation convenues.</p></article><article><Picto nom="main" taille={28}/><h3>Vos décisions visibles</h3><p>Les droits filtrent la recherche. Les actions engageantes attendent votre validation. Un cas incertain s’arrête.</p></article></div></section>}
  <section class="catalogue-section" id="os-livraison" aria-labelledby="livrables-titre"><div class="solution-tete"><p class="surtitre">Ce que nous vous remettons</p><h2 id="livrables-titre">{os?'Une mémoire utilisable. Des agents reliés.':'Votre version. Sa recette. Ses résultats.'}</h2></div><div class="solution-livrables">{s.livrables.map((c,i)=><article><span class="solution-index">0{i+1}</span><h3>{c.titre}</h3><p>{c.texte}</p></article>)}</div></section>
  {os ? <>
    <section class="catalogue-section" aria-labelledby="outils-titre"><div class="memlia-surface-verte solution-outils"><div><p class="surtitre">Dans vos outils</p><h2 id="outils-titre">Le cabinet garde ses repères.</h2><p>Logiciels métier, messageries et documents partagés : nous relions les espaces utiles au premier usage. Chaque connexion possède ses accès, ses formats et ses règles.</p><a class="catalogue-action" href="/integrations">Explorer les intégrations communes →</a></div><div class="solution-outils-liste"><div class="os-outils-logos">{outils.map(c=><a href={`/integrations#${c.id}`}>{c.logo&&<img src={c.logo.src} alt="" width="28" height="28" loading="lazy"/>}{c.nom}</a>)}</div><small>Marques de leurs titulaires, citées sans partenariat.</small><p>Votre logiciel n’est pas listé ? Nous l’intégrons sur demande.</p></div></div></section>
    <section class="catalogue-section" aria-labelledby="deploiement-titre"><div class="solution-tete"><h2 id="deploiement-titre">Votre environnement, dimensionné pour vos usages.</h2><p>Nous choisissons l’installation après avoir mesuré le volume documentaire, les modèles et les usages simultanés.</p></div><div class="solution-cartes"><article><h3>Un boîtier au cabinet</h3><p>La mémoire et le modèle peuvent fonctionner sur une machine dédiée, configurée pour le périmètre local retenu.</p></article><article><h3>Une infrastructure privée</h3><p>Un environnement dédié accueille les besoins de calcul ou d’exploitation qui dépassent le premier boîtier.</p></article><article><h3>Des flux explicités</h3><p>Modèles externes éventuels, sauvegardes et maintenance sont identifiés avant l’installation. Vous savez où passe chaque donnée.</p></article></div></section>
  </> : <>
    <section class="catalogue-section" aria-labelledby="base-titre"><div class="memlia-surface-verte solution-outils"><div><p class="surtitre">Une base, puis votre spécialisation</p><h2 id="base-titre">Le modèle apprend votre métier. La mémoire garde vos sources.</h2><p>Nous adaptons une base à poids accessibles pour les tâches retenues. Une mémoire documentaire peut compléter ses réponses avec les informations à jour et autorisées.</p><a class="catalogue-action" href="/memoire-collective-cabinet-comptable">Découvrir la mémoire collective →</a></div><div><ul class="modeles-logos" aria-label="Familles de modèles à poids accessibles">{MODELES_OUVERTS.map(m=><li><img src={m.logo} width={m.largeur} height={m.hauteur} alt={m.logotype?m.nom:''} class:list={{'modele-logotype':m.logotype}} loading="lazy"/>{!m.logotype&&<span>{m.nom}</span>}</li>)}</ul><p>Nous choisissons la base selon votre tâche et votre environnement. Sa version, sa licence et les ressources nécessaires sont définies avant l’entraînement.</p><small>Marques de leurs titulaires, citées sans partenariat.</small></div></div></section>
  </>}
  <section class="catalogue-section" id="recette" aria-labelledby="recette-titre"><div class="solution-tete"><p class="surtitre">Notre prise en charge</p><h2 id="recette-titre">{os?'Du premier usage à la mémoire vivante.':'Des données à une version acceptée par votre équipe.'}</h2></div><ol class="solution-etapes">{s.etapes.map((e,i)=><li><span class="solution-index">Étape 0{i+1}</span><h3>{e.titre}</h3><p>{e.texte}</p></li>)}</ol></section>
  <section class="catalogue-section" aria-labelledby="regle-titre"><div class="solution-regle"><div><p class="surtitre">La règle écrite</p><h2 id="regle-titre">{os?'Une mémoire partagée. Des frontières précises.':'Chaque essai a un budget. Chaque version, une décision.'}</h2></div><div><p>{os?'Nous écrivons qui peut retrouver quoi, quels outils un agent peut utiliser et quand il doit s’arrêter. Une source contradictoire ou un droit manquant est signalé, avant de poursuivre.':'Nous fixons les données autorisées, l’enveloppe d’essai et les critères d’acceptation. Le modèle de départ, le jeu d’évaluation et les versions restent identifiés.'}</p><p>{os?'Votre équipe valide les actions engageantes et conserve ses décisions professionnelles. L’historique sert à comprendre le travail, avec une conservation définie.':'Votre équipe accepte la mise en service. Les limites, la licence de base et les conditions de retour arrière accompagnent la version remise.'}</p><a href="/garanties" class="catalogue-action">Nos engagements →</a></div></div></section>
  <section class="catalogue-section" aria-labelledby="exemple-titre"><div class="solution-tete"><p class="surtitre">Dossier fictif</p><h2 id="exemple-titre">{os?'Une réponse utile sait aussi s’arrêter.':'Une bonne version se juge sur des cas réservés.'}</h2></div><div class="solution-table" data-table-scroll role="region" aria-label="Quatre situations fictives et leurs décisions" tabindex="0"><table><caption>{os?'Exemples de décisions à éprouver lors de la recette':'Exemples de contrôles avant publication du modèle'}</caption><thead><tr><th scope="col">Situation fictive</th><th scope="col">Ce qui est remis</th><th scope="col">Décision prévue</th></tr></thead><tbody>{os?<><tr><th scope="row">Procédure disponible</th><td>Réponse accompagnée de sa source</td><td>Préparation autorisée</td></tr><tr><th scope="row">Deux consignes contradictoires</th><td>Versions et différence signalées</td><td>Arrêt, arbitrage du responsable</td></tr><tr><th scope="row">Dossier sans habilitation</th><td>Aucun contenu du dossier transmis</td><td>Accès refusé</td></tr><tr><th scope="row">Réponse à envoyer au client</th><td>Brouillon, sources et pièce manquante</td><td>Validation avant envoi</td></tr></>:<><tr><th scope="row">Format métier connu</th><td>Sortie comparée à la référence réservée</td><td>Vérifier le respect du format</td></tr><tr><th scope="row">Document non autorisé</th><td>Contenu exclu avant l’apprentissage</td><td>Arrêt du lot concerné</td></tr><tr><th scope="row">Cas ambigu</th><td>Demande de précision attendue</td><td>Vérifier le refus de conclure</td></tr><tr><th scope="row">Version moins bonne que la base</th><td>Comparatif et erreurs documentés</td><td>Publication refusée</td></tr></>}</tbody></table></div><p class="scene-note">Scénarios de recette fictifs, sans traitement ni résultat client.</p></section>
  <section class="catalogue-section solution-faq" aria-labelledby="faq-titre"><div data-sticky-rail><p class="surtitre">Avant de commencer</p><h2 id="faq-titre">Vos questions, avant le premier périmètre.</h2><a class="catalogue-action" href="/contact">Parlons de votre usage →</a></div><div>{s.faq.map(f=><details><summary>{f.question}</summary><p>{f.reponse}</p></details>)}</div></section>
  <section class="catalogue-section" aria-labelledby="suite-titre"><div class="solution-tete"><h2 id="suite-titre">Un même savoir, plusieurs façons d’avancer.</h2></div><div class="solution-cartes"><article><h3>Les robots</h3><p>Une routine précise et son résultat, dans les outils du cabinet.</p><a href="/automatisation-cabinet-comptable" class="catalogue-action">Voir les robots →</a></article><article><h3>Les agents IA</h3><p>Les tâches d’un métier préparées avec vos règles et vos validations.</p><a href="/agents-ia" class="catalogue-action">Choisir un agent →</a></article><article><h3>{os?'Le modèle privé':'Memlia OS'}</h3><p>{os?'Une spécialisation sur vos exemples pour les besoins qui demandent un entraînement.':'La mémoire collective reliée aux outils et aux agents du cabinet.'}</p><a href={os?'/modele-ia-prive-entreprise':'/memoire-collective-cabinet-comptable'} class="catalogue-action">Découvrir l’offre →</a></article></div></section>
  <section class="catalogue-fin" aria-labelledby="final-titre"><h2 id="final-titre">{s.final}</h2><p>{os?'Décrivez une connaissance difficile à retrouver et la tâche qui en dépend. Nous définissons ensemble le premier périmètre.':'Décrivez ce que le modèle doit préparer, les bons exemples disponibles et les critères de votre équipe.'}</p><Button href="/contact" data-tache-solution={os?'solution-memlia-os':'solution-modele-prive'} variante="principal" picto="fleche">Confier une première tâche</Button><p class="mention">La description suffit. Aucun fichier interne à transmettre pour ce premier échange.<br/>Cadrage et devis avant toute installation ou tout entraînement.</p></section>
</div>

<script>import '@/lib/table-keyboard';
document.querySelectorAll<HTMLAnchorElement>('a[data-tache-solution]').forEach(link=>link.addEventListener('click',()=>{try{sessionStorage.setItem('memlia-tache',link.dataset.tacheSolution??'');}catch{/* Le formulaire reste utilisable sans stockage. */}}));</script>
