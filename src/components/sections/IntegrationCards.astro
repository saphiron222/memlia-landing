---
import Picto from '@/components/Picto.astro';
import { integrationPath, type IntegrationDefinition } from '@/data/integrations';

/**
 * Guides par environnement : chaque guide est une carte du site (global.css), lien en entier,
 * finie par le lien d'action fléché (système de page, § 6 : jamais de « → » tapé).
 */
interface Props {
  integrations: readonly IntegrationDefinition[];
  titresParTache?: boolean;
}
const { integrations, titresParTache = false } = Astro.props;
---

<ul class="cartes" data-integration-cards>
  {integrations.map((integration) => (
    <li>
      <a class="carte" href={integrationPath(integration)}>
        <div class="carte-corps">
          <span class="carte-meta">{integration.vendor} · {integration.product}</span>
          <h3 class="carte-titre">{titresParTache
            ? `${integration.task.charAt(0).toUpperCase() + integration.task.slice(1)} dans ${integration.product}`
            : integration.primaryQuery.charAt(0).toUpperCase() + integration.primaryQuery.slice(1)}</h3>
          <p class="carte-texte">{integration.description}</p>
          <span class="carte-action">Lire le guide<Picto nom="fleche" taille={14} /></span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  /* La carte remplit sa cellule de grille : les actions s'alignent d'une carte à l'autre. */
  li { display: flex; }
  li > .carte { flex: 1 1 auto; }
</style>
