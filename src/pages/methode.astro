---
import ListeEditoriale from '@/components/editorial/ListeEditoriale.astro';
import EtapesCartes from '@/components/editorial/EtapesCartes.astro';
import PageEditoriale from '@/layouts/PageEditoriale.astro';
import Renvois from '@/components/Renvois.astro';
import BlocEditorial from '@/components/editorial/BlocEditorial.astro';
import Picto from '@/components/Picto.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { SERVICE_ID } from '@/data/schema.mjs';
import { famillesDeLaProfession } from '@/data/familles';
const familles = famillesDeLaProfession('ec');
const nombrePoles = new Set(familles.map(({ pole }) => pole)).size;

const page = PAGES_V2.methode;
const url = `${SITE.url}${page.chemin}`;
const noeuds = [{
  '@type': 'WebPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
  inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': SERVICE_ID },
}];
/** Les ancres historiques restent stables ; cinq étapes de la prise en charge. */
const etapes = [
  {
    "id": "observer",
    "titre": "Observer le geste",
    "repere": "Observation",
    "texte": "Vous montrez une tâche courante et une exception. Nous repérons ses fichiers, ses outils et le résultat que votre équipe attend."
  },
  {
    "id": "cadrer",
    "titre": "Écrire la règle",
    "repere": "Règle",
    "texte": "Nous écrivons les accès, les cas couverts et les conditions d’arrêt. Vous savez ce qui se prépare seul et ce qui attend votre validation."
  },
  {
    "id": "eprouver",
    "titre": "Construire et éprouver",
    "repere": "Construction",
    "texte": "Nous construisons dans les outils convenus. Des dossiers fictifs permettent de vérifier les résultats, les exceptions et les arrêts avant votre recette."
  },
  {
    "id": "valider",
    "titre": "Valider avec votre équipe",
    "repere": "Recette",
    "texte": "Votre équipe vérifie les résultats et les exceptions sur les cas convenus, dans l’environnement autorisé. Elle accepte ou refuse la mise en service."
  },
  {
    "id": "maintenir",
    "titre": "Maintenir dans la durée",
    "repere": "Maintenance",
    "texte": "Un outil ou votre règle change ? Nous vérifions l’effet sur la tâche et rejouons les essais concernés. Le devis précise la maintenance et les évolutions couvertes."
  }
];
const renvois = [
  { texte: 'Situer les usages, règles, données, validations et mesures déclarés pour choisir une prochaine tâche.', libelle: 'Faire le diagnostic de maturité IA du cabinet', href: '/outils-comptables-gratuits/diagnostic-maturite-ia-cabinet' },
  { texte: 'Les routines du catalogue, leurs livrables et les outils dans lesquels nous les déployons.', libelle: 'Voir les robots', href: '/automatisation-cabinet-comptable' },
  { texte: 'Nos engagements, écrits avant de commencer.', libelle: 'Les garanties', href: '/garanties' },
  { texte: `La carte des tâches automatisables d’un cabinet : ${nombrePoles} pôles, ${familles.length} familles pour l’expertise comptable, une frontière par tâche.`, libelle: 'Lire la carte des tâches', href: '/blog/automatiser-un-cabinet-comptable-la-carte-des-taches' },
  { texte: 'Pourquoi Memlia existe, et qui écrit et code la règle.', libelle: 'À propos', href: '/a-propos' },
];
/**
 * Les outils à rejouer dans le navigateur : des destinations nommées, donc des listes de liens,
 * groupées par usage (Kevin, 13/10/2026 : dix-sept paragraphes d'affilée ne se lisaient pas). Le
 * libellé nomme l'outil ; le détail dit sa limite en une phrase.
 */
const OUTILS = '/outils-comptables-gratuits';
const groupesOutils: { titre: string; outils: { href: string; libelle: string; limite: string }[]; mention?: string }[] = [
  { titre: 'Comparer et contrôler', outils: [
    { href: `${OUTILS}/verificateur-fec-local`, libelle: 'Vérificateur FEC', limite: 'Les anomalies de structure sont localisées sans modifier votre fichier.' },
    { href: `${OUTILS}/assistant-lettrage-comptable-local`, libelle: 'Préparer le lettrage', limite: 'Les paires exactes sont proposées ; les ambiguïtés attendent votre décision.' },
    { href: `${OUTILS}/comparateur-balances-comptables`, libelle: 'Comparateur de balances comptables', limite: 'Les variations gardent leurs lignes sources ; votre équipe explique ensuite le compte.' },
    { href: `${OUTILS}/modele-rapprochement-bancaire-excel-gratuit`, libelle: 'Modèle de rapprochement bancaire ouvrable dans Excel', limite: 'Le classeur se télécharge sans compte, avant tout contrôle ; même des soldes concordants restent à valider par le collaborateur.' },
  ], mention: 'Avec le modèle de rapprochement bancaire, le contrôle en ligne garde les écarts et éléments inexpliqués visibles et exportables avec l’état NON VALIDÉ. Télécharger le classeur ou exporter le contrôle ne valide pas le rapprochement.' },
  { titre: 'Préparer', outils: [
    { href: `${OUTILS}/fusionner-fichiers-csv`, libelle: 'Fusionner des exports CSV', limite: 'Le fichier consolidé garde son rapport de provenance ; il ne valide pas les opérations comptables.' },
    { href: `${OUTILS}/checklist-pieces-comptables`, libelle: 'Checklist des pièces comptables à demander', limite: 'Seule la pièce manquante entre dans la demande à relire.' },
    { href: `${OUTILS}/preparer-pseudonymiser-fichier-csv-fec`, libelle: 'Préparer et pseudonymiser un fichier comptable avant IA', limite: 'Les risques de réidentification s’examinent avant toute décision de partage.' },
    { href: `${OUTILS}/generateur-relance-facture-impayee`, libelle: 'Générateur de relance de facture impayée', limite: 'Le message amiable reste à valider ; vous décidez de l’envoi.' },
  ] },
  { titre: 'Calculer', outils: [
    { href: `${OUTILS}/calculateur-marge-commerciale`, libelle: 'Calculateur de marge commerciale', limite: 'Il montre ses trois formules et refuse un dénominateur nul.' },
    { href: `${OUTILS}/calculateur-date-echeance-facture`, libelle: 'Calculateur de date d’échéance de facture', limite: 'Il exige le point de départ et la convention choisie.' },
    { href: `${OUTILS}/calculateur-amortissement-comptable`, libelle: 'Calculateur d’amortissement comptable', limite: 'Il déroule le prorata et chaque dotation, sans choisir la durée ni l’éligibilité fiscale.' },
    { href: `${OUTILS}/calculateur-roi-automatisation`, libelle: 'Calculateur de ROI d’automatisation comptable', limite: 'Il sépare temps libéré, coûts et dépenses évitables, sans en faire une promesse de gain.' },
  ] },
  { titre: 'Écrire avec l’IA', outils: [
    { href: `${OUTILS}/generateur-prompt-ia-gratuit`, libelle: 'Générateur de prompt IA gratuit', limite: 'La consigne se relit avant d’être utilisée dans un outil autorisé.' },
    { href: `${OUTILS}/verificateur-prompt-ia`, libelle: 'Vérificateur de prompt IA', limite: 'Le rapport explique les formulations repérées et les points manquants, en gardant votre original.' },
    { href: `${OUTILS}/generateur-prompt-expert-comptable`, libelle: 'Générateur de prompt pour expert-comptable', limite: 'Il assemble les entrées autorisées, la validation et les conditions d’arrêt ; aucun modèle d’IA n’est appelé.' },
    { href: `${OUTILS}/bibliotheque-prompts-comptables`, libelle: 'Bibliothèque de prompts comptables', limite: 'Douze modèles à adapter dans le générateur ; le cabinet garde la décision.' },
    { href: `${OUTILS}/generateur-charte-ia-cabinet`, libelle: 'Générateur de charte IA du cabinet', limite: 'Un rôle manquant ne s’invente pas ; le cabinet le désigne avant adoption.' },
  ] },
];
// Le groupe CAC finit par le service de circularisation, écrit en clair dans le gabarit : son ancre
// est le lien contextuel que la recette du service exige depuis cette page (scripts/service-forge.mjs).
const outilsCac = [
  { href: `${OUTILS}/seuil-signification-audit`, libelle: 'Seuil de signification en audit', limite: 'Le calcul ne décide pas du caractère significatif.' },
  { href: `${OUTILS}/suivi-circularisation`, libelle: 'Suivi de circularisation', limite: 'Un refus suspend la proposition de relance ; le CAC choisit les suites.' },
  { href: `${OUTILS}/bareme-heures-cac`, libelle: 'Barème d’heures du commissaire aux comptes', limite: 'Le budget saisi reste distinct de la grille ; le programme de travail demeure une décision du CAC.' },
];
const appel = {
  titre: 'La première étape commence par un échange.',
  texte: 'Décrivez le geste qui revient. Nous écrivons sa règle avec vous, construisons dans vos outils et faisons recetter le résultat par votre équipe. La description suffit pour commencer.',
  points: ['Observer le geste réel, pas le geste théorique.', 'Écrire la règle dans vos mots.', 'Éprouver les refus autant que les résultats.'],
};
---

<PageEditoriale page={page} noeuds={noeuds} eyebrow="Derrière nos robots et nos agents IA, nous" scene="methode" appel={appel}>
  <section class="pv" aria-labelledby="travail-titre"><BlocEditorial scene="methode"><div class="pv-copy"><h2 id="travail-titre">Le travail de votre équipe devient la règle.</h2><p>Vos collaborateurs savent quelle pièce manque, quel écart mérite une vérification et quand il faut s’arrêter. Nous écrivons ce savoir-faire avec eux, puis nous faisons tourner sa part répétitive.</p><p>Votre cabinet reçoit un résultat dans ses outils, une règle qui se relit et les exceptions qu’il doit reprendre. Un robot pour une routine, un agent IA pour un métier, une construction sur mesure pour votre propre tâche.</p></div></BlocEditorial></section>
  <section class="pv" aria-labelledby="etapes-titre">
    <EtapesCartes etapes={etapes}/>
    <div class="editorial-regle"><h2>La règle écrite.</h2><p>La même frontière pour un robot, un agent IA et une tâche sur mesure.</p><div class="editorial-frontiere"><div><h3>Se prépare seul</h3><p>Les données autorisées sont rassemblées et les propositions préparées selon la règle convenue.</p></div><div><h3>Attend votre validation</h3><p>Votre équipe relit les propositions et traite les exceptions avant toute suite prévue par la règle.</p></div><div><h3>Reste humain</h3><p>Le cabinet garde ses corrections, son appréciation du dossier et la décision de poursuivre.</p></div></div><div class="editorial-arret"><h3>Dans le doute, le dossier s’arrête.</h3><p>Une donnée absente, un format inattendu ou une règle ambiguë produit un arrêt expliqué. Ces cas font partie des essais et de votre recette.</p></div><a href="/garanties">Lire nos garanties →</a></div>
  </section>

  <section class="pv" aria-labelledby="cout">
    <div class="tete rv">
      <h2 id="cout">Ce que cette méthode coûte, et ce qu’elle évite</h2>
    </div>
    <ListeEditoriale>
        <li class="editorial-point rv"><h3 class="editorial-point-titre">Ce qu’elle coûte</h3><p class="editorial-point-texte"><a href="/blog/pourquoi-les-cabinets-comptables-n-adoptent-pas-les-nouveaux-outils">Le cadrage</a> et la recette demandent du temps à votre équipe. Le devis dépend des sources, des règles, des exceptions et des validations. Vous payez une tâche prise en charge, pas des sièges.</p></li>
        <li class="editorial-point rv"><h3 class="editorial-point-titre">Ce qu’elle évite</h3><p class="editorial-point-texte">Une automatisation livrée vite, qui produit des résultats plausibles, et dont personne ne sait dire quand elle se trompe. Cette exigence permet notamment d’<a href="/agents-ia/comptabilite#tache-achats-fournisseurs-4">éprouver le flux des factures fournisseurs</a> sur ses doublons et ses avoirs avant de le livrer.</p></li>
      </ListeEditoriale>
  </section>

  <section class="pv editorial-ressources" aria-labelledby="suite-titre-renvois"><div class="tete"><h2 id="suite-titre-renvois">Des cas concrets à éprouver.</h2><p>Le cas courant, la donnée absente et le refus attendu changent avec chaque tâche.</p></div><details><summary>Voir des exemples de recette par tâche</summary><div class="editorial-exemples"><p>Pour <a href="/agents-ia/finance#tache-evaluation-transmission-10">recetter la préparation d’un dossier d’évaluation</a>, nous rejouons un ajustement accepté, un ajustement en attente et deux versions concurrentes. Le tableau prépare les chiffres, jamais la valeur de l’entreprise.</p><p>Le cas courant et le justificatif absent suffisent déjà à <a href="/agents-ia/comptabilite#taches-titre">rejouer une règle de notes de frais</a> sans utiliser de dossier réel.</p><p>Pour <a href="/agents-ia/juridique-fiscal#tache-secretariat-juridique-7">éprouver les rappels de dépôt encore manuels</a>, le jeu fictif oppose une date confirmée, un circuit déjà couvert et une date inconnue. Le brouillon attend une validation ; aucun message n’est envoyé.</p><p class="texte-2">Avant l’essai, vous pouvez <a href="/blog/logiciel-ia-comptabilite">comparer le parcours complet d’un outil IA</a> : entrée, résultat, exception et reprise.</p><p class="texte-2">Pour relier les tests au résultat visible, voyez comment <a href="/blog/tests-verts-et-regle-des-trois-passes">recetter le parcours en trois passes</a>.</p><p class="texte-2">Pour <a href="/agents-ia/paie-social#tache-bulletins-controle-2">faire recetter les contrôles croisés des bulletins</a>, votre pôle social examine une prime différente, une référence absente et une revue à reprendre après recalcul. Il garde la correction et la validation.</p><p class="texte-2 lecture">Vous pouvez <a href="/agents-ia/juridique-fiscal#tache-registres-obligations-10">faire recetter un suivi de registres</a> sur des changements fictifs fournis : annotations conservées, alerte non envoyée et terme calendaire à vérifier. Les accès réels se testent avant utilisation.</p><p>La recette revient aux personnes qui feront le travail. C’est indispensable pour <a href="/agents-ia/paie-social">faire recetter un contrôle de paie</a> sans déplacer la correction ni la décision hors du pôle social.</p><p>Nous pouvons aussi <a href="/agents-ia/paie-social#tache-entrees-sorties-salaries-5">éprouver la préparation d’un dossier salarié</a> : une annonce hors portail, ses informations manquantes et le retour au circuit existant font partie des essais.</p></div></details><Renvois items={renvois}/></section>

  <section class="pv editorial-ressources" aria-labelledby="outils-gratuits-titre">
    <div class="tete rv">
      <h2 id="outils-gratuits-titre">Des règles à rejouer dans le navigateur</h2>
      <p class="lecture">Chaque page nomme la source, la règle et la limite avant le résultat.</p>
    </div>
    {groupesOutils.map((groupe) => (
      <details><summary>{groupe.titre}</summary><div class="liens-bloc">
        <ul class="liens">
          {groupe.outils.map((outil) => (
            <li>
              <a class="lien-rangee" href={outil.href}>
                <span class="lien-libelle">{outil.libelle}<span class="lien-detail">{outil.limite}</span></span>
                <Picto nom="fleche" taille={14} class="lien-fleche" />
              </a>
            </li>
          ))}
        </ul>
        {groupe.mention && <p class="mention">{groupe.mention}</p>}
      </div></details>
    ))}
    <div class="liens-bloc rv">
      <h3 class="liens-titre">Pour le commissariat aux comptes</h3>
      <ul class="liens">
        {outilsCac.map((outil) => (
          <li>
            <a class="lien-rangee" href={outil.href}>
              <span class="lien-libelle">{outil.libelle}<span class="lien-detail">{outil.limite}</span></span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
        <li>
          <a class="lien-rangee" href="/commissaires-aux-comptes#use-certification">
            <span class="lien-libelle">Automatiser la circularisation<span class="lien-detail">Le CAC valide les tiers et choisit les pièces à examiner ; les plateformes gardent les envois et les relances.</span></span>
            <Picto nom="fleche" taille={14} class="lien-fleche" />
          </a>
        </li>
      </ul>
    </div>
  </section>
</PageEditoriale>
