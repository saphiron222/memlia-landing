---
import ProofRow from '@/components/ProofRow.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['integration']; }
const { contenu = contenuDe('ec').integration } = Astro.props;
// Système de page : rangée (en-tête, maquette), puis trois principes en lignes (un principe, son
// explication), là où des phrases ouvertes par un mot en gras faisaient une liste.
---
<section id="integration" class="section integration" aria-labelledby="integration-title">
  <div class="conteneur pile">
    <ProofRow id={contenu.image}>
      <div class="tete rv">
        <h2 id="integration-title">{contenu.titre}</h2>
        <p>{contenu.texte}</p>
        <p>{contenu.limites}</p>
      </div>
    </ProofRow>
    <ul class="lignes integration-rules">
      {contenu.regles.map((r, i) => <Fragment>{i > 0 && ' '}<li class="ligne"><strong class="ligne-libelle">{r.titre}</strong> <span class="ligne-texte">{r.texte}</span></li></Fragment>)}
    </ul>
  </div>
</section>
