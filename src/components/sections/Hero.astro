---
import Button from '@/components/Button.astro';

import transcriptSource from '../../../public/media/r7/animatique.vtt?raw';
import { CTA } from '@/data/site.mjs';

/**
 * Hero M4-R3 : média R7 approuvé, conservé octet pour octet.
 */
const transcript = transcriptSource
  .split(/\r?\n\r?\n/).slice(1).map(cue => cue.split(/\r?\n/).slice(1).join(' ').trim()).filter(Boolean);

---

<section class="hero" aria-labelledby="hero-titre">
  <div class="hero-texte">
    <span class="pastille hero-eyebrow">
      Automatisation IA pour cabinets d’expertise comptable
    </span>
    <h1 id="hero-titre" class="hero-h1">
      Automatisez les tâches qui ralentissent votre cabinet.
    </h1>
    <p class="hero-sub">
      Memlia automatise vos processus répétitifs pour libérer du temps, dans vos outils existants. Votre cabinet garde la décision.
    </p>
    <div class="hero-boutons">
      <Button href={CTA.principal.href} variante="principal" picto="fleche" class="hero-btn">
        {CTA.principal.libelle}
      </Button>

    </div>

  </div>

  <div class="hero-cadre" data-cadre>
    <div class="hero-verre">
      <div class="hero-ecran">
        <video controls playsinline preload="metadata" width="1920" height="1080"
          aria-label="Découvrir l’automatisation Memlia en 45 secondes" aria-describedby="hero-media-help"
          poster="/media/r7/hero-poster.webp" src="/media/r7/animatique-hero-45s.mp4">
          <track kind="subtitles" srclang="fr" label="Français" src="/media/r7/animatique.vtt" default />
          <p>Votre navigateur ne peut pas lire cette vidéo. <a href="/media/r7/animatique-hero-45s.mp4">Télécharger la vidéo</a> ou lire la transcription ci-dessous.</p>
        </video>
      </div>
    </div>
    <p id="hero-media-help" class="hero-media-help">45 secondes pour comprendre. Activez le plein écran pour lire les détails. Sous-titres français disponibles.</p>
    <details class="hero-transcript">
      <summary>Lire la transcription de la vidéo</summary>
      {transcript.map(text => <p>{text}</p>)}
      <p>À l’écran : une entrée est traitée selon une règle définie. Une exception arrête le traitement concerné et est isolée pour revue. Le cabinet vérifie, modifie, valide ou refuse ; les saisies restent préservées. Les exemples illustrent le fonctionnement, sans donnée client réelle.</p>
      <a href="/media/r7/animatique-hero-45s.mp4" download>Télécharger la vidéo (MP4)</a>
    </details>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 40px var(--marge-page) 0;
    isolation: isolate;
  }
  .hero-texte {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    margin: 0 auto;
  }
  .hero-h1 {
    max-width: 1050px;
    font-size: clamp(2.25rem, 1rem + 3.6vw, 3.75rem);
  }
  .hero-sub {
    max-width: 672px;
    color: var(--texte-2);
    font-size: var(--t-base);
  }
  .hero-boutons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 12px;
  }
  .hero-confiance {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    margin-top: 8px;
    font-size: var(--t-sm);
    color: var(--texte-2);
  }
  .hero-confiance li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .hero-confiance svg {
    color: var(--accent-appui);
    flex: 0 0 auto;
  }
  /* Cadre de démo : capture statique pleine largeur sous 1024, calque verre au-dessus. */
  .hero-cadre {
    margin-top: 48px;
    max-width: min(1200px, calc(100vw - 32px));
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% + 256px);
  }
  .hero-ecran {
    border-radius: var(--r-ecran);
    border: 1px solid var(--ligne);
    overflow: hidden;
    background: var(--blanc);
    aspect-ratio: 16 / 9;
    box-shadow: 0 12px 36px rgba(35, 31, 32, 0.06);
  }
  .hero-ecran video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
  }
  .hero-ecran:focus-within { outline: 3px solid var(--accent-texte); outline-offset: 4px; }
  .hero-media-help, .hero-transcript { max-width: 75ch; margin: 16px auto 0; color: var(--texte-2); font-size: var(--t-sm); }
  .hero-transcript summary { cursor: pointer; padding: 12px 0; color: var(--texte-fort); }
  .hero-transcript p { margin: 8px 0; }
  .hero-transcript a { text-decoration: underline; }
  .hero-transcript summary:focus-visible { outline: 3px solid var(--accent-texte); outline-offset: 3px; }

  @media (max-width: 24.99rem) {
    .hero-boutons {
      flex-direction: column;
      align-items: stretch;
    }
  }
  @media (min-width: 64rem) {
    .hero {
      padding: 64px var(--marge-page-lg) 0;
    }
    .hero-texte {
      min-height: 270px;
    }
    .hero-cadre {
      margin: 48px 0 0;
    }
    .hero-verre {
      padding: 16px;
      border-radius: var(--r-cadre);
      background: rgba(252, 251, 247, 0.2);
      border: 1px solid rgba(35, 31, 32, 0.096);
    }
  }
  @media (min-width: 80rem) {
    .hero-cadre {
      margin-left: 0;
      margin-right: 0;
    }
  }

  /* Entrées au chargement (§5.1) — hero seulement, flou autorisé ici. */
  @keyframes hero-entree {
    from {
      opacity: 0;
      transform: translateY(15px) scale(0.98);
      filter: blur(7px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-etiquette {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.8);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-bouton {
    from {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(3px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-verre {
    from {
      opacity: 0;
      transform: scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-ecran {
    from {
      opacity: 0;
      transform: scale(0.98);
      filter: blur(6px) grayscale(1);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0) grayscale(0);
    }
  }
  :global(html.js) .hero-h1 {
    animation: hero-entree var(--duree-entree) var(--courbe-sortie) both;
  }
  :global(html.js) .hero-sub {
    animation: hero-entree var(--duree-entree) var(--courbe-sortie) 100ms both;
  }
  :global(html.js) .hero-eyebrow {
    animation: hero-etiquette var(--duree-etiquette) var(--courbe-etiquette) 200ms both;
  }
  :global(html.js) .hero-boutons > :nth-child(1) {
    animation: hero-bouton var(--duree-entree) var(--courbe-sortie) 100ms both;
  }
  :global(html.js) .hero-boutons > :nth-child(2) {
    animation: hero-bouton var(--duree-entree) var(--courbe-sortie) 200ms both;
  }
  :global(html.js) .hero-confiance {
    animation: hero-bouton var(--duree-entree) var(--courbe-sortie) 300ms both;
  }
  :global(html.js) .hero-verre {
    animation: hero-verre var(--duree-etiquette) var(--courbe-sortie) 200ms both;
  }
  :global(html.js) .hero-ecran {
    animation: hero-ecran var(--duree-revelation) var(--courbe-douce) 200ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero :is(.hero-h1, .hero-sub, .hero-eyebrow, .hero-boutons > *, .hero-confiance, .hero-verre, .hero-ecran) {
      animation: none;
    }
  }
</style>
