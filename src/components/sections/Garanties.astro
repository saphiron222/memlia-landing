---
import Picto from '@/components/Picto.astro';
import ProofRow from '@/components/ProofRow.astro';
import { GARANTIES } from '@/data/garanties';

/**
 * S3 — Garanties (spec §4.9), à la place des logos clients.
 * Chaque garantie est un lien vers la question FAQ qui la détaille.
 *
 * Système de page : un titre de section et son lien d'action ; la maquette encadrée à droite ;
 * les six garanties, nommées par leur seul libellé, en liste de liens (pictogramme, libellé,
 * flèche), là où des tuiles à libellé centré parlaient une autre langue.
 */
---

<section id="garanties" class="section garanties" aria-labelledby="garanties-titre">
  <div class="conteneur pile">
    <ProofRow id="09-garanties">
      <div class="tete rv">
        <h2 id="garanties-titre">Nos engagements, écrits avant de développer.</h2>
        <a class="lien-action" href="#questions">Lire les réponses <Picto nom="fleche" taille={14} /></a>
      </div>
    </ProofRow>
    <div class="liens-bloc">
      <ul class="liens rv" data-garanties>
        {GARANTIES.map((g) => (
          <li>
            <a href={g.href} class="lien-rangee">
              <Picto nom={g.picto} taille={20} />
              <span class="lien-libelle">{g.libelle}</span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
