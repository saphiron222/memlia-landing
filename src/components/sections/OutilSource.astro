---
import type { OutilDefinition } from '@/data/outils';
import type { ProofId } from '@/data/proofs';

interface Props {
  titre: string;
  source: OutilDefinition['source'];
  proof?: ProofId;
}

const { titre, source } = Astro.props;
/* Source liée sous l’outil ; image propre à la page réservée à Open Graph. */
---

<section class="section outil-source" data-tool-section="source" aria-labelledby="outil-source-titre">
  <div class="conteneur"><details class="outil-source-inner" data-tool-help><summary>{titre}</summary>
    <div class="outil-source-texte rv">
      <h2 id="outil-source-titre" class="sr-only">{titre}</h2>
      <div class="outil-source-citation" data-official-source>
        {source.titre && <h3>{source.titre}</h3>}
        <p><a href={source.url} rel={source.url.startsWith('http') ? 'noopener' : undefined}>{source.nom}</a> : {source.extrait}</p>
        {source.complement && (
          <p class="outil-source-complement">
            {source.complement.extrait}{' '}
            <a href={source.complement.url} rel="noopener">{source.complement.nom}</a>.
          </p>
        )}
      </div>
    </div>
  </details></div>
</section>

<style>
  .outil-source { padding-block:24px; }
  .outil-source summary { cursor:pointer;min-height:44px;font-weight:600;color:var(--accent-texte); }
  .outil-source-inner[open] > div {margin-top:20px;}
  .outil-source-inner {
    display: grid;
    gap: var(--bloc-ecart);
    align-items: start;
  }
  .outil-source-texte {
    display: grid;
    gap: var(--tete-ecart);
    max-width: 800px; margin-inline: auto; width:100%;
  }
  .outil-source-texte h2 {
    font-size: var(--titre-section);
  }
  .outil-source-citation {
    display: grid;
    gap: var(--espace-3);
  }
  .outil-source-citation h3 {
    font-size: var(--titre-bloc);
    line-height: 1.2;
  }
  .outil-source-citation p {
    margin: 0;
    color: var(--texte-2);
    text-wrap: pretty;
  }
  .outil-source-citation a {
    color: var(--accent-texte);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .outil-source-complement {
    padding-top: var(--espace-3);
    border-top: 1px solid var(--ligne-douce);
    font-size: var(--t-sm);
  }
  .outil-source-visuel {
    min-width: 0;
  }
  @media (min-width: 64rem) {
    .outil-source-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espace-16);
    }
  }
</style>
