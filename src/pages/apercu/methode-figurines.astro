---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Scene from '@/components/editorial/SceneFigurines.astro';
import Figurine from '@/components/catalogue/Figurine.astro';
import Carte from '@/components/catalogue/Carte.astro';
import {ROBOTS,ROBOT_CATEGORIES,cheminRobot} from '@/data/robots';
import {PAGES_V2} from '@/data/pages-v2.mjs';
import '@/styles/catalogue/commun.css';
const schema={'@context':'https://schema.org','@graph':[{'@type':'WebPage','@id':'https://memlia.fr/apercu/methode-figurines#page',url:'https://memlia.fr/apercu/methode-figurines',name:PAGES_V2.methode.h1,headline:PAGES_V2.methode.h1,inLanguage:'fr'}]};
const etapes=[
 ['Observer le geste','Vous montrez une tâche telle qu’elle se fait dans votre cabinet. Nous suivons ses fichiers, ses outils et les moments où votre équipe doit décider.','La tâche décrite, son point de départ et son résultat attendu.'],
 ['Écrire la règle','Nous précisons les accès, les formats, les cas couverts et les exceptions. Nous séparons préparation automatique, validation et jugement métier.','La règle écrite, avec ses validations et ses conditions d’arrêt.'],
 ['Construire et éprouver','Nous construisons dans les outils convenus et rejouons les cas courants comme les cas qui doivent s’arrêter, sur un jeu fictif.','Le robot ou l’agent et ses essais : sorties obtenues, écarts et refus attendus.'],
 ['Faire la recette avec vous','Les personnes qui feront le travail vérifient le résultat dans l’environnement autorisé, sur les cas et fichiers convenus.','La tâche prête à être prise en charge, après votre acceptation.'],
 ['Maintenir la prise en charge','Un portail change, un format évolue ou votre règle se précise : nous reprenons le parcours selon le périmètre de maintenance convenu.','Une règle à jour, rejouée et vérifiée avant toute évolution mise en service.'],
];
const robots=['cfe','suivi-urssaf'].map(id=>ROBOTS.find(r=>r.id===id)!);
---
<Base titre="Pilote Méthode Memlia — direction figurines" titreSocial={PAGES_V2.methode.h1} schema={schema} description="Proposition de refonte de la page Méthode dans la famille visuelle des agents IA et robots Memlia." chemin="/apercu/methode-figurines" noindex socialImage={{url:'https://memlia.fr/illustrations/figurines/a-atelier-1200.webp',width:1200,height:800,alt:'Deux figurines Memlia et les objets de la règle écrite.'}}>
<div class="feuille catalogue-page pilote">
 <aside class="pilote-note"><p>Proposition à valider · Méthode</p><a href="/apercu/direction-figurines">Les deux recettes et le plan des six pages →</a></aside>
 <section class="pilote-hero"><p class="surtitre">Derrière nos robots et nos agents IA, nous.</p><h1>{PAGES_V2.methode.h1}</h1><p>Nous prenons une tâche entière en charge : observation, règle écrite, construction, recette et maintenance. Un robot pour une routine, un agent IA pour un métier, ou une nouvelle tâche construite sur mesure dans vos outils.</p><Button href="/contact" variante="principal" picto="fleche">Confier une première tâche</Button><a class="catalogue-action" href="#etapes">Du premier geste au résultat remis ↓</a></section>
 <section class="catalogue-section" aria-labelledby="travail"><div class="pilote-histoire"><div><h2 id="travail">Le travail de votre équipe devient la règle.</h2><p>Vos collaborateurs savent quelle pièce manque, quel écart mérite une vérification et quand il faut s’arrêter. Nous écrivons ce savoir-faire avec eux, puis nous faisons tourner sa part répétitive.</p><p>Votre cabinet reçoit un résultat dans ses outils, une règle qui se relit et les exceptions qu’il doit reprendre. Votre équipe garde les corrections, les validations et le jugement.</p></div><div class="pilote-scenes"><fieldset><legend>Comparer la recette d’image</legend><label><input type="radio" name="scene" value="a" checked/><span>A · Scène de travail</span></label><label><input type="radio" name="scene" value="b"/><span>B · Portrait métier</span></label></fieldset><figure class="pilote-scene-a"><Scene recette="a-atelier" prioritaire alt="Un robot abricot et un agent sauge, avec des pièces, un registre et une exception séparée."/><figcaption>La tâche est cadrée, les pièces sont préparées et les exceptions restent visibles.</figcaption></figure><figure class="pilote-scene-b"><Scene recette="b-portrait" alt="Un robot abricot derrière un dossier ouvert, accompagné d’une feuille et d’une clé."/><figcaption>Une présence métier, un dossier ouvert et les accès à définir avec vous.</figcaption></figure></div></div></section>
 <section class="catalogue-section" id="etapes" aria-labelledby="etapes-titre"><div class="tete"><h2 id="etapes-titre">Une prise en charge qui va jusqu’à la maintenance.</h2><p>À chaque étape, votre équipe sait ce qu’elle nous montre, ce que nous construisons et ce qu’elle vérifie.</p></div><ol class="pilote-etapes">{etapes.map(([titre,texte,livrable],i)=><li><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{titre}</h3><p>{texte}</p></div><div class="pilote-remis"><span>Ce que nous vous remettons</span><p>{livrable}</p></div></li>)}</ol></section>
 <section class="catalogue-section" aria-labelledby="regle"><div class="pilote-regle"><h2 id="regle">La règle écrite.</h2><p>La même frontière pour un robot, un agent IA et une tâche sur mesure.</p><div class="pilote-frontiere"><div><h3>Ce qui se prépare</h3><p>Lire les données autorisées, les rassembler, les rapprocher et préparer le résultat selon la règle convenue.</p></div><div><h3>Ce qui se valide</h3><p>Relire les propositions, traiter les exceptions et autoriser les actions engageantes prévues dans le périmètre.</p></div><div><h3>Ce qui reste humain</h3><p>Corriger une saisie, apprécier un dossier, choisir la suite et engager le cabinet.</p></div></div><div class="pilote-arret"><h3>Dans le doute, le dossier s’arrête.</h3><p>Une pièce illisible, une donnée absente ou une règle ambiguë produit un arrêt expliqué. Ces cas font partie du jeu d’essai fictif et de votre recette.</p></div><a href="/garanties">Lire nos garanties →</a></div></section>
 <section class="catalogue-section" aria-labelledby="commencer"><div class="tete"><h2 id="commencer">Par quelle tâche commencer ?</h2><p>Une routine précise peut être confiée à un robot. Un métier peut réunir plusieurs tâches au sein d’un agent IA. Nous construisons aussi ce qui n’a pas encore sa fiche.</p></div><ul class="catalogue-grille">{robots.map(r=><li><Carte {...r} href={cheminRobot(r)} categorie={ROBOT_CATEGORIES.find(c=>c.id===r.categorie)?.nom??''}/></li>)}</ul><div class="pilote-surmesure"><div class="pilote-rappel"><Figurine src="/robots/habilitations-fiscales" alt="" taille={84}/></div><div><h3>Votre tâche n’est pas encore dans le catalogue ?</h3><p>Décrivez le geste, les outils et le résultat attendu. Nous écrivons sa règle et construisons le robot ou l’agent adapté à votre cabinet.</p></div><a class="catalogue-action" href="/contact">Confier cette tâche →</a></div></section>
 <section class="catalogue-fin"><h2>Une première tâche. Une règle qui vous appartient.</h2><p>Vous payez une tâche prise en charge, pas des sièges. Le devis suit les accès, les règles, les exceptions et la maintenance. Commençons par la tâche que votre équipe refait déjà.</p><Button href="/contact" variante="principal" picto="fleche">Confier une première tâche</Button><p class="mention">Rien à envoyer : la description suffit.</p></section>
</div></Base>
<style>
.pilote-note{padding:16px var(--marge-page);border-bottom:1px solid var(--ligne-douce);display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;font-size:var(--t-sm);color:var(--texte-2)}.pilote-note a{min-height:44px;display:inline-flex;align-items:center;color:var(--accent-texte)}.pilote-hero{padding:64px var(--marge-page) 0;display:grid;justify-items:center;gap:24px;text-align:center}.pilote-hero h1{font-size:var(--titre-page);max-width:18ch}.pilote-hero>p:not(.surtitre){max-width:64ch;color:var(--texte-2)}.pilote-histoire{display:grid;gap:40px;align-items:center}.pilote-histoire>div:first-child{display:grid;gap:24px}.pilote-histoire p{color:var(--texte-2)}.pilote-scenes{min-width:0}.pilote-scenes fieldset{border:0;padding:0;margin:0 0 16px;display:flex;gap:8px;flex-wrap:wrap}.pilote-scenes legend{font-size:var(--t-sm);color:var(--texte-2);margin-bottom:12px}.pilote-scenes label{position:relative;cursor:pointer}.pilote-scenes input{position:absolute;opacity:0;width:1px;height:1px}.pilote-scenes label span{padding:10px 12px;display:block;border:1px solid var(--ligne);border-radius:var(--r-chip);font-size:var(--t-sm);min-height:44px}.pilote-scenes input:checked+span{background:var(--encre);color:var(--creme);border-color:var(--encre)}.pilote-scenes input:focus-visible+span{outline:2.5px solid var(--focus);outline-offset:3px}.pilote-scenes figure{margin:0}.pilote-scenes figcaption{color:var(--texte-2);font-size:var(--t-sm);padding-top:12px}.pilote-scene-b{display:none}.pilote-scenes:has(input[value=b]:checked) .pilote-scene-a{display:none}.pilote-scenes:has(input[value=b]:checked) .pilote-scene-b{display:block}
.pilote-etapes{list-style:none;margin:0;padding:0}.pilote-etapes li{display:grid;gap:20px;padding:32px 0;border-top:1px solid var(--ligne-douce)}.pilote-etapes li>span{font-size:var(--titre-bloc);font-family:var(--police-display);color:var(--accent-texte)}.pilote-etapes h3{font-size:var(--titre-bloc);margin-bottom:16px}.pilote-etapes p{max-width:62ch;color:var(--texte-2)}.pilote-remis{border-left:2px solid var(--vert-doux);padding-left:20px}.pilote-remis>span{font-size:var(--t-sm);font-weight:600;color:var(--accent-texte)}.pilote-remis p{margin-top:12px}.pilote-regle{padding:32px 24px;border-radius:var(--r-cadre);background:var(--encre);color:var(--creme);display:grid;gap:32px}.pilote-regle h3{font-size:var(--titre-bloc)}.pilote-frontiere{display:grid;gap:32px}.pilote-frontiere p{margin-top:16px}.pilote-regle a{color:var(--creme);min-height:44px;display:inline-flex;align-items:center}.pilote-arret{padding-top:24px;border-top:1px solid var(--encre-42);display:grid;gap:16px}.pilote-surmesure{padding:32px;background:var(--accent-voile);border-radius:var(--r-cadre);display:grid;gap:24px;align-items:center}.pilote-rappel{width:84px;border-radius:var(--r-boite);overflow:hidden}.pilote-surmesure h3{font-size:var(--titre-bloc);margin-bottom:16px}.pilote-surmesure p{max-width:64ch;color:var(--texte-2)}
@media(min-width:48rem){.pilote-etapes li{grid-template-columns:48px minmax(0,1fr);gap:24px}.pilote-remis{grid-column:2}.pilote-frontiere{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(min-width:64rem){.pilote-note{padding-inline:var(--marge-page-lg)}.pilote-histoire{grid-template-columns:1fr 1fr;gap:48px}.pilote-etapes li{grid-template-columns:64px minmax(0,1.3fr) minmax(0,1fr);gap:40px}.pilote-remis{grid-column:auto}.pilote-regle{padding:48px}.pilote-surmesure{grid-template-columns:84px minmax(0,1fr) auto}}
</style>
