---
import ProofRow from '@/components/ProofRow.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['preuves']; }
const { contenu = contenuDe('ec').preuves } = Astro.props;
const retour = '\n';
const proofs = contenu.reperes;

/**
 * S6 — « Proposition vs saisie » + repères vérifiables (spec §4.10 / S6 b), à la place
 * des témoignages : aucune preuve sociale sans autorisation distincte. Le motif directeur
 * du produit est dit tel quel ; les repères restent des textes sans microliens.
 */
---

<section id="preuves" class="preuves" aria-labelledby="preuves-titre">
  <div class="preuves-media"><ProofRow id={contenu.image}>
  <div class="preuves-tete rv">

    <span class="eyebrow">{contenu.etiquette}</span>
    <h2 id="preuves-titre">{contenu.titre}</h2>
    <p class="texte-2 lecture preuves-intro">{retour}{contenu.texte}{retour}</p>
    <p class="texte-2 lecture">{contenu.propriete}</p>
  </div>
  </ProofRow></div>

  <div class="coins">
    <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
  <ul class="reperes rv-groupe" aria-label="Preuves de méthode">
    {proofs.map((r) => (
      <li class="repere rv">
        <h3 class="proof-title">{r.title}</h3>
        <p class="repere-libelle">{r.text}</p>

      </li>
    ))}
  </ul>
  </div>

</section>

<style>
  .preuves-media { padding: 0 var(--marge-page); }
  @media (min-width: 64rem) { .preuves-media { padding: 0 var(--marge-page-lg); } }
  .proof-title { font-size: var(--t-2xl); }
  .preuves {
    padding-top: 96px;
  }
  .preuves-tete {
    display: grid;
    gap: 12px;
    max-width: 720px;
    padding: 0;
  }
  .preuves-embleme {
    width: 72px;
    height: 72px;
    border-radius: var(--r-carte);
    overflow: hidden;
    border: 1px solid var(--ligne-douce);
    margin-bottom: 8px;
  }
  .preuves-intro {
    max-width: 62ch;
  }
  .reperes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--ligne-douce);
    border-top: 1px solid var(--ligne);
    border-bottom: 1px solid var(--ligne);
  }
  .repere {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 40px 24px 44px;
    background: var(--surface-feuille);
  }
  .repere-chiffre {
    font-family: var(--police-chiffres), 'Fraunces Fallback';
    font-variant-numeric: tabular-nums;
    font-size: var(--t-chiffre);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--texte-fort);
  }
  .repere-libelle {
    color: var(--texte);
    max-width: 34ch;
  }

  @media (min-width: 40rem) {
    .reperes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .repere:last-child { grid-column: 1 / -1; }
  }
  @media (min-width: 64rem) {
    .preuves {
      padding-top: 128px;
    }
    .preuves-tete {
      padding: 0;
    }
    .reperes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .repere:last-child { grid-column: auto; }
    .repere {
      padding: 48px 32px 56px;
    }
  }
</style>
