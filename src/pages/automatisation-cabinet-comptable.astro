---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import { getCollection } from 'astro:content';
import Renvois from '@/components/Renvois.astro';
import ProofRow from '@/components/ProofRow.astro';
import Picto, { type NomPicto } from '@/components/Picto.astro';
import RelatedIntegrations from '@/components/RelatedIntegrations.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { serviceNode, SERVICE_ID } from '@/data/schema.mjs';
import { eeatCommercial } from '@/data/page-eeat';
import { familleParId, famillesDeLaProfession } from '@/data/familles';
const familles = famillesDeLaProfession('ec');
const nombrePoles = new Set(familles.map(({ pole }) => pole)).size;
// Le catalogue nomme la tâche, pas le titre de sa page (Kevin, 13/10/2026) : un libellé court par
// service ; à défaut, celui de sa famille ; à défaut, le titre avant ses deux-points.
const LIBELLES_TACHES: Record<string, string> = {
  'bulletins-controle': 'Contrôle des bulletins de paie',
  'circularisation-cac': 'Circularisation',
  'entrees-sorties-salaries': 'Entrées et sorties des salariés',
  'evaluation-transmission': 'Dossier d’évaluation d’entreprise',
  'facture-electronique': 'Facture électronique',
  'factures-fournisseurs': 'Factures fournisseurs',
  'notes-de-frais': 'Notes de frais',
  'paie': 'Paie',
  'rapprochement-bancaire': 'Rapprochement bancaire',
  'registres-obligations': 'Registres et obligations',
  'saisie-comptable': 'Saisie comptable',
  'secretariat-juridique': 'Secrétariat juridique',
};
const taches = (await getCollection('services', ({ data }) => data.status === 'publie'))
  .map((service) => ({
    href: `/automatisation/${service.id}`,
    libelle: LIBELLES_TACHES[service.id] ?? familleParId(service.id)?.libelle ?? service.data.title.split(/\s*:/)[0].trim(),
  }))
  .sort((a, b) => a.libelle.localeCompare(b.libelle, 'fr'));

const page = PAGES_V2.service;
// La source de la page se cite sur ses mots, dans « Le jeu d’essai » (décision de Kevin du 06/10/2026).
const [sourceRgpd] = eeatCommercial('/automatisation-cabinet-comptable')?.sources ?? [];
if (!sourceRgpd) throw new Error('Source CNIL du hub absente de page-eeat');
const url = `${SITE.url}${page.chemin}`;
const noeuds = [
  {
    '@type': 'WebPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
    inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': SERVICE_ID },
  },
  serviceNode(),
];
const requis: { picto: NomPicto; titre: string; texte: string }[] = [
  { picto: 'feuilles', titre: 'Les formats réels', texte: 'Les colonnes, pièces et exports que votre équipe utilise pour cette tâche.' },
  { picto: 'bouclier', titre: 'Les accès', texte: 'Ce que l’automatisation doit lire, ce qu’elle peut écrire, et où s’arrête son périmètre.' },
  { picto: 'limites', titre: 'Les cas limites', texte: 'Une pièce absente ou un dossier atypique : le cas qui doit s’arrêter et la personne qui décide de la suite.' },
  { picto: 'grille', titre: 'L’environnement', texte: 'La version de vos outils, les postes concernés, qui utilisera quoi.' },
];
const renvois = [

  { texte: 'Choisir une prochaine action à partir des pratiques déclarées, sans classement des équipes.', libelle: 'Situer les pratiques IA du cabinet', href: '/outils-comptables-gratuits/diagnostic-maturite-ia-cabinet' },
  { texte: `La carte des tâches automatisables d’un cabinet : ${nombrePoles} pôles, ${familles.length} familles pour l’expertise comptable, une frontière par tâche.`, libelle: 'Lire la carte', href: '/blog/automatiser-un-cabinet-comptable-la-carte-des-taches' },
  { texte: 'Contrôler les bulletins de paie avant la DSN : une liste de contrôles à rejouer chaque mois.', libelle: 'Lire les contrôles avant la DSN', href: '/blog/controler-les-bulletins-de-paie-avant-la-dsn' },
  { texte: 'Suivre la production sociale dans Excel sans surveiller les personnes.', libelle: 'Lire le suivi de production sociale', href: '/blog/suivre-la-production-sociale-dans-excel' },
  { texte: 'Après une saisie automatisée, six contrôles restent à faire : lesquels, et pourquoi.', libelle: 'Lire les contrôles après la saisie', href: '/blog/automatiser-la-saisie-comptable-ce-qui-reste-a-verifier' },
  { texte: 'Lire un compte rendu métier DSN et ses anomalies, retour par retour.', libelle: 'Lire la méthode des retours DSN', href: '/blog/comprendre-les-comptes-rendus-metier-dsn' },
  { texte: 'Le questionnaire revenu vide qui a changé notre façon de cadrer une tâche.', libelle: 'Lire ce retour d’expérience', href: '/blog/pourquoi-les-cabinets-comptables-n-adoptent-pas-les-nouveaux-outils' },
  { texte: 'Nos engagements, écrits avant de commencer.', libelle: 'Nos garanties', href: '/garanties' },
];
const outils = [
  { href: '/outils-comptables-gratuits/fusionner-fichiers-csv', libelle: 'Fusionner des exports CSV', texte: 'Correspondance des colonnes confirmée, fichier consolidé et rapport des exceptions. Le cabinet vérifie la comparabilité des exports.' },
  { href: '/outils-comptables-gratuits/calculateur-roi-automatisation', libelle: 'Calculateur de ROI d’automatisation comptable', texte: 'Volumes, contrôle restant et dépenses vraiment évitables. La capacité libérée reste distincte des économies de trésorerie.' },
  { href: '/outils-comptables-gratuits/verificateur-fec-local', libelle: 'Vérificateur FEC local', texte: 'Un rapport par ligne, colonne et règle, sans corriger ni certifier le fichier.' },
  { href: '/outils-comptables-gratuits/comparateur-balances-comptables', libelle: 'Comparateur de balances comptables', texte: 'Deux balances issues de CSV : comptes nouveaux, disparus et variations selon vos seuils. L’explication des soldes reste à votre équipe.' },
  { href: '/outils-comptables-gratuits/generateur-prompt-expert-comptable', libelle: 'Générateur de prompt pour expert-comptable', texte: 'Entrées, format, validation et arrêt d’une consigne. Il aide à décrire le geste ; il ne réalise pas la tâche à la place du cabinet.' },
  { href: '/outils-comptables-gratuits/generateur-relance-facture-impayee', libelle: 'Générateur de relance de facture impayée', texte: 'Trois factures fictives : un solde de 90 euros, une facture soldée exclue et un litige à examiner. Le message amiable reste à valider ; vous décidez de l’envoi.' },
  { href: '/outils-comptables-gratuits/calculateur-amortissement-comptable', libelle: 'Calculateur d’amortissement comptable', texte: 'Base, prorata, dotation et valeur nette par exercice.' },
  { href: '/outils-comptables-gratuits/calculateur-marge-commerciale', libelle: 'Calculateur de marge commerciale', texte: 'Marge, taux de marge et taux de marque sur deux montants HT fictifs, sans produire de conseil de prix.' },
];
const appel = {
  titre: 'Décrivez le geste qui revient.',
  texte: 'Nous partons de votre description pour délimiter la tâche, le résultat à livrer et ce qui reste à décider. Le périmètre et le prix se précisent avant la construction.',
  points: ['Le geste : ce que quelqu’un refait chaque mois.', 'Les outils : d’où viennent les fichiers, où va le résultat.', 'Le résultat attendu : ce qui devrait exister à la fin.'],
};
---

<PageCommerciale page={page} noeuds={noeuds} eyebrow="Le service" hero="v2/14-hero-service" appel={appel}>
  <section class="pv" aria-labelledby="situation">
    <ProofRow id="01-flux">
      <div class="pv-copy rv">
        <h2 id="situation">Le geste que quelqu’un refait chaque mois</h2>
        <p>Recopier des montants d’un export vers un classeur. Réclamer les mêmes pièces aux mêmes clients. Comparer deux états qui devraient concorder. Votre collaborateur connaît le geste et les exceptions. Il recommence au dossier suivant.</p>
        <p class="texte-2">Nous écrivons avec lui les entrées, les étapes et le résultat attendu. La règle devient relisible par l’équipe. Nous prenons en charge la mécanique qui reste à faire entre vos outils, jusqu’à la proposition que vous validez.</p>
        <p class="texte-2">Pour une première règle concrète, vous pouvez <a href="/automatisation/saisie-comptable">confier la préparation de la saisie comptable</a> sans céder la validation des écritures.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="prepare">
    <div class="tete rv">
      <h2 id="prepare">La règle écrite, de la frontière au jeu d’essai</h2>
      <p class="texte-2 lecture">La règle décrit le résultat attendu, les cas couverts et les raisons de s’arrêter. Vous pouvez la relire avant que nous construisions l’automatisation. Elle comporte quatre parties.</p>
    </div>
    <ul class="lignes rv">
      <li class="ligne"><h3 class="ligne-libelle">La frontière</h3><p class="ligne-texte">Trois colonnes fixent ce qui se prépare seul, ce qui attend une validation et ce qui reste humain.</p></li>
      <li class="ligne"><h3 class="ligne-libelle">La proposition</h3><p class="ligne-texte">L’automatisation prépare le résultat et le présente. Ce que le cabinet saisit ne se touche jamais.</p></li>
      <li class="ligne"><h3 class="ligne-libelle">L’arrêt</h3><p class="ligne-texte">Une donnée manque, le cas sort de la règle ou deux lectures restent possibles : le traitement s’arrête et nomme le doute.</p></li>
      <li class="ligne"><h3 class="ligne-libelle">Le jeu d’essai</h3><p class="ligne-texte">Les cas qui doivent aboutir et ceux qui doivent échouer sont rejoués sur <a href={sourceRgpd.url} rel="noopener noreferrer" title={`${sourceRgpd.editeur} — ${sourceRgpd.titre}`}>{sourceRgpd.mot}</a> avant la recette.</p></li>
    </ul>
  </section>

  <section class="pv" aria-labelledby="cabinet">
    <ProofRow id="v2/02-proposition">
      <div class="pv-copy rv">
        <h2 id="cabinet">Que garde le cabinet quand une tâche est automatisée ?</h2>
        <p><strong>La décision. Toujours.</strong></p>
        <p class="texte-2">Pour situer cette frontière par geste, voyez <a href="/blog/intelligence-artificielle-metier-comptable-ce-qu-elle-prepare-ce-qui-reste-humain">ce que l’IA prépare et ce qui reste humain</a>.</p>
        <p>Votre équipe contrôle la proposition et décide de la suite. Une donnée manque ou une exception sort de la règle : la préparation s’arrête sur ce cas. Le motif reste visible pour le collaborateur qui le reprend.</p>
        <p>Cette frontière reste visible lorsque vous choisissez de <a href="/automatisation/rapprochement-bancaire">confier la préparation du rapprochement bancaire</a> : les appariements se proposent, les écarts restent à décider.</p>
        <p class="texte-2">La règle sépare les propositions que nous générons des saisies de votre équipe. Nous pouvons régénérer les premières ; vos commentaires, corrections et décisions restent les vôtres.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="requis">
    <ProofRow id="v2/01-qualification">
      <div class="pv-copy rv">
        <h2 id="requis">Comment savoir si une tâche est prête à être automatisée ?</h2>
        <p class="texte-2">Avant de choisir, commencez par <a href="/blog/cabinet-comptable-surcharge-de-travail-ou-passe-le-temps">repérer où passe le temps du cabinet</a> : le geste répétitif et le dossier qui demande un jugement ne se traitent pas de la même façon.</p>
        <p>Nous vérifions les formats utilisés, les droits nécessaires et les exceptions avec la personne qui réalise la tâche.</p>
        <p class="texte-2">Avant tout accès aux dossiers, nous précisons les données nécessaires, qui peut les lire et où elles sont traitées. Les premiers essais utilisent un jeu d’essai fictif : des données inventées pour tester la règle.</p>
      </div>
    </ProofRow>
    <ul class="lignes rv">
      {requis.map((r) => (
        <li class="ligne">
          <div class="ligne-tete">
            <span class="ligne-picto" aria-hidden="true"><Picto nom={r.picto} taille={24} /></span>
            <h3 class="ligne-libelle">{r.titre}</h3>
          </div>
          <p class="ligne-texte">{r.texte}</p>
        </li>
      ))}
    </ul>
    <p class="texte-2 lecture">Un justificatif manquant montre immédiatement pourquoi ce cadrage compte lorsque vous choisissez de <a href="/automatisation/notes-de-frais">confier le traitement répétitif des notes de frais</a>.</p>
  </section>

  <section class="pv" aria-labelledby="livre">
    <ProofRow id="07-livrer">
      <div class="pv-copy rv">
        <h2 id="livre">Que livre Memlia pour une tâche automatisée ?</h2>
        <p>Vous recevez la règle écrite, l’automatisation dans l’environnement convenu et les résultats des essais. La règle précise les entrées, les propositions produites, les validations et les conditions d’arrêt.</p>
        <p>La recette est la vérification par votre équipe du résultat livré, sur les cas convenus. Après les essais fictifs, elle se joue dans l’environnement autorisé du cabinet. Nous rejouons les cas qui doivent aboutir et ceux qui doivent s’arrêter. Un traitement qui continue alors qu’il devait s’arrêter est un défaut au même titre qu’un résultat faux.</p>
        <p class="texte-2">Les conditions de maintenance, de support et d’évolution sont écrites au devis. Un format ou une règle change : nous distinguons la correction couverte de l’évolution à chiffrer, puis les cas concernés sont rejoués.</p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="perimetre">
    <div class="tete rv">
      <h2 id="perimetre">Ce que nous savons écrire</h2>
      <p class="texte-2 lecture">Partons d’une tâche : rassembler les pièces manquantes, préparer des écarts entre deux états ou suivre une échéance. Nous écrivons ce qui déclenche le traitement, la proposition attendue et ce que votre équipe doit décider. <a href="/blog/automatiser-un-cabinet-comptable-la-carte-des-taches">Lire la carte des tâches</a>.</p>
    </div>
    {/* Ce qui reste hors des logiciels du cabinet, pôle par pôle (règle de couverture du 06/10/2026 :
        preuves dans le chantier cac-site-niveau-superieur, sorties/couverture-logiciels-2026-10-06/).
        Les lignes s'écrivent en clair : leurs liens sont les ancres contextuelles que la recette de
        chaque service exige depuis cette page (scripts/service-forge.mjs). */}
    <dl class="lignes perimetre-poles rv">
      <div class="ligne">
        <dt class="ligne-libelle">Production comptable</dt>
        <dd class="ligne-texte">Les pièces que votre outil n’impute pas, les points à trancher avant le bilan.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Paie et social</dt>
        <dd class="ligne-texte">Les variables reçues hors portail, les retours DSN triés par date limite. Vous pouvez <a href="/automatisation/paie">confier un geste répétitif autour de la paie</a> ; nous pouvons <a href="/automatisation/bulletins-controle">automatiser les contrôles des bulletins de paie</a> là où les contrôles natifs laissent un rapprochement manuel entre variables validées et résultats calculés, et <a href="/automatisation/entrees-sorties-salaries">préparer les dossiers d’entrée et de sortie des salariés</a> pour les annonces reçues hors portail. Les écarts attendent l’examen du gestionnaire : le circuit déjà utilisé, chaque correction et chaque décision restent au pôle social.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Portefeuille et échéances</dt>
        <dd class="ligne-texte">Le rappel à chaque client de ses échéances du mois, avec le montant.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Juridique</dt>
        <dd class="ligne-texte">L’échéancier d’approbation et de dépôt du portefeuille, les fiches clients tenues à jour des registres. Nous pouvons <a href="/automatisation/registres-obligations">automatiser le suivi des registres et obligations</a>, de la publication à la fiche client proposée. Nous pouvons aussi <a href="/automatisation/secretariat-juridique">suivre les échéances juridiques hors de votre outil</a> si ce suivi reste manuel après vérification de votre offre et de ses options. La mise à jour, les dates, l’approbation, le dépôt et les suites à donner restent au cabinet et aux personnes habilitées.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Administratif</dt>
        <dd class="ligne-texte">La boîte mail rangée par dossier, les lettres de mission non signées relancées.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Données et outils</dt>
        <dd class="ligne-texte">Les gestes entre deux outils qui ne se parlent pas.</dd>
      </div>
      <div class="ligne">
        <dt class="ligne-libelle">Commissariat aux comptes</dt>
        <dd class="ligne-texte">La sélection des tiers à circulariser selon votre règle et avec votre validation, les écarts de confirmation, les fichiers du client rapprochés de la balance. Le commissaire aux comptes garde la sélection des travaux, leur appréciation et l’opinion. Dans un cabinet mixte, les accès et le périmètre sont cadrés séparément pour chaque mission. Pour vos missions d’audit, découvrez <a href="/commissaires-aux-comptes">l’automatisation pour commissaire aux comptes</a>.</dd>
      </div>
    </dl>
    <div class="liens-bloc perimetre-outils rv">
      <h3 class="liens-titre">Avant de confier une tâche, nos outils gratuits</h3>
      <ul class="liens">
        {outils.map((outil) => (
          <li>
            <a class="lien-rangee" href={outil.href}>
              <span class="lien-libelle">{outil.libelle}<span class="lien-detail">{outil.texte}</span></span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pv" aria-labelledby="prix">
    <ProofRow id="v2/03-devis">
      <div class="pv-copy rv">
        <h2 id="prix">Vous payez une tâche prise en charge, pas des sièges.</h2>
        <p>Pour <a href="/automatisation/evaluation-transmission">préparer le dossier d’évaluation d’entreprise</a>, nous relions les pièces, périodes et retraitements qui restent à réunir hors de votre outil. Le cabinet garde les méthodes, la valeur et le conseil sur la transmission.</p>
        <p>Le devis dépend des sources à relier, des règles à appliquer, des exceptions et des validations. Un export stable à comparer et plusieurs formats à rapprocher demandent des travaux différents.</p>
        <p>Le devis précise le résultat livré, les cas couverts et les critères de recette. Il écrit aussi la maintenance, le support et les conditions d’évolution. <strong>Il n’est jamais multiplié par le nombre de postes.</strong></p>
      </div>
    </ProofRow>
  </section>

  <section class="pv" aria-labelledby="outils">
    <ProofRow id="08-integration">
      <div class="pv-copy rv">
        <h2 id="outils">Faut-il changer d’outil pour automatiser une tâche ?</h2>
        <p>Nous commençons par ce que votre logiciel fait déjà dans la version et le circuit que vous utilisez. Nous conservons ces fonctions. La tâche confiée porte sur les gestes qui restent : reprendre un export, rassembler les pièces reçues par courriel ou préparer les exceptions entre deux outils.</p>
        <p class="texte-2">Nous vérifions les formats, les accès et le résultat attendu avant de nous engager. Le devis nomme l’environnement pris en charge. Un guide publié sur un logiciel ne démontre pas la compatibilité avec toutes ses versions.</p>
        <p class="texte-2">La même vérification précède le choix de <a href="/automatisation/factures-fournisseurs">confier le flux des factures fournisseurs</a> : réception, proposition et exceptions doivent rester lisibles dans le circuit existant.</p>
        <p class="texte-2">Si l’accompagnement reste manuel, nous pouvons <a href="/automatisation/facture-electronique">préparer les relances des clients sur une autre plateforme agréée</a>, sans refaire les campagnes déjà utilisées dans votre outil.</p>
      </div>
    </ProofRow>
  </section>

  <RelatedIntegrations servicePath="/automatisation-cabinet-comptable" />

  <section class="pv" aria-labelledby="avant">
    <div class="tete rv">
      <h2 id="avant">Pour aller plus loin</h2>
      <p class="texte-2">Choisir une tâche, lire ses contrôles et comprendre nos engagements.</p>
    </div>
    <Renvois items={renvois} />
  </section>
  <section class="pv" aria-labelledby="taches-guides">
    <div class="tete"><h2 id="taches-guides">Les tâches que vous pouvez confier</h2><p>Retrouvez la règle, les limites et les essais prévus pour chaque tâche.</p></div>
    <div class="liens-bloc">
      <ul class="liens" data-service-catalog>
        {taches.map((tache) => (
          <li>
            <a class="lien-rangee" href={tache.href}>
              <span class="lien-libelle">{tache.libelle}</span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</PageCommerciale>

