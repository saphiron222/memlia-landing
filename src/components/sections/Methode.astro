---
import ProofMedia from '@/components/ProofMedia.astro';
import type { ProofId } from '@/data/proofs';
import { METHODE } from '@/data/methode';

// Système de page : les étapes (`.etapes`, global.css), une suite numérotée par son surtitre et
// une maquette encadrée par étape. Le DOM garde le texte avant l'image ; dès 64 rem, deux étapes
// par rangée, textes et maquettes alignés d'une colonne à l'autre. Jamais de quinconce.
---

<section id="methode" class="section parcours" aria-labelledby="methode-titre">
  <div class="conteneur pile">
    <div class="tete">
      <h2 id="methode-titre" class="parcours-h2">{METHODE.titre}</h2>
    </div>
    <ol class="etapes">
      {METHODE.etapes.map((e, i) => (
        <li class="etape" data-etape={i} data-proof-row>
          <div class="etape-copie step-copy" data-proof-copy>
            <p class="surtitre step-number">Étape {e.numero}</p>
            <h3 class="etape-h3">{e.titre}</h3>
            <p class="texte-2">{e.texte}</p>
          </div>
          <ProofMedia id={e.image as ProofId} cadre />
        </li>
      ))}
    </ol>
  </div>
</section>
