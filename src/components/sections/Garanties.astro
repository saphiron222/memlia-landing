---
import Picto from '@/components/Picto.astro';
import BlocEditorial from '@/components/editorial/BlocEditorial.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['garanties']; }
const { contenu = contenuDe('ec').garanties } = Astro.props;

/** Recette A du 15/10/2026 : contenu et ancres conservés, cadres commerciaux retirés. */
---

<section id="garanties" class="section garanties" aria-labelledby="garanties-titre">
  <div class="conteneur pile">
    <BlocEditorial>
      <div class="tete rv">
        <h2 id="garanties-titre">{contenu.titre}</h2>
        <a class="lien-action" href="#questions">{contenu.invitation} <Picto nom="fleche" taille={14} /></a>
      </div>
    </BlocEditorial>
    <div class="liens-bloc">
      <ul class="liens rv" data-garanties>
        {contenu.liens.map((g) => (
          <li>
            <a href={g.href} class="lien-rangee">
              <Picto nom={g.picto} taille={20} />
              <span class="lien-libelle">{g.libelle}</span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
