---
import Picto from '@/components/Picto.astro';

interface Props {
  mentionLocale: string;
  limites: readonly string[];
  suspension?: { motif: string; date: string };
  large?: boolean;
}

const { mentionLocale, limites, suspension, large = false } = Astro.props;
/*
 * L'outil suit le titre (épure du 14/10/2026, OUTILS-EPURE-PLAN.md) : le plateau du formulaire,
 * puis une seule colonne qui dit une fois ce qui reste dans le navigateur et une fois ce que la
 * page ne fait pas. Elle passe à droite dès 1 024 px, sauf pour un outil large (`zoneLarge`) où
 * elle reste dessous, sur deux colonnes ; en mobile, les limites tombent sous le résultat. La
 * phrase de consentement vit dans la FAQ sur les données.
 */
---

<section id="outil-calcul" class="section outil-zone-section" data-tool-section="calcul" aria-labelledby="outil-zone-titre">
  <div class="conteneur">
    <h2 id="outil-zone-titre" class="sr-only">Utiliser l’outil</h2>
    <div class:list={['outil-zone', { 'outil-zone-large': large }]}>
      <div class="outil-calcul">
        {suspension ? (
          <div class="outil-suspension" role="status" aria-labelledby="outil-suspension-titre">
            <p class="surtitre">Règle à revérifier</p>
            <h2 id="outil-suspension-titre">Calcul suspendu</h2>
            <p>Nous avons arrêté ce calcul plutôt que de répondre avec une règle que sa source officielle ne confirme plus.</p>
            <dl>
              <div><dt>Motif</dt><dd>{suspension.motif}</dd></div>
              <div><dt>Depuis le</dt><dd>{suspension.date}</dd></div>
            </dl>
          </div>
        ) : <slot />}
      </div>
      <div class="outil-cadre rv">
        <p class="outil-local" data-local-notice><Picto nom="bouclier" taille={18} /><span>{mentionLocale}</span></p>
        <details class="outil-limites"><summary>Lire les limites de cet outil</summary>
          <h2 id="limites-titre">Ce que cette page ne fait pas</h2>
          <ul data-tool-limits>
            {limites.map((limite) => <li>{limite}</li>)}
          </ul>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
  .outil-zone-section {
    padding-top: var(--espace-4);
  }
  .outil-zone {
    display: grid;
    gap: var(--bloc-ecart);
    align-items: start;
  }
  /* Le plateau du formulaire, comme sur /contact. */
  .outil-calcul {
    min-width: 0;
    padding: var(--espace-4);
    border: 1px solid var(--ligne);
    border-radius: var(--r-carte);
    background: var(--surface-feuille);
    box-shadow: var(--ombre-xs);
  }
  .outil-suspension {
    display: grid;
    gap: var(--tete-ecart);
    max-width: 62ch;
  }
  .outil-suspension h2 {
    font-size: var(--titre-intertitre);
  }
  .outil-suspension > p:not(.surtitre),
  .outil-suspension dd {
    color: var(--texte-2);
  }
  .outil-suspension dl {
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }
  .outil-suspension dl div {
    display: grid;
    gap: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--ligne-douce);
  }
  .outil-suspension dt {
    font-weight: 700;
  }
  .outil-cadre {
    display: grid;
    gap: var(--espace-8);
    align-content: start;
    min-width: 0;
  }
  .outil-local {
    display: flex;
    align-items: flex-start;
    gap: var(--espace-2);
    max-width: 62ch;
    margin: 0;
    color: var(--texte-2);
    font-size: var(--t-sm);
    text-wrap: pretty;
  }
  .outil-local :global(svg) {
    flex: 0 0 auto;
    margin-top: 0.15em;
    color: var(--accent-appui);
  }
  .outil-limites {
    display: grid;
    gap: var(--tete-ecart);
  }
  .outil-limites h2 {
    font-size: var(--titre-bloc);
    line-height: 1.2;
  }
  .outil-limites ul {
    display: grid;
    gap: var(--espace-2);
    max-width: 62ch;
    margin: 0;
    padding-left: 1.3em;
    list-style: disc;
    color: var(--texte-2);
  }
  .outil-limites li {
    text-wrap: pretty;
  }
  @media (min-width: 48rem) {
    .outil-calcul {
      padding: var(--carte-marge-lg);
    }
  }
  .outil-zone { max-width: 1040px; margin-inline: auto; }
  .outil-zone-large { max-width: none; }
  .outil-cadre { gap: 16px; }
  .outil-limites summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--accent-texte); font-weight: 600; }
  .outil-limites[open] h2 { margin: 16px 0; }
  @media (min-width: 64rem) { .outil-zone-section { padding-top: var(--espace-6); } }
</style>
