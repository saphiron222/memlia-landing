---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import Derriere from '@/components/sections/Derriere.astro';
import AgentAnnuaire from '@/components/sections/AgentAnnuaire.astro';
import Picto from '@/components/Picto.astro';
import Insecable from '@/components/Insecable.astro';
import { AGENTS, HUB } from '@/data/specialistes';
import { POLES } from '@/data/familles';
import { hubGraph } from '@/data/schema-agents.mjs';

/**
 * Le hub des agents IA (spec §1, annexe §2 et E12) : héros centré, « Derrière chaque agent, nous », l'annuaire et
 * ses filtres sans JavaScript, puis, pour la lecture informationnelle de la requête, la définition détaillée de
 * l'agent IA, le tableau des métiers et la façon dont un agent se construit ; l'appel final de la coque.
 *
 * Une seule source : les douze cartes, le tableau et l'`ItemList` du JSON-LD lisent le même tableau `AGENTS`, dans le
 * même ordre. Le graphe est assemblé et vérifié par `hubGraph` (aucun Service, jamais de FAQPage), pas ici.
 */
const agents = AGENTS;
const schema = hubGraph(HUB, agents);
const page = {
  chemin: HUB.chemin,
  titre: HUB.titreOnglet,
  description: HUB.description,
  h1: HUB.h1,
  chapeau: HUB.definition,
  ariane: HUB.ariane,
  secondaire: { libelle: HUB.ancreAnnuaire, href: '#annuaire', picto: 'chevron' as const },
};
const appel = { titre: HUB.appel.titre, texte: HUB.appel.texte, points: [] };
const { definitionDetaillee, metiers, construit, sansAgent } = HUB;
---

<PageCommerciale page={page} schema={schema} eyebrow={HUB.surtitre} hero="v2/49-hero-agents-ia" appel={appel}>
  <Derriere />

  <AgentAnnuaire agents={agents} />

  <section class="pv" aria-labelledby="definition-titre" data-definition>
    <div class="tete rv">
      <h2 id="definition-titre">{definitionDetaillee.titre}</h2>
    </div>
    <dl class="lignes">
      {definitionDetaillee.lignes.map((ligne) => (
        <div class="ligne">
          <dt class="ligne-libelle">{ligne.terme}</dt>
          <dd class="ligne-texte"><Insecable texte={ligne.texte} /></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="pv" aria-labelledby="metiers-titre" data-metiers>
    <div class="tete rv">
      <h2 id="metiers-titre">{metiers.titre}</h2>
      <p><Insecable texte={metiers.texte} /></p>
    </div>
    <div class="hub-metiers">
      <table>
        <caption class="sr-only">{metiers.legende}</caption>
        <thead>
          <tr>{metiers.colonnes.map((colonne) => <th scope="col">{colonne}</th>)}</tr>
        </thead>
        <tbody>
          {agents.map((agent) => (
            <tr style={`--teinte: ${POLES[agent.teinte].couleur}`}>
              <th scope="row">
                <span class="hub-metier-prenom">{agent.prenom}</span>
                <span class="hub-metier-libelle">{agent.libelle}</span>
              </th>
              {agent.frontiereEnBref.map((cellule, i) => <td data-label={metiers.colonnes[i + 1]}><span class="hub-metier-texte"><Insecable texte={cellule} /></span></td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="pv" aria-labelledby="construit-titre">
    <div class="tete rv">
      <h2 id="construit-titre">{construit.titre}</h2>
      <p><Insecable texte={construit.texte} /></p>
    </div>
    <div class="bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ol class="cartes">
        {construit.etapes.map((etape, i) => (
          <li class="cellule">
            <p class="surtitre">Étape {i + 1}</p>
            <h3 class="carte-titre">{etape.terme}</h3>
            <p class="carte-texte"><Insecable texte={etape.texte} /></p>
          </li>
        ))}
      </ol>
    </div>
    <div class="hub-sans-agent">
      <p class="mention"><strong><Insecable texte={sansAgent.question} /></strong> <Insecable texte={sansAgent.texte} /></p>
      <a class="lien-action" href={sansAgent.action.href}>{sansAgent.action.libelle}<Picto nom="fleche" taille={14} /></a>
    </div>
  </section>
</PageCommerciale>

<style>
  /* Le tableau des métiers : une comparaison (système de page § 4), une ligne par agent ; empilé sous 48 rem, chaque
     cellule nommée par sa colonne. La teinte du pôle ne marque que la pastille du prénom. */
  .hub-metiers {
    min-width: 0;
    border: 1px solid var(--ligne);
    border-radius: var(--r-boite);
    background: var(--surface-elevee);
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  th,
  td {
    padding: var(--espace-4);
    border-bottom: 1px solid var(--ligne-douce);
    text-align: left;
    vertical-align: top;
  }
  thead th {
    background: var(--surface-page);
    color: var(--texte-fort);
    font-size: var(--t-sm);
    font-weight: 600;
  }
  thead th:first-child {
    width: 22%;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tbody th {
    font-weight: 400;
  }
  td {
    color: var(--texte-2);
  }
  .hub-metier-prenom {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    font-family: var(--police-display), 'Fraunces Fallback';
    font-size: var(--titre-ligne);
    font-weight: 600;
    line-height: 1.3;
    color: var(--texte-fort);
  }
  .hub-metier-prenom::before {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--teinte);
  }
  .hub-metier-libelle {
    display: block;
    margin-top: 2px;
    padding-left: calc(10px + var(--espace-2));
    font-size: var(--t-sm);
    color: var(--texte-2);
  }
  @media (max-width: 47.99rem) {
    thead {
      display: none;
    }
    table,
    tbody,
    tr,
    th,
    td {
      display: block;
      width: 100%;
    }
    tr {
      padding: var(--espace-4);
      border-bottom: 1px solid var(--ligne);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    th,
    td {
      padding: 0;
      border: 0;
    }
    /* Deux éléments de grille par cellule, le libellé (::before) et la valeur : la valeur tient dans un seul
       élément, sinon un segment insécable tombait seul sous le libellé (revue de la tâche 4). */
    td {
      display: grid;
      grid-template-columns: minmax(7.5rem, 0.8fr) minmax(0, 1.2fr);
      gap: var(--espace-3);
      margin-top: var(--espace-3);
    }
    td::before {
      content: attr(data-label);
      color: var(--texte-fort);
      font-size: var(--t-sm);
      font-weight: 600;
    }
  }
  .hub-sans-agent {
    display: grid;
    gap: var(--espace-1);
    justify-items: start;
  }
</style>
