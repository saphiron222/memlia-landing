---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import IntegrationCards from '@/components/sections/IntegrationCards.astro';
import { auteurPar, identiteAuteur } from '@/data/auteurs';
import { INTEGRATIONS_INDEXABLES, integrationPath } from '@/data/integrations';
import { SITE } from '@/data/site.mjs';

const chemin = '/integrations';
const url = `${SITE.url}${chemin}`;
const auteur = auteurPar('kevin');
const vendors = ['Sage', 'Cegid', 'Silae'] as const;
const page = {
  chemin,
  titre: 'Guides par environnement comptable | Memlia',
  description: 'Des repères factuels par logiciel et par tâche, reliés aux moyeux de service Memlia et limités aux requêtes dont la demande a été mesurée.',
  h1: 'Guides par environnement comptable',
  chapeau: 'Une tâche se décrit avec les mots du cabinet, puis se rattache à l’environnement qui la porte. Neuf guides montrent les menus, les champs, le geste préparé et le cas qui doit s’arrêter.',
  ariane: 'Guides par environnement',
  secondaire: { libelle: 'Comprendre le service Memlia', href: '/automatisation-cabinet-comptable' },
};
const noeuds = [
  {
    '@type': 'CollectionPage', '@id': `${url}#webpage`, url, name: page.h1, headline: page.h1,
    description: page.description, datePublished: '2026-09-20', dateModified: '2026-09-21', inLanguage: SITE.langue,
    author: { '@id': `${SITE.url}${identiteAuteur(auteur)}` }, isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': `${url}#items` },
  },
  {
    '@type': 'ItemList', '@id': `${url}#items`, numberOfItems: INTEGRATIONS_INDEXABLES.length,
    itemListElement: INTEGRATIONS_INDEXABLES.map((integration, index) => ({
      '@type': 'ListItem', position: index + 1, name: integration.h1, url: `${SITE.url}${integrationPath(integration)}`,
    })),
  },
];
---

<PageCommerciale
  page={page}
  noeuds={noeuds}
  eyebrow="Guides documentés"
  hero="integrations/hub"
  appel={{
    titre: 'Décrivez le geste dans votre environnement.',
    texte: 'Le nom du logiciel situe le terrain. La mission commence par le geste réel, ses exceptions et la décision que votre équipe doit garder.',
    points: ['Le geste qui revient.', 'L’environnement et les accès disponibles.', 'Le cas qui doit arrêter la préparation.'],
  }}
>
  <section class="pv" aria-labelledby="publication">
    <div class="pv-tete rv">
      <h2 id="publication">Mesurer, publier peu, puis entretenir</h2>
      <p class="texte-2 lecture">Nous ouvrons un guide quand la demande est mesurée et que l’environnement apporte un repère propre. Une page sans signal est consolidée vers son moyeu de service au lieu de rester comme contenu maigre.</p>
    </div>
    <div class="pv-bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ol class="pv-bande-liste rv-groupe">
        <li class="pv-cellule rv"><h3>Demande mesurée</h3><p>La première vague retient neuf couples tâche–logiciel dont la formulation revient réellement.</p></li>
        <li class="pv-cellule rv"><h3>Repère propre</h3><p>Chaque guide porte un chemin, des champs, un piège et une source propres à l’environnement.</p></li>
        <li class="pv-cellule rv"><h3>Frontière de décision</h3><p>Chaque guide sépare la préparation, la validation de l’équipe et le cas d’arrêt.</p></li>
        <li class="pv-cellule rv"><h3>Entretien prévu</h3><p>Le signal d’indexation et la source sont relus ; une page sans utilité n’est pas conservée par inertie.</p></li>
      </ol>
    </div>
  </section>

  {vendors.map((vendor) => {
    const integrations = INTEGRATIONS_INDEXABLES.filter((integration) => integration.vendor === vendor);
    return (
      <section class="pv" aria-labelledby={`vendor-${vendor.toLowerCase()}`}>
        <div class="pv-tete rv">
          <p class="texte-2">{vendor}</p>
          <h2 id={`vendor-${vendor.toLowerCase()}`}>{integrations[0].product}</h2>
          <p class="texte-2 lecture">{integrations.length} {integrations.length > 1 ? 'guides documentés' : 'guide documenté'}, chacun relié à la tâche correspondante et à sa limite de validation.</p>
        </div>
        <IntegrationCards integrations={integrations} />
      </section>
    );
  })}

  <section class="pv" aria-labelledby="passage-tache">
    <div class="pv-tete rv">
      <h2 id="passage-tache">Du guide à la tâche confiée</h2>
      <p class="texte-2 lecture">Le guide donne un repère de départ. La prise en charge commence par le geste réel, les accès disponibles et les exceptions du cabinet, puis se termine par une recette menée avec l’équipe.</p>
    </div>
  </section>
</PageCommerciale>
