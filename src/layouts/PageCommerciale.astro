---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import { CTA, SITE } from '@/data/site.mjs';

/**
 * Coque des cinq pages commerciales du site v2 : fil d'Ariane, hero, appels à
 * l'action, puis les sections de la page en slot. Une seule coque pour éviter
 * qu'un chapeau ou un libellé de CTA diverge d'une page à l'autre.
 */
interface Props {
  page: {
    chemin: string;
    titre: string;
    description: string;
    h1: string;
    chapeau: string;
    ariane: string;
    secondaire: { libelle: string; href: string };
  };
  /** Nœuds supplémentaires du graphe de données structurées, avant Organization et WebSite. */
  noeuds?: unknown[];
}
const { page, noeuds = [] } = Astro.props;
const url = `${SITE.url}${page.chemin}`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    ...noeuds,
    {
      '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: page.ariane, item: url },
      ],
    },
    { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.nom, url: `${SITE.url}/`, logo: `${SITE.url}/apple-touch-icon.png`, email: SITE.email },
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.nom, inLanguage: SITE.langue, publisher: { '@id': `${SITE.url}/#organization` } },
  ],
};
---

<Base titre={page.titre} titreSocial={page.h1} description={page.description} chemin={page.chemin} base="/">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />

  <div class="feuille page-v2">
    <section class="conteneur page-tete" aria-labelledby="page-titre">
      <nav class="ariane" aria-label="Fil d’Ariane">
        <ol><li><a href="/">Accueil</a></li><li aria-current="page">{page.ariane}</li></ol>
      </nav>
      <h1 id="page-titre">{page.h1}</h1>
      <p class="texte-2 lecture page-chapeau">{page.chapeau}</p>
      <p class="page-actions">
        <Button href={CTA.principal.href} variante="principal" picto="fleche">{CTA.principal.libelle}</Button>
        <Button href={page.secondaire.href} variante="lien">{page.secondaire.libelle}</Button>
      </p>
    </section>

    <slot />
  </div>
</Base>

<style>
  .page-v2 { padding-block: clamp(2rem, 6vw, 4rem) clamp(3rem, 8vw, 6rem); }
  .page-tete { display: grid; gap: 1rem; max-width: 46rem; }
  .page-tete h1 { margin: 0; }
  .page-chapeau { margin: 0; }
  .page-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin: 0.5rem 0 0; }
  .page-v2 :global(section + section) { margin-block-start: clamp(2.5rem, 6vw, 4rem); }
  .page-v2 :global(.page-section) { display: grid; gap: 0.75rem; max-width: 46rem; }
  .page-v2 :global(.page-section h2) { margin: 0; }
  .page-v2 :global(.page-section h3) { margin: 1rem 0 0; }
  .page-v2 :global(.page-section p) { margin: 0; }
  .page-v2 :global(.page-section ul) { margin: 0; padding-inline-start: 1.25rem; display: grid; gap: 0.5rem; }
  .page-v2 :global(.page-encadre) {
    border-inline-start: 3px solid var(--vert); background: var(--surface);
    padding: 1rem 1.25rem; border-radius: 0 12px 12px 0; display: grid; gap: 0.5rem;
  }
</style>
