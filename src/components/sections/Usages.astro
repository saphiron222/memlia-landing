---
import Picto, { type NomPicto } from '@/components/Picto.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['usages']; }
const { contenu = contenuDe('ec').usages } = Astro.props;
const pictos: NomPicto[] = ['feuilles', 'bouclier', 'limites', 'flux', 'main'];

/**
 * Système de page : cinq familles de tâches, chacune un terme et sa définition, non cliquables.
 * Ce sont des lignes (`.lignes`, global.css), pas des cartes : une carte est une destination.
 * Le même pictogramme, de la même couleur, ouvre chaque ligne ; aucune palette par capacité.
 */
const examples = contenu.exemples;
---
<section id="usages" class="section uses" aria-labelledby="uses-title">
  <div class="conteneur pile">
    <div class="tete">
      <h2 id="uses-title">{contenu.titre}</h2>
      <p>{contenu.texte}</p>
    </div>
    <ul class="lignes">
      {examples.map((example, i) => (
        <li class="ligne" data-usage={example.id}>
          <div class="ligne-tete">
            <span class="ligne-picto" aria-hidden="true"><Picto nom={pictos[i]} taille={24} /></span>
            <h3 id={`use-${example.id}`} class="ligne-libelle">{example.title}</h3>
          </div>
          <p class="ligne-texte">{example.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
