---
interface Source {
  editeur: string;
  titre: string;
  url: string;
  preuve: string;
  consulteLe: string;
  limite?: string;
}
interface Props { source: Source; }
const { source } = Astro.props;
---

<article class="source-evidence" data-primary-source>
  <h3><a class="source-lien" href={source.url} rel="noopener noreferrer">{source.editeur} — {source.titre}<span aria-hidden="true"> ↗</span></a></h3>
  <p class="source-portee">{source.preuve}{source.limite && ` ${source.limite}`}</p>
</article>

<style>
  .source-evidence { display: grid; gap: 7px; padding: 24px 0; }
  h3 { font-size: var(--t-xl); line-height: 1.25; }
  a { color: var(--texte-fort); text-decoration: underline; text-decoration-color: var(--accent-appui); text-underline-offset: 4px; }
  p { max-width: 68ch; margin: 0; color: var(--texte-2); text-wrap: pretty; }
  .source-portee { font-size: var(--t-sm); line-height: 1.55; }
</style>
