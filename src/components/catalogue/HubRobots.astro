---
import { ROBOT_HUB as hub, ROBOTS, ROBOT_CATEGORIES, comptesRobots, cheminRobot } from '@/data/robots';
import Figurine from './Figurine.astro';
import Carte from './Carte.astro';
import Button from '@/components/Button.astro';
import Picto from '@/components/Picto.astro';
import Lockup from '@/components/Lockup.astro';
import SourcesRobots from './SourcesRobots.astro';
import '@/styles/catalogue/commun.css';
import '@/styles/catalogue/hub.css';
interface Props { guideHref: string }
const { guideHref } = Astro.props;
const comptes = comptesRobots();
const categories = ROBOT_CATEGORIES.filter((categorie) => comptes[categorie.id]);
const filtresCss = categories.map(({id}) => `.hub-annuaire:has(input[value="${id}"]:checked) .hub-robots > :not([data-categorie="${id}"]) { display: none; }`).join('\n');
const trio = ['taxes-foncieres', 'cfe', 'suivi-urssaf'].map((id) => ROBOTS.find((r) => r.id === id)).filter(Boolean);
---
<div class="feuille catalogue-page catalogue-hub">
  <section class="hub-hero" aria-labelledby="hub-titre" data-hub-section="hero">
    <p class="surtitre">Robots pour cabinets comptables</p><h1 id="hub-titre">{hub.h1}</h1><p class="hub-intro">{hub.introduction}</p>
    <Button href="#annuaire" variante="lien" picto="chevron">Trouver votre premier robot</Button>
    <ul class="hub-trio">{trio.map((robot) => robot && <li><div class="hub-medaillon"><Figurine src={robot.image.src} alt={robot.image.alt} taille={116} prioritaire /></div><p>{robot.nom}</p><span>{ROBOT_CATEGORIES.find((cat) => cat.id === robot.categorie)?.nom}</span></li>)}</ul>
  </section>
  <section class="catalogue-section" aria-labelledby="derriere-titre" data-hub-section="signature"><span id="prepare" class="catalogue-ancre" aria-hidden="true"></span>
    <div class="hub-signature memlia-surface-verte"><div class="hub-signature-marque"><Lockup href="/methode" /></div><div><h2 id="derriere-titre">Derrière chaque robot, nous.</h2><p>Nous observons le geste, écrivons sa règle, construisons et éprouvons le robot sur des cas fictifs. Votre équipe vérifie le résultat avant la mise en service. Nous assurons ensuite sa maintenance.</p><ol aria-label="Notre prise en charge"><li>Observation</li><li>Règle écrite</li><li>Essais</li><li>Recette</li><li>Maintenance</li></ol></div><a class="catalogue-action" href="/methode">Voir notre méthode<Picto nom="fleche" taille={14} /></a></div>
  </section>
  <section class="catalogue-section" id="annuaire" aria-labelledby="annuaire-titre" data-hub-section="annuaire"><span id="situation" class="catalogue-ancre" aria-hidden="true"></span><span id="livre" class="catalogue-ancre" aria-hidden="true"></span><span id="perimetre" class="catalogue-ancre" aria-hidden="true"></span><span id="taches-guides" class="catalogue-ancre" aria-hidden="true"></span>
    <div class="hub-annuaire-tete tete"><div><h2 id="annuaire-titre">Quelle tâche confier à un robot ?</h2><p>Choisissez la routine qui revient dans votre cabinet. Chaque fiche montre ce que le robot vous remet.</p></div><p class="hub-total">{ROBOTS.length} {ROBOTS.length === 1 ? 'robot' : 'robots'}</p></div>
    <div class="hub-annuaire">
      <fieldset class="hub-filtres"><legend class="sr-only">Filtrer les robots par besoin</legend>
        <label><input type="radio" name="robot-categorie" value="tous" checked /><span>Tous <span>({ROBOTS.length})</span></span></label>
        {categories.map((cat) => <label><input type="radio" name="robot-categorie" value={cat.id} /><span>{cat.nom} <span>({comptes[cat.id]})</span></span></label>)}
      </fieldset>
      <ul class="catalogue-grille hub-robots" aria-label="Catalogue des robots">{ROBOTS.map((robot) => <li data-categorie={robot.categorie} data-robot={robot.id}><Carte {...robot} href={cheminRobot(robot)} categorie={ROBOT_CATEGORIES.find((cat) => cat.id === robot.categorie)?.nom ?? ''} /></li>)}</ul>
    </div>
  </section>
  <section class="catalogue-section" aria-labelledby="construit-titre" data-hub-section="sur-mesure"><span id="cabinet" class="catalogue-ancre" aria-hidden="true"></span><span id="outils" class="catalogue-ancre" aria-hidden="true"></span>
    <div class="tete"><h2 id="construit-titre">Construit sur votre cabinet.</h2><p>Vos règles, vos outils, vos échéances : le robot suit le travail de votre équipe.</p></div>
    <ol class="catalogue-etapes"><li><span class="catalogue-etape-numero">01</span><h3>Vos règles</h3><p>Un avis absent, un seuil de variation, une validation avant envoi : nous écrivons avec vous ce qui se traite et ce qui s’arrête.</p><a class="catalogue-action" href="/methode">Écrire la règle<Picto nom="fleche" taille={14} /></a></li><li><span class="catalogue-etape-numero">02</span><h3>Vos outils</h3><p>Portail fiscal, logiciel du cabinet, messagerie ou dossier partagé : nous préparons les accès et le classement du résultat dans les outils que vous utilisez.</p><a class="catalogue-action" href="/integrations">Voir les compatibilités<Picto nom="fleche" taille={14} /></a></li><li><span class="catalogue-etape-numero">03</span><h3>Vos échéances</h3><p>Une campagne annuelle, une relève régulière, un nouveau dossier : nous réglons le déclenchement et les reprises au rythme de votre cabinet.</p><a class="catalogue-action" href="/garanties">Connaître les conditions d’arrêt<Picto nom="fleche" taille={14} /></a></li></ol>
    <SourcesRobots />
    <a class="catalogue-action" href={guideHref}>Repérer les tâches à automatiser dans votre cabinet<Picto nom="fleche" taille={14} /></a>
  </section>
  <section class="catalogue-section" aria-labelledby="autre-titre" data-hub-section="autre-tache"><span id="requis" class="catalogue-ancre" aria-hidden="true"></span><span id="avant" class="catalogue-ancre" aria-hidden="true"></span><div class="hub-autre"><h2 id="autre-titre">Votre tâche n’a pas encore son robot ?</h2><p>Décrivez le geste qui revient, l’outil ouvert et le résultat attendu. Nous écrivons sa règle avec vous.</p><a class="catalogue-action" href="/contact">Nous parler de cette tâche<Picto nom="fleche" taille={14} /></a></div></section>
  <section class="catalogue-fin" aria-labelledby="fin-titre" data-hub-section="contact"><span id="prix" class="catalogue-ancre" aria-hidden="true"></span><span id="suite" class="catalogue-ancre" aria-hidden="true"></span><h2 id="fin-titre">Une première tâche. Un résultat à vous remettre.</h2><p>Commençons par la routine que votre équipe refait déjà. Nous cadrons le travail, construisons le robot et le maintenons dans vos outils.</p><Button href="/contact" variante="principal" picto="fleche">Confier une première tâche</Button><a class="catalogue-action" href="/outils-comptables-gratuits/calculateur-roi-automatisation">Estimer le budget et le temps valorisé<Picto nom="fleche" taille={14}/></a><p class="mention">Rien à envoyer : la description suffit.</p></section>
</div>
<style is:inline set:html={filtresCss} />
