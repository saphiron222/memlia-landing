---
import Base from '@/layouts/Base.astro';
import AppelFinal from '@/components/sections/AppelFinal.astro';
import OutilFaq from '@/components/sections/OutilFaq.astro';
import OutilGaranties from '@/components/sections/OutilGaranties.astro';
import OutilHero from '@/components/sections/OutilHero.astro';
import OutilPreuves from '@/components/sections/OutilPreuves.astro';
import OutilPromesse from '@/components/sections/OutilPromesse.astro';
import OutilSuite from '@/components/sections/OutilSuite.astro';
import OutilZone from '@/components/sections/OutilZone.astro';
import { SITE } from '@/data/site.mjs';
import { OUTILS_HUB_PATH, outilPath, type OutilDefinition } from '@/data/outils';

interface Props { outil: OutilDefinition }
const { outil } = Astro.props;
const path = outilPath(outil);
const url = `${SITE.url}${path}`;
const socialImage = outil.proof ? {
  url: `/proofs/v2/og/${outil.proof.slice(3)}.webp`, width: 1200, height: 630,
  alt: `Aperçu fictif — ${outil.h1}`,
} : undefined;
const csp = "default-src 'self'; base-uri 'self'; connect-src 'none'; worker-src 'self'; font-src 'self'; form-action 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'";
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage', '@id': `${url}#page`, url, name: outil.h1, headline: outil.h1, description: outil.description,
      inLanguage: SITE.langue, mainEntity: { '@id': `${url}#application` },
    },
    {
      '@type': 'WebApplication', '@id': `${url}#application`, url, name: outil.h1,
      description: outil.description, applicationCategory: 'BusinessApplication', operatingSystem: 'Any',
      browserRequirements: 'JavaScript activé dans un navigateur récent', isAccessibleForFree: true,
    },
    {
      '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Outils comptables gratuits', item: `${SITE.url}${OUTILS_HUB_PATH}` },
        { '@type': 'ListItem', position: 3, name: outil.h1, item: url },
      ],
    },
  ],
};
---

<Base titre={outil.title} titreSocial={outil.h1} description={outil.description} chemin={path} noindex={outil.statut !== 'disponible'} base="/" csp={csp} socialImage={socialImage} schema={graph}>

  <div class="feuille" data-outil={outil.slug}>
    <OutilHero
      title={outil.h1}
      description={outil.description}
      proof={outil.proof}
      eyebrow={outil.proof ? undefined : 'Démonstration technique'}
      titleId="outil-titre"
      ctaHref="#outil-calcul"
      ctaLabel={outil.statut === 'suspendu' ? 'Voir la suspension' : 'Utiliser l’outil'}
      breadcrumbs={[
        { label: 'Accueil', href: '/' },
        { label: 'Outils comptables gratuits', href: OUTILS_HUB_PATH },
        { label: outil.h1 },
      ]}
    />
    <OutilPromesse entree={outil.promesse.entree} resultat={outil.promesse.resultat} />
    <OutilZone mentionLocale={outil.mentionLocale} limites={outil.limites} suspension={outil.suspension}>
      {outil.statut !== 'suspendu' && <slot />}
    </OutilZone>
    <OutilPreuves source={outil.source} mentionLocale={outil.mentionLocale} refus={outil.limites.at(-1) ?? outil.limites[0]} />
    <OutilGaranties />
    <OutilFaq mentionLocale={outil.mentionLocale} />
    <OutilSuite outil={outil} />
    <AppelFinal
      id="outil-confier"
      titre="La règle de votre cabinet ne tient pas dans un calculateur."
      texte="Nous observons la tâche complète, nous écrivons sa règle et ses limites, puis nous l’automatisons dans vos outils. Votre équipe garde la validation."
      points={[
        'Le geste : ce qui revient et dans quel outil.',
        'La limite : le cas qui doit arrêter le traitement.',
        'Le résultat : ce que votre équipe doit pouvoir valider.',
      ]}
      action={{ libelle: 'Confier une première tâche', href: outil.cta }}
    />
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-outil]');
  if (root) {
    const outil = root.dataset.outil ?? 'inconnu';
    const form = root.querySelector<HTMLFormElement>('[data-tool-section="calcul"] form');
    let started = false;
    let submits = 0;
    const emit = (action: string) => window.dispatchEvent(new CustomEvent('memlia:outil', {
      detail: { action, outil },
    }));
    const start = () => {
      if (started) return;
      started = true;
      emit('demarrage');
    };

    form?.addEventListener('input', start);
    form?.addEventListener('change', start);
    form?.addEventListener('submit', () => {
      start();
      submits += 1;
      if (form.hasAttribute('data-async-tool')) return;
      queueMicrotask(() => {
        const erreur = form.querySelector<HTMLElement>('[data-error]');
        const refuse = Boolean(erreur && !erreur.hidden && erreur.textContent?.trim());
        emit(refuse ? 'erreur' : 'reussite');
        if (submits > 1) emit('recalcul');
      });
    });
    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const action = target?.closest<HTMLElement>('[data-outil-action]')?.dataset.outilAction;
      if (action) {
        if (action === 'exemple') start();
        emit(action);
      }
      if (target?.closest('a[href="/contact"]')) emit('cta');
    });
    window.addEventListener('pageshow', (event) => {
      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (event.persisted || navigation?.type === 'back_forward' || navigation?.type === 'reload') emit('retour');
    }, { once: true });
  }
</script>
