---
import Base from './Base.astro';
import Picture from '@/components/Picture.astro';
import Picto from '@/components/Picto.astro';
import Button from '@/components/Button.astro';
import ArticleJsonLd from '@/components/ArticleJsonLd.astro';
import { SITE, CTA, OG_IMAGE } from '@/data/site.mjs';
import { BLOG, compterMots } from '@/data/blog.mjs';
import { IMAGES, cheminImage, hauteurPour } from '@/data/images.mjs';
import { auteurPar, identiteAuteur } from '@/data/auteurs';
import { isPreviewEntry } from '@/data/blog-visibility.mjs';
import { previewAssetOrigin } from '@/data/blog-preview-origin.mjs';
import type { CollectionEntry } from 'astro:content';

/**
 * Gabarit d'article (spec 7 bis, M5) : fil d'Ariane, en-tête, « En bref » (réponse
 * directe), couverture 16:9, corps Markdown, sources, pont vers le service, auteur,
 * lecture suivante. Colonne 720 px, styles du corps portés ici (`:global`).
 */
interface Props {
  entree: CollectionEntry<'blog'>;
  suivants: CollectionEntry<'blog'>[];
}
const { entree, suivants } = Astro.props;
const { data } = entree;
const chemin = `${BLOG.chemin}/${entree.id}`;
const auteur = auteurPar(data.auteur);
const dateMiseAJour = data.dateMiseAJour ?? data.datePublication;
const description = data.description ?? data.resume.slice(0, 157).trimEnd() + '…';
const nombreMots = compterMots(entree.body ?? '');
const minutes = Math.max(1, Math.ceil(nombreMots / BLOG.motsParMinute));
const formatDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
/** Open Graph attend un datetime ISO 8601 complet ; l'attribut `datetime` visible garde la date seule. */
const isoComplet = (d: Date) => d.toISOString();
/** Cible unique de l'attribution : la page qui présente la personne, jamais une fiche de liste. */
const cheminAuteur = identiteAuteur(auteur);
const urlAuteur = `${SITE.url}${cheminAuteur}`;
const LIBELLE_SUJET: Record<string, string> = {
  paie: 'Paie', dsn: 'DSN', excel: 'Excel', 'production-sociale': 'Production sociale',
  automatisation: 'Automatisation', pieces: 'Pièces', saisie: 'Saisie', lettrage: 'Lettrage', revision: 'Révision', fiscal: 'Fiscal',
  facturation: 'Facturation', courriels: 'Courriels', ia: 'IA', donnees: 'Données', juridique: 'Juridique', pilotage: 'Pilotage',
  methode: 'Méthode', securite: 'Sécurité', cabinet: 'Cabinet',
};
const image = data.image as keyof typeof IMAGES;
const candidatPreview = isPreviewEntry(entree);
const assetOrigin = previewAssetOrigin({
  candidatePreview: candidatPreview,
  configuredOrigin: process.env.BLOG_PREVIEW_ORIGIN,
  productionOrigin: SITE.url,
});
const socialImage = data.pipelineVersion === 1 && data.imageOg && data.imageAlt
  ? { url: `${assetOrigin}${data.imageOg}`, width: 1200, height: 630, alt: data.imageAlt }
  : { url: OG_IMAGE.url, width: OG_IMAGE.largeur, height: OG_IMAGE.hauteur, alt: OG_IMAGE.alt };
const heroDefinition = IMAGES[image];
const heroWidth = Math.max(...heroDefinition.largeurs);
const structuredImage = data.pipelineVersion === 1
  ? socialImage
  : {
      url: `${SITE.url}${cheminImage(image, heroWidth, 'webp')}`,
      width: heroWidth,
      height: hauteurPour(heroDefinition, heroWidth),
      alt: heroDefinition.alt,
    };
const ctaArticle = data.cta;
/**
 * La destination de l'appel à l'action suit la règle du site, pas le frontmatter.
 * Les articles publiés pointent Cal.com dans leurs octets scellés ; ces octets ne se
 * retouchent pas — c'est le gabarit qui applique la règle courante, et l'échange se
 * prépare désormais sur /contact avant toute réservation.
 */
const destinationArticle = ctaArticle?.destination && !ctaArticle.destination.includes('cal.com')
  ? ctaArticle.destination
  : CTA.principal.href;
const articleCta = {
  label: ctaArticle?.label ?? CTA.principal.libelle,
  destination: destinationArticle,
  outcome: ctaArticle?.outcome ?? 'Memlia automatise avec l’IA les tâches et processus chronophages des cabinets d’expertise comptable : la règle est écrite avec vous, l’automatisation prépare et signale, votre équipe décide. Le premier échange sert à cadrer le périmètre, sans transmettre de fichier ni de donnée client réelle.',
};
---

<Base titre={data.titreOnglet ?? `${data.titre} | Memlia`} titreSocial={data.titre} description={description} chemin={chemin} noindex={candidatPreview} ogType="article" socialImage={socialImage} base="/">
  <Fragment slot="head">
    <meta property="article:published_time" content={isoComplet(data.datePublication)} />
    <meta property="article:modified_time" content={isoComplet(dateMiseAJour)} />
    <meta property="article:author" content={urlAuteur} />
    {data.sujets.map((s) => <meta property="article:tag" content={LIBELLE_SUJET[s]} />)}
    <ArticleJsonLd
      chemin={chemin}
      titre={data.titre}
      description={description}
      datePublication={data.datePublication}
      dateMiseAJour={dateMiseAJour}
      auteur={auteur}
      imageUrl={structuredImage.url}
      imageWidth={structuredImage.width}
      imageHeight={structuredImage.height}
      imageAlt={structuredImage.alt}
      motsCles={data.motsCles}
      sujets={data.sujets.map((s) => LIBELLE_SUJET[s])}
      nombreMots={nombreMots}
    />
  </Fragment>

  <div class="feuille article-feuille">
    <article class="article conteneur" data-article={entree.id}>
      {candidatPreview && <p class="preview-temoin" role="status">Candidat éditorial — preview privée, non publiable</p>}
      <nav class="ariane" aria-label="Fil d’Ariane">
        <ol>
          <li><a href="/">Accueil</a></li>
          <li><a href={BLOG.chemin}>Blog</a></li>
          <li aria-current="page">{data.titre}</li>
        </ol>
      </nav>

      <header class="article-tete">
        <ul class="article-sujets" aria-label="Sujets">
          {data.sujets.map((s) => <li class="pastille"><span class="point"></span>{LIBELLE_SUJET[s]}</li>)}
        </ul>
        <h1 class="article-h1">{data.titre}</h1>
        <p class="article-meta texte-2">
          <a href={cheminAuteur} rel="author">{auteur.nom}</a>
          <span aria-hidden="true">·</span>
          <time datetime={iso(data.datePublication)}>{formatDate(data.datePublication)}</time>
          {data.dateMiseAJour && (
            <>
              <span aria-hidden="true">·</span>
              <span>mis à jour le <time datetime={iso(data.dateMiseAJour)}>{formatDate(data.dateMiseAJour)}</time></span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{minutes} min de lecture</span>
        </p>
        <aside class="en-bref" aria-labelledby="en-bref-titre">
          <span id="en-bref-titre" class="eyebrow">En bref</span>
          <p>{data.resume}</p>
        </aside>
      </header>

      <Picture id={image} sizes="(min-width: 48rem) 720px, 100vw" loading="eager" fetchpriority="high" class="article-couverture" />

      <div class="article-corps lecture">
        <slot />
      </div>

      <section class="article-sources" aria-labelledby="sources-titre">
        <h2 id="sources-titre">Sources consultées</h2>
        <ol>
          {data.sources.map((s) => (
            <li>
              {s.editeur}, <a href={s.url} rel="noopener">{s.titre}</a>, consulté le <time datetime={iso(s.consulte)}>{formatDate(s.consulte)}</time>.
            </li>
          ))}
        </ol>
      </section>

      <aside class="article-pont coins" aria-labelledby="pont-titre">
        <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
        <span class="eyebrow">Et dans votre cabinet ?</span>
        <h2 id="pont-titre">Cette tâche vous prend encore du temps à la main ?</h2>
        <p class="texte-2" data-cta-outcome>{articleCta.outcome}</p>
        <Button href={articleCta.destination} variante="principal" picto="fleche">{articleCta.label}</Button>
      </aside>

      <footer class="article-auteur">
        <span class="auteur-initiale" aria-hidden="true">{auteur.nom.charAt(0)}</span>
        <div>
          <p class="auteur-nom"><a href={cheminAuteur} rel="author">{auteur.nom}</a> <span class="texte-2">· {auteur.role}</span></p>
          <p class="texte-2 auteur-bio">{auteur.bio}</p>
        </div>
      </footer>

      {suivants.length > 0 && (
        <nav class="article-suite" aria-labelledby="suite-titre">
          <h2 id="suite-titre">À lire ensuite</h2>
          <ul>
            {suivants.map((s) => (
              <li>
                <a href={`${BLOG.chemin}/${s.id}`} class="suite-lien">
                  <span class="suite-titre">{s.data.titre}</span>
                  <span class="texte-2 suite-resume">{s.data.resume}</span>
                  <span class="btn btn-lien">Lire l’article <Picto nom="fleche" taille={14} /></span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {/* Ordre décrit par la copy transversale : signature, article connexe, puis la méthode. */}
      <p class="texte-2 article-pont-methode">Avant d’en parler : <a href="/methode">comment se déroule une mission</a>.</p>

      <p class="article-retour"><a class="btn btn-lien" href={BLOG.chemin}><Picto nom="gauche" taille={14} /> Tous les articles</a></p>
    </article>
  </div>
</Base>

<style>
  .article-feuille { background: var(--surface-feuille); }
  .article {
    max-width: 720px;
    padding-top: clamp(28px, 5vw, 56px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .preview-temoin {
    margin-bottom: 20px; padding: 10px 14px; border: 2px solid var(--accent-appui);
    border-radius: var(--r-boite); color: var(--texte-fort); font-weight: 600; background: var(--accent-voile);
  }
  .ariane ol { display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--t-sm); color: var(--texte-2); }
  .ariane li + li::before { content: '›'; margin-right: 6px; color: var(--picto-repos); }
  .ariane a { color: var(--texte-2); text-decoration: underline; text-underline-offset: 2px; }
  .ariane [aria-current] { color: var(--texte); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 34ch; }
  .article-tete { display: grid; gap: 16px; margin-top: 28px; }
  .article-sujets { display: flex; flex-wrap: wrap; gap: 8px; }
  .article-h1 { font-size: var(--t-5xl); line-height: 1.08; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 8px; font-size: var(--t-sm); }
  .article-meta a { color: var(--accent-texte); text-decoration: underline; text-underline-offset: 2px; }
  .en-bref {
    display: grid; gap: 8px; padding: 20px 24px; margin-top: 8px;
    border: 1px solid var(--ligne); border-left: 4px solid var(--accent-appui);
    border-radius: var(--r-boite); background: var(--accent-voile);
  }
  .en-bref p { font-size: var(--t-lg); color: var(--texte-fort); line-height: 1.5; }
  .article-couverture { margin-top: 32px; border-radius: var(--r-carte); overflow: hidden; border: 1px solid var(--ligne-douce); }
  .article-corps { margin-top: 40px; max-width: none; }
  .article-corps :global(h2) { font-size: var(--t-3xl); margin: 2.2em 0 0.6em; }
  .article-corps :global(h3) { font-size: var(--t-xl); margin: 1.6em 0 0.5em; }
  .article-corps :global(p) { margin: 0 0 1.1em; color: var(--texte); }
  .article-corps :global(ul), .article-corps :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .article-corps :global(ul) { list-style: disc; }
  .article-corps :global(ol) { list-style: decimal; }
  .article-corps :global(li) { margin: 0.4em 0; }
  .article-corps :global(li > p) { margin-bottom: 0.4em; }
  .article-corps :global(a) { color: var(--accent-texte); text-decoration: underline; text-underline-offset: 2px; }
  .article-corps :global(strong) { font-weight: 600; color: var(--texte-fort); }
  .article-corps :global(blockquote) {
    margin: 1.4em 0; padding: 12px 20px; border-left: 3px solid var(--ligne-forte);
    color: var(--texte-2); font-family: var(--police-display), 'Fraunces Fallback'; font-style: italic; font-weight: 400;
  }
  /* Un tableau à trois colonnes dépasse 320 px : il défile dans sa colonne au lieu d'élargir la page. */
  .article-corps :global(table) { display: block; width: 100%; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1.2em 0 1.6em; font-size: var(--t-sm); }
  .article-corps :global(th), .article-corps :global(td) { min-width: 9em; }
  .article-corps :global(th:nth-child(2)), .article-corps :global(td:nth-child(2)) { min-width: 16em; }
  .article-corps :global(th), .article-corps :global(td) { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid var(--ligne-douce); }
  .article-corps :global(th) { font-weight: 600; color: var(--texte-fort); border-bottom-color: var(--ligne-forte); }
  .article-corps :global(figure) { margin: 1.8em 0; }
  .article-corps :global(figure svg) { width: 100%; height: auto; display: block; border: 1px solid var(--ligne-douce); border-radius: var(--r-boite); background: var(--surface-page); }
  .article-corps :global(figcaption) { margin-top: 8px; font-size: var(--t-sm); color: var(--texte-2); }
  .article-corps :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; background: var(--surface-hover); padding: 0.1em 0.35em; border-radius: 4px; }
  .article-corps :global(hr) { border: 0; border-top: 1px solid var(--ligne-douce); margin: 2.4em 0; }
  .article-corps :global(.tableau-defilant) { overflow-x: auto; }
  .article-sources { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--ligne-douce); }
  .article-sources h2 { font-size: var(--t-xl); margin-bottom: 12px; }
  .article-sources ol { padding-left: 1.3em; list-style: decimal; font-size: var(--t-sm); color: var(--texte-2); display: grid; gap: 6px; }
  .article-sources a { color: var(--accent-texte); text-decoration: underline; text-underline-offset: 2px; overflow-wrap: anywhere; }
  .article-pont {
    display: grid; gap: 12px; justify-items: start; margin-top: 48px; padding: 32px 24px;
    border: 1px solid var(--ligne); border-radius: var(--r-carte); background: rgba(255, 254, 251, 0.92); box-shadow: var(--ombre-xs);
  }
  .article-pont h2 { font-size: var(--t-3xl); max-width: 24ch; }
  .article-pont p { max-width: 58ch; }
  .article-auteur { display: flex; gap: 16px; align-items: flex-start; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--ligne-douce); }
  .auteur-initiale {
    display: grid; place-items: center; flex: 0 0 auto; width: 48px; height: 48px; border-radius: 12px;
    background: var(--accent); color: var(--creme); font-family: var(--police-display), 'Fraunces Fallback'; font-weight: 600; font-size: 1.4rem;
  }
  .auteur-nom { font-weight: 600; color: var(--texte-fort); }
  .auteur-nom a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .auteur-bio { font-size: var(--t-sm); margin-top: 4px; }
  .article-suite { margin-top: 48px; }
  .article-suite h2 { font-size: var(--t-xl); margin-bottom: 12px; }
  .article-suite ul { display: grid; gap: 12px; }
  .suite-lien { display: grid; gap: 6px; padding: 20px; border: 1px solid var(--ligne); border-radius: var(--r-boite); transition: border-color var(--duree-1), background-color var(--duree-1); }
  .suite-titre { font-family: var(--police-display), 'Fraunces Fallback'; font-weight: 600; font-size: var(--t-xl); color: var(--texte-fort); }
  .suite-resume { font-size: var(--t-sm); }
  .article-retour { margin-top: 32px; }
  @media (hover: hover) {
    .suite-lien:hover { border-color: var(--ligne-forte); background: var(--surface-page); }
  }
  @media (min-width: 48rem) {
    .article-pont { padding: 40px 48px; }
  }
</style>
