---
import { getCollection } from 'astro:content';
import BlogRubrique from '@/components/blog/BlogRubrique.astro';
import { construireRoutesRubriques } from '@/data/blog-rubriques.mjs';
import { isBlogEntryVisible } from '@/data/blog-visibility.mjs';

export async function getStaticPaths() {
  const articles = await getCollection('blog', isBlogEntryVisible);
  return construireRoutesRubriques(articles)
    .filter(({ historique }) => historique)
    .map(({ param, rubrique }) => ({ params: { slug: param }, props: { rubrique } }));
}
---
<BlogRubrique rubrique={Astro.props.rubrique} />