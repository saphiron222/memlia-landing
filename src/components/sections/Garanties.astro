---
import Picto from '@/components/Picto.astro';
import ProofRow from '@/components/ProofRow.astro';
import { contenuDe, type ContenuAccueil } from '@/data/accueil/contenu';
interface Props { contenu?: ContenuAccueil['garanties']; }
const { contenu = contenuDe('ec').garanties } = Astro.props;

/**
 * S3 — Grille de garanties (spec §4.9), à la place des logos clients.
 * Chaque cellule est un lien vers la question FAQ qui la détaille.
 */
---

<section id="garanties" class="garanties" aria-labelledby="garanties-titre">
  <div class="garanties-media"><ProofRow id={contenu.image} enlarge>
  <div class="garanties-tete">
    <div class="garanties-phrase">
      <h2 id="garanties-titre" class="garanties-h2">{contenu.titre}</h2>
      <a class="btn btn-lien" href="#questions">{contenu.invitation} <Picto nom="fleche" taille={14} /></a>
    </div>
    <span class="garanties-sep" aria-hidden="true"></span>

  </div>

  <div class="garanties-proof-list">
  <ul class="garanties-grille rv" data-garanties>
    {contenu.liens.map((g) => (
      <li class="garantie">
        <a href={g.href} class="garantie-lien">
          <Picto nom={g.picto} taille={24} class="garantie-picto" />
          <span class="garantie-libelle">{g.libelle}</span>
          <Picto nom="fleche" taille={14} class="garantie-fleche" />
        </a>
      </li>
    ))}
  </ul>
  </div>
  </ProofRow></div>
</section>

<style>
  .garanties-media { padding: 0 var(--marge-page); }
  @media (min-width: 64rem) { .garanties-media { padding: 0 var(--marge-page-lg); } }
  .garanties {
    margin-top: 32px;
  }
  .garanties-tete {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 0 24px;
  }
  .garanties-phrase {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .garanties-h2 {
    font-family: var(--police-corps), 'Hanken Fallback';
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.5;
    color: var(--texte);
  }
  .garanties-sep {
    display: none;
    width: 1px;
    height: 56px;
    background: var(--ligne);
  }
  .garanties-embleme {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--ligne-douce);
    flex: 0 0 auto;
  }
  .garanties-grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--ligne-douce);
    border-top: 1px solid var(--ligne-douce);
    border-bottom: 1px solid var(--ligne-douce);
  }
  .garantie {
    position: relative;
    background: var(--surface-feuille);
    min-height: 96px;
    overflow: hidden;
  }
  .garantie-lien {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 100%;
    min-height: 96px;
    padding: 12px 8px 16px;
    text-align: center;
    color: var(--texte-2);
    transition: color var(--duree-4) var(--courbe-standard);
  }
  .garantie-picto {
    color: var(--picto-repos);
    transition: color var(--duree-4) var(--courbe-standard);
  }
  .garantie-libelle {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    text-wrap: balance;
  }
  .garantie-fleche {
    position: absolute;
    right: 10px;
    bottom: 8px;
    opacity: 0;
    transform: translateY(12px);
    color: var(--accent-texte);
    transition: opacity var(--duree-3) var(--courbe-standard), transform var(--duree-3) var(--courbe-standard);
  }
  .garantie-lien:focus-visible {
    outline-offset: -3px;
    border-radius: 0;
  }
  .garantie-lien:focus-visible,
  .garantie-lien:focus-visible .garantie-picto {
    color: var(--texte-fort);
  }
  .garantie-lien:focus-visible .garantie-fleche {
    opacity: 1;
    transform: none;
  }
  /* Un seul balayage à l'entrée dans le viewport, jamais en boucle (§4.9). */
  .garantie::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.6) 50%, transparent 70%);
    transform: translateX(-100%);
    pointer-events: none;
  }
  :global(html.js) .garanties-grille.in .garantie::after {
    animation: garantie-balayage 1.5s var(--courbe-standard) both;
    animation-delay: calc(var(--i, 0) * 150ms);
  }
  .garantie:nth-child(2) { --i: 0; }
  .garantie:nth-child(3) { --i: 1; }
  .garantie:nth-child(4) { --i: 2; }
  .garantie:nth-child(5) { --i: 3; }
  .garantie:nth-child(6) { --i: 4; }
  .garantie:nth-child(7) { --i: 5; }
  @keyframes garantie-balayage {
    to {
      transform: translateX(100%);
    }
  }
  @media (hover: hover) {
    .garantie-lien:hover {
      color: var(--texte-fort);
    }
    .garantie-lien:hover .garantie-picto {
      color: var(--accent-texte);
    }
    .garantie-lien:hover .garantie-fleche {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .garanties-grille.in .garantie::after {
      animation: none;
    }
  }
  @media (min-width: 40rem) {
    .garantie,
    .garantie-lien {
      min-height: 128px;
    }
  }
  @media (min-width: 48rem) {
    .garanties-tete {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 0 0 24px;
    }
    .garanties-phrase {
      flex-direction: column;
      align-items: start;
      gap: 16px;
      flex: 1;
    }
    .garanties-sep {
      display: none;
      margin: 0 24px;
    }
  }
  @media (min-width: 64rem) {
    .garanties-tete {
      padding: 0 0 24px;
    }
    .garanties-grille {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
