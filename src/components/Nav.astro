---
import Lockup from './Lockup.astro';
import Button from './Button.astro';
import Picto from './Picto.astro';
import { CTA } from '@/data/site.mjs';
import { creerNavigation } from '@/data/navigation.mjs';
import { cacDisponible } from '@/data/navigation-publiee';

/**
 * Navigation courte : les sections de l'accueil en clair à partir de 1024 px,
 * repliées derrière un menu en dessous. Le plan complet du site vit dans le footer.
 *
 * Le site v2 avait servi les cinq entrées dans le flux du bandeau, en deux colonnes. Elles
 * étaient atteignables sans action, mais occupaient le haut de chaque page et se lisaient
 * comme une liste en vrac. Le panneau refermable revient donc (demande de Kevin, 16/09/2026),
 * avec les propriétés qu'il tenait déjà : cible de 48 px, fond opaque, fond rendu inerte,
 * défilement verrouillé puis restauré à la fermeture, sortie par Échap comme par la croix.
 *
 * Le bandeau ne porte que le logo et le bouton du menu : toutes les destinations, Hub compris,
 * vivent dans le panneau. Une seule chose reste en dehors, parce qu'elle ne peut dépendre
 * d'aucun geste : la navigation en clair servie à qui n'a pas JavaScript — le panneau, lui,
 * ne s'ouvrirait pas.
 *
 * La barre est collante : à 56 px elle ne masque pas le contenu.
 */
interface Props {
  blogActif: boolean;
  /** Chemin canonique de la page courante (fourni par Base, indépendant de la forme d'URL du build). */
  chemin: string;
  /** Prefixe des ancres : vide sur l'accueil, « / » depuis une autre page. */
  base?: string;
}
const { blogActif, chemin } = Astro.props;

type Marque = 'page' | 'true' | undefined;
interface Destination { libelle: string; href: string; courant: Marque }
interface Groupe { id: string; libelle: string; sousEntrees: Destination[]; courant: Marque }

/**
 * Deux marquages distincts : « page » quand on est exactement sur l'entrée, « true »
 * quand on est dans sa section. Sans le second, un article de blog ne marquait plus
 * aucune entrée et le lecteur perdait sa position dans la navigation.
 */
const marquer = (href: string): Marque =>
  chemin === href ? 'page' : chemin.startsWith(`${href}/`) ? 'true' : undefined;

/**
 * « Ressources » n'est pas une page : c'est un groupe qui réunit le blog et le glossaire
 * (décision de Kevin, 16/09/2026) et qui accueillera les ressources à venir. Il se marque
 * « true » dès qu'une de ses destinations est courante ; ses destinations portent leur propre marque.
 */
const entrees: (Destination | Groupe)[] = creerNavigation({ chemin, cacDisponible, blogActif }).map((entree: any) => {
  if (entree.sousEntrees) {
    const sousEntrees: Destination[] = entree.sousEntrees
      .filter((sous: any) => blogActif || sous.href !== '/blog')
      .map((sous: any) => ({ ...sous, courant: marquer(sous.href) }));
    return { id: entree.id, libelle: entree.libelle, sousEntrees, courant: sousEntrees.some((sous) => sous.courant) ? 'true' : undefined };
  }
  return { ...entree, courant: marquer(entree.href) };
});
const estGroupe = (e: Destination | Groupe): e is Groupe => 'sousEntrees' in e;
/** Toutes les destinations à plat, pour la navigation servie sans JavaScript. */
const destinationsPlates = entrees.flatMap((e) => (estGroupe(e) ? e.sousEntrees : [e]));
const actionCourante = chemin === CTA.nav.href ? 'page' : undefined;
---

<header class="nav-barre">
  <div class="conteneur nav">
    <div class="nav-marque">
      <Lockup href="/" />
    </div>

    <nav class="nav-centre" aria-label="Navigation principale">
      <ul class="nav-liste">
        {entrees.map((e) => estGroupe(e) ? (
          <li class="nav-item nav-groupe" data-groupe>
            <button
              type="button"
              class="nav-entree nav-groupe-bouton"
              aria-expanded="false"
              aria-controls={`sous-menu-${e.id}`}
              aria-current={e.courant}
              data-groupe-bouton
            >
              {e.libelle}
              <Picto nom="chevron" taille={14} class="nav-chevron" />
            </button>
            <ul class="nav-sous-menu" id={`sous-menu-${e.id}`} aria-label={e.libelle}>
              {e.sousEntrees.map((s) => (
                <li><a class="nav-sous-entree" href={s.href} aria-current={s.courant}>{s.libelle}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li class="nav-item">
            <a class="nav-entree" href={e.href} aria-current={e.courant}>{e.libelle}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-droite">
      <Button href={CTA.nav.href} variante="principal" picto="fleche" class="nav-principal" aria-current={actionCourante}>
        {CTA.nav.libelle}
      </Button>

      <button
        type="button"
        class="nav-burger"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu principal"
        data-burger
      >
        <Picto nom="menu" taille={22} class="burger-ouvrir" />
        <Picto nom="fermer" taille={22} class="burger-fermer" />
      </button>
    </div>
  </div>
</header>

<!-- Sur mobile, les destinations restent immédiatement visibles et tactiles. -->
<nav class="nav-mobile-visible" aria-label="Navigation principale mobile" data-mobile-visible>
  <div class="conteneur nav-mobile-visible-liste">
    {destinationsPlates.map((e) => <a href={e.href} aria-current={e.courant}>{e.libelle}</a>)}
  </div>
</nav>

<!-- Frère du header : son backdrop-filter ne doit pas contenir le fixed (WebKit). -->
<div class="nav-mobile" id="menu-mobile" data-menu-mobile hidden>
  <nav aria-label="Navigation principale, menu" class="conteneur">
    <ul class="nav-mobile-liste">
      {entrees.map((e) => estGroupe(e) ? (
        <li class="nav-mobile-groupe">
          <p class="nav-mobile-groupe-titre" id={`menu-mobile-${e.id}`}>{e.libelle}</p>
          <ul class="nav-mobile-sous-liste" aria-labelledby={`menu-mobile-${e.id}`}>
            {e.sousEntrees.map((s) => (
              <li><a class="nav-mobile-lien nav-mobile-sous-lien" href={s.href} aria-current={s.courant}>{s.libelle}</a></li>
            ))}
          </ul>
        </li>
      ) : (
        <li><a class="nav-mobile-lien" href={e.href} aria-current={e.courant}>{e.libelle}</a></li>
      ))}
      <li class="nav-mobile-cta">
        <Button href={CTA.nav.href} variante="principal" picto="fleche" aria-current={actionCourante}>
          {CTA.nav.libelle}
        </Button>
      </li>
    </ul>
  </nav>
</div>

<noscript>
  <nav class="conteneur nav-sans-js" aria-label="Navigation sans JavaScript">
    {destinationsPlates.map((e) => <a href={e.href} aria-current={e.courant}>{e.libelle}</a>)}
    <a href={CTA.nav.href} aria-current={actionCourante}>{CTA.nav.libelle}</a>
  </nav>
</noscript>

<style>
  @media print { .nav-barre, .nav-sans-js { display: none; } }
  .nav-barre {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 254, 251, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--ligne-douce);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: var(--nav-h);
  }
  .nav-marque {
    display: flex;
    align-items: center;
  }
  .nav-centre {
    display: none;
  }
  .nav-liste {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-entree {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 8px;
    border-radius: var(--r-bouton);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--texte);
    transition: color var(--duree-1) ease-out, background-color var(--duree-1) ease-out;
  }
  .nav-entree[aria-current],
  .nav-entree:focus-visible {
    color: var(--texte-fort);
    background: var(--surface-hover);
  }
  /* Le groupe « Ressources » : un bouton, et un panneau qui s'ouvre au survol, au focus ou au clic. */
  .nav-groupe {
    position: relative;
  }
  /* Un bouton n'hérite pas de la police : seule la famille est reprise, la taille et la graisse
     restent celles de .nav-entree (le raccourci « font: inherit » les écrasait). */
  .nav-groupe-bouton {
    gap: 4px;
    margin: 0;
    border: 0;
    background: transparent;
    font-family: inherit;
    line-height: inherit;
    cursor: pointer;
  }
  .nav-chevron {
    transition: transform var(--duree-1) ease-out;
  }
  .nav-sous-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 200px;
    display: grid;
    gap: 2px;
    padding: 6px;
    background: var(--surface-feuille);
    border: 1px solid var(--ligne-douce);
    border-radius: var(--r-bouton);
    box-shadow: 0 12px 32px rgba(35, 31, 32, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity var(--duree-1) ease-out, transform var(--duree-1) ease-out;
  }
  /* Le bouton ouvre le panneau au clavier ; fermé, ses liens sortent du Tab. */
  .nav-groupe[data-ouvert] .nav-sous-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }
  .nav-groupe[data-ouvert] .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-sous-entree {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 10px;
    border-radius: var(--r-bouton);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--texte);
  }
  .nav-sous-entree[aria-current],
  .nav-sous-entree:focus-visible {
    color: var(--texte-fort);
    background: var(--surface-hover);
  }
  .nav-droite {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-principal {
    display: inline-flex;
    min-height: 44px;
    font-size: var(--t-sm);
  }
  .nav-burger {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    padding: 6px;
    border-radius: var(--r-bouton);
    border: 1px solid transparent;
    background: transparent;
    color: var(--texte-fort);
    cursor: pointer;
    transition: background-color var(--duree-1), border-color var(--duree-1);
  }
  .nav-burger .burger-fermer,
  .nav-burger[aria-expanded='true'] .burger-ouvrir {
    display: none;
  }
  .nav-burger[aria-expanded='true'] .burger-fermer {
    display: block;
  }
  .nav-mobile {
    position: fixed;
    z-index: 49;
    top: calc(var(--nav-h) + env(safe-area-inset-top, 0px) + 1px);
    left: 0;
    right: 0;
    height: calc(100vh - var(--nav-h) - env(safe-area-inset-top, 0px) - 1px);
    height: calc(100dvh - var(--nav-h) - env(safe-area-inset-top, 0px) - 1px);
    overflow-y: auto;
    overscroll-behavior-y: contain;
    /* Opaque, jamais translucide : le contenu ne doit pas transparaître sous les liens. */
    background: var(--surface-feuille);
    border-top: 1px solid var(--ligne);
    padding: 12px env(safe-area-inset-right, 0px) max(32px, env(safe-area-inset-bottom, 0px)) env(safe-area-inset-left, 0px);
  }
  .nav-mobile[hidden] {
    display: none;
  }
  .nav-mobile-liste {
    display: grid;
  }
  .nav-mobile-lien {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 12px 8px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--texte-fort);
    border-bottom: 1px solid var(--ligne-douce);
  }
  .nav-mobile-lien[aria-current] {
    color: var(--accent-texte);
  }
  .nav-mobile-groupe-titre {
    padding: 18px 8px 4px;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--texte-2);
  }
  .nav-mobile-sous-lien {
    padding-left: 20px;
  }
  .nav-mobile-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 20px 8px 0;
  }
  .nav-mobile-cta :global(.btn) {
    min-height: 48px;
    font-size: 1rem;
    white-space: normal;
  }
  .nav-sans-js {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 12px;
  }
  @media (max-width: 63.999rem) {
    .nav-barre[data-mobile-open] {
      position: fixed;
      left: 0;
      right: 0;
      background: var(--surface-feuille);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  /* Le fond ne défile pas derrière le panneau, et retrouve sa position à la fermeture. */
  :global(body[data-mobile-menu-open]) {
    position: fixed;
    top: var(--mobile-menu-scroll-top);
    left: 0;
    right: 0;
    overflow: hidden;
  }
  @media (max-width: 21.875rem) {
    .nav {
      gap: 8px;
    }
    .nav-burger {
      padding-inline: 6px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-sous-menu,
    .nav-chevron {
      transition: none;
    }
  }
  .nav-mobile-visible {
    display: block;
    border-bottom: 1px solid var(--ligne-douce);
    background: var(--surface-feuille);
  }
  .nav-mobile-visible-liste {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .nav-mobile-visible a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 10px;
    color: var(--texte);
    font-size: var(--t-sm);
    font-weight: 500;
    white-space: nowrap;
  }
  .nav-mobile-visible a[aria-current] {
    color: var(--accent-texte);
  }
  @media (hover: hover) {

    .nav-sous-entree:hover {
      color: var(--texte-fort);
      background: var(--surface-hover);
    }
    .nav-entree:hover {
      color: var(--texte-fort);
      background: var(--surface-hover);
    }
    .nav-burger:hover {
      background: var(--surface-hover);
    }
    .nav-burger:hover {
      border-color: var(--ligne);
    }
  }
  @media (min-width: 64rem) {
    .nav {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 16px;
    }
    .nav-centre {
      display: block;
      justify-self: center;
    }
    .nav-principal {
      display: inline-flex;
    }
    .nav-burger,
    .nav-mobile,
    .nav-mobile-visible {
      display: none;
    }
  }
</style>

<script>
  // Fond inerte et scroll conservé ; la navigation mobile reste quittable par X / Échap.
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu-mobile]');
  const header = document.querySelector<HTMLElement>('.nav-barre');
  if (burger && menu && header) {
    const desktop = window.matchMedia('(min-width: 64rem)');
    let scrollPosition = { x: 0, y: 0 };
    let previousScrollTop = '';
    let inertElements: { element: HTMLElement; inert: boolean }[] = [];
    const closeMenu = (restoreFocus = true) => {
      if (menu.hidden) return;
      menu.hidden = true;
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Ouvrir le menu principal');
      header.removeAttribute('data-mobile-open');
      document.body.removeAttribute('data-mobile-menu-open');
      if (previousScrollTop) document.body.style.setProperty('--mobile-menu-scroll-top', previousScrollTop);
      else document.body.style.removeProperty('--mobile-menu-scroll-top');
      inertElements.forEach(({ element, inert }) => { element.inert = inert; });
      inertElements = [];
      window.scrollTo({ left: scrollPosition.x, top: scrollPosition.y, behavior: 'instant' });
      if (restoreFocus) burger.focus({ preventScroll: true });
    };
    burger.addEventListener('click', () => {
      if (!menu.hidden) return closeMenu();
      if (desktop.matches) return;
      scrollPosition = { x: window.scrollX, y: window.scrollY };
      previousScrollTop = document.body.style.getPropertyValue('--mobile-menu-scroll-top');
      document.body.style.setProperty('--mobile-menu-scroll-top', `${-scrollPosition.y}px`);
      document.body.setAttribute('data-mobile-menu-open', '');
      header.setAttribute('data-mobile-open', '');
      const background = [...document.body.children].filter((element): element is HTMLElement =>
        element instanceof HTMLElement && element !== header && element !== menu &&
        !['SCRIPT', 'STYLE', 'NOSCRIPT'].includes(element.tagName));
      inertElements = [...background, ...header.querySelectorAll<HTMLElement>('a')]
        .map(element => ({ element, inert: element.inert }));
      inertElements.forEach(({ element }) => { element.inert = true; });
      menu.hidden = false;
      menu.scrollTop = 0;
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Fermer le menu principal');
      burger.focus({ preventScroll: true });
    });
    menu.addEventListener('click', (e) => {
      // Restaurer le fond avant l'action native du lien (ancre ou changement de page).
      if ((e.target as Element).closest('a')) closeMenu();
    });
    document.addEventListener('focusin', (e) => {
      if (!menu.hidden && e.target !== burger && !menu.contains(e.target as Node)) burger.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', (e) => {
      if (menu.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeMenu();
      } else if (e.key === 'Tab') {
        // Safari peut exclure les liens du Tab natif : parcourir toute la boucle explicitement.
        const controls = [burger, ...menu.querySelectorAll<HTMLAnchorElement>('a[href]')];
        const index = controls.indexOf(document.activeElement as HTMLButtonElement | HTMLAnchorElement);
        const next = (index + (e.shiftKey ? -1 : 1) + controls.length) % controls.length;
        e.preventDefault();
        controls[next].focus();
      }
    });
    desktop.addEventListener('change', (e) => {
      if (!e.matches || menu.hidden) return;
      closeMenu(false);
      header.querySelector<HTMLAnchorElement>('.nav-centre a')?.focus({ preventScroll: true });
    });
    // Ne pas conserver le verrou si la page est restaurée depuis le bfcache.
    window.addEventListener('pagehide', () => closeMenu(false));
  }

  // Le groupe « Ressources » : le survol et le focus le révèlent en CSS ; le clic, Échap et
  // le clic hors du groupe tiennent l'état annoncé (aria-expanded) et l'ouverture sans souris.
  const groupes = [...document.querySelectorAll<HTMLElement>('[data-groupe]')];
  for (const groupe of groupes) {
    const bouton = groupe.querySelector<HTMLButtonElement>('[data-groupe-bouton]');
    if (!bouton) continue;
    const ouvrir = (etat: boolean) => {
      groupe.toggleAttribute('data-ouvert', etat);
      bouton.setAttribute('aria-expanded', String(etat));
    };
    bouton.addEventListener('click', () => ouvrir(!groupe.hasAttribute('data-ouvert')));
    groupe.addEventListener('mouseenter', () => ouvrir(true));
    groupe.addEventListener('mouseleave', () => { if (!groupe.contains(document.activeElement)) ouvrir(false); });
    groupe.addEventListener('focusout', (e) => { if (!groupe.contains(e.relatedTarget as Node | null)) ouvrir(false); });
    groupe.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && groupe.hasAttribute('data-ouvert')) { e.preventDefault(); ouvrir(false); bouton.focus(); }
    });
  }
  if (groupes.length) {
    document.addEventListener('click', (e) => {
      for (const groupe of groupes) {
        if (groupe.contains(e.target as Node)) continue;
        groupe.removeAttribute('data-ouvert');
        groupe.querySelector('[data-groupe-bouton]')?.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
