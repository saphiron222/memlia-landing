---
import GrilleEditoriale from '@/components/editorial/GrilleEditoriale.astro';
import ListeEditoriale from '@/components/editorial/ListeEditoriale.astro';
import PageEditoriale from '@/layouts/PageEditoriale.astro';
import Renvois from '@/components/Renvois.astro';
import BlocEditorial from '@/components/editorial/BlocEditorial.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { auteurPar, identiteAuteur } from '@/data/auteurs';

const page = PAGES_V2.apropos;
const url = `${SITE.url}${page.chemin}`;
/** Identité canonique du site : ce nœud est celui que citent le blog et chaque article. */
const auteur = auteurPar('kevin');
const identite = `${SITE.url}${identiteAuteur(auteur)}`;
const noeuds = [
  {
    '@type': 'AboutPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
    inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': identite },
  },
];
const renvois = [
  { texte: 'Comment se déroule une mission, étape par étape, avec ce que chacune produit.', libelle: 'Comprendre la méthode', href: '/methode' },
  { texte: 'Des méthodes pour écrire et vérifier une tâche avant de l’automatiser, signées et sourcées.', libelle: 'Lire les articles', href: '/blog' },
  { texte: 'Le vocabulaire du cabinet, terme par terme, sourcé et daté, avec la frontière d’automatisation de chacun.', libelle: 'Consulter le glossaire', href: '/glossaire' },
];
const appel = {
  titre: 'Trouvons la prise en charge utile à votre cabinet.',
  texte: 'Partez d’une routine, d’un métier, d’un savoir à partager ou d’un modèle à former. Nous préparons son adaptation, son déploiement et la maintenance, avec un périmètre et un devis.',
  points: ['Le catalogue pour les tâches à déléguer.', 'Une adaptation à vos outils et à vos règles.', 'Une construction sur mesure quand elle est nécessaire.'],
};
---

<PageEditoriale page={page} noeuds={noeuds} eyebrow="Qui nous sommes" scene="apropos" appel={appel}>
  <section class="pv" aria-labelledby="pourquoi">
    <BlocEditorial scene="apropos">
      <div class="pv-copy rv">
        <h2 id="pourquoi">Un catalogue pour le travail qui revient.</h2>
        <p>Collecter un avis, retrouver une pièce, rapprocher deux fichiers : ces tâches se répètent d’un dossier à l’autre. Nous concevons des robots et agents IA pour les prendre en charge, puis les adaptons à chaque cabinet.</p>
        <p class="texte-2">Le catalogue donne un point de départ concret. Votre organisation détermine les comptes utilisés, les règles de classement, les livrables et les validations. Nous construisons sur mesure lorsque cette base ne couvre pas votre besoin.</p>
        <p class="texte-2">Pour <a href="/agents-ia/comptabilite#tache-saisie-ocr-2">prendre en charge la préparation des écritures</a> ou <a href="/agents-ia/juridique-fiscal#tache-secretariat-juridique-7">préparer le suivi juridique</a>, nous définissons les pièces à lire, la proposition attendue et les cas à reprendre. Votre collaborateur conserve la correction et la validation.</p>
      </div>
    </BlocEditorial>
  </section>

  <section class="pv" aria-labelledby="faisons"><div class="tete"><h2 id="faisons">Concevoir, déployer et maintenir.</h2><p>Vous choisissez le travail à confier. Nous préparons le service retenu, réglons son fonctionnement dans vos outils et faisons vérifier le résultat par votre équipe. Nous restons votre interlocuteur pour la maintenance prévue au devis.</p></div><GrilleEditoriale><article><h3>Des résultats à reprendre</h3><p class="texte-2">Pour <a href="/agents-ia/comptabilite#tache-banque-rapprochement-5">confier le rapprochement bancaire</a>, votre équipe reçoit les correspondances proposées et les écarts à examiner. Elle garde la décision sur les cas inexpliqués.</p></article><article><h3>Votre organisation conservée</h3><p class="texte-2">Nous adaptons les sources, les comptes, le classement et le rythme à votre cabinet. La règle écrite décrit les gestes confiés et les validations que vous conservez.</p></article><article><h3>Le savoir utile au travail</h3><p class="texte-2"><a href="/memoire-collective-cabinet-comptable">Memlia OS</a> retrouve vos sources et leur contexte avec les accès définis. Le <a href="/modele-ia-prive-entreprise">modèle privé</a> travaille vos formats et votre vocabulaire par entraînement sur des exemples autorisés. Nous évaluons la version avant sa publication.</p></article></GrilleEditoriale>
  </section>

  <section class="pv" aria-labelledby="expert">
    <div class="tete rv">
      <h2 id="expert">Vous confiez le travail répétitif. Vous gardez la maîtrise.</h2>
      <p>Ces engagements s’appliquent aux quatre services, avec un périmètre et des critères de recette propres à chacun.</p>
    </div>
    <ListeEditoriale>
        <li class="editorial-point rv"><h3 class="editorial-point-titre">Vos règles et vos validations.</h3><p class="editorial-point-texte">Pour <a href="/agents-ia/paie-social">confier la mécanique répétitive de la paie</a> ou <a href="/agents-ia/paie-social#tache-entrees-sorties-salaries-5">écrire la règle des entrées et sorties des salariés</a> annoncées hors portail, nous suivons les règles convenues avec votre pôle social. Un cas hors règle est présenté à votre équipe. Le jugement professionnel reste au cabinet.</p></li>
        <li class="editorial-point rv"><h3 class="editorial-point-titre">Le déploiement et la maintenance.</h3><p class="editorial-point-texte">Vous payez une tâche prise en charge, pas des sièges. Le devis précise le périmètre déployé, les adaptations, le support, la maintenance et les évolutions. Une nouvelle fonction ou une construction sur mesure se définit avec vous.</p></li>
      </ListeEditoriale>
  </section>

  <section class="pv" id="kevin-kitanga" aria-labelledby="fondateur"><div class="tete"><h2 id="fondateur">Qui est derrière Memlia</h2></div><GrilleEditoriale colonnes={2}><article><h3>Kevin Kitanga, fondateur</h3><p>Il conçoit les prises en charge Memlia et les adapte avec vos équipes. Du premier échange à la mise en service, il relie le besoin métier, les règles du cabinet et la mise en œuvre du service retenu.</p></article><article><h3>Des exemples que vous pouvez examiner</h3><p>Il signe les méthodes publiées sur le site. Les démonstrations fictives montrent un résultat, une exception et les décisions qui restent au cabinet. Elles vous aident à choisir une tâche avant d’organiser son déploiement.</p></article></GrilleEditoriale></section>

  <section class="pv editorial-publications" aria-labelledby="ecrivons">
    <div class="tete rv">
      <h2 id="ecrivons">Ce que nous publions</h2>
      <p>Nous écrivons sur ce qui se vérifie, ce qui s’automatise et ce qui reste une décision humaine. Chaque article est signé et sourcé.</p>
    </div>
    <Renvois items={renvois} />
  </section>
</PageEditoriale>
