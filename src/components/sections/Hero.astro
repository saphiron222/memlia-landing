---
import Button from '@/components/Button.astro';

import { CTA } from '@/data/site.mjs';

/**
 * Hero M4-R4 : média R8 sans cartouche, conservé octet pour octet.
 */

---

<section class="hero" aria-labelledby="hero-titre">
  <div class="hero-texte">
    <span class="pastille hero-eyebrow">
      Automatisation IA pour cabinets d’expertise comptable
    </span>
    <h1 id="hero-titre" class="hero-h1">
      Automatisez les tâches qui ralentissent votre cabinet.
    </h1>
    <p class="hero-sub">
      Memlia automatise vos processus répétitifs pour libérer du temps, dans vos outils existants. Votre cabinet garde la décision.
    </p>
    <div class="hero-boutons">
      <Button href={CTA.principal.href} variante="principal" picto="fleche" class="hero-btn">
        {CTA.principal.libelle}
      </Button>

    </div>

  </div>

  <div class="hero-cadre" data-cadre>
    <div class="hero-verre">
      <div class="hero-ecran" data-video-player>
        <video muted loop playsinline preload="metadata" width="1920" height="1080"
          tabindex="0" data-video aria-label="Reprendre la vidéo"
          disablepictureinpicture disableRemotePlayback controlslist="nodownload nofullscreen noremoteplayback"
          poster="/media/r8/hero-poster-1200.webp" src="/media/r8/animatique-hero-45s.mp4">
          <track kind="subtitles" srclang="fr" label="Français" src="/media/r8/animatique.vtt" default />
          <p>Votre navigateur ne peut pas lire cette vidéo. <a href="/media/r8/animatique-hero-45s.mp4">Télécharger la vidéo</a>.</p>
        </video>
        <div class="hero-video-overlay" data-video-overlay>
          <button class="hero-video-sound" type="button" data-video-sound>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
              <path d="M5 9v6h4l5 4V5L9 9H5Zm12.5-.5a5 5 0 0 1 0 7" />
            </svg>
            <span>Activer le son</span>
          </button>
        </div>
        <div class="hero-video-status" data-video-status role="status" aria-live="polite" hidden>
          <span data-video-status-message></span>
          <a href="/media/r8/animatique-hero-45s.mp4" data-video-download hidden>Télécharger la vidéo</a>
        </div>
        <noscript>
          <p class="hero-video-noscript">
            Votre navigateur ne peut pas lancer le lecteur interactif.
            <a href="/media/r8/animatique-hero-45s.mp4">Télécharger la vidéo</a>.
          </p>
        </noscript>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 40px var(--marge-page) 0;
    isolation: isolate;
  }
  .hero-texte {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    margin: 0 auto;
  }
  .hero-h1 {
    max-width: 1050px;
    font-size: clamp(2.25rem, 1rem + 3.6vw, 3.75rem);
  }
  .hero-sub {
    max-width: 672px;
    color: var(--texte-2);
    font-size: var(--t-base);
  }
  .hero-boutons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 12px;
  }
  .hero-confiance {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    margin-top: 8px;
    font-size: var(--t-sm);
    color: var(--texte-2);
  }
  .hero-confiance li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .hero-confiance svg {
    color: var(--accent-appui);
    flex: 0 0 auto;
  }
  /* Cadre de démo : capture statique pleine largeur sous 1024, calque verre au-dessus. */
  .hero-cadre {
    margin-top: 48px;
    max-width: min(1200px, calc(100vw - 32px));
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% + 256px);
  }
  .hero-ecran {
    position: relative;
    border-radius: var(--r-ecran);
    border: 1px solid var(--ligne);
    overflow: hidden;
    background: var(--blanc);
    aspect-ratio: 16 / 9;
    box-shadow: 0 12px 36px rgba(35, 31, 32, 0.06);
  }
  .hero-ecran video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    cursor: pointer;
  }
  .hero-ecran video:focus-visible {
    outline: 3px solid var(--accent-texte);
    outline-offset: -5px;
  }
  .hero-video-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    pointer-events: none;
  }
  .hero-video-overlay[hidden],
  .hero-video-status[hidden] {
    display: none;
  }
  .hero-video-sound {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 46px;
    padding: 10px 18px;
    border: 1px solid var(--accent-texte);
    border-radius: 999px;
    background: rgba(39, 182, 87, 0.9);
    color: var(--encre);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    pointer-events: auto;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(35, 31, 32, 0.18), 0 0 0 4px rgba(39, 182, 87, 0.12);
  }
  .hero-video-sound:hover {
    background: var(--accent-appui);
    color: var(--blanc);
  }
  .hero-video-sound:focus-visible {
    outline: 3px solid var(--blanc);
    outline-offset: 3px;
    box-shadow: 0 0 0 5px var(--accent-texte);
  }
  .hero-video-sound svg {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero-video-status,
  .hero-video-noscript {
    position: absolute;
    z-index: 2;
    right: 16px;
    bottom: 16px;
    left: 16px;
    width: fit-content;
    max-width: calc(100% - 32px);
    margin: 0 auto;
    padding: 10px 14px;
    border: 1px solid rgba(35, 31, 32, 0.14);
    border-radius: 12px;
    background: rgba(255, 254, 251, 0.96);
    color: var(--encre);
    font-size: var(--t-sm);
    text-align: center;
  }
  .hero-video-status a,
  .hero-video-noscript a {
    color: var(--accent-texte);
    font-weight: 700;
  }


  @media (max-width: 24.99rem) {
    .hero-boutons {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-video-sound {
      min-height: 44px;
      padding: 8px 14px;
    }
  }
  @media (min-width: 64rem) {
    .hero {
      padding: 64px var(--marge-page-lg) 0;
    }
    .hero-texte {
      min-height: 270px;
    }
    .hero-cadre {
      margin: 48px 0 0;
    }
    .hero-verre {
      padding: 16px;
      border-radius: var(--r-cadre);
      background: rgba(252, 251, 247, 0.2);
      border: 1px solid rgba(35, 31, 32, 0.096);
    }
  }
  @media (min-width: 80rem) {
    .hero-cadre {
      margin-left: 0;
      margin-right: 0;
    }
  }

  /* Entrées au chargement (§5.1) — hero seulement, flou autorisé ici. */
  @keyframes hero-entree {
    from {
      opacity: 0;
      transform: translateY(15px) scale(0.98);
      filter: blur(7px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-etiquette {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.8);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-bouton {
    from {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(3px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes hero-verre {
    from {
      opacity: 0;
      transform: scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-ecran {
    from {
      opacity: 0;
      transform: scale(0.98);
      filter: blur(6px) grayscale(1);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0) grayscale(0);
    }
  }
  :global(html.js) .hero-h1 {
    animation: hero-entree var(--duree-entree) var(--courbe-sortie) both;
  }
  :global(html.js) .hero-sub {
    animation: hero-entree var(--duree-entree) var(--courbe-sortie) 100ms both;
  }
  :global(html.js) .hero-eyebrow {
    animation: hero-etiquette var(--duree-etiquette) var(--courbe-etiquette) 200ms both;
  }
  :global(html.js) .hero-boutons > :nth-child(1) {
    animation: hero-bouton var(--duree-entree) var(--courbe-sortie) 100ms both;
  }
  :global(html.js) .hero-boutons > :nth-child(2) {
    animation: hero-bouton var(--duree-entree) var(--courbe-sortie) 200ms both;
  }
  :global(html.js) .hero-confiance {
    animation: hero-bouton var(--duree-entree) var(--courbe-sortie) 300ms both;
  }
  :global(html.js) .hero-verre {
    animation: hero-verre var(--duree-etiquette) var(--courbe-sortie) 200ms both;
  }
  :global(html.js) .hero-ecran {
    animation: hero-ecran var(--duree-revelation) var(--courbe-douce) 200ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero :is(.hero-h1, .hero-sub, .hero-eyebrow, .hero-boutons > *, .hero-confiance, .hero-verre, .hero-ecran) {
      animation: none;
    }
  }
</style>

<script>
  const pauseLabel = 'Mettre la vidéo en pause';
  const playLabel = 'Reprendre la vidéo';

  for (const player of document.querySelectorAll<HTMLElement>('[data-video-player]')) {
    const video = player.querySelector<HTMLVideoElement>('[data-video]');
    const overlay = player.querySelector<HTMLElement>('[data-video-overlay]');
    const soundButton = player.querySelector<HTMLButtonElement>('[data-video-sound]');
    const status = player.querySelector<HTMLElement>('[data-video-status]');
    const statusMessage = player.querySelector<HTMLElement>('[data-video-status-message]');
    const downloadLink = player.querySelector<HTMLAnchorElement>('[data-video-download]');
    if (!video || !overlay || !soundButton || !status || !statusMessage || !downloadLink) continue;

    let mediaFailed = false;

    const setStatus = (message = '', offerDownload = false) => {
      statusMessage.textContent = message;
      downloadLink.hidden = !offerDownload;
      status.hidden = message.length === 0;
    };

    const syncPlaybackLabel = () => {
      if (mediaFailed) {
        video.setAttribute('aria-label', 'Vidéo indisponible');
        return;
      }
      video.setAttribute('aria-label', video.paused ? playLabel : pauseLabel);
    };

    const startPlayback = async (autoplayAttempt = false) => {
      try {
        await video.play();
        setStatus();
        syncPlaybackLabel();
        return true;
      } catch {
        video.pause();
        syncPlaybackLabel();
        if (mediaFailed) return false;
        if (autoplayAttempt) {
          setStatus('La lecture automatique n’a pas démarré. Activez le son pour lancer la vidéo.');
        } else {
          setStatus('La vidéo ne peut pas démarrer. ', true);
        }
        return false;
      }
    };

    const showMediaError = () => {
      mediaFailed = true;
      video.pause();
      overlay.hidden = true;
      setStatus('La vidéo ne peut pas être lue. ', true);
      syncPlaybackLabel();
    };

    video.controls = false;
    video.removeAttribute('controls');
    video.muted = true;
    video.defaultMuted = true;
    video.loop = true;
    video.addEventListener('error', showMediaError);
    if (video.error) showMediaError();

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) {
      video.autoplay = false;
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
      syncPlaybackLabel();
    } else {
      video.autoplay = true;
      video.setAttribute('autoplay', '');
      void startPlayback(true);
    }

    soundButton.addEventListener('click', async () => {
      video.currentTime = 0;
      video.loop = false;
      video.removeAttribute('loop');
      video.muted = false;
      video.defaultMuted = false;
      if (await startPlayback()) overlay.hidden = true;
    });

    video.addEventListener('click', () => {
      if (mediaFailed) return;
      if (video.paused) void startPlayback();
      else video.pause();
    });

    video.addEventListener('keydown', event => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      video.click();
    });

    video.addEventListener('play', syncPlaybackLabel);
    video.addEventListener('pause', syncPlaybackLabel);
  }
</script>
