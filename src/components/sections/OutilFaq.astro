---
import Picto from '@/components/Picto.astro';
import type { QuestionOutil } from '@/data/outil-page';

interface Props {
  questions: readonly QuestionOutil[];
}

const { questions } = Astro.props;
// Système de page : la forme « questions » de l'accueil — l'en-tête collant à gauche dès
// 1 024 px, l'accordéon natif à droite, aux mêmes mesures. Les deux réponses absorbent les
// anciennes garanties (épure du 14/10/2026).
---

<section class="section outil-faq" data-tool-section="faq" aria-labelledby="outil-faq-titre">
  <div class="conteneur outil-faq-inner">
    <div class="tete outil-faq-heading rv">
      <h2 id="outil-faq-titre">Gratuité et données</h2>
    </div>
    <div class="outil-faq-list rv-groupe">
      {questions.map((item) => (
        <details class="outil-faq-item rv" id={item.id}>
          <summary>
            <span>{item.question}</span>
            <Picto nom="chevron" taille={16} class="outil-faq-chevron" />
          </summary>
          <p>{item.reponse}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .outil-faq-inner {
    display: grid;
    gap: var(--bloc-ecart);
  }
  .outil-faq-heading {
    align-content: start;
    max-width: 448px;
  }
  .outil-faq-list {
    border-top: 1px solid var(--ligne);
  }
  .outil-faq-item {
    border-bottom: 1px solid var(--ligne-douce);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .outil-faq-item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 4px;
    cursor: pointer;
    list-style: none;
    color: var(--texte-fort);
    font-family: var(--police-display), 'Fraunces Fallback';
    font-size: var(--t-xl);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .outil-faq-item summary::-webkit-details-marker {
    display: none;
  }
  .outil-faq-item summary:focus-visible {
    outline-offset: -2px;
  }
  .outil-faq-chevron {
    flex: 0 0 auto;
    margin-top: 0.35em;
    /* Seul indice qu'une réponse se déplie, la FAQ étant repliée : contraste 3:1 au moins (1.4.11). */
    color: var(--texte-2);
    transition: transform var(--duree-2) var(--courbe-standard), color var(--duree-1) var(--courbe-standard);
  }
  .outil-faq-item[open] .outil-faq-chevron {
    transform: rotate(180deg);
    color: var(--accent-texte);
  }
  .outil-faq-item p {
    max-width: 62ch;
    margin: 0;
    padding: 0 4px 24px;
    color: var(--texte-2);
  }
  @media (hover: hover) {
    .outil-faq-item summary:hover .outil-faq-chevron {
      color: var(--accent-texte);
    }
  }
  @media (min-width: 64rem) {
    .outil-faq-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--espace-24);
    }
    .outil-faq-heading {
      align-self: start;
    }
    .outil-faq-item summary {
      padding: 24px 8px;
    }
    .outil-faq-item p {
      padding: 0 8px 28px;
    }
  }
</style>
