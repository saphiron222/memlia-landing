---
import ScrollableTables from '@/components/ScrollableTables.astro';
import { PROOFS, type ProofId } from '@/data/proofs';

interface Props {
  proof: ProofId;
}

const { proof } = Astro.props;
const media = PROOFS[proof];
// Système de page : le document d'une page service, un texte long à intertitres (h2 à la taille d'un
// document, espacés sans filet), avec sa note collante à gauche dès 1 024 px (titre de bloc).
---

<section class="service-body" data-service-section="body" data-service-sections aria-label="Périmètre de la mission">
  <div class="service-body-grid conteneur">
    <aside class="service-body-proof rv" aria-labelledby="service-proof-title">
      <div class="service-body-proof-copy">
        <p class="surtitre">preuve fonctionnelle fictive</p>
        <h2 id="service-proof-title">{media.title}</h2>
        <p>{media.detail}</p>
      </div>
    </aside>

    <!-- Un corps long dépasse le seuil de révélation sur mobile : il reste visible. -->
    <div class="service-body-copy lecture">
      <ScrollableTables><slot /></ScrollableTables>
    </div>
  </div>
</section>
<script>
  import '@/lib/table-keyboard';
</script>

<style>
  .service-body {
    padding-top: var(--section-espace);
  }
  .service-body-grid {
    display: grid;
    gap: var(--bloc-ecart);
  }
  .service-body-proof {
    display: grid;
    align-content: start;
    gap: 24px;
    min-width: 0;
  }

  .service-body-proof-copy {
    display: grid;
    gap: var(--espace-3);
  }
  .service-body-proof-copy h2 {
    max-width: 22ch;
    font-size: var(--titre-bloc);
    line-height: 1.2;
  }
  .service-body-proof-copy p:not(.surtitre) {
    max-width: 58ch;
    color: var(--texte-2);
  }
  .service-body-copy {
    min-width: 0;
    max-width: none;
  }
  .service-body-copy :global(h2) {
    margin: 0;
    font-size: var(--titre-intertitre);
    line-height: 1.15;
  }
  .service-body-copy :global(h2:not(:first-child)) {
    margin-top: var(--espace-16);
  }
  .service-body-copy :global(h3) {
    margin: var(--espace-10) 0 var(--espace-3);
    font-size: var(--titre-bloc);
  }
  .service-body-copy :global(p) {
    margin: 18px 0 0;
    color: var(--texte);
  }
  .service-body-copy :global(ul),
  .service-body-copy :global(ol) {
    margin: 20px 0 0;
    padding-left: 1.3em;
  }
  .service-body-copy :global(ul) { list-style: disc; }
  .service-body-copy :global(ol) { list-style: decimal; }
  .service-body-copy :global(li) { margin: 0.5em 0; }
  .service-body-copy :global(a) {
    color: var(--accent-texte);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .service-body-copy :global(strong) {
    color: var(--texte-fort);
    font-weight: 600;
  }
  .service-body-copy :global([data-table-scroll]) {
    margin: 28px 0 0;
  }
  .service-body-copy :global(table) {
    width: 100%;
    min-width: 560px;
    border-top: 1px solid var(--ligne);
    border-bottom: 1px solid var(--ligne);
    border-collapse: collapse;
    font-size: var(--t-sm);
    table-layout: fixed;
  }
  .service-body-copy :global(th),
  .service-body-copy :global(td) {
    width: 33.333%;
    padding: 14px 12px;
    border-bottom: 1px solid var(--ligne-douce);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .service-body-copy :global(th) {
    color: var(--texte-fort);
    font-weight: 600;
    background: var(--surface-page);
  }
  @media (min-width: 64rem) {
    .service-body-grid {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: var(--espace-20);
      align-items: start;
    }
    .service-body-proof {
      position: sticky;
      top: calc(var(--nav-h) + 32px);
    }
  }
</style>
