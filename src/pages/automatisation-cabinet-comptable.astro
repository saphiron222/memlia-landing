---
import Base from '@/layouts/Base.astro';
import HubRobots from '@/components/catalogue/HubRobots.astro';
import { ROBOT_HUB } from '@/data/robots';
import { grapheHubRobots } from '@/data/schema-robots';
const socialImage = { url: 'https://memlia.fr/robots/hub.webp', width: 1200, height: 630, alt: 'La collection des robots Memlia pour les routines du cabinet comptable.' };
---
<Base titre={ROBOT_HUB.titre} titreSocial={ROBOT_HUB.h1} description={ROBOT_HUB.description} chemin={ROBOT_HUB.chemin} socialImage={socialImage} schema={grapheHubRobots()}><HubRobots /></Base>
