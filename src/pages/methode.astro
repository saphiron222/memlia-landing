---
import PageCommerciale from '@/layouts/PageCommerciale.astro';
import Renvois from '@/components/Renvois.astro';
import ProofMedia from '@/components/ProofMedia.astro';
import Picto from '@/components/Picto.astro';
import { PAGES_V2 } from '@/data/pages-v2.mjs';
import { SITE } from '@/data/site.mjs';
import { SERVICE_ID } from '@/data/schema.mjs';
import { famillesDeLaProfession } from '@/data/familles';
const familles = famillesDeLaProfession('ec');
const nombrePoles = new Set(familles.map(({ pole }) => pole)).size;
import type { ProofId } from '@/data/proofs';

const page = PAGES_V2.methode;
const url = `${SITE.url}${page.chemin}`;
const noeuds = [{
  '@type': 'WebPage', '@id': `${url}#page`, url, name: page.h1, description: page.description,
  inLanguage: SITE.langue, isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': SERVICE_ID },
}];
/**
 * Les quatre étapes, chacune avec son illustration : c'est une séquence, elle se numérote. Système
 * de page : la forme « étapes » (global.css), numérotée par son surtitre, une maquette encadrée par
 * étape, deux étapes par rangée dès 64 rem.
 */
const etapes: { id: string; titre: string; image: ProofId; paragraphes: string[] }[] = [
  { id: 'observer', titre: 'Observer', image: '04-observer', paragraphes: [
    'Nous regardons le geste tel qu’il se fait, pas tel qu’il devrait se faire.',
    'Nous suivons les fichiers reçus, les vérifications et les passages entre vos outils. Nous relevons les cas où un collaborateur doit chercher une pièce, expliquer un écart ou décider de la suite.',
    'Vous obtenez une description de la tâche entière, de son point de départ au résultat attendu. Elle distingue ce que vos outils font déjà et les gestes répétitifs qui restent à prendre en charge.',
  ] },
  { id: 'cadrer', titre: 'Cadrer', image: 'v2/04-perimetre', paragraphes: [
    'Nous écrivons la règle avec vous, dans le vocabulaire du cabinet. Les accès, les formats et les cas couverts sont vérifiés avant de construire.',
    'La règle écrite comporte quatre parties : la frontière entre préparation, validation et jugement ; la proposition distincte de vos saisies ; l’arrêt dans le doute ; le jeu d’essai fictif.',
    'Nous nommons les cas couverts, les exceptions et les conditions d’arrêt. Ce que nous générons se régénère ; vos saisies restent intactes. Une règle ambiguë se clarifie avec vous avant le développement.',
  ] },
  { id: 'eprouver', titre: 'Éprouver', image: 'v2/05-refus-attendu', paragraphes: [
    'Nous construisons un jeu d’essai entièrement fictif, qui ressemble à vos fichiers sans en être.',
    'Nous construisons l’automatisation dans les outils convenus, puis nous rejouons les cas courants et les exceptions. Une donnée manquante, un format inattendu ou un cas hors règle doit produire l’arrêt prévu.',
    'Vous pouvez comparer, pour chaque cas, le résultat attendu et la sortie obtenue. Un refus attendu qui ne se produit pas est un défaut à corriger avant la recette.',
  ] },
  { id: 'valider', titre: 'Faire valider', image: 'v2/06-recette-cabinet', paragraphes: [
    'La recette est votre vérification du résultat, avec les personnes qui feront le travail. Après les essais fictifs, elle se déroule dans l’environnement autorisé du cabinet, sur les cas et fichiers convenus.',
    'Votre équipe vérifie les propositions, les exceptions et les arrêts avant d’accepter la livraison. La décision et les corrections restent au cabinet.',
    'Nous livrons l’automatisation, sa règle écrite et ses essais. Le devis précise la maintenance, le support et les évolutions prises en charge. Une règle qui évolue est réécrite, rejouée et soumise à votre recette avant sa mise en service.',
  ] },
];
const renvois = [
  { texte: 'Situer les usages, règles, données, validations et mesures déclarés pour choisir une prochaine tâche.', libelle: 'Faire le diagnostic de maturité IA du cabinet', href: '/outils-comptables-gratuits/diagnostic-maturite-ia-cabinet' },
  { texte: 'Ce que le service livre concrètement, ce qu’il requiert et ce qui détermine le devis.', libelle: 'L’automatisation sur mesure', href: '/automatisation-cabinet-comptable' },
  { texte: 'Nos engagements, écrits avant de commencer.', libelle: 'Les garanties', href: '/garanties' },
  { texte: `La carte des tâches automatisables d’un cabinet : ${nombrePoles} pôles, ${familles.length} familles pour l’expertise comptable, une frontière par tâche.`, libelle: 'Lire la carte des tâches', href: '/blog/automatiser-un-cabinet-comptable-la-carte-des-taches' },
  { texte: 'Pourquoi Memlia existe, et qui écrit et code la règle.', libelle: 'À propos', href: '/a-propos' },
];
/**
 * Les outils à rejouer dans le navigateur : des destinations nommées, donc des listes de liens,
 * groupées par usage (Kevin, 13/10/2026 : dix-sept paragraphes d'affilée ne se lisaient pas). Le
 * libellé nomme l'outil ; le détail dit sa limite en une phrase.
 */
const OUTILS = '/outils-comptables-gratuits';
const groupesOutils: { titre: string; outils: { href: string; libelle: string; limite: string }[]; mention?: string }[] = [
  { titre: 'Comparer et contrôler', outils: [
    { href: `${OUTILS}/comparateur-balances-comptables`, libelle: 'Comparateur de balances comptables', limite: 'Les variations gardent leurs lignes sources ; votre équipe explique ensuite le compte.' },
    { href: `${OUTILS}/modele-rapprochement-bancaire-excel-gratuit`, libelle: 'Modèle de rapprochement bancaire ouvrable dans Excel', limite: 'Le classeur se télécharge sans compte, avant tout contrôle ; même des soldes concordants restent à valider par le collaborateur.' },
  ], mention: 'Le contrôle en ligne garde les écarts et éléments inexpliqués visibles et exportables avec l’état NON VALIDÉ. Télécharger le classeur ou exporter le contrôle ne valide pas le rapprochement.' },
  { titre: 'Préparer', outils: [
    { href: `${OUTILS}/fusionner-fichiers-csv`, libelle: 'Fusionner des exports CSV', limite: 'Le fichier consolidé garde son rapport de provenance ; il ne valide pas les opérations comptables.' },
    { href: `${OUTILS}/checklist-pieces-comptables`, libelle: 'Checklist des pièces comptables à demander', limite: 'Seule la pièce manquante entre dans la demande à relire.' },
    { href: `${OUTILS}/preparer-pseudonymiser-fichier-csv-fec`, libelle: 'Préparer et pseudonymiser un fichier comptable avant IA', limite: 'Les risques de réidentification s’examinent avant toute décision de partage.' },
    { href: `${OUTILS}/generateur-relance-facture-impayee`, libelle: 'Générateur de relance de facture impayée', limite: 'Le message amiable reste à valider ; vous décidez de l’envoi.' },
  ] },
  { titre: 'Calculer', outils: [
    { href: `${OUTILS}/calculateur-marge-commerciale`, libelle: 'Calculateur de marge commerciale', limite: 'Il montre ses trois formules et refuse un dénominateur nul.' },
    { href: `${OUTILS}/calculateur-date-echeance-facture`, libelle: 'Calculateur de date d’échéance de facture', limite: 'Il exige le point de départ et la convention choisie.' },
    { href: `${OUTILS}/calculateur-amortissement-comptable`, libelle: 'Calculateur d’amortissement comptable', limite: 'Il déroule le prorata et chaque dotation, sans choisir la durée ni l’éligibilité fiscale.' },
    { href: `${OUTILS}/calculateur-roi-automatisation`, libelle: 'Calculateur de ROI d’automatisation comptable', limite: 'Il sépare temps libéré, coûts et dépenses évitables, sans en faire une promesse de gain.' },
  ] },
  { titre: 'Écrire avec l’IA', outils: [
    { href: `${OUTILS}/generateur-prompt-ia-gratuit`, libelle: 'Générateur de prompt IA gratuit', limite: 'La consigne se relit avant d’être utilisée dans un outil autorisé.' },
    { href: `${OUTILS}/verificateur-prompt-ia`, libelle: 'Vérificateur de prompt IA', limite: 'Le rapport explique les formulations repérées et les points manquants, en gardant votre original.' },
    { href: `${OUTILS}/generateur-prompt-expert-comptable`, libelle: 'Générateur de prompt pour expert-comptable', limite: 'Il assemble les entrées autorisées, la validation et les conditions d’arrêt ; aucun modèle d’IA n’est appelé.' },
    { href: `${OUTILS}/bibliotheque-prompts-comptables`, libelle: 'Bibliothèque de prompts comptables', limite: 'Douze modèles à adapter dans le générateur ; le cabinet garde la décision.' },
    { href: `${OUTILS}/generateur-charte-ia-cabinet`, libelle: 'Générateur de charte IA du cabinet', limite: 'Un rôle manquant ne s’invente pas ; le cabinet le désigne avant adoption.' },
  ] },
];
// Le groupe CAC finit par le service de circularisation, écrit en clair dans le gabarit : son ancre
// est le lien contextuel que la recette du service exige depuis cette page (scripts/service-forge.mjs).
const outilsCac = [
  { href: `${OUTILS}/seuil-signification-audit`, libelle: 'Seuil de signification en audit', limite: 'Le calcul ne décide pas du caractère significatif.' },
  { href: `${OUTILS}/suivi-circularisation`, libelle: 'Suivi de circularisation', limite: 'Un refus suspend la proposition de relance ; le CAC choisit les suites.' },
  { href: `${OUTILS}/bareme-heures-cac`, libelle: 'Barème d’heures du commissaire aux comptes', limite: 'Le budget saisi reste distinct de la grille ; le programme de travail demeure une décision du CAC.' },
];
const appel = {
  titre: 'La première étape commence par un échange.',
  texte: 'Décrivez le geste qui revient. Nous écrivons sa règle avec vous, construisons dans vos outils et faisons recetter le résultat par votre équipe. La description suffit pour commencer.',
  points: ['Observer le geste réel, pas le geste théorique.', 'Écrire la règle dans vos mots.', 'Éprouver les refus autant que les résultats.'],
};
---

<PageCommerciale page={page} noeuds={noeuds} eyebrow="Quatre étapes, une recette" hero="v2/15-hero-methode" appel={appel}>
  <section class="pv" aria-labelledby="etapes-titre">
    <div class="tete rv">
      <h2 id="etapes-titre">Quatre étapes, dans cet ordre</h2>
      <p>Pour <a href="/automatisation/evaluation-transmission">recetter la préparation d’un dossier d’évaluation</a>, nous rejouons un ajustement accepté, un ajustement en attente et deux versions concurrentes. Le tableau prépare les chiffres, jamais la valeur de l’entreprise.</p>
      <p>Vous confiez une tâche entière. Nous observons le travail, écrivons la règle et construisons dans vos outils. Votre équipe vérifie le résultat avant la livraison ; la maintenance prolonge cette prise en charge.</p>
      <p>Le cas courant et le justificatif absent suffisent déjà à <a href="/automatisation/notes-de-frais">rejouer une règle de notes de frais</a> sans utiliser de dossier réel.</p>
      <p>Pour <a href="/automatisation/secretariat-juridique">éprouver les rappels de dépôt encore manuels</a>, le jeu fictif oppose une date confirmée, un circuit déjà couvert et une date inconnue. Le brouillon attend une validation ; aucun message n’est envoyé.</p>
    </div>
    <ol class="etapes">
      {etapes.map((e, i) => (
        <li class="etape" id={e.id}>
          <div class="etape-copie rv">
            <p class="surtitre">Étape {i + 1}</p>
            <h3>{e.titre}</h3>
            {e.paragraphes.map((p, j) => (
              <p class={j === 0 ? undefined : 'texte-2'}>{p}</p>
            ))}
            {e.id === 'eprouver' && <p class="texte-2">Avant l’essai, vous pouvez <a href="/blog/logiciel-ia-comptabilite">comparer le parcours complet d’un outil IA</a> : entrée, résultat, exception et reprise.</p>}
            {e.id === 'valider' && <p class="texte-2">Pour relier les tests au résultat visible, voyez comment <a href="/blog/tests-verts-et-regle-des-trois-passes">recetter le parcours en trois passes</a>.</p>}
            {e.id === 'valider' && <p class="texte-2">Pour <a href="/automatisation/bulletins-controle">faire recetter les contrôles croisés des bulletins</a>, votre pôle social examine une prime différente, une référence absente et une revue à reprendre après recalcul. Il garde la correction et la validation.</p>}
          </div>
          <ProofMedia id={e.image} cadre />
        </li>
      ))}
    </ol>
    <div class="bande coins" role="table" aria-label="La frontière de la règle écrite">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <div class="cartes rv-groupe" role="row">
        <div class="cellule rv" role="cell"><h3 class="carte-titre">Se prépare seul</h3><p class="carte-texte">Les données autorisées sont rassemblées et les propositions préparées selon la règle convenue.</p></div>
        <div class="cellule rv" role="cell"><h3 class="carte-titre">Attend votre validation</h3><p class="carte-texte">Votre équipe relit les propositions et traite les exceptions avant toute suite prévue par la règle.</p></div>
        <div class="cellule rv" role="cell"><h3 class="carte-titre">Reste humain</h3><p class="carte-texte">Le cabinet garde ses corrections, son appréciation du dossier et la décision de poursuivre.</p></div>
      </div>
    </div>
  </section>

  <section class="pv" aria-labelledby="cout">
    <div class="tete rv">
      <h2 id="cout">Ce que cette méthode coûte, et ce qu’elle évite</h2>
    </div>
    <div class="bande coins">
      <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
      <ul class="cartes rv-groupe">
        <li class="cellule rv"><h3 class="carte-titre">Ce qu’elle coûte</h3><p class="carte-texte"><a href="/blog/pourquoi-les-cabinets-comptables-n-adoptent-pas-les-nouveaux-outils">Le cadrage</a> et la recette demandent du temps à votre équipe. Le devis dépend des sources, des règles, des exceptions et des validations. Vous payez une tâche prise en charge, pas des sièges.</p></li>
        <li class="cellule rv"><h3 class="carte-titre">Ce qu’elle évite</h3><p class="carte-texte">Une automatisation livrée vite, qui produit des résultats plausibles, et dont personne ne sait dire quand elle se trompe. Cette exigence permet notamment d’<a href="/automatisation/factures-fournisseurs">éprouver le flux des factures fournisseurs</a> sur ses doublons et ses avoirs avant de le livrer.</p></li>
      </ul>
    </div>
    <p class="mention">Nous pouvons aussi <a href="/automatisation/facture-electronique">éprouver la préparation des appels de facture électronique</a> : un dossier sur une autre plateforme avance, un circuit déjà couvert est exclu et un choix incertain arrête la préparation.</p>
  </section>

  <section class="pv" aria-labelledby="suite-titre-renvois">
    <div class="tete rv">
      <h2 id="suite-titre-renvois">Ce qui vient ensuite</h2>
      <p class="texte-2 lecture">Vous pouvez <a href="/automatisation/registres-obligations">faire recetter un suivi de registres</a> sur des changements fictifs fournis : annotations conservées, alerte non envoyée et terme calendaire à vérifier. Les accès réels se testent avant utilisation.</p>
      <p>La recette revient aux personnes qui feront le travail. C’est indispensable pour <a href="/automatisation/paie">faire recetter un contrôle de paie</a> sans déplacer la correction ni la décision hors du pôle social.</p>
      <p>Nous pouvons aussi <a href="/automatisation/entrees-sorties-salaries">éprouver la préparation d’un dossier salarié</a> : une annonce hors portail, ses informations manquantes et le retour au circuit existant font partie des essais.</p>
    </div>
    <Renvois items={renvois} />
  </section>

  <section class="pv" aria-labelledby="outils-gratuits-titre">
    <div class="tete rv">
      <h2 id="outils-gratuits-titre">Des règles à rejouer dans le navigateur</h2>
      <p class="lecture">Chaque page nomme la source, la règle et la limite avant le résultat.</p>
    </div>
    {groupesOutils.map((groupe) => (
      <div class="liens-bloc rv">
        <h3 class="liens-titre">{groupe.titre}</h3>
        <ul class="liens">
          {groupe.outils.map((outil) => (
            <li>
              <a class="lien-rangee" href={outil.href}>
                <span class="lien-libelle">{outil.libelle}<span class="lien-detail">{outil.limite}</span></span>
                <Picto nom="fleche" taille={14} class="lien-fleche" />
              </a>
            </li>
          ))}
        </ul>
        {groupe.mention && <p class="mention">{groupe.mention}</p>}
      </div>
    ))}
    <div class="liens-bloc rv">
      <h3 class="liens-titre">Pour le commissariat aux comptes</h3>
      <ul class="liens">
        {outilsCac.map((outil) => (
          <li>
            <a class="lien-rangee" href={outil.href}>
              <span class="lien-libelle">{outil.libelle}<span class="lien-detail">{outil.limite}</span></span>
              <Picto nom="fleche" taille={14} class="lien-fleche" />
            </a>
          </li>
        ))}
        <li>
          <a class="lien-rangee" href="/automatisation/circularisation-cac">
            <span class="lien-libelle">Automatiser la circularisation<span class="lien-detail">Le CAC valide les tiers et choisit les pièces à examiner ; les plateformes gardent les envois et les relances.</span></span>
            <Picto nom="fleche" taille={14} class="lien-fleche" />
          </a>
        </li>
      </ul>
    </div>
  </section>
</PageCommerciale>
