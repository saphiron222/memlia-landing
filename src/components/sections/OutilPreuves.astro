---
import type { OutilDefinition } from '@/data/outils';

interface Props {
  source: OutilDefinition['source'];
  mentionLocale: string;
  refus: string;
  assemblage?: boolean;
}

const { source, mentionLocale, refus, assemblage = false } = Astro.props;
// Système de page : un en-tête (surtitre, titre de section), puis trois engagements en bande,
// bord à bord de la feuille, comme les principes des services.
---

<section class="section pile outil-preuves" data-tool-section="preuves" aria-labelledby="outil-preuves-titre">
  <div class="conteneur">
    <div class="tete rv">
      <p class="surtitre">La règle reste lisible</p>
      <h2 id="outil-preuves-titre">{assemblage ? 'L’assemblage, sa source et son refus sont visibles.' : 'Le calcul, sa source et son refus sont visibles.'}</h2>
    </div>
  </div>
  <div class="bande coins">
    <span class="coin hg"></span><span class="coin hd"></span><span class="coin bg"></span><span class="coin bd"></span>
    <div class="cartes rv-groupe">
      <article class="cellule outil-preuve rv">
        <h3 class="carte-titre">{assemblage ? 'Assemblage local' : 'Calcul local'}</h3>
        <p class="carte-texte">{mentionLocale}</p>
      </article>
      <article class="cellule outil-preuve rv">
        <h3 class="carte-titre">Arrêt explicite</h3>
        <p class="carte-texte">{refus}</p>
      </article>
      <article class="cellule outil-preuve rv" data-official-source>
        <h3 class="carte-titre">{source.titre ?? 'Source officielle'}</h3>
        <p class="carte-texte">{source.extrait}</p>
        <p class="outil-source-meta">
          <a href={source.url} rel={source.url.startsWith('http') ? 'noopener' : undefined}>{source.nom}</a>
        </p>
        {source.complement && (
          <p class="outil-source-complement">
            {source.complement.extrait}{' '}
            <a href={source.complement.url} rel="noopener">{source.complement.nom}</a>.
          </p>
        )}
      </article>
    </div>
  </div>
</section>

<style>
  /* Les trois preuves sont les cellules de la bande du site (`.bande`, global.css). */
  .outil-source-meta {
    display: grid;
    gap: 4px;
    font-size: var(--t-sm);
  }
  /* Même couleur que le texte de la cellule (`.carte-texte`). */
  .outil-source-meta,
  .outil-source-complement {
    margin: 0;
    color: var(--texte-2);
  }
  .outil-preuve a {
    color: var(--accent-texte);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .outil-source-complement {
    padding-top: 12px;
    border-top: 1px solid var(--ligne-douce);
    font-size: var(--t-sm);
  }
</style>
