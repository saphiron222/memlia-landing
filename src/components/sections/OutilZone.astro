---
interface Props {
  mentionLocale: string;
  limites: readonly string[];
  suspension?: { motif: string; date: string };
  large?: boolean;
}

const { mentionLocale, limites, suspension, large = false } = Astro.props;
/*
 * Système de page : l'outil est un formulaire, donc un plateau ; à côté dès 1 024 px, ce qui
 * reste dans le navigateur (un titre de bloc et son texte, comme sur /contact). « Ce que cette
 * page ne fait pas » est une section à part entière : son titre tombe au pas des sections, sa
 * liste se lit comme du texte.
 */
---

<section id="outil-calcul" class="section outil-zone-section" data-tool-section="calcul" aria-labelledby="outil-zone-titre">
  <div class="conteneur outil-zone-inner">
    <h2 id="outil-zone-titre" class="sr-only">Utiliser l’outil</h2>
    <div class:list={['outil-zone', { 'outil-zone-large': large }]}>
      <div class="outil-calcul">
        {suspension ? (
          <div class="outil-suspension" role="status" aria-labelledby="outil-suspension-titre">
            <p class="surtitre">Règle à revérifier</p>
            <h2 id="outil-suspension-titre">Calcul suspendu</h2>
            <p>Nous avons arrêté ce calcul plutôt que de répondre avec une règle que sa source officielle ne confirme plus.</p>
            <dl>
              <div><dt>Motif</dt><dd>{suspension.motif}</dd></div>
              <div><dt>Depuis le</dt><dd>{suspension.date}</dd></div>
            </dl>
          </div>
        ) : <slot />}
      </div>
      <aside class="outil-local rv" data-local-notice aria-labelledby="local-titre">
        <h3 id="local-titre">Ce qui reste dans votre navigateur</h3>
        <p>{mentionLocale}</p>
        <p>Seul un clic volontaire vers « Confier une première tâche » change de page. Le chemin de cette page n’est conservé que si vous envoyez ensuite le formulaire avec votre consentement.</p>
      </aside>
    </div>

    <div class="outil-limites rv" aria-labelledby="limites-titre">
      <h2 id="limites-titre">Ce que cette page ne fait pas</h2>
      <ul>
        {limites.map((limite) => <li>{limite}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .outil-zone-inner {
    display: grid;
    gap: var(--section-espace);
  }
  .outil-zone {
    display: grid;
    gap: var(--bloc-ecart);
    align-items: start;
  }
  /* Le plateau du formulaire, comme sur /contact. */
  .outil-calcul {
    min-width: 0;
    padding: var(--carte-marge);
    border: 1px solid var(--ligne);
    border-radius: var(--r-carte);
    background: var(--surface-feuille);
    box-shadow: var(--ombre-xs);
  }
  .outil-suspension {
    display: grid;
    gap: var(--tete-ecart);
    max-width: 62ch;
  }
  .outil-suspension h2 {
    font-size: var(--titre-intertitre);
  }
  .outil-suspension > p:not(.surtitre),
  .outil-suspension dd {
    color: var(--texte-2);
  }
  .outil-suspension dl {
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }
  .outil-suspension dl div {
    display: grid;
    gap: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--ligne-douce);
  }
  .outil-suspension dt {
    font-weight: 700;
  }
  .outil-local {
    display: grid;
    gap: var(--tete-ecart);
    align-content: start;
  }
  .outil-local h3 {
    font-size: var(--titre-bloc);
    line-height: 1.2;
  }
  .outil-local p {
    margin: 0;
    max-width: 58ch;
    color: var(--texte-2);
  }
  .outil-limites {
    display: grid;
    gap: var(--tete-ecart);
    max-width: 46rem;
  }
  .outil-limites h2 {
    font-size: var(--titre-section);
  }
  .outil-limites ul {
    display: grid;
    gap: var(--espace-2);
    max-width: 62ch;
    margin: 0;
    padding-left: 1.3em;
    list-style: disc;
    color: var(--texte-2);
  }
  .outil-limites li {
    text-wrap: pretty;
  }
  @media (min-width: 48rem) {
    .outil-calcul {
      padding: var(--carte-marge-lg);
    }
  }
  @media (min-width: 64rem) {
    .outil-zone {
      grid-template-columns: minmax(0, 7fr) minmax(280px, 5fr);
      gap: var(--espace-16);
    }
    .outil-local {
      position: sticky;
      top: calc(var(--nav-h) + 32px);
    }
    .outil-zone-large { grid-template-columns: minmax(0, 1fr); }
    .outil-zone-large .outil-local { position: static; }
  }
</style>
