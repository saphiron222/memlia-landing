---
import Chip from '@/components/Chip.astro';
import Button from '@/components/Button.astro';
import Picture from '@/components/Picture.astro';
import { MODULES_AFFICHES, LIBELLE_STATUT, ancreModule } from '@/data/modules';
import { CTA } from '@/data/site.mjs';


/**
 * S4 — Bandes de modules (spec §4.7 ; copy validée section 4). Une bande par module
 * affiché ; avec un seul module, le gabarit reste identique (pas de variante pleine largeur).
 */

---

<section id="modules" class="modules" aria-labelledby="modules-titre">
  <div class="modules-tete rv">
    <span class="eyebrow">Contrôles paie et DSN dans Excel</span>
    <h2 id="modules-titre">Commencez par la règle qui vous coûte le plus de vérifications.</h2>
    <p class="texte-2 modules-intro">Memlia avance module par module.</p>
  </div>

  <div class="bandes">
    {MODULES_AFFICHES.filter(m => m.image).map((m, i) => (
      <article id={ancreModule(m).slice(1)} class="bande rv" style={`--tuile:${m.tuile}`}>
        <div class="bande-texte">
          <div class="bande-etiquettes">
            <Chip variante="pleine" picto="panneau" libelle={m.nom} tuile={m.tuile} encreTuile={m.encreTuile} />
            <span class:list={['statut', `statut-${m.statut}`]}>{LIBELLE_STATUT[m.statut]}</span>
          </div>
          <h3 class="bande-h3">{m.titre}</h3>
          <p class="texte-2 lecture">{m.texte}</p>
          <div class="bande-actions">
            <Button href={CTA.principal.href} variante="contour" picto="fleche">{CTA.principal.libelle}</Button>
          </div>
        </div>
        <div class="bande-image motif-diagonal" style={`--rang:${i}`}>
          <div class="bande-ecran">
            {m.image && <Picture id={m.image} sizes="(min-width: 48rem) 500px, 100vw" />}
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="module-studies">
    {MODULES_AFFICHES.filter(m => !m.image).map(m => (
      <article id={ancreModule(m).slice(1)} class="module-study rv">
        <span class="statut statut-etude">{LIBELLE_STATUT[m.statut]}</span>
        <h3>{m.nom}</h3>
        <p class="texte-2">{m.texte}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .module-studies { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--ligne); }
  .module-study { padding: 40px 32px; border-bottom: 1px solid var(--ligne); display: grid; gap: 16px; align-content: start; }
  .module-study:nth-child(odd) { border-right: 1px solid var(--ligne); }
  .module-study h3 { font-size: var(--t-2xl); }
  .module-study .statut { justify-self: start; }
  @media (max-width: 47.99rem) {
    .module-studies { grid-template-columns: minmax(0, 1fr); }
    .module-study { padding: 32px 24px; }
    .module-study:nth-child(odd) { border-right: 0; }
  }
  .modules {
    padding-top: 96px;
  }
  .modules-tete {
    display: grid;
    gap: 12px;
    max-width: 720px;
    padding: 0 var(--marge-page) 40px;
  }
  .bandes {
    display: grid;
    gap: 48px;
  }
  .bande {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--ligne);
    border-bottom: 1px solid var(--ligne);
    background: var(--surface-feuille);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .bande-texte {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 48px 24px 24px;
    border-bottom: 1px solid var(--ligne-douce);
  }
  .bande-etiquettes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .statut {
    display: inline-flex;
    align-items: center;
    padding: 0.2em 0.6em;
    border-radius: 6px;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .statut-disponible {
    background: var(--accent-voile);
    color: var(--accent-texte);
  }
  .statut-pilote,
  .statut-etude {
    background: var(--ocre-voile);
    color: var(--ocre);
  }
  .bande-h3 {
    margin-top: 10px;
  }
  .bande-actions {
    margin-top: 20px;
  }
  .bande-image {
    position: relative;
    overflow: hidden;
    padding: 24px 0 0 24px;
    background-color: color-mix(in srgb, var(--tuile) 4%, var(--surface-feuille));
    background-image:
      linear-gradient(to bottom right, color-mix(in srgb, var(--tuile) 1%, transparent), color-mix(in srgb, var(--tuile) 10%, transparent)),
      repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.2) 0 1px, transparent 1px 4px);
  }
  .bande-ecran {
    background: rgba(35, 31, 32, 0.02);
    padding: 8px 0 0 8px;
    border-top-left-radius: var(--r-ecran-coin);
    border-top: 1px solid var(--ligne);
    border-left: 1px solid var(--ligne);
    margin-left: auto;
    max-width: 508px;
  }
  .bande-ecran :global(img) {
    display: block;
    width: 100%;
    max-width: 500px;
    border-top-left-radius: var(--r-cadre);
    border-top: 1px solid rgba(35, 31, 32, 0.06);
    border-left: 1px solid rgba(35, 31, 32, 0.06);
  }
  @media (min-width: 48rem) {
    .bande {
      grid-template-columns: 1fr 50%;
    }
    .bande-texte {
      padding: 64px 48px;
      border-bottom: 0;
      border-right: 1px solid var(--ligne-douce);
    }
    .bande-image {
      padding: 40px 0 0 40px;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
    }
  }
  @media (min-width: 64rem) {
    .modules {
      padding-top: 128px;
    }
    .modules-tete {
      padding-left: var(--marge-page-lg);
      padding-right: var(--marge-page-lg);
    }
    .bande-ecran {
      backdrop-filter: blur(24px) saturate(1.25);
    }
  }
</style>
