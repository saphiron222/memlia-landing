---
import { rendreTableauxAccessibles } from '@/lib/table-scroll.mjs';
const html = rendreTableauxAccessibles(await Astro.slots.render('default'));
---
<Fragment set:html={html} />
<style is:global>
  [data-table-scroll] { max-width: 100%; overflow-x: auto; }
  [data-table-scroll]:focus-visible { outline: 3px solid var(--accent-texte); outline-offset: 3px; }
</style>
